@{
    ViewBag.Title = "Panel/ToolsCustomToolAhead";
    var F = Html.F();
}


@section body {

    @(F.Panel().IsFluid(true).CustomToolAhead(true).IconUrl(Url.Content("~/res/images/16/8.png")).BodyPadding(10).Height(350).Title("面板").ID("Panel1").EnableCollapse(true)
        .Items(
            F.Label().Text("面板内容")
        )
        .Tools(
            F.Tool().IconFont(IconFont._Save).ID("Tool4").ClickHandler("onToolIconClick"),
            F.Tool().IconFont(IconFont._Plus).ID("Tool18").ClickHandler("onToolIconClick"),
            F.Tool().IconFont(IconFont._Pencil).ID("Tool10").ClickHandler("onToolIconClick"),
            F.Tool().IconFont(IconFont._Minus).ID("Tool5").ClickHandler("onToolIconClick")
        )
    )
    <br>

    @(F.Button().OnClick(Url.Action("Button2_Click"), Parameter.FromFunction("collapsed", "getPanel1CollapsedPostbackValue")).Text("检查面板的折叠状态").CssClass("marginr").ID("Button2"))
    <br>


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getPanel1CollapsedPostbackValue() {
            return F.ui.Panel1.collapsed;
        }

    </script>


    <script>

        function onToolIconClick(event) {
            // 当前点击的图标字体
            var iconFont = this.iconFont;

            F.notify({
                message: '你点击了标题栏工具图标：' + iconFont,
                messageIconFont: iconFont,
                displayMilliseconds: 3000,
                positionX: 'center',
                positionY: 'center'
            });
        }

    </script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示把自定义工具图标排在内置折叠工具之前。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>点击与对照工具排列</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板">面板</strong>标题栏点击<strong>保存</strong>工具。<br />结果：执行本页客户端提示，提示内容包含当前工具标识；工具位置或文字按本页配置显示。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Tools</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>）：声明当前面板的自定义标题工具。</li>
            <li><code>CustomToolAhead</code>（<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板">面板</strong>）：初始为<code>true</code>，把自定义工具排在内置工具前面。</li>
        </ul>
    </section>
}
