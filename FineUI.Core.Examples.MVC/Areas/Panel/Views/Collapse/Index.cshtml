@{
    ViewBag.Title = "Panel/Collapse";
    var F = Html.F();
}


@section body {

    @(F.Panel().IsFluid(true).EnableCollapse(true).OnExpand(Url.Action("Panel1_CollapseExpand"), Parameter.FromFunction("collapsed", "getPanel1CollapsedPostbackValue")).OnCollapse(Url.Action("Panel1_CollapseExpand"), Parameter.FromFunction("collapsed", "getPanel1CollapsedPostbackValue")).IconUrl(Url.Content("~/res/images/16/8.png")).BodyPadding(10).Title("面板一").ID("Panel1")
        .Items(
            F.Panel().EnableCollapse(true).OnExpand(Url.Action("Panel2_CollapseExpand"), Parameter.FromFunction("collapsed", "getPanel2CollapsedPostbackValue")).OnCollapse(Url.Action("Panel2_CollapseExpand"), Parameter.FromFunction("collapsed", "getPanel2CollapsedPostbackValue")).ShowHeader(true).BodyPadding(10).Height(200).ShowBorder(true).Title("面板二").ID("Panel2").Content("展开折叠这两个面板。")
        )
    )
    <br>


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getPanel1CollapsedPostbackValue() {
            return F.ui.Panel1.collapsed;
        }

        function getPanel2CollapsedPostbackValue() {
            return F.ui.Panel2.collapsed;
        }

    </script>
}
