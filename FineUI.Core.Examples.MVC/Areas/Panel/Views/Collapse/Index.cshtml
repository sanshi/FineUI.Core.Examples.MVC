@{
    ViewBag.Title = "Panel/Collapse";
    var F = Html.F();
}


@section body {

    @(F.Panel().IsFluid(true).EnableCollapse(true).OnExpand(Url.Action("Panel1_CollapseExpand"), Parameter.FromFunction("collapsed", "getPanel1CollapsedPostbackValue")).OnCollapse(Url.Action("Panel1_CollapseExpand"), Parameter.FromFunction("collapsed", "getPanel1CollapsedPostbackValue")).IconUrl(Url.Content("~/res/images/16/8.png")).BodyPadding(10).Title("面板一").ID("Panel1")
        .Items(
            F.Panel().EnableCollapse(true).OnExpand(Url.Action("Panel2_CollapseExpand"), Parameter.FromFunction("collapsed", "getPanel2CollapsedPostbackValue")).OnCollapse(Url.Action("Panel2_CollapseExpand"), Parameter.FromFunction("collapsed", "getPanel2CollapsedPostbackValue")).ShowHeader(true).BodyPadding(10).Height(200).ShowBorder(true).Title("面板二").ID("Panel2").Content("展开折叠这两个面板。")
        )
    )
    <br>


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getPanel1CollapsedPostbackValue() {
            return F.ui.Panel1.collapsed;
        }

        function getPanel2CollapsedPostbackValue() {
            return F.ui.Panel2.collapsed;
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示分别监听嵌套面板的展开和折叠事件，并读取事件发生后的状态。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>核对两个面板的状态</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel1" title="面板一">面板一</strong>及其内部面板中点击折叠图标，再分别展开。<br />结果：每次状态变化触发对应面板事件并回发，后台提示面板名称与展开或折叠状态。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>OnCollapse</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板一">面板一</strong>、<strong class="example-control-reference" data-example-control="Panel2" title="面板二">面板二</strong>）：对应面板折叠后处理当前状态。</li>
        <li><code>OnExpand</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板一">面板一</strong>、<strong class="example-control-reference" data-example-control="Panel2" title="面板二">面板二</strong>）：对应面板展开后处理当前状态。</li>
    </ul>
</section>
}
