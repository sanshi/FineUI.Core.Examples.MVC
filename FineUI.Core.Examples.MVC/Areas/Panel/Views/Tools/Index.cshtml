@{
    ViewBag.Title = "Panel/Tools";
    var F = Html.F();
}


@section body {

    @(F.Panel().IsFluid(true).IconUrl(Url.Content("~/res/images/16/8.png")).BodyPadding(10).Height(350).Title("面板").ID("Panel1").EnableCollapse(true)
        .Items(
            F.Label().Text("面板内容")
        )
        .Tools(
            F.Tool().ID("ToolExample1").ToolTip("设置").IconFont(IconFont._Gear).ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("设置").IconFont(IconFont._Wrench).ID("Tool13").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("下载").IconFont(IconFont._Download).ID("Tool1").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("上传").IconFont(IconFont._Upload).ID("Tool3").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("打印").IconFont(IconFont._Print).ID("Tool2").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("保存").IconFont(IconFont._Save).ID("Tool4").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("新增").IconFont(IconFont._Plus).ID("Tool18").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("编辑").IconFont(IconFont._Pencil).ID("Tool10").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("删除").IconFont(IconFont._Minus).ID("Tool5").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("删除").IconFont(IconFont._Trash).ID("Tool14").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("删除").IconFont(IconFont._Close).ID("Tool15").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("登录").IconFont(IconFont._SignIn).ID("Tool6").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("退出").IconFont(IconFont._PowerOff).ID("Tool11").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("帮助").IconFont(IconFont._Question).ID("Tool9").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("详细").IconFont(IconFont._Info).ID("Tool20").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("搜索").IconFont(IconFont._Search).ID("Tool12").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("授权").IconFont(IconFont._Key).ID("Tool17").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("用户").IconFont(IconFont._User).ID("Tool7").ClickHandler("onToolIconClick"),
            F.Tool().ToolTip("分组").IconFont(IconFont._Group).ID("Tool19").ClickHandler("onToolIconClick")
        )
    )
    <br>

    @(F.Button().OnClick(Url.Action("Button2_Click"), Parameter.FromFunction("collapsed", "getPanel1CollapsedPostbackValue")).Text("检查面板的折叠状态").CssClass("marginr").ID("Button2"))
    <br>


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getPanel1CollapsedPostbackValue() {
            return F.ui.Panel1.collapsed;
        }

    </script>


    <script>

        function onToolIconClick(event) {
            // 当前点击的图标字体
            var iconFont = this.iconFont;

            F.notify({
                message: '你点击了标题栏工具图标：' + iconFont,
                messageIconFont: iconFont,
                displayMilliseconds: 3000,
                positionX: 'center',
                positionY: 'center'
            });
        }

    </script>

}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示在面板标题栏添加多种字体工具图标，并处理当前工具的点击。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>点击与对照工具排列</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>标题栏点击<strong>下载</strong>工具。<br />结果：执行本页客户端提示，提示内容包含当前工具标识；工具位置或文字按本页配置显示。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Tools</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>）：声明当前面板的自定义标题工具。</li>
        <li><code>IconFont</code>（本页各标题工具，如<strong class="example-control-reference" data-example-control="ToolExample1" title="第 1 个标题工具">第 1 个标题工具</strong>）：使用内置字体图标标识每项工具。</li>
        <li><code>ToolTip</code>（本页各标题工具，如<strong class="example-control-reference" data-example-control="ToolExample1" title="第 1 个标题工具">第 1 个标题工具</strong>）：悬停时显示对应操作名称。</li>
    </ul>
</section>
}
