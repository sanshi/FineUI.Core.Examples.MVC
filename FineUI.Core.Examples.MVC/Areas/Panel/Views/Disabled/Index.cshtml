@{
    ViewBag.Title = "Panel/Disabled";
    var F = Html.F();
}


@section body {

    @(F.Panel().IsFluid(true).IconFont(IconFont._VolumeUp).BodyPadding(10).Enabled(false).Title("面板").ID("Panel1")
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Bottom).ID("Toolbar1")
                .Items(
                    F.ToolbarText().ID("ToolbarText1").Text("工具条文本一"),
                    F.ToolbarSeparator().ID("ToolbarSeparator1"),
                    F.ToolbarText().ID("ToolbarText2").Text("工具条文本二"),
                    F.ToolbarSeparator().ID("ToolbarSeparator2"),
                    F.Button().Text("工具条按钮").ID("btnToolbarButton").ClickHandler("onToolbarButtonClick"),
                    F.ToolbarFill().ID("ToolbarFill1"),
                    F.ToolbarText().ID("ToolbarText4").Text("工具条文本四")
                )
        )
        .Items(
            F.Panel().ShowHeader(true).BodyPadding(10).Height(200).ShowBorder(true).Title("内容面板").ID("ContentPanel1").Content("可以在此放置<a href=\"http://www.w3schools.com/html/\" target=\"_blank\">HTML</a>标签。")
        )
    )
    <br>

    @(F.Button().OnClick(Url.Action("Button2_Click"), Parameter.FromFunction("disabled", "getPanel1DisabledPostbackValue")).Text("启用/禁用面板").CssClass("marginr").ID("Button2"))

    <br>


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getPanel1DisabledPostbackValue() {
            return F.ui.Panel1.disabled;
        }

    </script>


    <script>

        function onToolbarButtonClick(event) {
            F.alert("你点击了工具栏按钮");
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示初始禁用整个面板，并由面板外的按钮恢复或再次禁用。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>切换整个面板的可用状态</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="Button2" title="启用/禁用面板">启用/禁用面板</strong>。<br />结果：后台启用原先禁用的面板，内部工具栏和内容恢复可操作。
            </li>
            <li>点击<strong class="example-control-reference" data-example-control="Button2"
                    title="启用/禁用面板">启用/禁用面板</strong>。<br />结果：整个面板再次禁用，内部控件不再接受普通用户操作，内容仍保留。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Enabled</code>（<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板">面板</strong>）：初始为<code>false</code>，外层面板初始为 <code>false</code>，影响它内部的交互区域。</li>
        </ul>
    </section>
}
