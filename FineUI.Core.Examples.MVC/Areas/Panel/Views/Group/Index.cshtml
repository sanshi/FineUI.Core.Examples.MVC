@{
    ViewBag.Title = "Panel/Group";
    var F = Html.F();
}


@section body {

    <div id="content1">
        <a href="http://tech.163.com/special/jobsdead/" target="_blank"><b>乔布斯</b></a><br />
        <div>
            <p>
                乔布斯于1955年2月24日出生，苹果创始人之一。今年8月苹果超越埃克森美孚成为全球最大市值企业，截止上季度持有现金达到762亿美金，甚至超过了美国政府国库存款。
            </p>
            <p>
                遗憾的是，苹果的取得巨大成功还是无法给乔布斯一个健康的身体，乔布斯2003年被发现患有胰脏癌，随后又查出肝癌，危在旦夕的乔布斯在经历了8年的抗癌斗争、3次病休、若干次手术后，于2011年8月25日正式宣布从CEO位置辞职。2011年10月6日，乔布斯在苹果发布iPhone 4S后的第二天与世长辞。
            </p>
        </div>
    </div>


    @(F.Panel().IsFluid(true).EnableCollapse(true).Title("面板（自动高度）").BodyPadding(10).ID("Panel1")
        .Items(
            F.GroupPanel().Collapsed(true).EnableCollapse(true).ID("GroupPanel1").BodyPadding(10).Title("分组面板一")
                .Items(
                    F.SimpleForm().ShowHeader(false).ShowBorder(false).ID("SimpleForm1")
                        .Items(
                            F.TextBox().Label("名称").ID("TextBox1"),
                            F.TextArea().Label("备注").ID("TextArea1")
                        )
                ),
            F.GroupPanel().Title("分组面板二").EnableCollapse(true).ID("GroupPanel2")
                .Toolbars(
                    F.Toolbar().Position(ToolbarPosition.Bottom).ID("Toolbar1")
                        .Items(
                            F.Button().Text("左侧的按钮").ID("Button3"),
                            F.ToolbarFill().ID("ToolbarFill1"),
                            F.Button().Text("右侧的按钮").ID("Button1")
                        )
                )
                .Items(
                    F.Panel().ShowHeader(false).ShowBorder(false).ID("ContentPanel1").BodyPadding(10).ContentEl("#content1")
                )
        )
    )
    <br>

    @(F.Button().OnClick(Url.Action("Button2_Click"), Parameter.FromFunction("collapsed", "getGroupPanel2CollapsedPostbackValue")).Text("展开/折叠分组面板二").ID("Button2"))
    <br>

}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getGroupPanel2CollapsedPostbackValue() {
            return F.ui.GroupPanel2.collapsed;
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示可折叠的分组面板，在同一页面组织表单与普通内容。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>分别展开和折叠分组</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="GroupPanel1" title="分组面板一">分组面板一</strong>标题栏的展开图标，在名称或备注中输入文字。<br />结果：初始折叠的分组展开，显示内部表单。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button2" title="展开/折叠分组面板二">展开/折叠分组面板二</strong>。<br />结果：后台切换第二个分组，第一组表单内容继续保留。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableCollapse</code>（<strong class="example-control-reference" data-example-control="GroupPanel1" title="分组面板一">分组面板一</strong>、<strong class="example-control-reference" data-example-control="GroupPanel2" title="分组面板二">分组面板二</strong>）：初始为<code>true</code>，给对应分组显示折叠入口。</li>
        <li><code>Collapsed</code>（<strong class="example-control-reference" data-example-control="GroupPanel1" title="分组面板一">分组面板一</strong>）：初始为<code>true</code>，第一组初始为 <code>true</code>，等待用户展开。</li>
        <li><code>BodyPadding</code>（<strong class="example-control-reference" data-example-control="GroupPanel1" title="分组面板一">分组面板一</strong>）：初始为<code>10</code>，给分组内容与边框预留内边距。</li>
    </ul>
</section>
}
