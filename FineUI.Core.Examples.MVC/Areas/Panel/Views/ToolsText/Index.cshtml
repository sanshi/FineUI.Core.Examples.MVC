@{
    ViewBag.Title = "Panel/ToolsText";
    var F = Html.F();
}

@section body {

    @(F.Panel().IsFluid(true).IconUrl(Url.Content("~/res/images/16/8.png")).BodyPadding(10).Height(350).Title("面板").ID("Panel1")
        .Items(
            F.Label().Text("面板内容")
        )
        .Tools(
            F.Tool().Text("保存").ToolTip("保存").IconFont(IconFont._Save).ID("Tool4").ClickHandler("onToolIconClick"),
            F.Tool().Text("新增").ToolTip("新增").IconFont(IconFont._Plus).ID("Tool18").ClickHandler("onToolIconClick"),
            F.Tool().Text("编辑").ToolTip("编辑").IconFont(IconFont._Pencil).ID("Tool10").ClickHandler("onToolIconClick"),
            F.Tool().Text("删除").ToolTip("删除").IconFont(IconFont._Minus).ID("Tool5").ClickHandler("onToolIconClick")
        )
    )
    <br>


    @(F.Button().OnClick(Url.Action("Button2_Click"), Parameter.FromFunction("collapsed", "getPanel1CollapsedPostbackValue")).Text("检查面板的折叠状态").CssClass("marginr").ID("Button2"))
    <br>


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getPanel1CollapsedPostbackValue() {
            return F.ui.Panel1.collapsed;
        }

    </script>


    <script>

        function onToolIconClick(event) {
            // 当前点击的图标字体
            var iconFont = this.iconFont;

            F.notify({
                message: '你点击了标题栏工具图标：' + iconFont,
                messageIconFont: iconFont,
                displayMilliseconds: 3000,
                positionX: 'center',
                positionY: 'center'
            });
        }

    </script>

}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示在面板工具图标旁显示文字，帮助区分各项操作。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>点击与对照工具排列</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>标题栏点击<strong>保存</strong>工具。<br />结果：执行本页客户端提示，提示内容包含当前工具标识；工具位置或文字按本页配置显示。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Tools</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>）：声明当前面板的自定义标题工具。</li>
        <li><code>Text</code>（<strong class="example-control-reference" data-example-control="Tool4" title="第 1 个标题工具">第 1 个标题工具</strong>、<strong class="example-control-reference" data-example-control="Tool18" title="第 2 个标题工具">第 2 个标题工具</strong>、<strong class="example-control-reference" data-example-control="Tool10" title="第 3 个标题工具">第 3 个标题工具</strong>、<strong class="example-control-reference" data-example-control="Tool5" title="第 4 个标题工具">第 4 个标题工具</strong>）：各组分别设为<code>保存</code>、<code>新增</code>、<code>编辑</code>、<code>删除</code>，提供工具图标旁显示的说明文字。</li>
    </ul>
</section>
}
