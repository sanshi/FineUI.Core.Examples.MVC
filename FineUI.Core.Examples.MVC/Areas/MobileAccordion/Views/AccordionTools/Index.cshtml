@{
    ViewBag.Title = "MobileAccordion/AccordionTools";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section head {

    <style>
        .f-tool.mybadge {
            opacity: 1.0;
            filter: alpha(opacity=100);
        }

            .f-tool.mybadge .f-tool-text {
                padding: 0 4px;
                color: #fff;
                text-align: center;
                white-space: nowrap;
                background-color: #d15b47;
                font-size: 14px;
                border-radius: 12px;
				min-width: 24px;
            }


        .f-tool.mybadge-sub {
            opacity: 0.7;
            filter: alpha(opacity=70);
        }

            .f-tool.mybadge-sub .f-tool-text {
                font-size: 14px;
            }
    </style>


}

@section body {


    @(F.Accordion().ID("Accordion1").ShowHeader(false).ShowBorder(false).ActivePaneIndex(1).ShowCollapseTool(false).IsViewPort(true)
        .Toolbars(
            F.Toolbar().ID("Toolbar1").Title("手风琴控件").HeaderStyle(true)
        )
        .Panes(
            F.AccordionPane().ID("AccordionPane1").Title("面板一").IconUrl(Url.Content("~/res/images/16/1.png")).BodyPadding("2px 5px")
                .Tools(
                    F.Tool().ID("ToolExample1").CssClass("mybadge").Text("30")
                )
                .Items(
                    F.Label().ID("Label1").Text("面板一中的文本")
                ),
            F.AccordionPane().ID("AccordionPane2").Title("面板二（列表）").IconUrl(Url.Content("~/res/images/16/4.png")).Layout(LayoutType.Fit)
                .Tools(
                    F.Tool().ID("Tool1").CssClass("mybadge").Text("30/260")
                )
                .Items(
                    F.DataList().ID("DataList1")
                        .Items(
                            F.DataListItem().Value("item1").Text("列表项1"),
                            F.DataListItem().Value("item2").Text("列表项2"),
                            F.DataListItem().Value("item3").Text("列表项3"),
                            F.DataListItem().Value("item4").Text("列表项4"),
                            F.DataListItem().Value("item5").Text("列表项5")
                        )
                ),
            F.AccordionPane().ID("AccordionPane3").Title("面板三（IFrame）").IconUrl(Url.Content("~/res/images/16/7.png")).EnableIFrame(true).IFrameUrl(Url.Content("~/MobileButton/Button"))
                .Tools(
                    F.Tool().ID("Tool3").CssClass("mybadge-sub").Text("简单的文字描述"),
                    F.Tool().ID("Tool2").CssClass("mybadge").Text("30/150")
                )
        )
    )


}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示在移动手风琴标题中显示数字徽标和简短说明，并分别设置它们的外观。</p>
    <h3><i class="f-iconfont f-iconfont-list" aria-hidden="true"></i>切换面板并对照标题标记</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴">手风琴</strong>依次点击<strong class="example-control-reference" data-example-control="AccordionPane1" title="面板一">面板一</strong>、面板二和面板三标题。<br />结果：对应内容展开；标题中的 <code>30</code>、<code>30/260</code> 等数字徽标和简短说明保留各自样式，文字标记本身没有配置业务点击动作。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Tools</code>（<strong class="example-control-reference" data-example-control="AccordionPane1" title="面板一">面板一</strong>、<strong class="example-control-reference" data-example-control="AccordionPane2" title="面板二（列表）">面板二（列表）</strong>、<strong class="example-control-reference" data-example-control="AccordionPane3" title="面板三（IFrame）">面板三（IFrame）</strong>）：各组分别设为<code>F.Tool().ID(&quot;ToolExample1&quot;).CssClass(&quot;mybadge&quot;).Text(&quot;30&quot;)</code>、<code>F.Tool().ID(&quot;Tool1&quot;).CssClass(&quot;mybadge&quot;).Text(&quot;30/260&quot;)</code>，在各面板标题中放置数字或说明工具。</li>
        <li><code>Text</code>（<strong class="example-control-reference" data-example-control="ToolExample1" title="第 1 个标题工具">第 1 个标题工具</strong>、<strong class="example-control-reference" data-example-control="Tool1" title="第 2 个标题工具">第 2 个标题工具</strong>、<strong class="example-control-reference" data-example-control="Tool3" title="第 3 个标题工具">第 3 个标题工具</strong>、<strong class="example-control-reference" data-example-control="Tool2" title="第 4 个标题工具">第 4 个标题工具</strong>）：各组分别设为<code>30</code>、<code>30/260</code>、<code>简单的文字描述</code>、<code>30/150</code>，提供本页数字或简短说明。</li>
        <li><code>CssClass</code>（<strong class="example-control-reference" data-example-control="ToolExample1" title="第 1 个标题工具">第 1 个标题工具</strong>、<strong class="example-control-reference" data-example-control="Tool1" title="第 2 个标题工具">第 2 个标题工具</strong>、<strong class="example-control-reference" data-example-control="Tool3" title="第 3 个标题工具">第 3 个标题工具</strong>、<strong class="example-control-reference" data-example-control="Tool2" title="第 4 个标题工具">第 4 个标题工具</strong>）：各组分别设为<code>mybadge</code>、<code>mybadge-sub</code>，分别使用 <code>mybadge</code> 与 <code>mybadge</code>-<code>sub</code> 显示徽标和淡色说明。</li>
    </ul>
</section>
}
