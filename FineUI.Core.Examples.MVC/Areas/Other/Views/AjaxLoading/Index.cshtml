@{
    ViewBag.Title = "Other/AjaxLoading";
    var F = Html.F();
}


@section body {


    @(F.Button().Text("不显示提示信息").ID("Button1")
        .EnableAjaxLoading(false)
        .OnClick(Url.Action("Button1_Click"))
    )
    <br>
    <br>

    @(F.Button().Text("使用PageManager定义的提示信息").ID("Button2").OnClick(Url.Action("Button1_Click")))
    <br>
    <br>

    @(F.Button().Text("默认风格提示信息").ID("Button3")
        .AjaxLoadingType(AjaxLoadingType.Default)
        .OnClick(Url.Action("Button1_Click"))
    )
    <br>
    <br>

    @(F.Button().Text("Mask风格提示信息").ID("Button4")
        .AjaxLoadingType(AjaxLoadingType.Mask)
        .OnClick(Url.Action("Button1_Click"))
    )
    <br>
    <br>

    @(F.Button().Text("Mask风格提示信息（显示提示文本）").ID("Button5")
        .AjaxLoadingType(AjaxLoadingType.Mask)
        .ShowAjaxLoadingMaskText(true)
        .OnClick(Url.Action("Button1_Click"))
    )
    <br>
    <br>

    @(F.Button().Text("Mask风格提示信息（自定义提示文本）").ID("Button6")
        .AjaxLoadingType(AjaxLoadingType.Mask)
        .ShowAjaxLoadingMaskText(true)
        .AjaxLoadingMaskText("这是自定义提示文本")
        .OnClick(Url.Action("Button1_Click"))
    )
    <br>
    <br>
    注：
    <ul>
        <li>为了观察Ajax提示信息，所有按钮动作在后台都会睡眠1秒钟。</li>
        <li>本示例仅作演示，实际应用中请在Web.config中增加这些配置项，以便在整个项目中保持统一。</li>
    </ul>


}

