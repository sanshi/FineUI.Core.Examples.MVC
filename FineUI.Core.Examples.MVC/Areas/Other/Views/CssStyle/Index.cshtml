@{
    ViewBag.Title = "Other/CssStyle";
    var F = Html.F();
}


@section head {

    <style>
        .red {
            font-weight: bold;
            color: Red;
        }

        .green {
            font-weight: bold;
            font-style: italic;
            font-size: 1.5em;
            color: Green;
        }
    </style>

}

@section body {

    @(F.Label().ID("Label1").Text("文本一，注意观察文本的样式"))
    <br>

    @(F.Button().CssClass("marginr").ID("Button1").OnClick(Url.Action("Button1_Click")).Text("通过 CssStyle 修改文本的样式"))
    @(F.Button().ID("Button3").OnClick(Url.Action("Button3_Click")).Text("清空 CssStyle 设置的样式"))

    <br>
    <br>

    @(F.Label().ID("Label2").Text("文本二，注意观察文本的样式"))
    <br>

    @(F.Button().CssClass("marginr").ID("Button2").OnClick(Url.Action("Button2_Click"),
            Parameter.FromFunction("hasClassRed", "getLabel2HasClassRedPostbackValue")).Text("通过 CssClass 修改文本的样式")
    )
    @(F.Button().ID("Button4").OnClick(Url.Action("Button4_Click")).Text("清空 CssClass 设置的样式"))
    <br>
    <br>



}

@section script {
    <script>
        function clearLabelStyle() {
            F.ui.Label1.el.attr('style', '');
        }
    </script>


    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getLabel2HasClassRedPostbackValue() {
            return F.ui.Label2.el.hasClass('red');
        }

    </script>
}
