@{
    ViewBag.Title = "Other/ServerErrorCustomTimeout";
    var F = Html.F();
}


@section body {

    @{
        // AJAX请求超时时间设为 2 秒
        F.PageManager.AjaxTimeout(2);
    }

    @(F.Button().ID("Button5").OnClick(Url.Action("Button5_Click")).Text("服务器异常（500）"))
   


}


@section script {

    <script>
        F.beforeAjaxError(function (data, textStatus) {
            if (textStatus === 'timeout') {
                showCenterNotify('AJAX请求超时！', 'error');
            }

            // 需要显式的返回 false，来阻止默认的错误处理
            return false;
        });

    </script>

}