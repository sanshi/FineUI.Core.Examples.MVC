@{
    ViewBag.Title = "MobileButton/ButtonGroup";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    @(F.Panel().ID("Panel1").ShowBorder(false).ShowHeader(false).Layout(LayoutType.VBox).BoxConfigSpace(30).BodyPadding(10).AutoScroll(true).IsViewPort(true)
        .Items(
            F.ButtonGroup().ID("ButtonGroup1").EnablePressGroup(true)
                .Items(
                    F.Button().ID("Button1").Text("按钮一").EnablePress(true).Pressed(true),
                    F.Button().ID("Button2").Text("按钮二").EnablePress(true),
                    F.Button().ID("Button3").Text("按钮三").EnablePress(true)
                ),
            F.ButtonGroup().ID("ButtonGroup4").Layout(LayoutType.HBox).BoxConfigPosition(BoxLayoutPosition.Center).EnablePressGroup(true)
                .Items(
                    F.Button().ID("Button10").Text("按钮一").EnablePress(true),
                    F.Button().ID("Button11").Text("按钮二").EnablePress(true).Pressed(true),
                    F.Button().ID("Button12").Text("按钮三").EnablePress(true)
                ),
            F.ButtonGroup().ID("ButtonGroup5").Layout(LayoutType.HBox).BoxConfigPosition(BoxLayoutPosition.End).EnablePressGroup(true)
                .Items(
                    F.Button().ID("Button13").Text("按钮一").EnablePress(true),
                    F.Button().ID("Button14").Text("按钮二").EnablePress(true),
                    F.Button().ID("Button15").Text("按钮三").EnablePress(true).Pressed(true)
                ),
            F.ButtonGroup().ID("ButtonGroup3").Layout(LayoutType.HBox).EnablePressGroup(true)
                .Items(
                    F.Button().ID("Button7").BoxFlex(1).Text("按钮一").EnablePress(true),
                    F.Button().ID("Button8").BoxFlex(1).Text("按钮二").EnablePress(true).Pressed(true),
                    F.Button().ID("Button9").BoxFlex(1).Text("按钮三").EnablePress(true)
                )
        )
    )


}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示移动按钮组的互斥按下状态、对齐和等宽伸展。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>在同组中切换按下项</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="ButtonGroup1" title="第 1 个按钮组">第 1 个按钮组</strong>依次点击两个不同按钮。<br />结果：后点击的按钮按下，同组原先按下的按钮弹起；其它按钮组的状态不变。</li>
        <li>对照其它组的排列和宽度。<br />结果：各组分别对齐或拉伸，使用伸展比例的一组等分当前宽度。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnablePressGroup</code>（<strong class="example-control-reference" data-example-control="ButtonGroup1" title="第 1 个按钮组">第 1 个按钮组</strong>、<strong class="example-control-reference" data-example-control="ButtonGroup4" title="第 2 个按钮组">第 2 个按钮组</strong>、<strong class="example-control-reference" data-example-control="ButtonGroup5" title="第 3 个按钮组">第 3 个按钮组</strong>、<strong class="example-control-reference" data-example-control="ButtonGroup3" title="第 4 个按钮组">第 4 个按钮组</strong>）：初始为<code>true</code>，在各组内部保持互斥的按下状态。</li>
        <li><code>BoxFlex</code>（<strong class="example-control-reference" data-example-control="Button7" title="第 10 个按钮（按钮一）">第 10 个按钮（按钮一）</strong>、<strong class="example-control-reference" data-example-control="Button8" title="第 11 个按钮（按钮二）">第 11 个按钮（按钮二）</strong>、<strong class="example-control-reference" data-example-control="Button9" title="第 12 个按钮（按钮三）">第 12 个按钮（按钮三）</strong>）：初始为<code>1</code>，对应按钮等比例分配组内剩余宽度。</li>
    </ul>
</section>
}
