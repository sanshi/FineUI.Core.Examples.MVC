@{
    ViewBag.Title = "MobileButton/ButtonGroup";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    @(F.Panel().ID("Panel1").ShowBorder(false).ShowHeader(false).Layout(LayoutType.VBox).BoxConfigChildMargin("0 0 30 0").BodyPadding(10).AutoScroll(true).IsViewPort(true)
        .Items(
            F.ButtonGroup().ID("ButtonGroup1").EnablePressGroup(true)
                .Items(
                    F.Button().ID("Button1").Text("按钮一").EnablePress(true).Pressed(true),
                    F.Button().ID("Button2").Text("按钮二").EnablePress(true),
                    F.Button().ID("Button3").Text("按钮三").EnablePress(true)
                ),
            F.ButtonGroup().ID("ButtonGroup4").Layout(LayoutType.HBox).BoxConfigPosition(BoxLayoutPosition.Center).EnablePressGroup(true)
                .Items(
                    F.Button().ID("Button10").Text("按钮一").EnablePress(true),
                    F.Button().ID("Button11").Text("按钮二").EnablePress(true).Pressed(true),
                    F.Button().ID("Button12").Text("按钮三").EnablePress(true)
                ),
            F.ButtonGroup().ID("ButtonGroup5").Layout(LayoutType.HBox).BoxConfigPosition(BoxLayoutPosition.End).EnablePressGroup(true)
                .Items(
                    F.Button().ID("Button13").Text("按钮一").EnablePress(true),
                    F.Button().ID("Button14").Text("按钮二").EnablePress(true),
                    F.Button().ID("Button15").Text("按钮三").EnablePress(true).Pressed(true)
                ),
            F.ButtonGroup().ID("ButtonGroup3").Layout(LayoutType.HBox).EnablePressGroup(true)
                .Items(
                    F.Button().ID("Button7").BoxFlex(1).Text("按钮一").EnablePress(true),
                    F.Button().ID("Button8").BoxFlex(1).Text("按钮二").EnablePress(true).Pressed(true),
                    F.Button().ID("Button9").BoxFlex(1).Text("按钮三").EnablePress(true)
                )
        )
    )


}

