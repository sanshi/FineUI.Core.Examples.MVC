@{
    ViewBag.Title = "MobileButton/ButtonGroupVertical";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    @(F.Panel().ID("Panel1").ShowBorder(false).ShowHeader(false).Layout(LayoutType.VBox).BoxConfigSpace(10).BodyPadding(10).AutoScroll(true).IsViewPort(true)
        .Items(
            F.ButtonGroup().ID("ButtonGroup2").Layout(LayoutType.VBox).BoxConfigAlign(BoxLayoutAlign.StretchMax).EnablePressGroup(true).Vertical(true)
                .Items(
                    F.Button().ID("Button4").Text("按钮一").Icon(Icon.Cake).EnablePress(true).Pressed(true),
                    F.Button().ID("Button5").Text("按钮二").IconFont(IconFont._Bank).EnablePress(true),
                    F.Button().ID("Button6").Text("按钮三").IconFont(IconFont._Group).EnablePress(true)
                ),
            F.ButtonGroup().ID("ButtonGroup6").Layout(LayoutType.VBox).BoxConfigAlign(BoxLayoutAlign.StretchMaxCenter).EnablePressGroup(true).Vertical(true)
                .Items(
                    F.Button().ID("Button16").Text("按钮一").Icon(Icon.Cake).EnablePress(true),
                    F.Button().ID("Button17").Text("按钮二").IconFont(IconFont._Bank).EnablePress(true).Pressed(true),
                    F.Button().ID("Button18").Text("按钮三").IconFont(IconFont._Group).EnablePress(true)
                ),
            F.ButtonGroup().ID("ButtonGroup7").Layout(LayoutType.VBox).BoxConfigAlign(BoxLayoutAlign.StretchMaxEnd).EnablePressGroup(true).Vertical(true)
                .Items(
                    F.Button().ID("Button19").Text("按钮一").Icon(Icon.Cake).EnablePress(true),
                    F.Button().ID("Button20").Text("按钮二").IconFont(IconFont._Bank).EnablePress(true),
                    F.Button().ID("Button21").Text("按钮三").IconFont(IconFont._Group).EnablePress(true).Pressed(true)
                ),
            F.ButtonGroup().ID("ButtonGroup8").Layout(LayoutType.VBox).BoxConfigAlign(BoxLayoutAlign.Stretch).EnablePressGroup(true).Vertical(true)
                .Items(
                    F.Button().ID("Button22").Text("按钮一").Icon(Icon.Cake).EnablePress(true),
                    F.Button().ID("Button23").Text("按钮二").IconFont(IconFont._Bank).EnablePress(true).Pressed(true),
                    F.Button().ID("Button24").Text("按钮三").IconFont(IconFont._Group).EnablePress(true)
                )
        )
    )


}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示垂直按钮组中的互斥按下状态，以及不同水平对齐方式。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>在同组中切换按下项</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="ButtonGroup2" title="第 1 个按钮组">第 1
                    个按钮组</strong>依次点击两个不同按钮。<br />结果：后点击的按钮按下，同组原先按下的按钮弹起；其它按钮组的状态不变。</li>
            <li>对照其它组的排列和宽度。<br />结果：组内按钮纵向连续排列，各组分别使用本页对应的水平对齐。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnablePressGroup</code>（<strong class="example-control-reference" data-example-control="ButtonGroup2" title="第 1 个按钮组">第 1
                    个按钮组</strong>、<strong class="example-control-reference" data-example-control="ButtonGroup6" title="第 2 个按钮组">第 2 个按钮组</strong>、<strong
                    class="example-control-reference" data-example-control="ButtonGroup7" title="第 3 个按钮组">第 3 个按钮组</strong>、<strong
                    class="example-control-reference" data-example-control="ButtonGroup8" title="第 4 个按钮组">第 4
                    个按钮组</strong>）：初始为<code>true</code>，在各组内部保持互斥的按下状态。</li>
            <li><code>Vertical</code>（<strong class="example-control-reference" data-example-control="ButtonGroup2" title="第 1 个按钮组">第 1 个按钮组</strong>、<strong
                    class="example-control-reference" data-example-control="ButtonGroup6" title="第 2 个按钮组">第 2 个按钮组</strong>、<strong
                    class="example-control-reference" data-example-control="ButtonGroup7" title="第 3 个按钮组">第 3 个按钮组</strong>、<strong
                    class="example-control-reference" data-example-control="ButtonGroup8" title="第 4 个按钮组">第 4 个按钮组</strong>）：初始为<code>true</code>，使用纵向分组。</li>
            <li><code>BoxConfigAlign</code>（<strong class="example-control-reference" data-example-control="ButtonGroup2" title="第 1 个按钮组">第 1
                    个按钮组</strong>、<strong class="example-control-reference" data-example-control="ButtonGroup6" title="第 2 个按钮组">第 2 个按钮组</strong>、<strong
                    class="example-control-reference" data-example-control="ButtonGroup7" title="第 3 个按钮组">第 3 个按钮组</strong>、<strong
                    class="example-control-reference" data-example-control="ButtonGroup8" title="第 4 个按钮组">第 4
                    个按钮组</strong>）：各组分别设为<code>BoxLayoutAlign.StretchMax</code>、<code>BoxLayoutAlign.StretchMaxCenter</code>、<code>BoxLayoutAlign.StretchMaxEnd</code>、<code>BoxLayoutAlign.Stretch</code>，控制纵向按钮组中各按钮的宽度与水平对齐。
            </li>
        </ul>
    </section>
}
