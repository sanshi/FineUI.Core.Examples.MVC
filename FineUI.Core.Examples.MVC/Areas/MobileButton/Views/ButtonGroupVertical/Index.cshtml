@{
    ViewBag.Title = "MobileButton/ButtonGroupVertical";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    @(F.Panel().ID("Panel1").ShowBorder(false).ShowHeader(false).Layout(LayoutType.VBox).BoxConfigChildMargin("0 0 10px 0").BodyPadding(10).AutoScroll(true).IsViewPort(true)
        .Items(
            F.ButtonGroup().ID("ButtonGroup2").Layout(LayoutType.VBox).BoxConfigAlign(BoxLayoutAlign.StretchMax).EnablePressGroup(true).Vertical(true)
                .Items(
                    F.Button().ID("Button4").Text("按钮一").Icon(Icon.Cake).EnablePress(true).Pressed(true),
                    F.Button().ID("Button5").Text("按钮二").IconFont(IconFont._Bank).EnablePress(true),
                    F.Button().ID("Button6").Text("按钮三").IconFont(IconFont._Group).EnablePress(true)
                ),
            F.ButtonGroup().ID("ButtonGroup6").Layout(LayoutType.VBox).BoxConfigAlign(BoxLayoutAlign.StretchMaxCenter).EnablePressGroup(true).Vertical(true)
                .Items(
                    F.Button().ID("Button16").Text("按钮一").Icon(Icon.Cake).EnablePress(true),
                    F.Button().ID("Button17").Text("按钮二").IconFont(IconFont._Bank).EnablePress(true).Pressed(true),
                    F.Button().ID("Button18").Text("按钮三").IconFont(IconFont._Group).EnablePress(true)
                ),
            F.ButtonGroup().ID("ButtonGroup7").Layout(LayoutType.VBox).BoxConfigAlign(BoxLayoutAlign.StretchMaxEnd).EnablePressGroup(true).Vertical(true)
                .Items(
                    F.Button().ID("Button19").Text("按钮一").Icon(Icon.Cake).EnablePress(true),
                    F.Button().ID("Button20").Text("按钮二").IconFont(IconFont._Bank).EnablePress(true),
                    F.Button().ID("Button21").Text("按钮三").IconFont(IconFont._Group).EnablePress(true).Pressed(true)
                ),
            F.ButtonGroup().ID("ButtonGroup8").Layout(LayoutType.VBox).BoxConfigAlign(BoxLayoutAlign.Stretch).EnablePressGroup(true).Vertical(true)
                .Items(
                    F.Button().ID("Button22").Text("按钮一").Icon(Icon.Cake).EnablePress(true),
                    F.Button().ID("Button23").Text("按钮二").IconFont(IconFont._Bank).EnablePress(true).Pressed(true),
                    F.Button().ID("Button24").Text("按钮三").IconFont(IconFont._Group).EnablePress(true)
                )
        )
    )


}

