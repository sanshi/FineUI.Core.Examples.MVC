@{
    ViewBag.Title = "GridMerge/ColumnsAll";
    var F = Html.F();
}


@using System.Data;

@section body {

    @{
        DataTable source = DataSourceUtil.GetDataTable();

        foreach (DataRow row in source.Rows)
        {
            DateTime logTime = (DateTime)row["LogTime"];
            row["LogTime"] = new DateTime(logTime.Year, logTime.Month, logTime.Day);
        }
    }

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableColumnLines(true)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("ID").DataField("ID"),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        ).Listener("dataload", "onGridDataLoad").DataSource(source)
    )
    <br>
    <br>


    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>
        function onGridDataLoad(event) {
            this.mergeColumns();
        }
    </script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>让全部数据列按相邻相同值自动合并，减少重复显示。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>查看相邻相同值的显示</h3>
        <ul>
            <li>沿<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong><strong><strong>所学专业</strong></strong>、<strong>分组</strong>和<strong>注册日期</strong>等配置列逐行查看合并边界。<br />结果：所有参与的数据列分别合并连续相同值，不相邻的相同值仍是不同块。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>mergeColumns</code>（<strong>页面合并脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：不传列清单时处理全部适用数据列；仍只合并连续相同的显示值。</li>
        </ul>
    </section>
}
