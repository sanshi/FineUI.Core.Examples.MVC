@{
    ViewBag.Title = "GridMerge/ColumnsLockColumn";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableColumnLines(true).AllowColumnLocking(true)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("ID").DataField("ID").EnableLock(true).Locked(true),
            F.RenderField().HeaderText("姓名").DataField("Name").EnableLock(true).Locked(true),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").EnableLock(true),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int).EnableLock(true),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true).EnableLock(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").Width(300).EnableLock(true),
            F.RenderField().HeaderText("分组A").DataField("Group").RendererFunction("renderGroup").EnableLock(true),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd").EnableLock(true)
        ).Listener("dataload", "onGridDataLoad")
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>
        function onGridDataLoad(event) {
            this.mergeColumns(['EntranceYear', 'Major']);
        }
    </script>

}
