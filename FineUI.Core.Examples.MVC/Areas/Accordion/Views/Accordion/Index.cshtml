@{
    ViewBag.Title = "Accordion/Accordion";
    var F = Html.F();
}


@section body {

    @(F.Accordion().IsFluid(true).ActivePaneIndex(1).ShowBorder(true).Height(500).Title("手风琴控件").ID("Accordion1").ShowHeader(false)
        .Panes(
            F.AccordionPane().BodyPadding("2 5").IconUrl(Url.Content("~/res/images/16/1.png")).Title("面板一").ID("AccordionPane1")
                .Items(
                    F.Label().Text("面板一中的文本").ID("Label1")
                ),
            F.AccordionPane().BodyPadding("2 5").IconUrl(Url.Content("~/res/images/16/4.png")).Title("面板二").ID("AccordionPane2")
                .Items(
                    F.Label().Text("面板二中的文本").ID("Label2")
                ),
            F.AccordionPane().BodyPadding("2 5").IconUrl(Url.Content("~/res/images/16/7.png")).Title("面板三").ID("AccordionPane3")
                .Items(
                    F.Label().Text("面板三中的文本").ID("Label3")
                )
        )
    )
    <br>

    @(F.Button().OnClick(Url.Action("Button1_Click"), Parameter.FromFunction("activeIndex", "getAccordion1ActiveIndexPostbackValue")).Text("获取当前展开的面板").ID("Button1"))
    <br>
    <br>

    @(F.Button().OnClick(Url.Action("Button2_Click"), Parameter.FromFunction("activeIndex", "getAccordion1ActiveIndexPostbackValue")).Text("展开下一个面板").ID("Button2"))
    <br>


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getAccordion1ActiveIndexPostbackValue() {
            return F.ui.Accordion1.getActivePaneIndex();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示手风琴面板的互斥展开、读取当前面板和顺序切换。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>展开与读取当前面板</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴控件">手风琴控件</strong>点击<code>面板一</code>标题。<br />结果：浏览器展开面板一，原来展开的面板收起。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button1" title="获取当前展开的面板">获取当前展开的面板</strong>。<br />结果：读取当前展开面板的位置并显示提示；显示编号按页面习惯从 <code>1</code> 开始。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button2" title="展开下一个面板">展开下一个面板</strong>。<br />结果：切换到下一个可用面板，显示对应内容。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>ActivePaneIndex</code>（<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴控件">手风琴控件</strong>）：初始为<code>1</code>，指定当前展开面板，配置索引从 <code>0</code> 开始。</li>
        <li><code>EnableFill</code>（<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴控件">手风琴控件</strong>）：默认填充可用高度，当前展开面板使用剩余空间。</li>
    </ul>
</section>
}
