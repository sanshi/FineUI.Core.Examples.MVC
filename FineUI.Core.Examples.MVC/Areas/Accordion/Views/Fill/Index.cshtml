@{
    ViewBag.Title = "Accordion/Fill";
    var F = Html.F();
}


@section body {

    @(F.Accordion().IsFluid(true).ActivePaneIndex(1).ShowBorder(true).Height(500).Title("手风琴控件").ID("Accordion1").EnableFill(false).ShowHeader(false)
        .Panes(
            F.AccordionPane().BodyPadding("2 5").IconUrl(Url.Content("~/res/images/16/1.png")).Title("面板一").ID("AccordionPane1")
                .Items(
                    F.Label().Text("面板一中的文本").ID("Label1")
                ),
            F.AccordionPane().BodyPadding("2 5").IconUrl(Url.Content("~/res/images/16/4.png")).Title("面板二").ID("AccordionPane2")
                .Items(
                    F.Label().Text("面板二中的文本<br/>balabala<br/>balabala<br/>balabala<br/>balabala").ID("Label2").EncodeText(false)
                ),
            F.AccordionPane().BodyPadding("2 5").IconUrl(Url.Content("~/res/images/16/7.png")).Title("面板三").ID("AccordionPane3")
                .Items(
                    F.Label().Text("面板三中的文本").ID("Label3")
                )
        )
    )
    <br>

    @(F.Button().OnClick(Url.Action("Button1_Click"), Parameter.FromFunction("activeIndex", "getAccordion1ActiveIndexPostbackValue")).Text("获取当前展开的面板").ID("Button1"))
    <br>
    <br>

    @(F.Button().OnClick(Url.Action("Button2_Click"), Parameter.FromFunction("activeIndex", "getAccordion1ActiveIndexPostbackValue")).Text("展开下一个面板").ID("Button2"))
    <br>


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getAccordion1ActiveIndexPostbackValue() {
            return F.ui.Accordion1.getActivePaneIndex();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示手风琴面板按内容自然高度展开，并允许把所有面板都收起。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>比较自然高度与全部折叠</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴控件">手风琴控件</strong>先展开面板二，再点击它的标题。<br />结果：面板按内容高度显示；再次点击可收起当前面板，不强制保留一个展开项。</li>
        <li>点击<strong class="example-control-reference" data-example-control="Button1" title="获取当前展开的面板">获取当前展开的面板</strong>。<br />结果：全部折叠时显示没有面板处于展开状态的提示。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableFill</code>（<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴控件">手风琴控件</strong>）：设为<code>false</code>，展开面板不再填满容器剩余高度。</li>
        <li><code>ActivePaneIndex</code>（<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴控件">手风琴控件</strong>）：设为<code>1</code>，全部折叠时表示没有当前面板，不能按正常位置直接取内容。</li>
    </ul>
</section>
}
