@{
    ViewBag.Title = "Accordion/PaneIndexChanged";
    var F = Html.F();
}


@section body {

    @(F.Accordion().IsFluid(true).ActivePaneIndex(1).ShowBorder(true).Height(500).Title("手风琴控件").ID("Accordion1").ShowHeader(false).OnPaneIndexChanged(Url.Action("Accordion1_PaneIndexChanged"), Parameter.FromFunction("activeIndex", "getAccordion1ActiveIndexPostbackValue"))
        .Panes(
            F.AccordionPane().BodyPadding("2 5").IconUrl(Url.Content("~/res/images/16/1.png")).Title("面板一").ID("AccordionPane1")
                .Items(
                    F.Label().Text("面板一中的文本").ID("Label1")
                ),
            F.AccordionPane().BodyPadding("2 5").IconUrl(Url.Content("~/res/images/16/4.png")).Title("面板二").ID("AccordionPane2")
                .Items(
                    F.Label().Text("面板二中的文本").ID("Label2")
                ),
            F.AccordionPane().BodyPadding("2 5").IconUrl(Url.Content("~/res/images/16/7.png")).Title("面板三").ID("AccordionPane3")
                .Items(
                    F.Label().Text("面板三中的文本").ID("Label3")
                )
        )
    )
    <br>

    @(F.Button().OnClick(Url.Action("Button1_Click"), Parameter.FromFunction("activeIndex", "getAccordion1ActiveIndexPostbackValue")).Text("获取当前展开的面板").ID("Button1"))
    <br>
    <br>

    @(F.Button().OnClick(Url.Action("Button2_Click"), Parameter.FromFunction("activeIndex", "getAccordion1ActiveIndexPostbackValue")).Text("展开下一个面板").ID("Button2"))
    <br>


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getAccordion1ActiveIndexPostbackValue() {
            return F.ui.Accordion1.getActivePaneIndex();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示手风琴当前面板改变时回发，并读取变化后的展开位置。</p>
    <h3><i class="f-iconfont f-iconfont-refresh" aria-hidden="true"></i>处理展开面板变化</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴控件">手风琴控件</strong>从面板二切到面板一。<br />结果：面板改变事件回发，后台显示当前展开面板的编号。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>OnPaneIndexChanged</code>（<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴控件">手风琴控件</strong>）：当前展开面板变化时执行，不需要另点读取按钮。</li>
        <li><code>ActivePaneIndex</code>（<strong class="example-control-reference" data-example-control="Accordion1" title="手风琴控件">手风琴控件</strong>）：设为<code>1</code>，用于读取事件发生后的当前面板位置。</li>
    </ul>
</section>
}
