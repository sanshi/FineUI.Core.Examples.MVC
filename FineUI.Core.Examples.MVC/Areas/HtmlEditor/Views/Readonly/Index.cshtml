@{
    ViewBag.Title = "HtmlEditor/Readonly";
    var F = Html.F();
}

@section body {
    @(F.SimpleForm().ID("SimpleForm1").IsFluid(true).BodyPadding(10).LabelAlign(LabelAlign.Top).Title("只读与恢复编辑")
        .Items(
            F.HtmlEditor().ID("HtmlEditor1").Label("正文").Height(320).Text("<p>FineUI 富文本编辑器</p><p>选择文字，试试<strong>加粗</strong>、<em>斜体</em>和列表。</p>").Readonly(true).ToolbarSet(EditorToolbarSet.Basic),
            
            F.TextArea().ID("TextArea1").Label("HTML 内容").Height(120).Text("<p>FineUI 富文本编辑器</p><p>选择文字，试试<strong>加粗</strong>、<em>斜体</em>和列表。</p>"),
            F.Button().ID("Button1").Text("获取编辑器内容").CssClass("marginr").OnClick(Url.Action("Button1_Click"), Parameter.FromFunction("content", "getHtmlEditorContent")),
            F.Button().ID("Button2").Text("设置编辑器内容").CssClass("marginr").OnClick(Url.Action("Button2_Click"), Parameter.FromFunction("content", "getSourceContent")),
            F.Button().ID("btnToggle").Text("切换只读")
        )
    )
    <p>只读时允许选择、复制和查看源码；修改正文和应用源码均被禁止。可使用下方按钮切换。</p>
    <p>内置编辑器使用 Text 读写 HTML；旧编辑器仍可显式设置 Editor。</p>
}
@section script {
    <script>
function toggleHtmlEditorReadonly() {
    var editor = F.ui.HtmlEditor1;
    editor.setReadonly(!editor.readonly);
}
function getHtmlEditorContent() {
    return F.ui.HtmlEditor1.getValue();
}
function getSourceContent() {
    return F.ui.TextArea1.getValue();
}
F.ready(function () { F.ui.btnToggle.on('click', toggleHtmlEditorReadonly); });
    </script>
}
