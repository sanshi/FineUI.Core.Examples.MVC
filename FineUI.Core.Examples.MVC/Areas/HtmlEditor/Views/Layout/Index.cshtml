@{
    ViewBag.Title = "HtmlEditor/Layout";
    var F = Html.F();
}

@section body {
    @(F.SimpleForm().ID("SimpleForm1").IsFluid(true).BodyPadding(10).LabelAlign(LabelAlign.Top).Title("多实例与容器布局")
        .Items(
            F.HtmlEditor().ID("HtmlEditor1").Label("正文").Height(320).Text("<p>FineUI 富文本编辑器</p><p>选择文字，试试<strong>加粗</strong>、<em>斜体</em>和列表。</p>").Readonly(false).ToolbarSet(EditorToolbarSet.Basic),
            F.HtmlEditor().ID("HtmlEditor2").Label("正文").Height(320).Text("<p>FineUI 富文本编辑器</p><p>选择文字，试试<strong>加粗</strong>、<em>斜体</em>和列表。</p>").Readonly(false).ToolbarSet(EditorToolbarSet.Basic),
            F.TextArea().ID("TextArea1").Label("HTML 内容").Height(120).Text("<p>FineUI 富文本编辑器</p><p>选择文字，试试<strong>加粗</strong>、<em>斜体</em>和列表。</p>"),
            F.Button().ID("Button1").Text("获取编辑器内容").CssClass("marginr").OnClick(Url.Action("Button1_Click"), Parameter.FromFunction("content", "getHtmlEditorContent")),
            F.Button().ID("Button2").Text("设置编辑器内容").OnClick(Url.Action("Button2_Click"), Parameter.FromFunction("content", "getSourceContent"))
        )
    )
    <p>两个编辑器拥有独立的内容、选区和撤销记录；改变浏览器宽度可观察工具栏换行。</p>
    <p>内置编辑器使用 Text 读写 HTML；旧编辑器仍可显式设置 Editor。</p>
}
@section script {
    <script>
function toggleHtmlEditorReadonly() {
    var editor = F.ui.HtmlEditor1;
    editor.setReadonly(!editor.readonly);
}
function getHtmlEditorContent() {
    return F.ui.HtmlEditor1.getValue();
}
function getSourceContent() {
    return F.ui.TextArea1.getValue();
}

    F.ready(function () {
    var editorWindow = new F.Window({
        id: 'Window1', renderTo: document.body, title: '窗口与隐藏选项卡', hidden: true,
        width: 760, height: 460, layout: 'fit', resizable: true,
        items: [{ type: 'TabStrip', id: 'TabStrip1', items: [
            { type: 'Tab', id: 'Tab1', title: '第一份文档', layout: 'fit', items: [
                { type: 'HtmlEditor', id: 'HtmlEditor3', showLabel: false, value: '<p>窗口中的第一份文档</p>' }
            ] },
            { type: 'Tab', id: 'Tab2', title: '隐藏选项卡', layout: 'fit', items: [
                { type: 'HtmlEditor', id: 'HtmlEditor4', showLabel: false, value: '<p>切换选项卡后继续编辑</p>' }
            ] }
        ] }]
    });
    new F.Button({ id: 'btnOpenEditor', renderTo: document.body, text: '打开编辑窗口', handler: function () {
        editorWindow.show();
    } });
});
</script>
}
