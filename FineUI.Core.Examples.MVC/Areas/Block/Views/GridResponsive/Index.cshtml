@{
    ViewBag.SourceFiles = "~/wwwroot/res/css/responsive_card.css;~/wwwroot/res/js/grid.js;~/wwwroot/res/js/responsive_card.js";
    ViewBag.Title = "Block/GridResponsive";
    var F = Html.F();
}

@section head {

    <link href="~/res/css/responsive_card.css?v@(GlobalConfig.ProductVersion)" rel="stylesheet" />

}

@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").CssClass("responsive-card-grid").Title("表格").ShowHeader(true).ShowBorder(true)
        .EnableCheckBoxSelect(true).EnableAlternateRowColor(true).EnableRowLines(true).DataIDField("Id").DataTextField("Name").KeepCurrentSelection(true)
        .Height(600)
        .DataAttributeFields(new string[] { "Name", "Gender", "Avatar", "EntranceYear", "Status", "Desc" })
        .ResponsiveCardSize(GridResponsiveCardSize.MD).CardRendererFunction("renderResponsiveCard")
        .Columns(
            F.RenderField().ColumnID("UserProfile").Width(250).RendererFunction("renderUserProfile").HeaderText("基本信息"),
            F.RenderCheckField().ColumnID("AtSchool").DataField("AtSchool").RenderAsStaticField(true).HeaderText("是否在校"),
            F.RenderField().ColumnID("Rate1").Width(150).DataField("Rate1").FieldType(FieldType.Int).HeaderText("评分").RendererFunction("renderRate1"),
            F.RenderField().ColumnID("Major").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150).HeaderText("所学专业"),
            F.RenderField().ColumnID("Status").DataField("Status").HeaderText("状态").RendererFunction("renderStatus")
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br />
    <div style="padding: 0 10px; line-height: 1.8;">
        注：缩放浏览器窗口（或在手机/平板上打开）：屏幕宽度小于 992px（中屏以下）时，表格自动切换为卡片模式；否则显示为普通表格。通过 ResponsiveCardSize 实现，由屏幕尺寸主导显示模式。
    </div>

}

@section script {

    <script src="~/res/js/grid.js"></script>
    <script src="~/res/js/responsive_card.js"></script>

}
