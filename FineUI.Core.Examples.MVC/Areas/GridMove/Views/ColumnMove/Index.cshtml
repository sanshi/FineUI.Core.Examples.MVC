@{
    ViewBag.Title = "GridMove/ColumnMove";
    var F = Html.F();
}

@using Newtonsoft.Json.Linq;

@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableColumnMove(true)
        .Columns(
            F.RowNumberField().ColumnID("RowNumber"),
            F.RenderField().HeaderText("姓名").ColumnID("Name").DataField("Name"),
            F.RenderField().HeaderText("性别").ColumnID("Gender").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").ColumnID("EntranceYear").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").ColumnID("AtSchool").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").ColumnID("Major").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").ColumnID("Group").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").ColumnID("LogTime").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        )
        .DataSource(DataSourceUtil.GetDataTable()).Listener("columnmove", "onGrid1ColumnMove")
    )
    <br>
    <br>

    @(F.Button().ID("btnRefresh").Text("刷新本页面（保持列顺序）").ClickHandler("onRefreshClick"))

    <br />
    <br />
    @(F.Button().CssClass("marginr").Text("清空数据").ID("btnClearData").OnClick(Url.Action("btnClearData_Click")))
    @(F.Button().Text("重新绑定数据").ID("btnRebind").Icon(Icon.Reload).OnClick(Url.Action("btnRebindData_Click"), "Grid1"))


    @{
        JArray savedColumns = ViewBag.Grid1ColumnIDS as JArray;
        if (savedColumns != null && savedColumns.Count > 0)
        {
            var grid1 = F.GetControl<Grid>("Grid1");

            // 将数据库保存的列顺序应用到表格列上
            int order = 0;
            foreach (string columnId in savedColumns)
            {
                GridColumn foundColumn = grid1.FindColumn(columnId);
                if (foundColumn != null)
                {
                    foundColumn.ColumnOrder = order;
                }
                order++;
            }
        }
    }

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onRefreshClick(event) {
            window.location.reload();
        }


        function onGrid1ColumnMove(event, targetColumnId, sourceColumnId, operation) {
            var grid = this;

            // 列顺序数组
            var columnIds = $.map(grid.columns, function (item, index) {
                return item.columnId;
            });

            // 触发后台事件
            F.doPostBack({
                url: '@Url.Action("Grid1_ColumnMove")',
                params: {
                    columnIds: F.toJSON(columnIds)
                }
            });
        }


    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>拖动列标题改变显示顺序，并在刷新后恢复已保存顺序。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>移动列后刷新核对</h3>
        <ol>
            <li>将<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>一个允许移动的列标题拖到另一列附近。<br />结果：列头和正文一起采用新顺序，行中的实际字段值仍对应原字段；事件读取最新列清单。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnRefresh"
                    title="刷新本页面（保持列顺序）">刷新本页面（保持列顺序）</strong>。<br />结果：后台按当前会话保存的配置创建列，顺序恢复。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableColumnMove</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，允许拖动列标题调整位置。
            </li>
            <li><code>columnmove</code>（<strong>页面移动脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：移动后读取列顺序与事件参数；需要恢复锁定时同时保存相应锁定状态。</li>
        </ul>
    </section>
}
