@{
    ViewBag.Title = "GridMove/RowMoveMulti";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("表格").EnableMultiSelect(true).DataIDField("Id").DataTextField("Name")
        .Columns(
            F.RowNumberField().ColumnID("RowNumber"),
            F.RenderField().HeaderText("姓名").ColumnID("Name").DataField("Name"),
            F.RenderField().HeaderText("性别").ColumnID("Gender").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").ColumnID("EntranceYear").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").ColumnID("AtSchool").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").ColumnID("Major").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").ColumnID("Group").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").ColumnID("LogTime").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd")
        ).DataSource(ViewBag.Grid1DataSource)

    )
    <br>
    <br>

    @(F.Button().ID("btnMoveUp").Text("选中行上移（可多选）").CssClass("marginr").ClickHandler("onMoveUpClick"))
    @(F.Button().ID("btnMoveDown").Text("选中行下移（可多选）").CssClass("marginr").ClickHandler("onMoveDownClick"))
    <br>
    <br>

    @(F.Button().ID("btnSaveToDB").Text("保存数据").ClickHandler("onSaveToDBClick"))
    @(F.Button().ID("btnRefresh").Text("刷新本页面（请先点击保存按钮）").ClickHandler("onRefreshClick"))


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onRefreshClick(event) {
            window.location.reload();
        }


        function onMoveUpClick(event) {
            var grid = F.ui.Grid1;

            // 向上移动
            grid.moveRowsUp(grid.getSelectedRows());
        }

        function onMoveDownClick(event) {
            var grid = F.ui.Grid1;

            // 向下移动
            grid.moveRowsDown(grid.getSelectedRows());
        }

        function onSaveToDBClick(event) {
            var grid = F.ui.Grid1;

            // 列顺序数组
            var rowIds = $.map(grid.data, function (item, index) {
                return item.id;
            });

            // 触发后台事件
            F.doPostBack({
                url: '@Url.Action("Grid1_RowMove")',
                params: {
                    rowIds: F.toJSON(rowIds)
                }
            });
        }

    </script>
}
