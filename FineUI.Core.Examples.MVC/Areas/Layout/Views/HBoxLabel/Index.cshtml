@{
    ViewBag.Title = "Layout/HBoxLabel";


    var F = Html.F();
}

@section head {

    <style>
        .zuckerberg {
            padding: 10px;
        }

        .mylabel {
            border-width: 1px;
            border-style: solid;
        }

            .mylabel .f-field-label {
                margin: 0;
            }
    </style>

}


@section body {

    <div id="zuckerberg" class="zuckerberg">
        <p>
            <a href="http://baike.baidu.com/view/1299586.htm" target="_blank"><b>马克·扎克伯格</b></a>
        </p>
        <p>
            马克·艾略特·扎克伯格（Mark Elliot Zuckerberg），美国社交网站Facebook的创办人，被人们冠以“第二盖茨”的美誉。哈佛大学计算机和心理学专业辍学生。据《福布斯》杂志保守估计，马克·扎克伯格拥有135亿美元身家，是2008年全球最年轻的巨富，也是历来全球最年轻的自行创业亿万富豪。
        </p>
        <p>
            2014年2月10日，马克·扎克伯格及其华裔妻子普莉希拉·陈登上美国《慈善纪事报》2013年年度慈善排行榜榜首。
        </p>
    </div>

    @(F.Panel().ID("Panel2").IsFluid(true).Height(200).ShowBorder(true).EnableCollapse(true).Layout(LayoutType.HBox).BodyPadding(10).BoxConfigSpace(5).ShowHeader(true).Title("面板（Panel）")
        .Items(
            F.Panel().ID("Panel1").ShowBorder(true).ShowHeader(false).AutoScroll(true).BoxFlex(1).ContentEl("#zuckerberg"),
            F.Panel().ID("Panel4").BoxFlex(2).BodyPadding(10).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().ID("Label3").Text("BoxFlex=2 末项无额外间隔")
                )
        )
    )
    <br>

    @(F.Panel().ID("Panel5").IsFluid(true).Height(200).ShowBorder(true).EnableCollapse(true).Layout(LayoutType.HBox).BodyPadding(10).BoxConfigSpace(5).ShowHeader(true).Title("面板（Label）")
        .Items(
            F.Label().ID("Label1").CssClass("mylabel f-widget-content").EncodeText(false).AutoScroll(true).BoxFlex(1).Text(@ViewBag.Label1Text),
            F.Panel().ID("Panel8").BoxFlex(2).BodyPadding(10).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().ID("Label6").Text("BoxFlex=2 末项无额外间隔")
                )
        )
    )


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示在水平盒布局中混排标签和其它字段。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照布局与尺寸变化</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel2" title="面板（Panel）">面板（Panel）</strong>中对照同排标签、字段及它们的对齐位置。<br />结果：各项按自己的宽度和本页对齐规则水平排列。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel2" title="面板（Panel）">面板（Panel）</strong>、<strong class="example-control-reference" data-example-control="Panel5" title="面板（Label）">面板（Label）</strong>）：初始为<code>LayoutType.HBox</code>，父容器使用本页对应的布局方式，决定其直接子项的排列。</li>
        <li><code>BoxFlex</code>（<strong class="example-control-reference" data-example-control="Panel1" title="第 2 个面板">第 2 个面板</strong>、<strong class="example-control-reference" data-example-control="Panel4" title="第 3 个面板">第 3 个面板</strong>、<strong class="example-control-reference" data-example-control="Label1" title="第 2 个标签">第 2 个标签</strong>、<strong class="example-control-reference" data-example-control="Panel8" title="第 5 个面板">第 5 个面板</strong>）：各组分别设为<code>1</code>、<code>2</code>，直接子项按此比例分配父容器剩余空间。</li>
    </ul>
</section>
}
