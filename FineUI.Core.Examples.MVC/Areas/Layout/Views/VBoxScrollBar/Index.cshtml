@{
    ViewBag.Title = "Layout/VBoxScrollBar";


    var F = Html.F();
}


@section body {

    @(F.Panel().ID("Panel5").Margin(24).ShowBorder(true).Layout(LayoutType.VBox).AutoScroll(true).ShowHeader(true).Title("面板（Layout=VBox AutoScroll=true），高度变小时可能出现纵向滚动条").BoxConfigSpace(5).BodyPadding(10).IsViewPort(true)
        .Items(
            F.Panel().ID("Panel1").Title("面板1").Height(300).BodyPadding(10).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().ID("Label1").Text("Height=300")
                ),
            F.Panel().ID("Panel2").Title("面板2").BoxFlex(1).MinHeight(300).BodyPadding(10).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().ID("Label3").Text("BoxFlex=1 末项无额外间隔 MinHeight=300")
                )
        )
    )


}

