@{
    ViewBag.Title = "Layout/Region";


    var F = Html.F();
}


@section body {

    @(F.Panel().ID("Panel1").Margin(24).ShowBorder(false).ShowHeader(false).Layout(LayoutType.Region).IsViewPort(true)
        .Items(
            F.Panel().ID("panelTopRegion").RegionPosition(Position.Top).RegionSplit(true).EnableCollapse(true).Collapsed(true).Height(100).Title("顶部面板").ShowBorder(true).ShowHeader(true).BodyPadding(10).IconFont(IconFont._PullUp)
                .Items(
                    F.Label().ID("Label1").Text("顶部面板的内容")
                ),
            F.Panel().ID("panelLeftRegion").RegionPosition(Position.Left).RegionSplit(true).EnableCollapse(true).Collapsed(true).Width(250).Title("左侧面板（有提示信息）").TitleToolTip("左侧面板（有提示信息）").ShowBorder(true).ShowHeader(true).BodyPadding(10).IconFont(IconFont._PullLeft)
                .Items(
                    F.Label().ID("Label2").Text("左侧面板的内容")
                ),
            F.Panel().ID("panelCenterRegion").RegionPosition(Position.Center).Title("中间面板").ShowBorder(true).ShowHeader(true).BodyPadding(10).IconFont(IconFont._RoundPlus)
                .Items(
                    F.Label().ID("Label3").Text("中间面板的内容"),
                    F.Label().ID("Label6"),
                    F.Button().ID("Button4").Text("更新左侧面板的标题").OnClick(Url.Action("Button4_Click")),
                    F.Label().ID("Label7"),
                    F.Button().ID("btnHideBottomRegion").Text("隐藏/显示底部面板").OnClick(Url.Action("btnHideBottomRegion_Click"), Parameter.FromFunction("hidden", "getpanelBottomRegionHiddenPostbackValue"))
                ),
            F.Panel().ID("panelRightRegion").RegionPosition(Position.Right).RegionSplit(true).EnableCollapse(true).Width(200).Title("右侧面板").ShowBorder(true).ShowHeader(true).BodyPadding(10).IconFont(IconFont._PullRight)
                .Items(
                    F.Label().ID("Label4").Text("右侧面板的内容")
                ),
            F.Panel().ID("panelBottomRegion").RegionPosition(Position.Bottom).RegionSplit(true).EnableCollapse(true).Height(100).Title("底部面板").ShowBorder(true).ShowHeader(true).BodyPadding(10).IconFont(IconFont._PullDown)
                .Items(
                    F.Label().ID("Label5").Text("底部面板的内容")
                )
        )
    )


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getpanelBottomRegionHiddenPostbackValue() {
            return F.ui.panelBottomRegion.hidden;
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示上、下、左、右与中心区域的空间分配，以及侧边区域拖动和折叠。</p>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>调整区域空间</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel1" title="第 1 个面板">第 1 个面板</strong>拖动可用的分隔条，再点击侧边区域的折叠入口。<br />结果：被操作区域改变尺寸或折叠，中心区域随剩余空间重新布局；其它区域内容保留。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel1" title="第 1 个面板">第 1 个面板</strong>）：外层使用 <code>Region</code> 布局组织各方向的子区域。 本页使用<code>LayoutType.Region</code>。</li>
        <li><code>RegionPosition</code>（本页各面板，如<strong class="example-control-reference" data-example-control="panelTopRegion" title="顶部面板">顶部面板</strong>）：指定每个子区域所在的方向，中心区域使用剩余空间。 本页各组分别使用<code>Position.Top</code>、<code>Position.Left</code>、<code>Position.Center</code>、<code>Position.Right</code>、<code>Position.Bottom</code>。</li>
        <li><code>RegionSplit</code>（<strong class="example-control-reference" data-example-control="panelTopRegion" title="顶部面板">顶部面板</strong>、<strong class="example-control-reference" data-example-control="panelLeftRegion" title="左侧面板（有提示信息）">左侧面板（有提示信息）</strong>、<strong class="example-control-reference" data-example-control="panelRightRegion" title="右侧面板">右侧面板</strong>、<strong class="example-control-reference" data-example-control="panelBottomRegion" title="底部面板">底部面板</strong>）：允许对应区域显示可拖动的分隔条。 本页使用<code>true</code>。</li>
    </ul>
</section>
}
