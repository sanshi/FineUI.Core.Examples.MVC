@{
    ViewBag.Title = "Layout/HBoxAutoHeightStretch";


    var F = Html.F();
}


@section body {

    @(F.Panel().ID("PanelExample1").IsFluid(true).ShowBorder(true).Layout(LayoutType.HBox).BodyPadding(10).BoxConfigSpace(5).ShowHeader(true).Title("面板（Layout=HBox）（默认值：BoxConfigAlign=Stretch）")
        .Items(
            F.Panel().Title("面板1").Width(200).BodyPadding(10).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().Text("Width=200")
                ),
            F.Panel().Title("面板2").Width(200).BodyPadding(10).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().EncodeText(false).Text("Width=200px<br><br><br><br><br><br><br><br>bottom line")
                ),
            F.Panel().Title("面板3").BoxFlex(1).BodyPadding(10).Margin(0).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().Text("BoxFlex=1")
                )
        )
    )
    <br>
    <br>
    @(F.Panel().IsFluid(true).ShowBorder(true).Layout(LayoutType.HBox).BodyPadding(10).BoxConfigSpace(5).ShowHeader(true).Title("面板（Layout=HBox）（默认值：BoxConfigAlign=Stretch）")
        .Items(
            F.Panel().Title("面板1").Width(200).BodyPadding(10).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().Text("Width=200")
                ),
            F.Panel().ID("PanelExample7").Title("面板2").Width(200).Height(250).BodyPadding(10).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().EncodeText(false).Text("Width=200 Height=250")
                ),
            F.Panel().Title("面板3").BoxFlex(1).BodyPadding(10).Margin(0).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().Text("BoxFlex=1")
                )
        )
    )
    <br>
    <br>
    @(F.Panel().ID("PanelExample9").IsFluid(true).ShowBorder(true).Layout(LayoutType.HBox).BoxConfigAlign(BoxLayoutAlign.Start).BodyPadding(10).BoxConfigSpace(5).ShowHeader(true).Title("面板（Layout=HBox BoxConfigAlign=Start）")
        .Items(
            F.Panel().Title("面板1").Width(200).BodyPadding(10).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().Text("Width=200")
                ),
            F.Panel().Title("面板2").Width(200).BodyPadding(10).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().EncodeText(false).Text("Width=200px<br><br><br><br><br><br><br><br>bottom line")
                ),
            F.Panel().Title("面板3").BoxFlex(1).BodyPadding(10).Margin(0).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().Text("BoxFlex=1")
                )
        )
    )
    <br>
    <br>
    @(F.Panel().ID("PanelExample13").IsFluid(true).ShowBorder(true).Layout(LayoutType.HBox).BoxConfigAlign(BoxLayoutAlign.Start).BodyPadding(10).BoxConfigSpace(5).ShowHeader(true).Title("面板（Layout=HBox BoxConfigAlign=Start）")
        .Items(
            F.Panel().Title("面板1").Width(200).BodyPadding(10).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().Text("Width=200")
                ),
            F.Panel().ID("PanelExample15").Title("面板2").Width(200).Height(250).BodyPadding(10).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().EncodeText(false).Text("Width=200 Height=250")
                ),
            F.Panel().Title("面板3").BoxFlex(1).BodyPadding(10).Margin(0).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().Text("BoxFlex=1")
                )
        )
    )
    <br>
    <br>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示对比自动高度下子项纵向拉伸的效果。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照布局与尺寸变化</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="PanelExample1" title="第 1 个面板（面板（Layout=HBox）（默认值：BoxConfigAlign=Stretch））">第 1
                    个面板（面板（Layout=HBox）（默认值：BoxConfigAlign=Stretch））</strong>中对照同排子项的底边与不同内容长度。<br />结果：开启拉伸的一组按同排内容确定共同高度，其它组保留各自自然高度。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>BoxConfigAlign</code>（<strong class="example-control-reference" data-example-control="PanelExample9"
                    title="第 9 个面板（面板（Layout=HBox BoxConfigAlign=Start））">第 9 个面板（面板（Layout=HBox BoxConfigAlign=Start））</strong>、<strong
                    class="example-control-reference" data-example-control="PanelExample13" title="第 13 个面板（面板（Layout=HBox BoxConfigAlign=Start））">第 13
                    个面板（面板（Layout=HBox BoxConfigAlign=Start））</strong>）：初始为<code>BoxLayoutAlign.Start</code>，指定盒布局中交叉方向的对齐或伸展方式。</li>
            <li><code>Height</code>（<strong class="example-control-reference" data-example-control="PanelExample7"
                    title="第 5 个面板（面板（Layout=HBox）（默认值：BoxConfigAlign=Stretch））的面板2">第 5 个面板（面板（Layout=HBox）（默认值：BoxConfigAlign=Stretch））的面板2</strong>、<strong
                    class="example-control-reference" data-example-control="PanelExample15" title="第 13 个面板（面板（Layout=HBox BoxConfigAlign=Start））的面板2">第 13
                    个面板（面板（Layout=HBox BoxConfigAlign=Start））的面板2</strong>）：初始为<code>250</code>，显式高度限定可用区域；未设置固定高度的对照组按内容和父布局计算。</li>
        </ul>
    </section>
}
