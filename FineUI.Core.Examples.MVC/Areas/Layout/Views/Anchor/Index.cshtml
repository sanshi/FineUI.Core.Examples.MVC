@{
    ViewBag.Title = "Layout/Anchor";


    var F = Html.F();
}


@section body {

    @(F.Panel().IsFluid(true).ID("Panel3").Title("面板一（Height=300px）").Height(300).BodyPadding(10).ShowBorder(true).ShowHeader(true)
        .Items(
            F.Panel().ID("Panel1").ShowBorder(true).Margin("0 0 5 0").BodyPadding(10).ShowHeader(false).Title("面板")
                .Items(
                    F.Label().ID("Label5").Text("Margin=0 0 5 0")
                ),
            F.Form().ID("Form3").ShowBorder(true).BodyPadding(10).ShowHeader(false).Title("表单")
                .Rows(
                    F.FormRow()
                        .Items(
                            F.Label().ID("Label2").Label("文本").Text("文本内容")
                        ),
                    F.FormRow()
                        .Items(
                            F.TextBox().ID("TextBox2").Label("输入框"),
                            F.Button().ID("Button2").Text("按钮")
                        )
                )
        )
    )
    <br>

    @(F.Panel().IsFluid(true).ID("Panel2").Height(300).ShowBorder(true).BodyPadding(10).Layout(LayoutType.Anchor).ShowHeader(true).Title("面板二（Height=300px Layout=Anchor）")
        .Items(
            F.Panel().ID("Panel4").AnchorValue("60% 30%").Margin("0 0 5 0").BodyPadding(10).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().ID("Label3").Text("AnchorValue=60% 30% Margin=0 0 5 0")
                ),
            F.Form().ID("Form2").AnchorValue("100% 70%").BodyPadding(10).ShowBorder(true).ShowHeader(false)
                .Rows(
                    F.FormRow()
                        .Items(
                            F.Label().ID("Label1").Text("AnchorValue=100% 70%")
                        ),
                    F.FormRow()
                        .Items(
                            F.TextBox().ID("TextBox1").Label("输入框"),
                            F.Button().ID("Button7").Text("按钮")
                        )
                )
        )
    )
    <br>

    @(F.Panel().IsFluid(true).ID("Panel5").Title("面板三").BodyPadding(10).ShowBorder(true).ShowHeader(true)
        .Items(
            F.Form().ID("Form4").ShowBorder(false).BodyPadding(10).ShowHeader(false)
                .Rows(
                    F.FormRow()
                        .Items(
                            F.TextBox().ID("TextBox3").Label("用户名"),
                            F.Button().ID("Button6").Text("搜索")
                        )
                ),
            F.Panel().ID("Panel6").ShowBorder(true).ShowHeader(false)
                .Toolbars(
                    F.Toolbar().ID("Toolbar1")
                        .Items(
                            F.Button().ID("Button4").Text("按钮一"),
                            F.Button().ID("Button5").Text("按钮二")
                        )
                )
                .Items(
                    F.Grid().Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid3").DataIDField("Id").DataTextField("Name").EnableCheckBoxSelect(true)
                        .Columns(
                            F.RowNumberField(),
                            F.RenderField().HeaderText("姓名").DataField("Name"),
                            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
                            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
                            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
                            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup")
                        )
                        .DataSource(DataSourceUtil.GetDataTable())
                )
        )
    )
    <br>

    @(F.Panel().IsFluid(true).ID("Panel7").BodyPadding(10).ShowBorder(true).ShowHeader(true).Height(500).Title("面板四（Height=500px Layout=Anchor）").Layout(LayoutType.Anchor)
        .Items(
            F.Form().ID("Form5").ShowBorder(false).BodyPadding(10).AnchorValue("100%").ShowHeader(false)
                .Rows(
                    F.FormRow()
                        .Items(
                            F.TextBox().ID("TextBox5").Label("用户名"),
                            F.TextBox().ID("TextBox8").Label("所在班级")
                        ),
                    F.FormRow()
                        .Items(
                            F.TextBox().ID("TextBox6").Label("所在年级"),
                            F.Button().ID("Button11").Text("搜索")
                        )
                ),
            F.Panel().ID("Panel8").ShowBorder(true).ShowHeader(false).AnchorValue("100% -100").Layout(LayoutType.Fit)
                .Toolbars(
                    F.Toolbar().ID("Toolbar2")
                        .Items(
                            F.Button().ID("Button8").Text("按钮一"),
                            F.Button().ID("Button9").Text("按钮二")
                        )
                )
                .Items(
                    F.Grid().Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid2").DataIDField("Id").DataTextField("Name").EnableCheckBoxSelect(true)
                    .Columns(
                        F.RowNumberField(),
                        F.RenderField().HeaderText("姓名").DataField("Name"),
                        F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                        F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
                        F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
                        F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
                        F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup")
                    )
                    .DataSource(DataSourceUtil.GetDataTable())
                )
        )
    )
    <br>
    <br>
    <br>
    <strong>【推荐】</strong>使用VBox布局实现与上例相同的界面：
    <br>
    <hr>
    <br>
    @(F.Panel().IsFluid(true).ID("Panel9").Layout(LayoutType.VBox).BodyPadding(10).BoxConfigSpace(0).ShowBorder(true).ShowHeader(true).Height(500).Title("面板五（Height=500px Layout=VBox BoxConfigSpace=0）")
        .Items(
            F.Form().ID("Form6").ShowBorder(false).BodyPadding(10).ShowHeader(false)
                .Rows(
                    F.FormRow()
                        .Items(
                            F.TextBox().ID("TextBox4").Label("用户名"),
                            F.TextBox().ID("TextBox7").Label("所在班级")
                        ),
                    F.FormRow()
                        .Items(
                            F.TextBox().ID("TextBox9").Label("所在年级"),
                            F.Button().ID("Button10").Text("搜索")
                        )
                ),
            F.Panel().ID("Panel10").ShowBorder(true).ShowHeader(false).BoxFlex(1).Layout(LayoutType.Fit)
                .Toolbars(
                    F.Toolbar().ID("Toolbar3")
                        .Items(
                            F.Button().ID("Button12").Text("按钮一"),
                            F.Button().ID("Button13").Text("按钮二")
                        )
                )
                .Items(
                    F.Grid().Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableCheckBoxSelect(true)
                        .Columns(
                            F.RowNumberField(),
                            F.RenderField().HeaderText("姓名").DataField("Name"),
                            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
                            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
                            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
                            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup")
                        )
                        .DataSource(DataSourceUtil.GetDataTable())
                )
        )
    )



}

@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示用锚点比例让字段随父容器宽高变化。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照布局与尺寸变化</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel3" title="面板一（Height=300px）">面板一（Height=300px）</strong>中缩小和放大浏览器，比较字段与容器边缘的距离。<br />结果：设置锚点的字段按对应比例伸缩，固定尺寸项目保持自身尺寸。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（本页各面板，如<strong class="example-control-reference" data-example-control="Panel2" title="面板二（Height=300px Layout=Anchor）">面板二（Height=300px Layout=Anchor）</strong>）：各组分别设为<code>LayoutType.Anchor</code>、<code>LayoutType.Fit</code>、<code>LayoutType.VBox</code>，父容器使用本页对应的布局方式，决定其直接子项的排列。</li>
        <li><code>AnchorValue</code>（<strong class="example-control-reference" data-example-control="Panel4" title="第 4 个面板">第 4 个面板</strong>、<strong class="example-control-reference" data-example-control="Form2" title="第 2 个表单">第 2 个表单</strong>、<strong class="example-control-reference" data-example-control="Form5" title="第 4 个表单">第 4 个表单</strong>、<strong class="example-control-reference" data-example-control="Panel8" title="第 8 个面板">第 8 个面板</strong>）：各组分别设为<code>60% 30%</code>、<code>100% 70%</code>、<code>100%</code>、<code>100% -100</code>，子项按本页锚点比例随父容器尺寸变化。</li>
    </ul>
</section>
}
