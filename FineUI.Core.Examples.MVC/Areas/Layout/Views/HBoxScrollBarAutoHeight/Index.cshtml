@{
    ViewBag.Title = "Layout/HBoxScrollBarAutoHeight";


    var F = Html.F();
}


@section body {

    @(F.Panel().ID("Panel5").IsFluid(true).ShowBorder(true).Layout(LayoutType.HBox).AutoScroll(true).ShowHeader(true).Title("面板（Layout=HBox AutoScroll=true），宽度变小时可能出现横向滚动条").BoxConfigChildMargin("0 5 0 0").BodyPadding(10)
        .Items(
            F.Panel().ID("Panel1").Title("面板1").Width(600).BodyPadding(10).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().ID("Label1").Text("Width=600")
                ),
            F.Panel().ID("Panel2").Title("面板2").BoxFlex(1).MinWidth(600).Margin(0).BodyPadding(10).ShowBorder(true).ShowHeader(false)
                .Items(
                    F.Label().ID("Label3").Text("BoxFlex=1 Margin=0 MinWidth=600")
                )
        )
    )

    <br />
    <br />
    注：反复缩小页面宽度，使得面板出现横向滚动条，此时面板的高度应保持不变。

}

