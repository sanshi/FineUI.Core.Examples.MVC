@{
    ViewBag.Title = "Layout/Fit";


    var F = Html.F();
}


@section body {

    @(F.Panel().IsFluid(true).ID("Panel3").Title("面板一（未设置Layout属性）").Height(300).BodyPadding(10).ShowBorder(true).ShowHeader(true)
        .Items(
            F.Form().ID("Form3").ShowBorder(true).BodyPadding(10).ShowHeader(false).Title("表单")
                .Rows(
                    F.FormRow()
                        .Items(
                            F.Label().ID("Label2").Label("文本").Text("文本内容")
                        ),
                    F.FormRow()
                        .Items(
                            F.TextBox().ID("TextBox2").Label("输入框"),
                            F.Button().ID("Button2").Text("按钮")
                        )
                )
        )
    )
    <br>

    @(F.Panel().IsFluid(true).ID("Panel1").Title("面板二（Layout=Fit）").Layout(LayoutType.Fit).Height(300).BodyPadding(10).ShowBorder(true).ShowHeader(true)
        .Items(
            F.Form().ID("Form2").ShowBorder(true).BodyPadding(10).ShowHeader(false).Title("表单")
                .Rows(
                    F.FormRow()
                        .Items(
                            F.Label().ID("Label1").Label("文本").Text("文本内容")
                        ),
                    F.FormRow()
                        .Items(
                            F.TextBox().ID("TextBox1").Label("输入框"),
                            F.Button().ID("Button1").Text("按钮")
                        )
                )
        )
    )
    <br>

    @(F.Panel().IsFluid(true).ID("Panel2").Title("面板三（Layout=Fit）").Layout(LayoutType.Fit).Height(300).BodyPadding(10).ShowBorder(true).ShowHeader(true)
        .Toolbars(
            F.Toolbar().ID("Toolbar1")
                .Items(
                    F.Button().ID("Button4").Text("按钮一"),
                    F.Button().ID("Button5").Text("按钮二")
                )
        )
        .Items(
            F.Grid().Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableCheckBoxSelect(true)
                .Columns(
                    F.RowNumberField(),
                    F.RenderField().HeaderText("姓名").DataField("Name"),
                    F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                    F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
                    F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
                    F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
                    F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup")
                )
                .DataSource(DataSourceUtil.GetDataTable())
        )
    )


}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示让单个子面板填满父容器内容区。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照布局与尺寸变化</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel3" title="面板一（未设置Layout属性）">面板一（未设置Layout属性）</strong>中调整浏览器窗口大小。<br />结果：子面板随父容器内容区一起伸缩，不需要另设固定宽高。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板二（Layout=Fit）">面板二（Layout=Fit）</strong>、<strong class="example-control-reference" data-example-control="Panel2" title="面板三（Layout=Fit）">面板三（Layout=Fit）</strong>）：初始为<code>LayoutType.Fit</code>，父容器使用本页对应的布局方式，决定其直接子项的排列。</li>
    </ul>
</section>
}
