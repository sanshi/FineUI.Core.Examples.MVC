@{
    ViewBag.Title = "Layout/ColumnScrollBar";


    var F = Html.F();
}


@section body {

    @(F.Panel().ID("Panel1").AutoScroll(true).ShowBorder(true).BodyPadding(10).Layout(LayoutType.Column).ShowHeader(true).Title("面板（高度变小时可能出现纵向滚动条）").IsViewPort(true)
        .Items(
            F.Panel().ID("Panel24").ColumnWidth("33%").ShowBorder(false).ShowHeader(false).Margin("0 5 0 0")
                .Items(
                    F.Panel().ID("Panel25").BodyPadding(10).ShowBorder(true).ShowHeader(true).MarginBottom(5).Content("我的面板<br><br><br><br><br><br><br><br>"),
                    F.Panel().ID("Panel26").BodyPadding(10).ShowBorder(true).ShowHeader(true).MarginBottom(5).Content("我的面板<br><br><br><br><br><br><br><br><br>"),
                    F.Panel().ID("Panel27").BodyPadding(10).ShowBorder(true).ShowHeader(true).Content("我的面板<br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br>")
                ),
            F.Panel().ID("Panel28").ColumnWidth("33%").ShowBorder(false).ShowHeader(false).Margin("0 5 0 0")
                .Items(
                    F.Panel().ID("Panel29").BodyPadding(10).ShowBorder(true).ShowHeader(true).MarginBottom(5).Content("我的面板<br><br><br><br>"),
                    F.Panel().ID("Panel30").BodyPadding(10).ShowBorder(true).ShowHeader(true).MarginBottom(5).Content("我的面板<br><br><br><br><br><br><br>"),
                    F.Panel().ID("Panel31").BodyPadding(10).ShowBorder(true).ShowHeader(true).Content("我的面板<br><br><br><br><br><br>")
                ),
            F.Panel().ID("Panel32").ColumnWidth("34%").ShowBorder(false).ShowHeader(false)
                .Items(
                    F.Panel().ID("Panel33").BodyPadding(10).ShowBorder(true).ShowHeader(true).MarginBottom(5).Content("我的面板<br><br><br><br><br><br>"),
                    F.Panel().ID("Panel34").BodyPadding(10).ShowBorder(true).ShowHeader(true).MarginBottom(5).Content("我的面板<br><br><br>"),
                    F.Panel().ID("Panel35").BodyPadding(10).ShowBorder(true).ShowHeader(true).Content("我的面板<br><br><br><br><br><br><br><br><br><br><br>")
                )
        )
    )



}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在列布局中为较多内容提供纵向滚动。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照布局与尺寸变化</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板（高度变小时可能出现纵向滚动条）">面板（高度变小时可能出现纵向滚动条）</strong>中缩小可用高度，再向下滚动列布局内容。<br />结果：列宽规则保持不变，超出高度的内容可滚动查看。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板（高度变小时可能出现纵向滚动条）">面板（高度变小时可能出现纵向滚动条）</strong>）：初始为<code>LayoutType.Column</code>，父容器使用本页对应的布局方式，决定其直接子项的排列。</li>
            <li><code>ColumnWidth</code>（<strong class="example-control-reference" data-example-control="Panel24" title="第 2 个面板">第 2 个面板</strong>、<strong
                    class="example-control-reference" data-example-control="Panel28" title="第 6 个面板">第 6 个面板</strong>、<strong class="example-control-reference"
                    data-example-control="Panel32" title="第 10 个面板">第 10 个面板</strong>）：各组分别设为<code>33%</code>、<code>34%</code>，规定当前子项占用的列宽。</li>
            <li><code>AutoScroll</code>（<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板（高度变小时可能出现纵向滚动条）">面板（高度变小时可能出现纵向滚动条）</strong>）：初始为<code>true</code>，内容超出该容器时允许滚动查看。</li>
        </ul>
    </section>
}
