@{
    ViewBag.Title = "MobilePanel/PanelIFrame";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    @(F.Panel().ID("Panel1").ShowHeader(false).ShowBorder(false).EnableIFrame(true).IFrameUrl(Url.Content("~/MobileButton/Button")).IsViewPort(true)
        .Toolbars(
            F.Toolbar().ID("Toolbar2").Title("面板（IFrame）").HeaderStyle(true),
            F.Toolbar().ID("Toolbar1").Position(ToolbarPosition.Bottom).CssClass("f-state-default")
                .Items(
                    F.ToolbarFill(),
                    F.Button().Text("转到其他页面").Size(ButtonSize.Small).EnableDefaultState(false).ShowMenuIcon(false)
                        .Menu(F.Menu()
                            .Items(
                                F.MenuButton().Text("首页")
                                    .AttributeDataTag(Url.Content("~/MobileButton/Button")).ClickHandler("onMyMenuButtonClick"),
                                F.MenuButton().Text("按钮分组")
                                    .AttributeDataTag(Url.Content("~/MobileButton/ButtonGroup")).ClickHandler("onMyMenuButtonClick"),
                                F.MenuButton().Text("按钮分组（垂直）")
                                    .AttributeDataTag(Url.Content("~/MobileButton/ButtonGroupVertical")).ClickHandler("onMyMenuButtonClick"),
                                F.MenuButton().Text("按钮分组（与选项卡交互）")
                                    .AttributeDataTag(Url.Content("~/MobileButton/ButtonGroupTabStrip")).ClickHandler("onMyMenuButtonClick")
                            )
                        )
                )
        )
    )


}


@section script {

    <script>

        function onMyMenuButtonClick(event) {
            var iframeUrl = this.getAttr('data-tag');
            F.ui.Panel1.setIFrameUrl(iframeUrl);
        }

    </script>

}