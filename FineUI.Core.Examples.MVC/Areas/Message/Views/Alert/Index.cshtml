@{
    ViewBag.Title = "Message/Alert";
    var F = Html.F();
}


@section body {

    @(F.Form().IsFluid(true).ID("SimpleForm1").Title("创建对话框").LabelWidth(150).BodyPadding(10)
        .Items(
            F.GroupPanel().ID("GroupPanel2").Layout(LayoutType.Anchor).Title("常用属性")
                .Items(
                    F.TextBox().ID("tbxMessage").Required(true).ShowRedStar(true).Label("消息提示").Text("你好 FineUI！"),
                    F.TextBox().ID("tbxTitle").Label("对话框标题").Text(""),
                    F.CheckBox().ID("cbxEnableClose").Checked(true).Label("是否可关闭"),
                    F.RadioButtonList().ID("rblMessageBoxIcon").Label("消息图标").ColumnNumber(3)
                        .Items(
                            F.RadioItem().Value("None").Text("无图标").Selected(true),
                            F.RadioItem().Value("Information").Text("消息"),
                            F.RadioItem().Value("Warning").Text("警告"),
                            F.RadioItem().Value("Question").Text("问题"),
                            F.RadioItem().Value("Error").Text("错误"),
                            F.RadioItem().Value("Success").Text("成功")
                        )
                ),
            F.GroupPanel().ID("GroupPanel1").Layout(LayoutType.Anchor).Title("其它属性")
                .Items(
                    F.TextBox().ID("tbxID").Label("对话框ID"),
                    F.NumberBox().ID("nbWidth").NoDecimal(true).NoNegative(true).Label("对话框宽度").MinValue(200).MaxValue(900),
                    F.NumberBox().ID("nbMinWidth").NoDecimal(true).NoNegative(true).Label("对话框最小宽度"),
                    F.NumberBox().ID("nbMaxWidth").NoDecimal(true).NoNegative(true).Label("对话框最大宽度"),
                    F.RadioButtonList().ID("rblTarget").Label("弹出位置").ColumnNumber(3)
                        .Items(
                            F.RadioItem().Value("Self").Text("当前页面").Selected(true),
                            F.RadioItem().Value("Parent").Text("父页面"),
                            F.RadioItem().Value("Top").Text("顶层页面")
                        )
                )
        )
        .Toolbars(
            F.Toolbar().ID("Toolbar1").Position(ToolbarPosition.Bottom).ToolbarAlign(ToolbarAlign.Right)
                .Items(
                    F.Button().Text("点击弹出对话框").ID("btnHello").ValidateForms("SimpleForm1").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
                )
        )
    )


}


@section exampleDescription {
<section aria-label="页面描述">
    <p>通过配置表单创建提示对话框，对照消息、标题、图标、大小和显示层级。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-window" aria-hidden="true"></i>按表单配置创建提示框</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="tbxMessage" title="消息提示">消息提示</strong>输入 <code>本次测试内容</code>，在<strong class="example-control-reference" data-example-control="tbxTitle" title="对话框标题">对话框标题</strong>输入 <code>自定义标题</code>，点击<strong class="example-control-reference" data-example-control="btnHello" title="点击弹出对话框">点击弹出对话框</strong>。<br />结果：按钮回发，后台读取当前字段，新对话框显示填写的消息和标题。</li>
        <li>更改本页的图标、宽度或弹出位置，再次点击<strong class="example-control-reference" data-example-control="btnHello" title="点击弹出对话框">点击弹出对话框</strong>。<br />结果：新创建的对话框采用修改后的配置，已有对话框不作为输入字段被同步修改。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Message / Title</code>（<strong class="example-control-reference" data-example-control="tbxMessage" title="消息提示">消息提示</strong>）：从消息与标题字段取值，作为新创建对话框的正文和标题。</li>
    </ul>
</section>
}
