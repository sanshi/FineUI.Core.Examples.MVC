@{
    ViewBag.Title = "CSP/Button";
    var F = Html.F();
}

@section body {


    @(F.Button().Text("缺省按钮").CssClass("marginr"))
    @(F.Button().ID("btnPrimary").Text("主按钮").ButtonColor(ButtonColor.Primary))

    <br />
    <br />

    @(F.Button().ID("btnChangeEnable").Text("启用后面的按钮").CssClass("marginr").OnClick(Url.Action("btnChangeEnable_Click")))
    @(F.Button().ID("btnEnable").Text("禁用的按钮").Enabled(false).OnClick(Url.Action("btnEnable_Click")))

    <br />
    <br />

    @(F.Button().ID("btnChangePressed").Text("改变后面按钮的按下状态").CssClass("marginr").OnClick(Url.Action("btnChangePressed_Click"), Parameter.FromFunction("pressed", "getbtnPressedPressedPostbackValue")))
    @(F.Button().ID("btnPressed").Text("按下的按钮").EnablePress(true).Pressed(true))

    <br />
    <br />

    @(F.Button().ID("btnTooltip").Text("这个按钮有提示信息（点击改变提示信息）").ToolTip("这是按钮的提示信息").OnClick(Url.Action("btnTooltip_Click")))


    <br />
    <br />

    @(F.Button().Text("小按钮").Size(ButtonSize.Small).CssClass("marginr"))
    @(F.Button().Text("普通按钮").CssClass("marginr"))
    @(F.Button().Text("中等大小按钮").Size(ButtonSize.Medium).CssClass("marginr"))
    @(F.Button().Text("大按钮").Size(ButtonSize.Large).CssClass("marginr"))

    <br />
    <br />
    注：
    <ul>
        <li>示例站已全局开启严格 CSP 和 nonce，本页不需要重复设置。框架会为页面模板中的普通内联 <code>&lt;script&gt;</code> 自动添加本次请求的 nonce。</li>
        <li>说明：<a target="_blank" href="https://fineui.com/docs/#/FineUICore_RazorForms/1700_CSP_nonce">CSP 与 nonce 的配置和用法</a></li>
    </ul>


}



@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getbtnPressedPressedPostbackValue() {
            return F.ui.btnPressed.isPressed();
        }

    </script>


    <script type="text/javascript">

        console.log('Hello world!');

    </script>

}
