@{
    ViewBag.Title = "Grid/SummaryClient";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-row-summary .f-grid-cell-Major .f-grid-cell-text {
            text-align: right;
        }

        .f-grid-row-summary .f-grid-cell-text {
            font-weight: bold;
        }
    </style>

}

@section body {

    @(F.Grid().IsFluid(true).EnableCheckBoxSelect(true).Height(450).ShowHeader(true).ShowBorder(true).Title("表格").ID("Grid1").DataIDField("Id").DataTextField("Name").AllowPaging(true).PageSize(15).IsDatabasePaging(true).OnPageIndexChanged(Url.Action("Grid1_PageIndexChanged"), "Grid1").EnableSummary(true).SummaryPosition(SummaryPosition.Bottom)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").ColumnID("Major").RendererFunction("renderMajor").MinWidth(150).ExpandUnusedSpace(true).SummaryText("合计："),
            F.RenderField().HeaderText("学费").DataField("Fee").SummaryType(SummaryType.Sum),
            F.RenderField().HeaderText("学杂费").DataField("ExtraFee").SummaryType(SummaryType.Sum)
        ).RecordCount(ViewBag.Grid1RecordCount).DataSource(ViewBag.Grid1DataSource)

    )
    <br>

    @(F.Button().Text("选中了哪些行").CssClass("marginr").ClickHandler("onNotifySelectedRowsClick"))
    <br>
    <br>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>由浏览器按列统计配置计算当前加载页费用合计。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>当前数据改变后重新统计</h3>
        <ul>
            <li>查看<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>的<strong>学费</strong>与<strong>学杂费</strong>统计，再点击下一页。<br />结果：浏览器对当前加载记录计算各列总和，新页加载后重新计算，不包含未加载的其他页。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>SummaryType</code>（<strong>学费与学杂费列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：费用列采用 Sum，浏览器从当前行数值计算合计。</li>
        </ul>
    </section>
}
