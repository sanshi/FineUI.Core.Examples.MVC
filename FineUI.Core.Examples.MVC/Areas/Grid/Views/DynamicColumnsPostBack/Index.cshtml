@{
    ViewBag.Title = "Grid/GridPostBack";
    var F = Html.F();
}

@model System.Data.DataTable

@section body {

    @(F.DropDownList().ID("DropDownList1").Label("切换表格").Width(500)
        .OnSelectedIndexChanged(Url.Action("DropDownList1_SelectedIndexChanged"), new Parameter("selected", "this.getValue()"))
        .Items(
            F.ListItem().Text("表格一（单选，行扩展列）").Value("table1").Selected(true),
            F.ListItem().Text("表格二（多选，多表头，全选列）").Value("table2")
        )
    )
    <br>
    <br>
    @(F.Grid().IsFluid(true).Title("表格一（单选，行扩展列）").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableMultiSelect(false)
        .Columns(ViewBag.Grid1Columns).DataSource(Model))
    <br>
    <br>


    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))

    <br>
    <br>
    注：此功能有很大的局限性，不支持单元格编辑，不支持在回发时改变是否排序、是否分页和是否过滤等属性。
}


@section script {

    <script src="~/res/js/grid.js"></script>

}
