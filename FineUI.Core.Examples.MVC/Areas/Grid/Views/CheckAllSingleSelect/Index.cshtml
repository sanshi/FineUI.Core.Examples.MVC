@{
    ViewBag.Title = "Grid/CheckAllSingleSelect";
    var F = Html.F();
}

@section body {

    @(F.Grid().IsFluid(true).EnableCheckBoxSelect(true).ShowHeader(true).ShowBorder(true).Title("表格（只能单选）").ID("Grid1").DataIDField("Id").DataTextField("Name").EnableMultiSelect(false)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        )
        .DataSource(DataSourceUtil.GetDataTable())

    )
    <br>

    @(F.Button().Text("选中了哪些行（客户端）").CssClass("marginr").ClickHandler("onNotifySelectedRowsClick"))
    @(F.Button().ClickHandler("onSelectRowsClick").Text("选中第 8 行（客户端）"))
    <br>
    <br>

}


@section script {

    <script src="~/res/js/grid.js"></script>
    <script type="text/javascript">

        function onSelectRowsClick(event) {
            F.ui.Grid1.selectRows([7]);
        }
    </script>


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>把表格限制为单行选择。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>依次选择两行</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格（只能单选）">表格（只能单选）</strong>先选第一行，再选第二行。<br />结果：第二行选中时取消第一行，始终最多保留一条用户选择。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（只能单选）">表格（只能单选）</strong>）：初始为 <code>false</code>，关闭多选，新行选择替换原来的选中行。</li>
    </ul>
</section>
}
