@{
    ViewBag.Title = "Grid/RowNumberAlign";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).EnableCheckBoxSelect(true).ShowHeader(true).ShowBorder(true).Title("表格（数据库分页，切换分页时序号连续）").ID("Grid1").DataIDField("Id").DataTextField("Name").AllowPaging(true).PageSize(10).IsDatabasePaging(true).OnPageIndexChanged(Url.Action("Grid1_PageIndexChanged"), "Grid1")
        .Columns(
            F.RowNumberField().Width(60).EnablePagingNumber(true).TextAlign(TextAlign.Right),
            F.RenderField().HeaderText("ID").DataField("Id").Width(150),
            F.RenderField().HeaderText("时间").DataField("EntranceTime").ExpandUnusedSpace(true).MinWidth(150).FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd HH:mm:ss")
        ).RecordCount(ViewBag.Grid1RecordCount).DataSource(ViewBag.Grid1DataSource)

    )
    <br>

    @(F.Button().Text("选中了哪些行").CssClass("marginr").ClickHandler("onNotifySelectedRowsClick"))
    <br>
    <br>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>把序号列的文字明确设为靠右对齐。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>查看序号列的独立设置</h3>
    <ul>
        <li>查看<strong class="example-control-reference" data-example-control="Grid1" title="表格（数据库分页，切换分页时序号连续）">表格（数据库分页，切换分页时序号连续）</strong>最左侧的序号列。<br />结果：序号文字靠右侧排列，数据列仍采用各自的对齐配置。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>TextAlign</code>（<strong>序号列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格（数据库分页，切换分页时序号连续）">表格（数据库分页，切换分页时序号连续）</strong>）：初始为 <code>Right</code>，只决定序号文字对齐方向。</li>
    </ul>
</section>
}
