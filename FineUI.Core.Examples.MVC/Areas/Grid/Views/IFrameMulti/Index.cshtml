@{
    ViewBag.SourceFiles = "~/Grid/IFrameWindow";
    ViewBag.Title = "Grid/IFrameMulti";
    var F = Html.F();
}

@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableCheckBoxSelect(true)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("窗口列").RendererFunction("renderWindowField1")
        )
        .Toolbars(
            F.Toolbar()
                .Items(
                    F.Button().Icon(Icon.ApplicationEdit).Text("审批数据").ID("btnApprove").ClickHandler("onApproveClick")
                )
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>
    <br>



    @(F.Window().Hidden(true).Height(500).Width(850).IsModal(true).OnClose(Url.Action("Window1_Close")).Target(Target.Self).EnableResize(true).EnableMaximize(true).EnableIFrame(true).Title("审批").ID("Window1"))

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

    function renderWindowField1(value, params) {
        return '<a href="#" class="mywindowfield">编辑</a>';
    }

    // 打开窗体
    function openWindow(ids, texts) {

        // /Grid/IFrameWindow?id=104&name=刘国
        var iframeWindowUrl = '@Url.Content("~/Grid/IFrameWindow")';
        var iframeUrl = iframeWindowUrl + '?id=' + ids + '&name=' + encodeURIComponent(texts);

        // 显示窗体
        F.ui.Window1.show(iframeUrl, '详细信息 - ' + texts);
    }


    function onApproveClick(event) {
        var grid = F.ui.Grid1;

        if (!grid.hasSelection()) {
            F.alert('请至少选择一项！');
            return;
        }

        var selectedRows = grid.getSelectedRows(true);

        // DataIDField
        var selectedRowIds = $.map(selectedRows, function (item, index) {
            return item.id;
        }).join(',');

        // DataTextField
        var selectedRowTexts = $.map(selectedRows, function (item, index) {
            return item.text;
        }).join(',');

        openWindow(selectedRowIds, selectedRowTexts);
    }


    F.ready(function () {

        var grid = F.ui.Grid1;

        // 点击表格行中的编辑按钮
        grid.el.on('click', 'a.mywindowfield', function (event) {
            event.preventDefault();
            var rowEl = $(this).closest('.f-grid-row');
            var rowData = grid.getRowData(rowEl);

            openWindow(rowData.id, rowData.text);
        });

    });


    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>把选中多行的标识和姓名交给审批窗体，一次查看本次选择的记录。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>由表格记录打开审批窗体</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>勾选两行，点击<strong class="example-control-reference"
                    data-example-control="btnApprove" title="审批数据">审批数据</strong>。<br />结果：脚本用本次选中行集合生成网址参数和窗体标题，IFrame
                内显示相应资料；<strong>姓名</strong>通过编码传入，不能直接拼接未编码文字。</li>
            <li>取消全部选择后再次点击<strong class="example-control-reference" data-example-control="btnApprove"
                    title="审批数据">审批数据</strong>。<br />结果：本页提示先选择记录，不打开一个没有对象的审批窗体。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：选择多行数据，然后点击[审批数据]按钮。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableIFrame</code>（<strong class="example-control-reference" data-example-control="Window1" title="审批">审批</strong>）：初始为
                <code>true</code>，在独立页面中呈现选中记录资料。
            </li>
            <li><code>getSelectedRows / show</code>（<strong>打开窗体的页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：从当前记录或选择集合取得稳定主键与显示文字，作为窗体地址及标题；本页不执行真实审批业务。</li>
        </ul>
    </section>
}
