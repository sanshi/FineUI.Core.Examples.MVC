@{
    ViewBag.Title = "Grid/CheckAllAutoHide";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).EnableCheckBoxSelect(true).ShowHeader(true).ShowBorder(true).Title("表格").ID("Grid1").DataIDField("Id").DataTextField("Name").CheckBoxSelectAutoHide(true)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        )
        .DataSource(DataSourceUtil.GetDataTable())

    )
    <br>

    @(F.Button().Text("选中了哪些行（客户端）").CssClass("marginr").ClickHandler("onNotifySelectedRowsClick"))
    @(F.Button().ClickHandler("onSelectRowsClick").Text("选中第 2, 6, 8 行（客户端）"))
    <br>
    <br>


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>


    </script>
    <script type="text/javascript">

        function onSelectRowsClick(event) {
            F.ui.Grid1.selectRows([1,5,7]);
        }
    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>让未选行的选择框平时隐藏，在悬停或选中时显示。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>对照悬停与选中状态</h3>
    <ol>
        <li>把鼠标移入<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>的一行，勾选后移开鼠标。<br />结果：悬停时显示选择框；选中后仍显示勾选状态，其他未选行的选择框在移开鼠标后隐藏。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>CheckBoxSelectAutoHide</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>true</code>，根据悬停和选中状态显示选择框，不改变选择结果。</li>
    </ul>
</section>
}
