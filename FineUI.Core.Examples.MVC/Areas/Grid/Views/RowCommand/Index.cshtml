@{
    ViewBag.Title = "Grid/RowCommand";
    var F = Html.F();
}


@section head {

    <style>
        .mybtn3 .f-icon.f-icon-remove {
            color: red;
        }
    </style>

}

@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableCheckBoxSelect(true)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("").Commands(new GridCommand
            {
                CommandName = "Action1",
                Text = "按钮"
            }),
            F.RenderField().HeaderText("").Commands(new GridCommand
            {
                CommandName = "Action2",
                Icon = Icon.Delete,
                ConfirmText = "你确定要这么做吗？",
                ConfirmTarget = Target.Top
            }),
            F.RenderField().HeaderText("").Commands(new GridCommand
            {
                CommandName = "Action3",
                IconFont = IconFont.Remove,
                CssClass = "mybtn3",
                ConfirmText = "你确定要这么做吗？",
                ConfirmTarget = Target.Top
            })

        )
        .Listener("rowcommand", "onGrid1RowCommand")
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function doAction(cnode) {
            var grid1 = F.ui.Grid1;
            var rowEl = cnode.closest('.f-grid-row');
            var rowData = grid1.getRowData(rowEl);
            var column = grid1.getColumn(cnode.parents('.f-grid-cell'));

            var message = '你点击了第 ' + (rowEl.index() + 1) + ' 行，第 ' + (column.index + 1) + ' 列，行ID：' + rowData.id + '，姓名：' + rowData.text;

            F.notify({
                message: message,
                target: '_top',
                header: false,
                positionX: 'center',
                positionY: 'top'
            });
        }

        function onGrid1RowCommand(event, rowId, rowIndex, columnId, commandName) {
            doAction($(event.target));
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>通过行单击回发事件读取当前记录的主键和姓名。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>触发当前行事件</h3>
    <ul>
        <li>单击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>中某条记录的姓名单元格。<br />结果：动作触发后台事件，后台读取本次行索引及对应数据键，提示行主键和姓名。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>RowClick</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：处理本页关注的行单击动作，取本次操作对应的行信息。</li>
    </ul>
</section>
}
