@{
    ViewBag.Title = "Grid/CustomHeadMenu";
    var F = Html.F();
}

@section head {

    <style>
        .custom-filter {
            position: absolute;
            margin-left: 2px;
            cursor: pointer;
        }

        .f-grid-colheader.custom-filtered .f-grid-colheader-text {
            /* font-style: italic; */
            font-weight: bold;
        }
    </style>

}


@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableHeaderMenu(false)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderTextRawHtml(new RawHtml("入学年份<i class=\"f-icon f-iconfont f-iconfont-filter custom-filter\"></i>")).DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderTextRawHtml(new RawHtml("是否在校<i class=\"f-icon f-iconfont f-iconfont-filter custom-filter\"></i>")).DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        )
        .Listener("dataload", "checkGridColheaderStyle")
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))
    @(F.Menu().ID("Menu1")
        .Items(
            F.MenuCheckBox().ID("btnSelectAll").GroupName("AtSchool").Checked(true).OnCheckedChanged(Url.Action("btnAtSchool_CheckedChanged"), "Grid1", Parameter.FromFunction("menuStatus", "getCurrentControlMenuStatusPostbackValue")).Text("全部"),
            F.MenuCheckBox().ID("btnSelectAtSchool").GroupName("AtSchool").OnCheckedChanged(Url.Action("btnAtSchool_CheckedChanged"), "Grid1", Parameter.FromFunction("menuStatus", "getCurrentControlMenuStatusPostbackValue")).Text("在校"),
            F.MenuCheckBox().ID("btnSelectNotAtSchool").GroupName("AtSchool").OnCheckedChanged(Url.Action("btnAtSchool_CheckedChanged"), "Grid1", Parameter.FromFunction("menuStatus", "getCurrentControlMenuStatusPostbackValue")).Text("离校")
        )
    )
    @(F.Menu().ID("Menu2")
        .Items(
            F.MenuCheckBox().ID("btnEntranceYearAll").GroupName("EntranceYear").Checked(true).OnCheckedChanged(Url.Action("btnEntranceYear_CheckedChanged"), "Grid1", Parameter.FromFunction("menuStatus", "getCurrentControlMenuStatusPostbackValue")).Text("全部"),
            F.MenuCheckBox().ID("btnEntranceYearGreatThan2002").GroupName("EntranceYear").OnCheckedChanged(Url.Action("btnEntranceYear_CheckedChanged"), "Grid1", Parameter.FromFunction("menuStatus", "getCurrentControlMenuStatusPostbackValue")).Text("入学年份大于2002")
        )
    )
}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlMenuStatusPostbackValue() {
            return getMenuStatus();
        }

    </script>


    <script src="~/res/js/grid.js"></script>

    <script>

        function getMenuStatus() {
            return F.toJSON({
                menu1: getMenuCheckBoxChecked('menu1'),
                menu2: getMenuCheckBoxChecked('menu2')
            });
        }

        function getMenuCheckBoxChecked(type) {
            var result;
            var menuCmp = type === 'menu1' ? F.ui.Menu1 : F.ui.Menu2;
            $.each(menuCmp.items, function (index, item) {
                if (item.isChecked()) {
                    result = item.getText();
                }
            });

            return result;
        }

        function checkGridColheaderStyle(event) {
            var grid1El = F.ui.Grid1.el;
            var colheaderEntranceYearEl = grid1El.find('.f-grid-colheader-EntranceYear');
            var colheaderAtSchoolEl = grid1El.find('.f-grid-colheader-AtSchool');

            var btnSelectAll = F.ui.btnSelectAll;
            var btnEntranceYearAll = F.ui.btnEntranceYearAll;


            if (btnSelectAll.isChecked()) {
                colheaderAtSchoolEl.removeClass('custom-filtered');
            } else {
                colheaderAtSchoolEl.addClass('custom-filtered');
            }

            if (btnEntranceYearAll.isChecked()) {
                colheaderEntranceYearEl.removeClass('custom-filtered');
            } else {
                colheaderEntranceYearEl.addClass('custom-filtered');
            }
        }

        function onGridDataLoad(event) {
            checkGridColheaderStyle();
        }

        F.ready(function () {

            F.ui.Grid1.el.on('click', '.f-grid-colheader .custom-filter', function (event) {
                var colHeaderEl = $(this).parents('.f-grid-colheader');
                if (colHeaderEl.hasClass('f-grid-colheader-AtSchool')) {
                    F.ui.Menu1.show();
                } else if (colHeaderEl.hasClass('f-grid-colheader-EntranceYear')) {
                    F.ui.Menu2.show();
                }
            });

        });

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>用表头旁自定义图标打开业务过滤菜单，以入学年份与在校状态筛选数据。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>按业务选项过滤记录</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>是否在校表头旁的过滤图标，选择在校或离校。<br />结果：后台按所选状态筛选记录，对应表头文字加粗；选择全部可取消这一列的限制。</li>
        <li>打开入学年份旁的过滤菜单，选择入学年份大于2002。<br />结果：年份条件与当前在校条件一起应用；选择该菜单的全部只取消年份限制，不清掉另一列条件。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableHeaderMenu</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>false</code>，隐藏标准表头菜单，由自定义过滤图标打开本页业务菜单。</li>
        <li><code>custom-filter / custom-filtered</code>（<strong>自定义表头与页面 CSS</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：前者标识过滤入口，后者在有条件时加粗列标题；筛选仍由菜单对应处理函数完成。</li>
    </ul>
</section>
}
