@{
    ViewBag.Title = "Grid/RowCommandWindow";
    ViewBag.SourceFiles = "~/Grid/RowCommandWindow/Details";
    var F = Html.F();
    var rows = new[]
    {
        new { ID = 105, Slug = "customer-105", DisplayName = "张三" },
        new { ID = 106, Slug = "customer-106", DisplayName = "李四" }
    };
}

@section body {
    @(F.Grid().ID("Grid1").Title("客户列表").ShowHeader(true).ShowBorder(true).IsFluid(true)
        .DataIDField("ID")
        .Columns(
            F.RenderField().HeaderText("客户编号").DataField("ID").Width(150),
            F.RenderField().HeaderText("客户标识").DataField("Slug").Width(220),
            F.RenderField().HeaderText("客户姓名").DataField("DisplayName").Width(150),
            F.RenderField().HeaderText("操作").ExpandUnusedSpace(true).Commands(new GridCommand
            {
                Text = "查看客户",
                CommandName = "View",
                WindowID = "Details",
                WindowIFrameUrlFormatString = Url.Content("~/Grid/RowCommandWindow/Details?slug={0}"),
                WindowIFrameUrlFields = new[] { "Slug" },
                WindowTitleFormatString = "客户 - {0}",
                WindowTitleFields = new[] { "DisplayName" }
            })
        )
        .DataSource(rows)
    )
    @(F.Window().ID("Details").Title("客户详情").Width(500).Height(300)
        .IsModal(true).EnableIFrame(true).Hidden(true))

    <p>点击“查看客户”打开该行的客户详情：网址参数取自 <code>Slug</code>，窗体标题取自 <code>DisplayName</code>。</p>
}
