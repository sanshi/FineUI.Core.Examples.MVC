@{
    ViewBag.Title = "Grid/SortingServer";
    var F = Html.F();
}



@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").AllowSorting(true).EnableCheckBoxSelect(true).OnSort(Url.Action("Grid1_Sort"), "Grid1")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name").SortField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").SortField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").SortField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").SortField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").MarginRight(5).ClickHandler("onNotifySelectedRowsClick"))
    @(F.Button().OnClick(Url.Action("Button2_Click"),
            Parameter.FromFunction("fields", "getGrid1FieldsPostbackValue")).Text("[入学年份]倒序排列").ID("Button2")
    )

}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getGrid1FieldsPostbackValue() {
            return F.ui.Grid1.fields;
        }

    </script>


    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>由按钮在后台指定排序列与方向，使数据顺序与表头标记同步更新。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>通过按钮指定排序</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="Button2"
                    title="[入学年份]倒序排列">[入学年份]倒序排列</strong>。<br />结果：后台把<strong>入学年份</strong>设为降序条件，重新绑定后较大的年份排在前面，列标题显示降序标记。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>SortField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：指定排序使用的数据字段；未设置时初次加载不主动排序。
            </li>
            <li><code>SortDirection</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：指定排序方向 ASC 或
                DESC，并与重新绑定后的记录保持一致。</li>
        </ul>
    </section>
}
