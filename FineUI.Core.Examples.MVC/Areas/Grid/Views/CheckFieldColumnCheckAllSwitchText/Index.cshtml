@{
    ViewBag.Title = "Grid/CheckFieldColumnCheckAllSwitchText";
    var F = Html.F();
}

@section head {

    <style>
        .f-field-body-checkboxlabel {
            white-space: nowrap;
        }
    </style>

}


@section body {


    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableCheckBoxSelect(true).CheckBoxSelectWidth(60).CheckBoxSelectDisplayType(CheckBoxDisplayType.Switch)
        .Toolbars(
            F.Toolbar()
                .Items(
                    F.Label().Text("快速设定："),
                    F.CheckBox().Text("是否在校2").MarginRight(10).AttributeDataTag("AtSchool2").Listener("change", "onQuickSetCheckChange").DisplayType(CheckBoxDisplayType.Switch),
                    F.CheckBox().Text("是否在校3").MarginRight(10).AttributeDataTag("AtSchool3").Listener("change", "onQuickSetCheckChange").DisplayType(CheckBoxDisplayType.Switch),
                    F.CheckBox().Text("是否在校4").MarginRight(10).AttributeDataTag("AtSchool4").Listener("change", "onQuickSetCheckChange").DisplayType(CheckBoxDisplayType.Switch)
                )
        )
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderCheckField().HeaderText("是否在校2").ColumnID("AtSchool2").DataField("AtSchool").RenderAsStaticField(false).DisplayType(CheckBoxDisplayType.Switch),
            F.RenderCheckField().HeaderText("是否在校3").ColumnID("AtSchool3").DataField("AtSchool").RenderAsStaticField(false).DisplayType(CheckBoxDisplayType.Switch).SwitchTextVisible(true),
            F.RenderCheckField().HeaderText("是否在校4").ColumnID("AtSchool4").DataField("AtSchool").RenderAsStaticField(false).DisplayType(CheckBoxDisplayType.Switch).SwitchTextVisible(true).SwitchOnText("是").SwitchOffText("否")
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>
    <br>

    @(F.Button().Text("选中行复选框的状态").ID("Button2").ClickHandler("onNotifyCheckFieldStatusClick"))

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onQuickSetCheckChange(event) {
            var grid1 = F.ui.Grid1;
            var checkboxFieldID = this.getAttr('data-tag'), checked = this.getValue();

            //var checkboxEls = grid1.el.find('.f-grid-cell-' + checkboxFieldID + ' .f-grid-checkbox');
            //checkboxEls.toggleClass('f-checked', checked);

            // 更新所有行中指定列复选框的值
            F.ui.Grid1.getRowEls().each(function () {
                grid1.updateCellValue($(this), checkboxFieldID, checked, true);
            });
        }

        function onNotifyCheckFieldStatusClick(event) {
            var grid1 = F.ui.Grid1;

            var rowEls = grid1.getSelectedRowEls();
            if (!rowEls.length) {
                F.alert('没有选中项！');
                return;
            }

            var result = ['<table class="result">'];
            result.push('<tr>');
            result.push('<th>ID</th>');
            result.push('<th>姓名</th>');
            result.push('<th>是否在校2</th>');
            result.push('<th>是否在校3</th>');
            result.push('<th>是否在校4</th>');
            result.push('</tr>');
            rowEls.each(function () {
                var cnode = $(this);
                var rowData = grid1.getRowData(cnode);
                var isChecked2 = cnode.find('.f-grid-cell-AtSchool2 .f-grid-checkbox').hasClass('f-checked');
                var isChecked3 = cnode.find('.f-grid-cell-AtSchool3 .f-grid-checkbox').hasClass('f-checked');
                var isChecked4 = cnode.find('.f-grid-cell-AtSchool4 .f-grid-checkbox').hasClass('f-checked');

                result.push('<tr>');
                result.push('<td>' + rowData.id + '</td>');
                result.push('<td>' + rowData.text + '</td>');
                result.push('<td>' + (isChecked2 ? '在校' : '不在校') + '</td>');
                result.push('<td>' + (isChecked3 ? '在校' : '不在校') + '</td>');
                result.push('<td>' + (isChecked4 ? '在校' : '不在校') + '</td>');
                result.push('</tr>');
            });
            result.push('</table>');

            F.notify({
                message: F.rawHtml(result.join('')),
                target: '_top',
                header: false,
                messageIcon: '',
                positionX: 'center',
                positionY: 'top'
            });
        }

    </script>
}
