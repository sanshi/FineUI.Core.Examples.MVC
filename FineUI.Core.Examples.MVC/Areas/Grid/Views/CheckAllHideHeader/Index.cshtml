@{
    ViewBag.Title = "Grid/CheckAllHideHeader";
    var F = Html.F();
}

@section head {

    <style>
        .f-grid-colheader.f-grid-checkselectionfield .f-grid-checkbox {
            display: none;
        }
    </style>

}

@section body {

    @(F.Grid().IsFluid(true).EnableCheckBoxSelect(true).ShowHeader(true).ShowBorder(true).Title("表格").ID("Grid1").DataIDField("Id").DataTextField("Name")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        )
        .DataSource(DataSourceUtil.GetDataTable()).SelectedRowIDArray("105", "110")

    )
    <br>

    @(F.Button().Text("选中了哪些行（客户端）").CssClass("marginr").ClickHandler("onNotifySelectedRowsClick"))
    @(F.Button().ClickHandler("onSelectRowsClick").Text("选中第 2, 6, 8 行（客户端）"))
    <br>
    <br>

    <br>

}


@section script {

    <script src="~/res/js/grid.js"></script>
    <script type="text/javascript">

        function onSelectRowsClick(event) {
            F.ui.Grid1.selectRows([1,5,7]);
        }
    </script>


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>隐藏选择列的表头全选框，仍允许逐行勾选记录。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>逐行选择</h3>
    <ul>
        <li>查看<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>的选择列表头，再勾选两条记录。<br />结果：表头全选框不可见，每行复选框仍能正常勾选；没有隐藏整列或取消选择能力。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：本例通过 CSS 隐藏了表头复选框。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>CSS</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：隐藏选择列表头内的复选框；行内选择框保持原样。</li>
    </ul>
</section>
}
