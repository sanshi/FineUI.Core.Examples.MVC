@{
    ViewBag.Title = "Grid/CheckFieldHideSome";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-cell.hidethis .f-grid-checkbox {
            display: none;
        }
    </style>

}


@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderCheckField().HeaderText("是否在校").ColumnID("AtSchool2").RenderAsStaticField(false).DataField("AtSchool").RendererFunction("renderAtSchool2"),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd")
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br />
    <br />
    注：本示例隐藏 EntranceYear&lt;=2004 的复选框，通过CSS样式来隐藏（display:none;）。
    <br />
    <br />

    @(F.Button().Text("选中了哪些行").ID("Button1").MarginRight(5).ClickHandler("onNotifySelectedRowsClick"))
    @(F.Button().Text("选中行复选框的状态").ID("Button2").ClickHandler("onNotifyCheckFieldStatusClick"))

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderAtSchool2(value, params) {
            var entranceYear = params.rowData.values['EntranceYear'];
            if (entranceYear <= 2004) {
                params.cellCls = 'hidethis';
            }

            return value;
        }

        function onNotifyCheckFieldStatusClick(event) {
            var grid1 = F.ui.Grid1;

            var rowEls = grid1.getSelectedRowEls();
            if (!rowEls.length) {
                F.alert('没有选中项！');
                return;
            }

            var result = ['<table class="result">'];
            result.push('<tr>');
            result.push('<th>ID</th>');
            result.push('<th>姓名</th>');
            result.push('<th>是否在校</th>');
            result.push('</tr>');
            rowEls.each(function () {
                var cnode = $(this);
                var rowData = grid1.getRowData(cnode);
                var atSchoolEl = cnode.find('.f-grid-cell-AtSchool2 .f-grid-checkbox');
                var isChecked = atSchoolEl.hasClass('f-checked');

                result.push('<tr>');
                result.push('<td>' + rowData.id + '</td>');
                result.push('<td>' + rowData.text + '</td>');
                result.push('<td>' + (isChecked ? '在校' : '不在校') + '</td>');
                result.push('</tr>');
            });
            result.push('</table>');

            F.notify({
                message: F.rawHtml(result.join('')),
                target: '_top',
                header: false,
                messageIcon: '',
                positionX: 'center',
                positionY: 'top'
            });
        }


    </script>
}
