@{
    ViewBag.Title = "Grid/CheckFieldPostBack";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderCheckField().HeaderText("是否在校").ColumnID("AtSchool2").DataField("AtSchool").RenderAsStaticField(false),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd")
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").MarginRight(5).ClickHandler("onNotifySelectedRowsClick"))


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        var checkboxSelector = '.f-grid-cell-AtSchool2 .f-grid-checkbox';

        F.ready(function () {

            var grid1 = F.ui.Grid1;

            grid1.el.on('click', checkboxSelector, function (event) {
                var cnode = $(this);
                var rowData = grid1.getRowData(cnode.closest('.f-grid-row'));
                var isChecked = cnode.hasClass('f-checked');

                // 触发后台事件
                F.doPostBack({
                    url: '@Url.Action("Grid1_CheckFieldChanged")',
                    params: {
                        rowId: rowData.id,
                        rowText: rowData.text,
                        isChecked: isChecked
                    }
                });

            });

        });

    </script>
}
