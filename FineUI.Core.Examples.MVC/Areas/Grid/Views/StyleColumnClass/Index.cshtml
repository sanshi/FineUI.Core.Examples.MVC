@{
    ViewBag.Title = "Grid/StyleColumnClass";
    var F = Html.F();
}


@section head {

    <style>
        
        
        .f-grid-colheader-EntranceYear .f-grid-colheader-text,
        .f-grid-row .f-grid-cell-EntranceYear {
            color: red;
            font-weight: bold;
        }

        .f-grid-colheader-Major .f-grid-colheader-text,
        .f-grid-row .f-grid-cell-Major {
            color: green;
            font-weight: bold;
        }

            .f-grid-row .f-grid-cell-Major a,
            .f-grid-row .f-grid-cell-Major a:hover {
                color: green;
            }

    </style>

}

@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        )
        .DataSource(DataSourceUtil.GetDataTable()).Attribute("data-source-key", "source1")
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").CssClass("marginr").ClickHandler("onNotifySelectedRowsClick"))
    @(F.Button().ID("btnRebindGrid").Text("重新绑定表格").OnClick(Url.Action("Button1_Click"),
            Parameter.FromFunction("fields", "getGrid1FieldsPostbackValue"),
            Parameter.FromFunction("source", "getGrid1SourcePostbackValue"))
    )

}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getGrid1FieldsPostbackValue() {
            return F.ui.Grid1.fields;
        }

        function getGrid1SourcePostbackValue() {
            return F.ui.Grid1.getAttr('data-source-key');
        }

    </script>


    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>为整列指定样式类，让该列各行采用一致外观。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>对照本页样式规则</h3>
    <ul>
        <li>查看<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>中的已设置样式列，并与相邻普通列比较。<br />结果：样式由列配置统一应用到该列，不需要逐条记录判断后再赋值；同列不同记录保持一致的样式规则。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>换一组记录后重新应用规则</h3>
    <ul>
        <li>点击<strong class="example-control-reference" data-example-control="btnRebindGrid" title="重新绑定表格">重新绑定表格</strong>。<br />结果：按钮回发后后台换入另一组记录；列配置或按数据判断的样式规则继续应用，不是仅给最初几行写死颜色。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>CssClass</code>（<strong>本页列与样式</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：在指定列上声明样式类，本页 CSS 决定相应单元格的文字和背景外观。</li>
    </ul>
</section>
}
