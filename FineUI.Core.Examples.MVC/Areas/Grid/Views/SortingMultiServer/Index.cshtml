@{
    ViewBag.Title = "Grid/SortingMultiServer";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .AllowSorting(true).SortingToolTip(true).SortingCancel(true).SortFieldArray(@ViewBag.Grid1SortFields).SortingMulti(true).EnableCheckBoxSelect(true).OnSort(Url.Action("Grid1_Sort"), "Grid1")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name").SortField("Name").Width(150),
            F.RenderField().HeaderText("性别").DataField("Gender").SortField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").Width(150),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").SortField("EntranceYear").FieldType(FieldType.Int).Width(150),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").SortField("AtSchool").RenderAsStaticField(true).Width(150),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        ).Toolbars(
            F.Toolbar().Position(ToolbarPosition.Top).Items(
                F.Label().ID("labSortOrderTip").Text(ViewBag.SortTip)
            )
        ).DataSource(ViewBag.Grid1DataSource)
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick").MarginRight(5))
    @(F.Button().OnClick(Url.Action("Button2_Click"), 
        Parameter.FromFunction("fields", "getGrid1FieldsPostbackValue")).Text("[入学年份]正序，[姓名]倒序").ID("btnChangeOnServer")
    )

}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getGrid1FieldsPostbackValue() {
            return F.ui.Grid1.fields;
        }

    </script>


    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>由后台一次设置多列排序条件，同时更新数据顺序和各列表头的方向标记。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>后台指定组合排序</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="btnChangeOnServer"
                    title="[入学年份]正序，[姓名]倒序">[入学年份]正序，[姓名]倒序</strong>。<br />结果：后台先按入学年份升序排列，同一年份再按姓名降序排列；重新绑定后的记录和两个列标题标记一致。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>SortFieldArray</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：保存有先后顺序的字段与方向组合；本页按钮把<strong>入学年份</strong> ASC、姓名 DESC 依次写入并重新绑定数据。</li>
        </ul>
    </section>
}
