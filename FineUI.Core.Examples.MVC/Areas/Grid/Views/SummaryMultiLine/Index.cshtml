@{
    ViewBag.Title = "Grid/SummaryMultiLine";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-row-summary .f-grid-cell-Major .f-grid-cell-text {
            text-align: right;
        }

        .f-grid-row-summary .f-grid-cell-text {
            font-weight: bold;
        }

        .f-grid-row-summary:first-child .f-grid-cell-text {
            font-weight: normal;
            font-style: italic;
        }
    </style>

}

@section body {

    @(F.Grid().IsFluid(true).EnableCheckBoxSelect(true).Height(450).ShowHeader(true).ShowBorder(true).Title("表格").ID("Grid1").DataIDField("Id").DataTextField("Name").AllowPaging(true).PageSize(15).IsDatabasePaging(true).OnPageIndexChanged(Url.Action("Grid1_PageIndexChanged"), "Grid1").EnableSummary(true).SummaryPosition(SummaryPosition.Bottom).SummaryRowCount(2)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").ColumnID("Major").RendererFunction("renderMajor").MinWidth(150).ExpandUnusedSpace(true),
            F.RenderField().HeaderText("学费").DataField("Fee"),
            F.RenderField().HeaderText("学杂费").DataField("ExtraFee")
        ).RecordCount(ViewBag.Grid1RecordCount).DataSource(ViewBag.Grid1DataSource).SummaryDataArray(ViewBag.Grid1SummaryDataArray)

    )
    <br>

    @(F.Button().Text("选中了哪些行").CssClass("marginr").ClickHandler("onNotifySelectedRowsClick"))
    <br>
    <br>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
