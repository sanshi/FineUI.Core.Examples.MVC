@{
    ViewBag.Title = "Grid/SortingClientSorter";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").AllowSorting(true).EnableCheckBoxSelect(true)
        .Toolbars(
            F.Toolbar().ToolbarAlign(ToolbarAlign.Right)
                .Items(
                    F.DropDownList().ID("DropDownList1").Label("[所学专业]列的排序方式").LabelWidth(200).LabelAlign(LabelAlign.Right)
                        .Items(
                            F.ListItem().Text("按字母顺序").Value("sort_letter"),
                            F.ListItem().Text("按字符个数").Value("sort_length")
                        )
                )
        )
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name").SortField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").SortField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").SortField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").SortField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").SortField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150).SorterFunction("majorSorter"),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd")
        ).DataSource(ViewBag.Grid1DataSource)
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))

    <br />
    <br />

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function majorSorter(x, y) {
            if (F.ui.DropDownList1.getValue() === 'sort_letter') {
                return x.localeCompare(y, 'zh');
            } else {
                return x.length - y.length;
            }
        }

    </script>
}
