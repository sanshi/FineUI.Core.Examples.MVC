@{
    ViewBag.Title = "Grid/WidthExpandUnusedSpace";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Margin(24)
        .Title("表格（[个人简介]占据空余空间100%）(改变页面大小来观察每列宽度的变化)").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").IsViewPort(true)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").Width(200),
            F.RenderField().HeaderText("个人简介").DataField("Desc").ExpandUnusedSpace(true).MinWidth(150)
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>让个人简介列填满其余列之后的可用宽度。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>调整可用宽度核对列宽</h3>
        <ol>
            <li>缩窄再放宽<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（[个人简介]占据空余空间100%）(改变页面大小来观察每列宽度的变化)">表格（[个人简介]占据空余空间100%）(改变页面大小来观察每列宽度的变化)</strong>所在区域。<br />结果：<strong>个人简介</strong>承担剩余空间，普通固定宽度列不按同样比例伸缩。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ExpandUnusedSpace</code>（<strong>个人简介列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（[个人简介]占据空余空间100%）(改变页面大小来观察每列宽度的变化)">表格（[个人简介]占据空余空间100%）(改变页面大小来观察每列宽度的变化)</strong>）：<strong>个人简介</strong>列开启填充剩余宽度，其他列使用自己的固定宽度。
            </li>
        </ul>
    </section>
}
