@{
    ViewBag.Title = "Grid/GroupField";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("表格").DataIDField("Id")
        .Columns(
            F.RenderField().DataField("Year").HeaderText("统计年份"),
            F.GroupField().HeaderText("安徽省").TextAlign(TextAlign.Center)
                .Columns(
                    F.GroupField().HeaderText("合肥市").TextAlign(TextAlign.Center)
                        .Columns(
                            F.RenderField().DataField("AHData1").HeaderText("数据一"),
                            F.RenderField().DataField("AHData2").HeaderText("数据二")
                        )
                ),
            F.GroupField().HeaderText("河南省").TextAlign(TextAlign.Center)
                .Columns(
                    F.GroupField().HeaderText("驻马店市").TextAlign(TextAlign.Center)
                        .Columns(
                            F.RenderField().DataField("HZData1").HeaderText("数据一"),
                            F.RenderField().DataField("HZData2").HeaderText("数据二")
                        ),
                    F.GroupField().HeaderText("漯河市").TextAlign(TextAlign.Center)
                        .Columns(
                            F.RenderField().DataField("HLData1").HeaderText("数据一"),
                            F.RenderField().DataField("HLData2").HeaderText("数据二")
                        )
                ),
            F.RenderField().BoxFlex(1).TextAlign(TextAlign.Center).DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd").HeaderText("记录时间")
        ).DataSource(ViewBag.Grid1DataSource)

    )
    <br>
    <br>


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>用分组表头组织多层列标题，底层叶子列仍各自读取对应字段。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>沿组头找到对应明细列</h3>
        <ul>
            <li>查看<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>表头各层的省、市等分组，再向下对照明细列与正文。<br />结果：上层标题跨越所属下级列，叶子标题与各行值逐列对应；表头层次不改变数据行数量。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>GroupField.Columns</code>（<strong>分组表头</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：在分组中继续放分组或数据列，按嵌套结构形成表头层级。</li>
            <li><code>DataField</code>（<strong>叶子数据列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：仅由底层数据列读取每行字段，组头不重复绑定数据。</li>
        </ul>
    </section>
}
