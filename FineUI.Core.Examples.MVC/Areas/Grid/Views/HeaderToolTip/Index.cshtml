@{
    ViewBag.Title = "Grid/HeaderToolTip";
    var F = Html.F();
}



@section body {

    @(F.Grid().IsFluid(true).Height(300).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业，这是很长的标题文本，真的很长很长").HeaderToolTip("所学专业，这是很长的标题文本，真的很长很长").HeaderToolTipPosition(ToolTipPosition.Top).DataField("Major").RendererFunction("renderMajor").Width(150)
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>给专业列标题设置完整提示，标题较长时仍能悬停读取。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>悬停查看列标题全文</h3>
        <ul>
            <li>把鼠标移到<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>的专业列标题。<br />结果：标题提示显示完整文字，提示出现在配置的顶部位置；这是表头提示，与数据单元格提示分别配置。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>HeaderToolTip / HeaderToolTipPosition</code>（<strong>专业列标题</strong>，位于<strong class="example-control-reference"
                    data-example-control="Grid1" title="表格">表格</strong>）：专业列提供完整提示文字，弹出位置初始为 <code>Top</code>。</li>
        </ul>
    </section>
}
