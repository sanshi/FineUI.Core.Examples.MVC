@{
    ViewBag.Title = "TabStrip/AddTabRemoveOnClose";
    var F = Html.F();
}


@section body {

    @(F.TabStrip().IsFluid(true).ID("TabStrip1").Height(500).ShowBorder(true).ActiveTabIndex(0)
        .Tabs(
            F.Tab().ID("TabExample1").Title("FineUI官网").EnableIFrame(true).IFrameUrl("https://fineui.com/")
        )
    )
    <br>

    @(F.Button().ID("btnAddTab1").CssClass("marginr").Text("DeepSeek官网（客户端代码）").ClickHandler("onAddTab1Click"))

    @(F.Button().ID("btnAddTab2").CssClass("marginr").Text("ASP.NET官网（客户端代码）").ClickHandler("onAddTab2Click"))

    @(F.Button().ID("btnRemoveTab1").CssClass("marginr").Text("删除DeepSeek官网（客户端代码）").ClickHandler("onRemoveTab1Click"))

    @(F.Button().ID("btnRemoveTab2").CssClass("marginr").Text("删除ASP.NET官网（客户端代码）").ClickHandler("onRemoveTab2Click"))
    <br>
    <br>

    @(F.Button().ID("btnAddTab3").CssClass("marginr").Text("DeepSeek官网（服务端代码）").OnClick(Url.Action("btnAddTab3_Click")))

    @(F.Button().ID("btnAddTab4").CssClass("marginr").Text("ASP.NET官网（服务端代码）").OnClick(Url.Action("btnAddTab4_Click")))

    @(F.Button().ID("btnRemoveTab3").CssClass("marginr").Text("删除DeepSeek官网（服务端代码）").OnClick(Url.Action("btnRemoveTab3_Click")))

    @(F.Button().ID("btnRemoveTab4").CssClass("marginr").Text("删除ASP.NET官网（服务端代码）").OnClick(Url.Action("btnRemoveTab4_Click")))
    <br>
    <br>


}


@section script {

    <script>

        function onAddTab1Click(event) {
            F.ui.TabStrip1.addTab({
                id: 'dynamic_tab1',
                iframe: true,
                iframeUrl: 'https://deepseek.com/',
                title: 'DeepSeek官网',
                closable: true,
                icon: '@Url.Content("~/res/icon/application.png")',
                removeOnClose: true
            });
        }

        function onAddTab2Click(event) {
            F.ui.TabStrip1.addTab({
                id: 'dynamic_tab2',
                iframe: true,
                iframeUrl: 'https://asp.net/',
                title: 'ASP.NET官网',
                closable: true,
                icon: '@Url.Content("~/res/icon/application_add.png")',
                removeOnClose: true
            });

        }

        function onRemoveTab1Click(event) {
            F.ui.TabStrip1.closeTab('dynamic_tab1');
        }

        function onRemoveTab2Click(event) {
            F.ui.TabStrip1.closeTab('dynamic_tab2');
        }

    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示关闭动态 <code>iframe</code> 标签时移除实例，并允许随后重新创建同名标签。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>添加、关闭与重新添加</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="btnAddTab1" title="DeepSeek官网（客户端代码）">DeepSeek官网（客户端代码）</strong>。<br />结果：浏览器新建并激活一个 <code>iframe</code> 标签，标签配置了关闭后移除实例。</li>
        <li>在<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>关闭刚添加的标签，再点击同一个新增按钮。<br />结果：旧实例已被移除，可以重新创建相同 <code>ID</code> 的标签并正常激活。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnAddTab3" title="DeepSeek官网（服务端代码）">DeepSeek官网（服务端代码）</strong>。<br />结果：按钮回发，由后台生成并下发新标签配置，再激活对应页面。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>addTab()</code>（<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>）：按指定 <code>ID</code>、标题及 <code>iframe</code> 地址添加标签。</li>
        <li><code>RemoveOnClose</code>（<strong class="example-control-reference" data-example-control="TabExample1" title="FineUI官网">FineUI官网</strong>）：初始为 <code>true</code>，关闭时移除标签实例，不仅隐藏标题。</li>
    </ul>
</section>
}
