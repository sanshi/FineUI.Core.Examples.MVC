@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在侧边标题栏中竖排文字并保留工具图标。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对比标题与当前项</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="TabStrip1" title="第 1 个选项卡">第 1
                    个选项卡</strong>依次点击不同标签，对照本页其它组的同类标题。<br />结果：内容区随当前标签切换；标题方向、对齐、背景、边框或墨水条按本页配置显示。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>TabPosition</code>（<strong class="example-control-reference" data-example-control="TabStrip1" title="第 1 个选项卡">第 1 个选项卡</strong>、<strong
                    class="example-control-reference" data-example-control="TabStrip2" title="第 2 个选项卡">第 2 个选项卡</strong>、<strong
                    class="example-control-reference" data-example-control="TabStrip3" title="第 3 个选项卡">第 3 个选项卡</strong>、<strong
                    class="example-control-reference" data-example-control="TabStrip4" title="第 4 个选项卡">第 4
                    个选项卡</strong>）：各组分别设为<code>TabPosition.Top</code>、<code>TabPosition.Bottom</code>、<code>TabPosition.Left</code>、<code>TabPosition.Right</code>，指定标题栏所在方向；各组按本页配置分别对照。
            </li>
            <li><code>TabTitleVertical</code>（<strong class="example-control-reference" data-example-control="TabStrip3" title="第 3 个选项卡">第 3
                    个选项卡</strong>、<strong class="example-control-reference" data-example-control="TabStrip4" title="第 4 个选项卡">第 4
                    个选项卡</strong>）：初始为<code>true</code>，在侧边标题栏竖排文字。</li>
            <li><code>Tools</code>（<strong class="example-control-reference" data-example-control="TabStrip1" title="第 1 个选项卡">第 1 个选项卡</strong>、<strong
                    class="example-control-reference" data-example-control="TabStrip2" title="第 2 个选项卡">第 2 个选项卡</strong>、<strong
                    class="example-control-reference" data-example-control="TabStrip3" title="第 3 个选项卡">第 3 个选项卡</strong>、<strong
                    class="example-control-reference" data-example-control="TabStrip4" title="第 4 个选项卡">第 4 个选项卡</strong>）：把工具图标放入当前标题栏。</li>
        </ul>
    </section>
}
