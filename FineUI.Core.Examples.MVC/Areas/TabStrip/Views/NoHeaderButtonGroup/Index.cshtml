@{
    ViewBag.Title = "TabStrip/NoHeaderButtonGroup";
    var F = Html.F();
}

@section head {

    <style>
        .mybuttongroup .f-btn {
            border-width: 0;
            border-radius: 0;
            margin-bottom: 5px;
            padding-top: 10px;
            padding-bottom: 10px;
        }

        .mytabstrip {
            border-left-width: 1px;
        }
    </style>

}


@section body {

    @(F.Panel().ID("Panel1").ShowHeader(false).ShowBorder(true).IsFluid(true).Height(450).Layout(LayoutType.HBox)
        .Items(
            F.ButtonGroup().ID("ButtonGroup1").CssClass("mybuttongroup f-state-default").EnablePressGroup(true).Layout(LayoutType.VBox).Vertical(true).Width(200)
                .Items(
                    F.Button().ID("Button1").Text("标签一").Icon(Icon.Cake).EnablePress(true),
                    F.Button().ID("Button2").Text("标签二").IconFont(IconFont._Bank).EnablePress(true).Pressed(true),
                    F.Button().ID("Button3").Text("标签三").IconFont(IconFont._Group).EnablePress(true)
                ).Listener("presschange", "onButtonGroupPressChange"),
            F.TabStrip().ID("TabStrip1").CssClass("mytabstrip").EnableTabCloseMenu(true).BoxFlex(1).ShowBorder(false).ShowTabHeader(false).ActiveTabIndex(1).AnimationType(SwapAnimationType.Fade)
                .Tabs(
                    F.Tab().ID("Tab1").Title("标签一").EnableClose(false).BodyPadding(10)
                        .Items(
                            F.Label().ID("Label5").Text("标签一中的文本")
                        ),
                    F.Tab().ID("Tab2").Title("标签二").BodyPadding(10).EnableClose(true)
                        .Items(
                            F.Label().ID("Label4").Text("标签二中的文本")
                        ),
                    F.Tab().ID("Tab3").Title("标签三").BodyPadding(10).EnableClose(true).Layout(LayoutType.VBox)
                        .Items(
                            F.Label().ID("Label3").Text("标签三中的文本"),
                            F.TabStrip().ID("TabStrip2").BoxFlex(1).EnableTabCloseMenu(true).ShowBorder(true).ActiveTabIndex(1)
                                .Tabs(
                                    F.Tab().ID("Tab4").Title("标签四").EnableClose(false).BodyPadding(10)
                                        .Items(
                                            F.Label().ID("Label1").Text("标签四中的文本")
                                        ),
                                    F.Tab().ID("Tab5").Title("标签五").EnableClose(false).BodyPadding(10)
                                        .Items(
                                            F.Label().ID("Label2").Text("标签五中的文本")
                                        )
                                )
                        )
                )
        )
    )


}


@section script {

    <script>

        function onButtonGroupPressChange(event, btn) {
            var btnIndex = btn.el.index('.f-btn');

            // 激活相应的选项卡
            F.ui.TabStrip1.getItem(btnIndex).activate();
        }


    </script>
}