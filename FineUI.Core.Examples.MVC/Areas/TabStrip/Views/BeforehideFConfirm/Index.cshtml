@{
    ViewBag.Title = "TabStrip/BeforehideFConfirm";
    var F = Html.F();
}


@section body {

    @(F.TabStrip().IsFluid(true).ID("TabStrip1").Height(500).EnableTabCloseMenu(true).ShowBorder(true).ActiveTabIndex(2)
        .Tabs(
            F.Tab().ID("Tab1").Title("标签一").EnableClose(false).BodyPadding(10)
                .Items(
                    F.Label().ID("Label5").Text("标签一中的文本")
                ),
            F.Tab().ID("Tab2").Title("标签二").BodyPadding(10).EnableClose(true)
                .Items(
                    F.Label().ID("Label4").Text("标签二中的文本")
                ),
            F.Tab().ID("Tab3").Title("标签三（关闭前弹出确认框）").BodyPadding(10).EnableClose(true)
                .Items(
                    F.Label().ID("Label3").Text("标签三中的文本")
                )
                .Listener("beforehide", "onTab3Beforehide")
        )
    )
    <br>
    <br>

}



@section script {

    <script>

        function onTab3Beforehide(event) {
            // this代表当前选项卡
            var tab = this;

            // F.confirm是异步函数，直接返回
            F.confirm({
                message: '关闭标签三？',
                ok: function () {
                    // 关闭选项卡（本过程中不触发事件）
                    F.noEvent(function () {
                        tab.hide();
                    });
                },
                cancel: function () {
                    // 啥也不做
                }
            });


            // 需要显式的返回 false，来阻止执行返回的脚本
            return false;
        }

    </script>

}