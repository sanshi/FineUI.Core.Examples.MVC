@{
    ViewBag.Title = "TabStrip/TabIndexChanged";
    var F = Html.F();
}


@section body {

    @(F.TabStrip().IsFluid(true).ID("TabStrip1").Height(350).OnTabIndexChanged(Url.Action("TabStrip1_TabIndexChanged"), Parameter.FromFunction("activeIndex", "getTabStrip1ActiveIndexPostbackValue")).ShowBorder(true).ActiveTabIndex(1)
        .Tabs(
            F.Tab().Title("标签一").BodyPadding(10).Layout(LayoutType.Fit)
                .Items(
                    F.SimpleForm().ID("SimpleForm1").ShowBorder(false).ShowHeader(false).Title("SimpleForm1")
                        .Items(
                            F.Label().ID("Label1").CssClass("highlight").Label("文本").Text("初始文本"),
                            F.NumberBox().ID("NumberBox1").Label("数字输入框").Required(true).ShowRedStar(true),
                            F.TextBox().ID("TextBox1").Label("文本框").Required(true).ShowRedStar(true),
                            F.DatePicker().ID("DatePicker1").Label("日期选择器").Text("2008-05-09").Required(true).ShowRedStar(true),
                            F.TextArea().ID("TextArea2").Label("多行文本框").Required(true).ShowRedStar(true)
                        )
                ),
            F.Tab().Title("标签二").BodyPadding(10)
                .Items(
                    F.Label().ID("Label2").CssClass("highlight").Text("初始文本")
                ),
            F.Tab().Title("标签三").BodyPadding(10)
                .Items(
                    F.Label().ID("Label3").CssClass("highlight").Text("初始文本")
                )
        )
    )
    <br>

    @(F.Button().ID("Button2").CssClass("marginr").ValidateForms("SimpleForm1").Text("验证第一个标签中的表单"))

    @(F.Button().ID("Button3").Text("选中下一个标签").OnClick(Url.Action("Button3_Click"), Parameter.FromFunction("activeIndex", "getTabStrip1ActiveIndexPostbackValue")))


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getTabStrip1ActiveIndexPostbackValue() {
            return F.ui.TabStrip1.getActiveTabIndex();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示切换选项卡时回发，并由后台更新新激活标签中的内容。</p>
    <h3><i class="f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换后读取当前标签</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>从<code>标签二</code>切到<code>标签三</code>。<br />结果：切换事件回发，后台读取当前标签位置，并把回发时间写入对应内容标签。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>OnTabIndexChanged</code>（<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>）：激活标签改变时处理当前标签。</li>
        <li><code>ActiveTabIndex</code>（<strong class="example-control-reference" data-example-control="TabStrip1" title="选项卡">选项卡</strong>）：设为<code>1</code>，后台据此区分当前激活的标签，索引从 <code>0</code> 开始。</li>
    </ul>
</section>
}
