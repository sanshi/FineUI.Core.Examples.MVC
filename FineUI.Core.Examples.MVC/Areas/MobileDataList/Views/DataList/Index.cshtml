@{
    ViewBag.Title = "MobileDataList/DataList";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    @(F.Panel().ID("Panel1").ShowBorder(false).ShowHeader(false).AutoScroll(true).IsViewPort(true)
        .Toolbars(
            F.Toolbar().ID("Toolbar1").Title("列表").HeaderStyle(true)
        )
        .Items(
            F.DataList().ID("DataList1")
                .Items(
                    F.DataListItem().Value("item1").Text("列表项1"),
                    F.DataListItem().Value("item2").Text("列表项2"),
                    F.DataListItem().Value("item3").Text("列表项3"),
                    F.DataListItem().Value("item4").Text("列表项4"),
                    F.DataListItem().Value("item5").Text("列表项5"),
                    F.DataListItem().Value("item6").Text("列表项6"),
                    F.DataListItem().Value("item7").Text("列表项7"),
                    F.DataListItem().Value("item8").Text("列表项8"),
                    F.DataListItem().Value("item9").Text("一个很长很长很长很长很长很长很长很长很长很长很长很长很长很的列表项")
                )
        )
    )


}

