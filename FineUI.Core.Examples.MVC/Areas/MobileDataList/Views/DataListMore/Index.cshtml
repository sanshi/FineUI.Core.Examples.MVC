@{
    ViewBag.Title = "MobileDataList/DataListMore";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section head {

    <link href="~/res/css/datalist.css" rel="stylesheet" />
    <style>
        .item-desc {
            word-break: break-all;
            white-space: normal;
        }

        .morebutton {
            width: 100%;
            text-align: center;
            margin: 8px 0;
        }
    </style>

}


@section body {

    @(F.Panel().ID("Panel1").ShowBorder(false).ShowHeader(false).AutoScroll(true).IsViewPort(true)
        .Toolbars(
            F.Toolbar().ID("Toolbar1").Title("列表").HeaderStyle(true)
        )
        .Items(
            F.DataList().ID("DataList1").Items(ViewBag.DataList1Items).Attribute("data-index", "0"),
            F.LinkButton().ID("btnMore").CssClass("morebutton").Text("加载更多...").OnClick(@Url.Action("btnMore_Click"), Parameter.FromFunction("dataIndex", "getDataList1DataIndexPostbackValue"))
        )
    )




}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getDataList1DataIndexPostbackValue() {
            return F.ui.DataList1.getAttr('data-index');
        }

    </script>
}
