@{
    ViewBag.Title = "MobileDataList/DataListSelectedValueArrayKeepCurrentSelection";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section head {

    <link href="~/res/css/datalist.css" rel="stylesheet" />

}


@section body {

    @(F.Panel().ID("Panel1").ShowBorder(false).ShowHeader(false).AutoScroll(true).IsViewPort(true)
        .Toolbars(
            F.Toolbar().ID("Toolbar1").Title("列表").HeaderStyle(true)
                .Items(
                    F.Button().Text("获取选中项").ID("btnSubmit").OnClick(Url.Action("btnSubmit_Click"),
                            new Parameter("selected", "F.ui.DataList1.getSelectedItems()"))
                )
        )
        .Items(
            F.DataList().ID("DataList1").EnableSelect(true).EnableMultiSelect(true).KeepCurrentSelection(true).Items(ViewBag.DataList1Items).SelectedValueArray("cn", "us")
        )
    )




}

