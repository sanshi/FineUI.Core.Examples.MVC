@{
    ViewBag.Title = "MobileDataList/DataListSelectedValue";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section head {

    <link href="~/res/css/datalist.css" rel="stylesheet" />

}


@section body {

    @(F.Panel().ID("Panel1").ShowBorder(false).ShowHeader(false).AutoScroll(true).IsViewPort(true)
        .Toolbars(
            F.Toolbar().ID("Toolbar1").Title("列表").HeaderStyle(true)
                .Items(
                    F.Button().Text("获取选中项").ID("btnSubmit").OnClick(Url.Action("btnSubmit_Click"),
                            Parameter.FromFunction("selected", "getDataList1SelectedPostbackValue"))
                )
        )
        .Items(
            F.DataList().ID("DataList1").EnableSelect(true).Items(ViewBag.DataList1Items).SelectedValue("fr")
        )
    )




}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getDataList1SelectedPostbackValue() {
            return F.ui.DataList1.getSelectedItem();
        }

    </script>
}
