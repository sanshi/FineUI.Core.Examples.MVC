@{
    ViewBag.Title = "MobileWindow/PositionSlideUp";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    <div id="container1">
        <p>
            <a href="http://baike.baidu.com/view/3645.htm" target="_blank"><b>比尔·盖茨</b></a>
        </p><p>
            比尔·盖茨（Bill Gates），全名威廉·亨利·盖茨三世，简称比尔或盖茨。1975年与好友保罗·艾伦一起创办了微软公司，比尔盖茨担任微软公司董事长、CEO和首席软件设计师。
        </p>
    </div>

    @(F.Panel().ID("Panel1").ShowBorder(false).ShowHeader(false).Layout(LayoutType.VBox).BoxConfigChildMargin("0 0 5 0").BodyPadding(10).IsViewPort(true)
        .Items(
            F.Button().ID("btnOpenWindow").Text("从下方滑入窗体").ClickHandler("onOpenWindow1Click")
        )
    )

    @(F.Window().ID("Window1").ShowHeader(false).IsModal(true).HideOnMaskClick(true).BodyPadding(10).Layout(LayoutType.Fit).PercentWidth("100%").PercentHeight("100%").EnableDefaultCorner(false).PositionY(Position.Bottom).Hidden(true)
        .Toolbars(
            F.Toolbar().ID("Toolbar1").Title("弹出窗体标题").HeaderStyle(true).ToolbarAlign(ToolbarAlign.Right)
                .Items(
                    F.Button().ID("Button1").Size(ButtonSize.Small).Text("关闭").ClickHandler("onCloseWindow1Click")
                )
        )
        .Items(
            F.Panel().ShowBorder(false).ShowHeader(false).AutoScroll(true).ContentEl("#container1")
        )
    )

}


@section script {

    <script>

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onCloseWindow1Click(event) {
            F.ui.Window1.hide();
        }

    </script>

}
