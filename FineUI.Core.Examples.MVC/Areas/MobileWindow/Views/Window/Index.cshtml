@{
    ViewBag.Title = "MobileWindow/Window";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    @(F.Panel().ID("Panel1").ShowBorder(false).ShowHeader(false).Layout(LayoutType.VBox).BoxConfigChildMargin("0 0 5 0").BodyPadding(10).IsViewPort(true)
        .Items(
            F.Button().ID("btnOpenWindow").Text("打开登陆窗体").ClickHandler("onOpenWindowClick")
        )
    )

    @(F.Window().ID("Window1").Title("登陆窗体").IsModal(true).EnableClose(true).Layout(LayoutType.Fit).BodyPadding(15).Width(300).Hidden(true)
        .Items(
            F.SimpleForm().ID("SimpleForm1").ShowBorder(false).ShowHeader(false).Layout(LayoutType.VBox).MessageTarget(MessageTarget.None)
                .Items(
                    F.TextBox().ID("tbxUserName").Label("用户名").ShowLabel(false).EmptyText("请输入用户名").Required(true),
                    F.TextBox().ID("tbxPassword").Label("密码").ShowLabel(false).TextMode(TextMode.Password).EmptyText("请输入密码").Required(true),
                    F.Button().ID("btnLogin").Text("登录").Type(ButtonType.Submit).BoxFlex(1).ValidateForms("Window1").ValidateMessageBoxPlain(true).OnClick(Url.Action("btnLogin_Click"), "SimpleForm1")
                )
        )
    )

}


@section script {

    <script>

        function onCancelClick() {
            F.ui.Window1.hide();
        }

        function onOpenWindowClick(event) {
            F.ui.Window1.show();
        }

    </script>

}