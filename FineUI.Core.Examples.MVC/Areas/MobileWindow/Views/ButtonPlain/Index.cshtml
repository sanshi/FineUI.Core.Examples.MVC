@{
    ViewBag.Title = "MobileWindow/ButtonPlain";
    ViewBag.BodyBGColor = false;
    var F = Html.F();
}


@section body {

    @(F.Panel().ID("Panel1").ShowBorder(false).ShowHeader(false).Layout(LayoutType.VBox).BoxConfigSpace(5).BodyPadding(10).IsViewPort(true)
        .Items(
            F.Button().ID("btnOpenWindow").Text("打开登录窗体").ClickHandler("onOpenWindowClick")
        )
    )

    @(F.Window().ID("Window1").Title("登录窗体").IsModal(true).EnableClose(false).Layout(LayoutType.Fit).BodyPadding(15).Width(300).Hidden(true)
        .Items(
            F.SimpleForm().ID("SimpleForm1").ShowBorder(false).ShowHeader(false).Layout(LayoutType.VBox).MessageTarget(MessageTarget.None)
                .Items(
                    F.TextBox().ID("tbxUserName").Label("用户名").ShowLabel(false).EmptyText("请输入用户名").Required(true),
                    F.TextBox().ID("tbxPassword").Label("密码").ShowLabel(false).TextMode(TextMode.Password).EmptyText("请输入密码").Required(true)
                )
        )
        .Toolbars(
            F.Toolbar().ID("Toolbar1").CssClass("f-toolbar-buttonplain").Position(ToolbarPosition.Bottom).Layout(LayoutType.Fit)
                .Items(
                    F.ButtonGroup().ID("ButtonGroup1").Layout(LayoutType.HBox)
                        .Items(
                            F.Button().ID("btnCancel").Text("取消").BoxFlex(1).ClickHandler("onCancelClick"),
                            F.Button().ID("btnLogin").Text("登录").Type(ButtonType.Submit).BoxFlex(1).ValidateForms("Window1").ValidateMessageBoxPlain(true).OnClick(Url.Action("btnLogin_Click"), "SimpleForm1")
                        )
                )
        )
    )

}


@section script {

    <script>

        function onCancelClick(event) {
            F.ui.Window1.hide();
        }

        function onOpenWindowClick(event) {
            F.ui.Window1.show();
        }

    </script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示移动窗体底部的简洁双按钮工具栏，用取消入口关闭不带关闭图标的窗体。</p>
    <h3><i class="f-iconfont f-iconfont-window" aria-hidden="true"></i>对照底部按钮并取消</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="btnOpenWindow" title="打开登录窗体">打开登录窗体</strong>。<br />结果：窗体出现，底部取消与登录等宽排列，标题栏不显示关闭图标。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnCancel" title="取消">取消</strong>。<br />结果：浏览器隐藏窗体，不提交登录；再次打开仍能继续使用。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>CssClass</code>（<strong class="example-control-reference" data-example-control="Toolbar1" title="工具栏">工具栏</strong>）：设为<code>f-toolbar-buttonplain</code>，底部工具栏使用 <code>f</code>-<code>toolbar</code>-<code>buttonplain</code> 简洁按钮样式。</li>
        <li><code>BoxFlex</code>（<strong class="example-control-reference" data-example-control="btnCancel" title="取消">取消</strong>、<strong class="example-control-reference" data-example-control="btnLogin" title="登录">登录</strong>）：设为<code>1</code>，底部两个按钮等分可用宽度。</li>
        <li><code>EnableClose</code>（<strong class="example-control-reference" data-example-control="Window1" title="登录窗体">登录窗体</strong>）：设为<code>false</code>，窗体设为 <code>false</code>，改由本页取消按钮关闭。</li>
    </ul>
</section>
}
