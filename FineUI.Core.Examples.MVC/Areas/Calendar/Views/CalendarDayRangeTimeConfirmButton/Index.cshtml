@{
    ViewBag.Title = "Calendar/CalendarDayRangeTimeConfirmButton";
    var F = Html.F();
}


@section body {

    @(F.Calendar().ID("Calendar1").DateFormatString(ViewBag.Calendar1DateFormatString)
        .RangeStartDate(ViewBag.Calendar1RangeStartDate).RangeEndDate(ViewBag.Calendar1RangeEndDate)
        .OnDateSelect(Url.Action("Calendar1_DateSelect"), Parameter.FromFunction("text", "getCalendar1TextPostbackValue"))
        .DisplayType(CalendarDisplayType.DayRange).ShowTime(true).ShowConfirmButton(true).ConfirmToSelect(true))

    <br>
    <br>

    @(F.Button().ID("Button1").OnClick(Url.Action("Button1_Click")).Text(ViewBag.Button1Text))
    <br>
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCalendar1TextPostbackValue() {
            return F.ui.Calendar1.getText();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示日期时间范围先暂存选择，点击<strong>确定</strong>后才提交当前值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择日期时间范围</h3>
        <ol>
            <li>
                依次将起点和终点选择为今天之后第<code>5</code>天<code>09</code>时<code>30</code>分到第<code>10</code>天<code>10</code>时<code>30</code>分。<br />
                结果：选择暂存在面板中；还没有执行选中事件，输入框或下方结果保持原值。
            </li>
            <li>
                点击面板中的<strong>确定</strong>。<br />
                结果：完成选择并触发选中事件。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ShowConfirmButton</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：显示面板中的<strong>确定</strong>按钮；是否延后提交选择由 <code>ConfirmToSelect</code> 控制。</li>
            <li><code>ConfirmToSelect</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：将当前选择暂存在面板中，点击<strong>确定</strong>后才提交当前值并触发选中事件。</li>
        </ul>
    </section>
}
