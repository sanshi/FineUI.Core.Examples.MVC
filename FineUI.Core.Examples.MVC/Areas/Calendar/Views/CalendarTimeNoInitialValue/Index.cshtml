@{
    ViewBag.Title = "Calendar/CalendarTimeNoInitialValue";
    var F = Html.F();
}


@section body {

    @(F.Calendar().ID("Calendar1").DateFormatString(ViewBag.Calendar1DateFormatString)
        @* .SelectedDate(ViewBag.Calendar1SelectedDate) *@
        .OnDateSelect(Url.Action("Calendar1_DateSelect"), Parameter.FromFunction("selectedDate", "getCalendar1SelectedDatePostbackValue")).ShowTime(true))
    <br>
    <br>

    @(F.Button().ID("Button1").OnClick(Url.Action("Button1_Click")).Text(ViewBag.Button1Text))
    <br>
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCalendar1SelectedDatePostbackValue() {
            return F.ui.Calendar1.getText();
        }

    </script>
}
