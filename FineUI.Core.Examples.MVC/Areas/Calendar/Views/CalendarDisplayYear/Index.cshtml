@{
    ViewBag.Title = "Calendar/CalendarDisplayYear";
    var F = Html.F();
}


@section body {

    @(F.Calendar().ID("Calendar1").DateFormatString(ViewBag.Calendar1DateFormatString).Text(ViewBag.Calendar1Text).DisplayType(CalendarDisplayType.Year).ShowTodayButton(false)
        .OnDateSelect(Url.Action("Calendar1_DateSelect"), Parameter.FromFunction("text", "getCalendar1TextPostbackValue")))
    <br>
    <br>

    @(F.Button().ID("Button1").OnClick(Url.Action("Button1_Click")).Text(ViewBag.Button1Text))
    <br>
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCalendar1TextPostbackValue() {
            return F.ui.Calendar1.getText();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在页面内直接只选择年份。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择年份</h3>
        <ul>
            <li>
                在面板中选择明年。<br />
                结果：面板高亮当前选择。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：控制选中值的文字格式；本页使用 <code>yyyy</code>。</li>
            <li><code>DisplayType</code>（<strong class="example-control-reference" data-example-control="Calendar1" title="日历">日历</strong>）：本页采用年份面板，一次选择一个值。</li>
        </ul>
    </section>
}
