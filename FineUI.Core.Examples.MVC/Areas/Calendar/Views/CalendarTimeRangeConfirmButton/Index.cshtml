@{
    ViewBag.Title = "Calendar/CalendarTimeRangeConfirmButton";
    var F = Html.F();
}


@section body {

    @(F.Calendar().ID("Calendar1").DateFormatString(ViewBag.Calendar1DateFormatString)
        .Text(ViewBag.Calendar1Text)
        .OnDateSelect(Url.Action("Calendar1_DateSelect"), Parameter.FromFunction("text", "getCalendar1TextPostbackValue"))
        .DisplayType(CalendarDisplayType.TimeRange).ShowConfirmButton(true).ConfirmToSelect(true))

    <br>
    <br>

    @(F.Button().ID("Button1").OnClick(Url.Action("Button1_Click")).Text(ViewBag.Button1Text))
    <br>
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCalendar1TextPostbackValue() {
            return F.ui.Calendar1.getText();
        }

    </script>
}
