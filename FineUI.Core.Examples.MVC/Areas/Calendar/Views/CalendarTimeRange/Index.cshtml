@{
    ViewBag.Title = "Calendar/CalendarTimeRange";
    var F = Html.F();
}


@section body {

    @(F.Calendar().ID("Calendar1").DateFormatString(ViewBag.Calendar1DateFormatString)
        .Text(ViewBag.Calendar1Text)
        .OnDateSelect(Url.Action("Calendar1_DateSelect"), Parameter.FromFunction("text", "getCalendar1TextPostbackValue"))
        .DisplayType(CalendarDisplayType.TimeRange))

    <br>
    <br>

    @(F.Button().ID("Button1").OnClick(Url.Action("Button1_Click")).Text(ViewBag.Button1Text))
    <br>
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCalendar1TextPostbackValue() {
            return F.ui.Calendar1.getText();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在页面内直接只选择时间范围，无需选择日期。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择时间范围</h3>
        <ul>
            <li>
                依次将起点和终点选择为09时30分到10时30分。<br />
                结果：面板高亮当前选择，范围显示起止两个值。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>：控制选中值的文字格式；本页使用 HH:mm:ss。</li>
            <li><code>DisplayType</code>：本页采用时间范围面板，选择起点和终点。</li>
        </ul>
    </section>
}
