@{
    ViewBag.Title = "Calendar/CalendarTimeRange";
    var F = Html.F();
}


@section body {

    @(F.Calendar().ID("Calendar1").DateFormatString(ViewBag.Calendar1DateFormatString)
        .Text(ViewBag.Calendar1Text)
        .OnDateSelect(Url.Action("Calendar1_DateSelect"), new Parameter("text", "F.ui.Calendar1.getText()"))
        .DisplayType(CalendarDisplayType.TimeRange))

    <br>
    <br>

    @(F.Button().ID("Button1").OnClick(Url.Action("Button1_Click")).Text(ViewBag.Button1Text))
    <br>
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}

