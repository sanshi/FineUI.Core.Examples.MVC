@{
    ViewBag.Title = "ThirdParty/IconFontOpenIconic";
    var F = Html.F();
}


@section head {

    <link rel="stylesheet" href="~/res/third-party/openiconic/fonts.css" />
}

@section body {

    @(F.Button().ID("btnIcon1").Text("图标在左侧").IconFontClass("oi oi-tags").CssClass("marginr")
    )

    @(F.Button().ID("btnIcon2").Text("图标在右侧").IconAlign(IconAlign.Right).IconFontClass("oi oi-star")
    )
    <br>
    <br>

    @(F.Button().ID("btnIcon3").Text("图标在上面").IconAlign(IconAlign.Top).IconFontClass("oi oi-cart").CssClass("marginr")
    )

    @(F.Button().ID("btnIcon4").Text("图标在下面").IconAlign(IconAlign.Bottom).IconFontClass("oi oi-cloud")
    )
    <br>
    <br>
    只有图片的按钮：
    <br>
    <br>

    @(F.Button().ID("Button1").IconFontClass("oi oi-share").CssClass("marginr")
    )

    @(F.Button().ID("Button2").IconFontClass("oi oi-key").CssClass("marginr")
    )

    @(F.Button().ID("Button7").IconFontClass("oi oi-lock-locked").CssClass("marginr")
    )

    @(F.Button().ID("Button8").IconFontClass("oi oi-trash").CssClass("marginr")
    )
    <br>
    <br>

    @(F.Panel().ID("Panel1").Width(500).Title("面板").Height(250).BodyPadding(10).EnableCollapse(true).IconFontClass("oi oi-list")
        .Items(
            F.Label().Text("面板内容")
        )
        .Tools(
            F.Tool().IconFontClass("oi oi-cog").ToolTip("设置").ClickHandler("onToolIconClick"),
            F.Tool().IconFontClass("oi oi-cloud-download").ToolTip("下载").ClickHandler("onToolIconClick")
        )
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Bottom).ToolbarAlign(ToolbarAlign.Right)
                .Items(
                    F.Button().ID("btnMenu").Text("操作").IconFontClass("oi oi-pencil")
                        .Menu(F.Menu()
                            .Items(
                                F.MenuButton().IconFontClass("oi oi-trash").Text("删除选中项"),
                                F.MenuButton().IconFontClass("oi oi-ban").Text("禁用选中项")
                            )
                        )
                )
        )
    )
    <br>

    @(F.Tree().ID("Tree1").Width(500).ShowHeader(true).Title("树控件").EnableCollapse(false)
        .Nodes(
            F.TreeNode().Text("中国").Expanded(true)
                .Nodes(
                    F.TreeNode().Text("河南省").Expanded(true)
                        .Nodes(
                            F.TreeNode().Text("驻马店市").Expanded(true).IconFontClass("oi oi-flag").NodeID("zhumadian")
                                .Nodes(
                                    F.TreeNode().Text("遂平县").IconFontClass("oi oi-tag").NodeID("suiping"),
                                    F.TreeNode().Text("西平县").IconFontClass("oi oi-book").NodeID("xiping")
                                ),
                            F.TreeNode().Text("漯河市").NodeID("luohe").IconFontClass("oi oi-bookmark")
                        ),
                    F.TreeNode().Text("安徽省").NodeID("anhui")
                )
        )
    )

    <br />
    <br />
    <a href="https://useiconic.com/open/" target="_blank">https://useiconic.com/open/</a>
}


@section script {

    <script>
        function onToolIconClick(event) {
            // 当前点击的图标字体
            var iconFontCls = this.iconFontCls;

            F.notify({
                message: '你点击了标题栏工具图标：' + iconFontCls,
                messageIconFontCls: iconFontCls,
                displayMilliseconds: 300000,
                positionX: 'center',
                positionY: 'center'
            });
        }
    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>接入 Open Iconic 图标字体，在按钮、工具、菜单和树节点中使用同一图标库。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照图标位置与来源</h3>
        <ul>
            <li>对照<strong class="example-control-reference" data-example-control="btnIcon1"
                    title="图标在左侧">图标在左侧</strong>等按钮中的图标方向，再打开操作菜单。<br />结果：按钮按左右上下配置排列图标；面板标题、工具和菜单复用本页图标库。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>IconFontClass</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：填写该字体库的 CSS
                类名，类名需与已经加载的样式一致。</li>
            <li><code>IconAlign</code>（<strong class="example-control-reference" data-example-control="btnIcon1" title="图标在左侧">图标在左侧</strong>）：为不同按钮指定
                Left、Right、Top、Bottom，对照图标与文字的相对位置。</li>
        </ul>
    </section>
}
