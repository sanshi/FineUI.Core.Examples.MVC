@{
    ViewBag.Title = "ThirdParty/IconFontIonicons";
    var F = Html.F();
}


@section head {

    <link rel="stylesheet" href="~/res/third-party/ionicons/fonts.css" />
}

@section body {

    @(F.Button().ID("btnIcon1").Text("图标在左侧").IconFontClass("ion ion-md-pricetags").CssClass("marginr")
    )

    @(F.Button().ID("btnIcon2").Text("图标在右侧").IconAlign(IconAlign.Right).IconFontClass("ion ion-md-star")
    )
    <br>
    <br>

    @(F.Button().ID("btnIcon3").Text("图标在上面").IconAlign(IconAlign.Top).IconFontClass("ion ion-md-cart").CssClass("marginr")
    )

    @(F.Button().ID("btnIcon4").Text("图标在下面").IconAlign(IconAlign.Bottom).IconFontClass("ion ion-md-cloud")
    )
    <br>
    <br>
    只有图片的按钮：
    <br>
    <br>

    @(F.Button().ID("Button1").IconFontClass("ion ion-md-share").CssClass("marginr")
    )

    @(F.Button().ID("Button2").IconFontClass("ion ion-md-key").CssClass("marginr")
    )

    @(F.Button().ID("Button7").IconFontClass("ion ion-md-lock").CssClass("marginr")
    )

    @(F.Button().ID("Button8").IconFontClass("ion ion-md-trash").CssClass("marginr")
    )
    <br>
    <br>

    @(F.Panel().ID("Panel1").Width(500).Title("面板").Height(250).BodyPadding(10).EnableCollapse(true).IconFontClass("ion ion-md-list")
        .Items(
            F.Label().Text("面板内容")
        )
        .Tools(
            F.Tool().IconFontClass("ion ion-md-cog").ToolTip("设置").ClickHandler("onToolIconClick"),
            F.Tool().IconFontClass("ion ion-md-cloud-download").ToolTip("下载").ClickHandler("onToolIconClick")
        )
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Bottom).ToolbarAlign(ToolbarAlign.Right)
                .Items(
                    F.Button().ID("btnMenu").Text("操作").IconFontClass("ion ion-md-create")
                        .Menu(F.Menu()
                            .Items(
                                F.MenuButton().IconFontClass("ion ion-md-trash").Text("删除选中项"),
                                F.MenuButton().IconFontClass("ion ion-md-hand").Text("禁用选中项")
                            )
                        )
                )
        )
    )
    <br>

    @(F.Tree().ID("Tree1").Width(500).ShowHeader(true).Title("树控件").EnableCollapse(false)
        .Nodes(
            F.TreeNode().Text("中国").Expanded(true)
                .Nodes(
                    F.TreeNode().Text("河南省").Expanded(true)
                        .Nodes(
                            F.TreeNode().Text("驻马店市").Expanded(true).IconFontClass("ion ion-md-flag").NodeID("zhumadian")
                                .Nodes(
                                    F.TreeNode().Text("遂平县").IconFontClass("ion ion-md-pricetag").NodeID("suiping"),
                                    F.TreeNode().Text("西平县").IconFontClass("ion ion-md-book").NodeID("xiping")
                                ),
                            F.TreeNode().Text("漯河市").NodeID("luohe").IconFontClass("ion ion-md-bookmark")
                        ),
                    F.TreeNode().Text("安徽省").NodeID("anhui")
                )
        )
    )

    <br />
    <br />
    <a href="https://ionicons.com/" target="_blank">https://ionicons.com/</a>

}


@section script {

    <script>
        function onToolIconClick(event) {
            // 当前点击的图标字体
            var iconFontCls = this.iconFontCls;

            F.notify({
                message: '你点击了标题栏工具图标：' + iconFontCls,
                messageIconFontCls: iconFontCls,
                displayMilliseconds: 300000,
                positionX: 'center',
                positionY: 'center'
            });
        }
    </script>

}