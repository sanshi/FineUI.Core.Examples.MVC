@{
    ViewBag.SourceFiles = "~/Areas/ThirdParty/Views/EChartsDynamicBar/IFrame.cshtml";
    ViewBag.Title = "ThirdParty/EChartsDynamicBar";
    var F = Html.F();
}


@section body {

    @(F.Panel().ID("Panel1").Title("当前生产销售情况").IsViewPort(true).ShowBorder(true).Margin(10).ShowHeader(false).EnableIFrame(true).IFrameUrl(Url.Content("~/ThirdParty/EChartsDynamicBar/IFrame"))
        .Toolbars(
            F.Toolbar().ID("Toolbar2")
                .Items(
                    F.RadioButtonList().ID("rblChartType").Label("选择图表类型").Width(280)
                        .Items(
                            F.RadioItem().Text("销售").Value("sales").Selected(true),
                            F.RadioItem().Text("产量").Value("output")
                        ).Listener("change", "onChartTypeChange")
                )
        )
    )


}


@section script {

    <script>

        function onChartTypeChange(event) {

            var chartType = this.getValue();
            var newUrl = F.resolveUrl('/ThirdParty/EChartsDynamicBar/IFrame?type=' + encodeURIComponent(chartType));

            F.ui.Panel1.setIFrameUrl(newUrl);
        }

    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>通过选项切换 IFrame 中的图表类型，演示动态加载第三方图表页面。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换图表类型</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="rblChartType" title="选择图表类型">选择图表类型</strong>选择另一种图表。<br />结果：浏览器更改<strong class="example-control-reference" data-example-control="Panel1" title="当前生产销售情况">当前生产销售情况</strong>的 IFrame 地址，重新加载对应图表页面。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableIFrame</code>（<strong class="example-control-reference" data-example-control="Panel1" title="当前生产销售情况">当前生产销售情况</strong>）：初始为 <code>true</code>，在窗体或面板中用 IFrame 加载独立页面。</li>
        <li><code>IFrameUrl</code>（<strong class="example-control-reference" data-example-control="Panel1" title="当前生产销售情况">当前生产销售情况</strong>）：指定 IFrame 实际加载的页面地址。</li>
        <li><code>iframeUrl</code>（<strong class="example-control-reference" data-example-control="Panel1" title="当前生产销售情况">当前生产销售情况</strong>）：图表类型变化后更新内嵌页面地址，具体绘图逻辑在子页面中。</li>
    </ul>
</section>
}
