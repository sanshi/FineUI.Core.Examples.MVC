@{
    ViewBag.Title = "DatePicker/DatePickerTimeConfirmButton";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("简单表单")
        .Items(
            F.DatePicker().Required(true).DateFormatString("yyyy-MM-dd HH:mm:ss").Label("开始日期").EmptyText("请选择开始日期").ID("DatePicker1").ShowRedStar(true).ShowTime(true).SelectedDate(DateTime.Now.AddDays(2)).ShowConfirmButton(true).ConfirmToSelect(true),
            F.DatePicker().ID("DatePicker2").Required(true).Readonly(false).CompareControl("DatePicker1").DateFormatString("yyyy-MM-dd HH:mm:ss").CompareOperator(Operator.GreaterThan).CompareMessage("结束日期应该大于开始日期").Label("结束日期").ShowRedStar(true).ShowTime(true),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false).ShowLabel(false))



}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示日期时间先暂存选择，点击<strong>确定</strong>后才提交当前值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择日期时间</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="DatePicker1" title="开始日期">开始日期</strong>字段右侧的下拉图标。<br />
                结果：显示本页日期时间面板，可同时调整时、分；输入框当前值仍可对照查看。
            </li>
            <li>
                在面板中选择今天之后第<code>5</code>天<code>09</code>时<code>30</code>分。<br />
                结果：选择暂存在面板中；还没有执行选中事件，输入框或下方结果保持原值。
            </li>
            <li>
                点击面板中的<strong>确定</strong>。<br />
                结果：提交临时选择，回填输入框并收起弹层。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：<strong class="example-control-reference" data-example-control="DatePicker1" title="开始日期">开始日期</strong>启用了 <code>ConfirmToSelect</code> 属性，点击确定按钮才会触发选择事件。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ShowConfirmButton</code>（<strong class="example-control-reference" data-example-control="DatePicker1" title="开始日期">开始日期</strong>）：显示面板中的<strong>确定</strong>按钮；是否延后提交选择由 <code>ConfirmToSelect</code> 控制。</li>
            <li><code>ConfirmToSelect</code>（<strong class="example-control-reference" data-example-control="DatePicker1" title="开始日期">开始日期</strong>）：将当前选择暂存在面板中，点击<strong>确定</strong>后才提交当前值并触发选中事件。</li>
        </ul>
    </section>
}
