@{
    ViewBag.Title = "DatePicker/DatePicker";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("简单表单")
        .Items(
            F.DatePicker().Required(true).DateFormatString("yyyy-MM-dd").Label("开始日期").EmptyText("请选择开始日期").ID("DatePicker1").ShowRedStar(true).SelectedDate(DateTime.Now.AddDays(2)),
            F.DatePicker().ID("DatePicker2").Required(true).Readonly(false).CompareControl("DatePicker1").DateFormatString("yyyy-MM-dd").CompareOperator(Operator.GreaterThan).CompareMessage("结束日期应该大于开始日期").Label("结束日期").ShowRedStar(true),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false).ShowLabel(false))


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示通过输入框弹出的面板选择日期。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择日期</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="DatePicker1" title="开始日期">开始日期</strong>字段右侧的下拉图标。<br />
                结果：显示本页日期面板；输入框当前值仍可对照查看。
            </li>
            <li>
                在面板中选择今天之后第<code>5</code>天。<br />
                结果：所选值回填输入框。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-send" aria-hidden="true"></i>验证并读取当前值</h3>
        <ol>
            <li>
                填写本页所有必填日期或时间，让结束值晚于开始值。<br />
                结果：满足必填和本页比较规则；结束值等于或早于开始值时，比较字段显示错误。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnSubmit" title="提交表单">提交表单</strong>。<br />
                结果：浏览器验证通过后回发，后台读取本页日期或时间值，更新结果标签。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="DatePicker1" title="开始日期">开始日期</strong>、<strong class="example-control-reference" data-example-control="DatePicker2" title="结束日期">结束日期</strong>）：控制选中值的文字格式；本页使用 <code>yyyy</code>-<code>MM</code>-<code>dd</code>。</li>
            <li><code>SelectedDate</code>（<strong class="example-control-reference" data-example-control="DatePicker1" title="开始日期">开始日期</strong>）：设置当前选中值，显示和高亮随当前值更新。</li>
            <li><code>CompareControl</code>（<strong class="example-control-reference" data-example-control="DatePicker2" title="结束日期">结束日期</strong>）：结束字段引用同组开始字段，校验时读取该字段当前值进行比较。</li>
            <li><code>CompareOperator</code>（<strong class="example-control-reference" data-example-control="DatePicker2" title="结束日期">结束日期</strong>）：本页要求结束值严格大于开始值；相等或更早时不能通过验证。</li>
            <li><code>Required</code>（<strong class="example-control-reference" data-example-control="DatePicker1" title="开始日期">开始日期</strong>、<strong class="example-control-reference" data-example-control="DatePicker2" title="结束日期">结束日期</strong>）：必填字段为空时阻止提交；范围字段需要起止两个值均有效。</li>
        </ul>
    </section>
}
