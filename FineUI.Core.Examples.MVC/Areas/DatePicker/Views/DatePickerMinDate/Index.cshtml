@{
    ViewBag.Title = "DatePicker/DatePickerMinDate";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("简单表单")
        .Items(
            F.DatePicker().Required(true).Label("日期").EmptyText("限制范围的日期").ID("DatePicker1").ShowRedStar(true).MinDate(DateTime.Now)
                .MaxDate(DateTime.Now.AddDays(10)),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), Parameter.FromFunction("date", "getDatePicker1DatePostbackValue"))
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false).ShowLabel(false))


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getDatePicker1DatePostbackValue() {
            return F.ui.DatePicker1.getText();
        }

    </script>
}
