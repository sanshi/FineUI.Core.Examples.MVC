@{
    ViewBag.Title = "DatePicker/DatePickerIndependentRangePanels";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("简单表单")
        .Items(
            F.DatePicker().Required(true).DateFormatString("yyyy-MM-dd")
                .Label("日期范围").EmptyText("请选择日期范围").ID("DatePicker1").ShowRedStar(true)
                .RangeStartDate(@ViewBag.DatePicker1RangeStartDate).RangeEndDate(@ViewBag.DatePicker1RangeEndDate)
                .DisplayType(CalendarDisplayType.DayRange).IndependentRangePanels(true),
            F.DatePicker().Required(true).DateFormatString("yyyy/MM")
                .Label("月份范围").EmptyText("请选择月份范围").ID("DatePicker2").ShowRedStar(true)
                .RangeStartDate(@ViewBag.DatePicker2RangeStartDate).RangeEndDate(@ViewBag.DatePicker2RangeEndDate)
                .DisplayType(CalendarDisplayType.MonthRange).IndependentRangePanels(true),
            F.DatePicker().Required(true).DateFormatString("yyyy")
                .Label("年份范围").EmptyText("请选择年份范围").ID("DatePicker3").ShowRedStar(true)
                .RangeStartDate(@ViewBag.DatePicker3RangeStartDate).RangeEndDate(@ViewBag.DatePicker3RangeEndDate)
                .DisplayType(CalendarDisplayType.YearRange).IndependentRangePanels(true),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false).ShowLabel(false))




}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示日期、月份和年份三个范围选择器的左右面板独立切换，便于选择跨度较大的区间。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>分别切换左右面板</h3>
        <ol>
            <li>
                分别在本页的范围面板中切换左侧月份或年份，再单独切换右侧。<br />
                结果：只改变所操作面板的位置，另一侧不被强制带到相邻月份；可以定位跨度较大的区间。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <div> 说明：设置 IndependentRangePanels=true 开启“范围面板独立切换”。范围选择时左右两个面板可各自独立切换年份/月份，互不联动，便于快速定位跨度较大的起止日期区间。 </div>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>IndependentRangePanels</code>：设为 true，左右面板分别切换年月，另一侧不被强制切到相邻月份。</li>
        </ul>
    </section>
}
