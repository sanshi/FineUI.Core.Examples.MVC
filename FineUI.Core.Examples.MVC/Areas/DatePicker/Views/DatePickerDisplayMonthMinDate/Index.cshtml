@{
    ViewBag.Title = "DatePicker/DatePickerDisplayMonthMinDate";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("简单表单")
        .Items(
            F.DatePicker().Required(true).DateFormatString("yyyy/MM").DisplayType(CalendarDisplayType.Month).ShowTodayButton(false).Label("开始年月").EmptyText("请选择开始年月").ID("DatePicker1").ShowRedStar(true).SelectedDate(@ViewBag.DatePicker1SelectedDate).MinDate(@ViewBag.DatePicker1MinDate).MaxDate(@ViewBag.DatePicker1MaxDate),
            F.DatePicker().ID("DatePicker2").Required(true).Readonly(false).CompareControl("DatePicker1").DateFormatString("yyyy/MM").DisplayType(CalendarDisplayType.Month).ShowTodayButton(false).CompareOperator(Operator.GreaterThan).CompareMessage("结束年月应该大于开始年月").Label("结束年月").ShowRedStar(true),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false).ShowLabel(false))


}
