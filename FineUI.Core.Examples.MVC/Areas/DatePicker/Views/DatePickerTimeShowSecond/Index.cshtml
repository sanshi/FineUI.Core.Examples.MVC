@{
    ViewBag.Title = "DatePicker/DatePickerTimeShowSecond";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("简单表单")
        .Items(
            F.DatePicker().Required(true).DateFormatString("yyyy-MM-dd HH:mm").Label("开始日期").EmptyText("请选择开始日期").ID("DatePicker1").ShowRedStar(true).ShowTime(true).SelectedDate(DateTime.Now.AddDays(2)).ShowSecond(false),
            F.DatePicker().ID("DatePicker2").Required(true).Readonly(false).CompareControl("DatePicker1").DateFormatString("yyyy-MM-dd HH:mm").CompareOperator(Operator.GreaterThan).CompareMessage("结束日期应该大于开始日期").Label("结束日期").ShowRedStar(true).ShowTime(true).ShowSecond(false),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false).ShowLabel(false))


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示选择日期时间时隐藏秒列，只显示和读取到分钟。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-time" aria-hidden="true"></i>只选择小时和分钟</h3>
        <ol>
            <li>
                展开日期选择面板，查看并选择小时和分钟。<br />
                结果：时间区域不显示秒列，所选日期时间的显示文字也不包含秒。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="DatePicker1" title="开始日期">开始日期</strong>、<strong class="example-control-reference" data-example-control="DatePicker2" title="结束日期">结束日期</strong>）：设为<code>yyyy-MM-dd HH:mm</code>，控制选中值的文字格式。</li>
            <li><code>ShowSecond</code>（<strong class="example-control-reference" data-example-control="DatePicker1" title="开始日期">开始日期</strong>、<strong class="example-control-reference" data-example-control="DatePicker2" title="结束日期">结束日期</strong>）：设为 <code>false</code>，时间面板只显示小时和分钟，不创建秒列；输出格式也不含秒。</li>
        </ul>
    </section>
}
