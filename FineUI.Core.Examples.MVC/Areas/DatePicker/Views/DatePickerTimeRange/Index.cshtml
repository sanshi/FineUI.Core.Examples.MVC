@{
    ViewBag.Title = "DatePicker/DatePickerTimeRange";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("简单表单")
        .Items(
            F.DatePicker().Required(true).DateFormatString("HH:mm:ss")
                .Label("时间范围").EmptyText("请选择时间范围").ID("DatePicker1").ShowRedStar(true)
                .Text(@ViewBag.DatePicker1Text)
                .DisplayType(CalendarDisplayType.TimeRange),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false).ShowLabel(false))


}
