@{
    ViewBag.Title = "DatePicker/DatePickerDayRangeMinDate";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("简单表单")
        .Items(
            F.DatePicker().Required(true).DateFormatString("yyyy/MM/dd")
                .Label("日期范围").EmptyText("请选择日期范围").ID("DatePicker1").ShowRedStar(true)
                .RangeStartDate(@ViewBag.DatePicker1RangeStartDate).RangeEndDate(@ViewBag.DatePicker1RangeEndDate)
                .MinDate(@ViewBag.DatePicker1MinDate).MaxDate(@ViewBag.DatePicker1MaxDate)
                .DisplayType(CalendarDisplayType.DayRange),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false).ShowLabel(false))


}
