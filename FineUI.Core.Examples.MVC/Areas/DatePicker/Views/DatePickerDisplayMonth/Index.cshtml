@{
    ViewBag.Title = "DatePicker/DatePickerDisplayMonth";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("简单表单")
        .Items(
            F.DatePicker().Required(true).DateFormatString("yyyy/MM").DisplayType(CalendarDisplayType.Month).ShowTodayButton(false).Label("开始年月").EmptyText("请选择开始年月").ID("DatePicker1").ShowRedStar(true).SelectedDate(DateTime.Now),
            F.DatePicker().ID("DatePicker2").Required(true).Readonly(false).CompareControl("DatePicker1").DateFormatString("yyyy/MM").DisplayType(CalendarDisplayType.Month).ShowTodayButton(false).CompareOperator(Operator.GreaterThan).CompareMessage("结束年月应该大于开始年月").Label("结束年月").ShowRedStar(true),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false).ShowLabel(false))


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示通过输入框弹出的面板只选择年月。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择年月</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="DatePicker1" title="开始年月">开始年月</strong>字段右侧的下拉图标。<br />
                结果：显示本页年月面板；输入框当前值仍可对照查看。
            </li>
            <li>
                在面板中选择下个月。<br />
                结果：所选值回填输入框。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="DatePicker1" title="开始年月">开始年月</strong>、<strong class="example-control-reference" data-example-control="DatePicker2" title="结束年月">结束年月</strong>）：初始为<code>yyyy/MM</code>，控制选中值的文字格式。</li>
            <li><code>DisplayType</code>（<strong class="example-control-reference" data-example-control="DatePicker1" title="开始年月">开始年月</strong>、<strong class="example-control-reference" data-example-control="DatePicker2" title="结束年月">结束年月</strong>）：本页采用年月面板，一次选择一个值。</li>
        </ul>
    </section>
}
