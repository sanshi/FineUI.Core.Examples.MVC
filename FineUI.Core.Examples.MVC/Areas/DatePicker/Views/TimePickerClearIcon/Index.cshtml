@{
    ViewBag.Title = "DatePicker/TimePickerClearIcon";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("简单表单")
        .Items(
            F.DatePicker().Required(true).EnableEdit(false).Label("日期").EmptyText("请选择日期").ID("DatePicker1").ShowRedStar(true).AutoShowClearIcon(true).SelectedDate(DateTime.Now),
            F.TimePicker().ID("TimePicker1").ShowRedStar(true).EnableEdit(false).Label("时间").Increment(30).MinTimeText("8:30").MaxTimeText("20:30").Required(true).EmptyText("请选择时间").AutoShowClearIcon(true).Text("09:30"),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false).ShowLabel(false))




}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示日期和时间字段的清空图标，清空后仍须重新选择才能通过必填验证。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-close" aria-hidden="true"></i>清空后重新选择</h3>
        <ol>
            <li>
                点击已有时间右侧的清空图标，再从下拉面板选择一个时间。<br />
                结果：原时间先被清空；重新选择后显示新时间，清空图标再次出现。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：本示例通过<code>EnableEdit</code>属性控制日期和时间选择器不可编辑。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>AutoShowClearIcon</code>（<strong class="example-control-reference" data-example-control="TimePicker1" title="时间">时间</strong>）：有值时显示清空图标；点击后清空字段并隐藏图标，必填规则继续生效。</li>
        </ul>
    </section>
}
