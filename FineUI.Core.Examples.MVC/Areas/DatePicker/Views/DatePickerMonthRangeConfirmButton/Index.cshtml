@{
    ViewBag.Title = "DatePicker/DatePickerMonthRangeConfirmButton";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("简单表单")
        .Items(
            F.DatePicker().Required(true).DateFormatString("yyyy/MM")
                .Label("月份范围").EmptyText("请选择月份范围").ID("DatePicker1").ShowRedStar(true)
                .RangeStartDate(@ViewBag.DatePicker1RangeStartDate).RangeEndDate(@ViewBag.DatePicker1RangeEndDate)
                .MinDate(@ViewBag.DatePicker1MinDate).MaxDate(@ViewBag.DatePicker1MaxDate)
                .DisplayType(CalendarDisplayType.MonthRange).ShowConfirmButton(true).ConfirmToSelect(true),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false).ShowLabel(false))


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示年月范围先暂存选择，点击<strong>确定</strong>后才提交当前值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-calendar" aria-hidden="true"></i>选择年月范围</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="DatePicker1" title="月份范围">月份范围</strong>字段右侧的下拉图标。<br />
                结果：显示本页年月范围面板；输入框当前值仍可对照查看。
            </li>
            <li>
                依次将起点和终点选择为当前月份之后第<code>1</code>个月到第<code>2</code>个月。<br />
                结果：选择暂存在面板中；还没有执行选中事件，输入框或下方结果保持原值。
            </li>
            <li>
                点击面板中的<strong>确定</strong>。<br />
                结果：提交临时选择，回填输入框并收起弹层。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ShowConfirmButton</code>（<strong class="example-control-reference" data-example-control="DatePicker1"
                    title="月份范围">月份范围</strong>）：显示面板中的<strong>确定</strong>按钮；是否延后提交选择由 <code>ConfirmToSelect</code> 控制。</li>
            <li><code>ConfirmToSelect</code>（<strong class="example-control-reference" data-example-control="DatePicker1"
                    title="月份范围">月份范围</strong>）：将当前选择暂存在面板中，点击<strong>确定</strong>后才提交当前值并触发选中事件。</li>
        </ul>
    </section>
}
