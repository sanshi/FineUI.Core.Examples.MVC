@{
    ViewBag.Title = "DropDownList/ShengShiXian";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("中国省市县联动")
        .Items(
            F.DropDownList().ID("ddlSheng").Label("省份").ShowRedStar(true).CompareType(CompareType.String).CompareValue("-1").CompareOperator(Operator.NotEqual).CompareMessage("请选择省份！").OnSelectedIndexChanged(Url.Action("ddlSheng_SelectedIndexChanged"), "SimpleForm1").Items(ViewBag.ShengItems),
            F.DropDownList().ID("ddlShi").Label("地区市").ShowRedStar(true).CompareType(CompareType.String).CompareValue("-1").CompareOperator(Operator.NotEqual).CompareMessage("请选择地区市！").OnSelectedIndexChanged(Url.Action("ddlShi_SelectedIndexChanged"), "SimpleForm1").Enabled(false)
                .Items(
                    F.ListItem().Text("选择地区市").Value("-1")
                ),
            F.DropDownList().ID("ddlXian").ShowRedStar(true).CompareType(CompareType.String).CompareValue("-1").CompareOperator(Operator.NotEqual).CompareMessage("请选择县区市！").Label("县区市").Enabled(false)
                .Items(
                    F.ListItem().Text("选择县区市").Value("-1")
                ),
            F.Button().ID("btnSubmit").Text("获取选中的省市县").ValidateForms("SimpleForm1").ValidateTarget(Target.Top).OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false).ShowLabel(false).CssStyle("font-weight:bold;"))
    <br>


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>从省份逐级加载<strong class="example-control-reference" data-example-control="ddlShi" title="地区市">地区市</strong>和县区，切换上级后重置下级选择。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>逐级选择地区</h3>
        <ol>
            <li>
                先选择省份“安徽”。<br />
                结果：<strong class="example-control-reference" data-example-control="ddlShi" title="地区市">地区市</strong>列表加载安徽的数据并变为可选；原来的下级选择被清除。
            </li>
            <li>
                选择<code>合肥市</code>，再选择<code>包河区</code>，点击提交按钮。<br />
                结果：结果显示“您选择的省市县：安徽 | 合肥市 | 包河区”。
            </li>
            <li>
                切换到另一个省份。<br />
                结果：<strong class="example-control-reference" data-example-control="ddlShi" title="地区市">地区市</strong>和县区按新省份重新加载，不再保留安徽的下级选择。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>OnSelectedIndexChanged</code>（<strong class="example-control-reference" data-example-control="ddlSheng" title="省份">省份</strong>、<strong
                    class="example-control-reference" data-example-control="ddlShi" title="地区市">地区市</strong>）：上级选择改变后回发，后台重新加载下级选项，并切换下级可用状态。</li>
        </ul>
    </section>
}
