@{
    ViewBag.Title = "DropDownList/NoForceSelectionEmpty";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉列表（用户输入值，初始值，下拉选项为空）").ShowHeader(true)
        .Items(
            F.DropDownList().ID("DropDownList1").EnableEdit(true).AutoSelectFirstItem(false).ForceSelection(false).Text("初始自定义值"),
            F.Button().ID("btnRebindData").Text("重新绑定数据").OnClick(Url.Action("btnRebindData_Click"), Parameter.FromFunction("dataLength", "getDropDownList1DataLengthPostbackValue")).CssClass("marginr"),
            F.Button().ID("btnSetText").Text("更新为[用户输入值]").OnClick(Url.Action("btnSetText_Click")).CssClass("marginr"),
            F.Button().ID("btnGetSelection").Text("获取此下拉列表的选中项").OnClick(Url.Action("btnGetSelection_Click"), "DropDownList1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))
    <br>
    下拉列表的属性设置为：
    <ul>
        <li>AutoSelectFirstItem="false"：初始不强制选中第一项</li>
        <li>EnableEdit="true"：可以手工编辑</li>
        <li>ForceSelection="false"：用户输入值</li>
    </ul>


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getDropDownList1DataLengthPostbackValue() {
            return F.ui.DropDownList1.data.length;
        }

    </script>
}
