@{
    ViewBag.Title = "DropDownList/DataBindSimpleList";
    var F = Html.F();
}


@section body {


    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉列表（绑定到简单列表）").ShowHeader(true)
        .Items(
            F.DropDownList().ID("DropDownList1").DataSource(ViewBag.DropDownList1DataSource),
            F.Button().ID("btnSelectItem6").Text("选中[可选项6]").OnClick(Url.Action("btnSelectItem6_Click")).CssClass("marginr"),
            F.Button().ID("btnGetSelection").Text("获取此下拉列表的选中项").OnClick(Url.Action("btnGetSelection_Click"), "DropDownList1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))
    <br>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示将简单列表转换为下拉选项。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>对照绑定后的选项</h3>
        <ol>
            <li>
                展开<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>，查看本页加载的选项。<br />
                结果：选项来自本页数据源；显示文字和业务值按本页的绑定方式生成。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataSource</code>（<strong class="example-control-reference" data-example-control="DropDownList1"
                    title="下拉列表">下拉列表</strong>）：提供本页绑定的数据集合，绑定后生成选项。</li>
        </ul>
    </section>
}
