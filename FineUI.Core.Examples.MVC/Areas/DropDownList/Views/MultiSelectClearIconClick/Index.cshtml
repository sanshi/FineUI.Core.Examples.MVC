@{
    ViewBag.Title = "DropDownList/MultiSelectClearIconClick";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉列表（多选）").ShowHeader(true)
        .Items(
            F.DropDownList().ID("DropDownList1").EnableMultiSelect(true).AutoShowClearIcon(true).OnClearIconClick(Url.Action("DropDownList1_ClearIconClick"))
                .Items(
                    F.ListItem().Text("可选项1").Value("Value1").Selected(true),
                    F.ListItem().Text("可选项2（不可选择）").Value("Value2").EnableSelect(false),
                    F.ListItem().Text("可选项3（不可选择）").Value("Value3").EnableSelect(false),
                    F.ListItem().Text("可选项4").Value("Value4").Selected(true),
                    F.ListItem().Text("可选项5").Value("Value5"),
                    F.ListItem().Text("可选项6").Value("Value6"),
                    F.ListItem().Text("可选择项7").Value("Value7"),
                    F.ListItem().Text("可选择项8").Value("Value8"),
                    F.ListItem().Text("可选择项9").Value("Value9"),
                    F.ListItem().Text("普通型1 < L > 1.5").Value("普通型1 < L > 1.5")
                ),
            F.Button().ID("btnSelectItem6").Text("选中[可选项6]").OnClick(Url.Action("btnSelectItem6_Click")).CssClass("marginr"),
            F.Button().ID("btnGetSelection").Text("获取此下拉列表的选中项").OnClick(Url.Action("btnGetSelection_Click"), "DropDownList1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))








}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示用清空图标一次移除全部已选内容，并处理清空事件。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>清空全部选择</h3>
        <ol>
            <li>
                先点击<strong class="example-control-reference" data-example-control="btnSelectItem6" title="选中[可选项6]">选中[可选项6]</strong>，再点击输入框的清空图标。<br />
                结果：全部选中值被清除，清空图标隐藏；后台清空事件显示“你点击了清空图标”。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>AutoShowClearIcon</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：有内容时显示清空图标。 本页声明值为 <code>true</code>。</li>
            <li><code>OnClearIconClick</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：点击清空图标后请求后台处理。</li>
        </ul>
    </section>
}
