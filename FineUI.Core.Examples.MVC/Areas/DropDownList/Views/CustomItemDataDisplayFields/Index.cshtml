@{
    ViewBag.Title = "DropDownList/CustomItemDataDisplayFields";
    var F = Html.F();
}

@section head {

    <style>
        .item-text {
            margin-bottom: 5px;
            font-weight: bold;
        }

        .item-desc {
            font-size: 0.9em;
            word-break: break-all;
        }
    </style>

}

@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("自定义列表项（DataDisplayFields）").ShowHeader(true)
        .Items(
            F.DropDownList().ID("DropDownList1").DataTextField("Name").DataValueField("Id").DataDisplayFields("Name", "Desc").DataDisplayFormatString("<div class=\"item-text\">{0}</div><div class=\"item-desc\">{1}</div>")
                .DataSource(DataSourceUtil.GetDataTable()),
            F.Button().ID("btnGetSelection").Text("获取此下拉列表的选中项").OnClick(Url.Action("btnGetSelection_Click"), "DropDownList1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))
    <br>


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>用模板或逐项处理自定义人员选项外观，选中后只显示姓名并提交人员标识。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>区分选项模板和选中文字</h3>
        <ol>
            <li>
                展开面板选择“张萍萍”这一项。<br />
                结果：面板可同时显示姓名、描述等模板内容；选中后输入区使用姓名，业务值为 101。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataDisplayFields</code>：把额外数据字段提供给选项显示模板。</li>
            <li><code>DataDisplayFormatString</code>：自定义下拉面板内选项的显示内容。 本页声明值为 &lt;div class=\&quot;item-text\&quot;&gt;{0}&lt;/div&gt;&lt;div class=\&quot;item-desc\&quot;&gt;{1}&lt;/div&gt;。</li>
            <li><code>DataTextField</code>：从指定字段取得选中后显示的文字。 本页声明值为 Name。</li>
        </ul>
    </section>
}
