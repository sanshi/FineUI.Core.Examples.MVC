@{
    ViewBag.Title = "DropDownList/MultiSelectTagsNoForceSelectionInitValue";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉列表（多选，可编辑，用户输入值）").ShowHeader(true)
        .Items(
            F.DropDownList().ID("DropDownList1").EnableMultiSelect(true).EnableEdit(true).ForceSelection(false)
                .MultiSelectMode(MultiSelectMode.Tags).MultiSelectMode(MultiSelectMode.Tags)
                .Text(ViewBag.DropDownList1Text).SelectedValueArray(ViewBag.DropDownList1SelectedValueArray)
                .Items(
                    F.ListItem().Text("可选项1").Value("Value1").Selected(true),
                    F.ListItem().Text("可选项2（不可选择）").Value("Value2").EnableSelect(false),
                    F.ListItem().Text("可选项3（不可选择）").Value("Value3").EnableSelect(false),
                    F.ListItem().Text("可选项4").Value("Value4").Selected(true),
                    F.ListItem().Text("可选项5").Value("Value5"),
                    F.ListItem().Text("可选项6").Value("Value6"),
                    F.ListItem().Text("可选择项7").Value("Value7"),
                    F.ListItem().Text("可选择项8").Value("Value8"),
                    F.ListItem().Text("可选择项9").Value("Value9"),
                    F.ListItem().Text("普通型1 < L > 1.5").Value("普通型1 < L > 1.5")
                ),
            F.Button().ID("btnSelectItem6").Text("选中[可选项6]").OnClick(Url.Action("btnSelectItem6_Click")).CssClass("marginr"),
            F.Button().ID("btnGetSelection").Text("获取此下拉列表的选中项").OnClick(Url.Action("btnGetSelection_Click"), "DropDownList1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))



}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在初次加载时显示列表之外的自定义文字，以及真实选项与自定义初值的组合。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>核对自定义初始文字</h3>
        <ol>
            <li>
                打开页面后查看输入区。<br />
                结果：初始显示<code>ViewBag.DropDownList1Text</code>，可保留不在现有列表中的文字。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>SelectedValueArray</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：后台用
                <code>UIHelper</code> 设置选择；读取当前值时由客户端作为请求参数提交。
            </li>
            <li><code>ForceSelection</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：为
                <code>false</code> 时允许保存列表之外的用户输入；为 <code>true</code> 时需要匹配现有选项。 本页声明值为 <code>false</code>。
            </li>
            <li><code>Text</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>）：提供本页的初始显示文字。</li>
        </ul>
    </section>
}
