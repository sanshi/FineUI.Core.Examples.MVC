@{
    ViewBag.Title = "DropDownList/EnableEditFilter";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉列表（可编辑，强制选择）").ShowHeader(true)
        .Items(
            F.DropDownList().ID("DropDownList1").EnableEdit(true).FilterFunction("filterDropDownList1")
                .Items(
                    F.ListItem().Text("可选项1").Value("Value1").Selected(true),
                    F.ListItem().Text("可选项2（不可选择）").Value("Value2").EnableSelect(false),
                    F.ListItem().Text("可选项3（不可选择）").Value("Value3").EnableSelect(false),
                    F.ListItem().Text("可选项4").Value("Value4"),
                    F.ListItem().Text("可选项5").Value("Value5"),
                    F.ListItem().Text("可选项6").Value("Value6"),
                    F.ListItem().Text("选择项7").Value("Value7"),
                    F.ListItem().Text("选择项8").Value("Value8"),
                    F.ListItem().Text("选择项9").Value("Value9"),
                    F.ListItem().Text("普通型1 < L > 1.5").Value("普通型1 < L > 1.5")
                ),
            F.Button().ID("btnSelectItem6").Text("选中[可选项6]").OnClick(Url.Action("btnSelectItem6_Click")).CssClass("marginr"),
            F.Button().ID("btnGetSelection").Text("获取此下拉列表的选中项").OnClick(Url.Action("btnGetSelection_Click"), "DropDownList1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))




}


@section script {
    <script>

        function filterDropDownList1(filterText, listItemText) {
            // 返回false则排除当前列表项
            if (!F.startsWith(filterText.toLowerCase(), listItemText.toLowerCase())) {
                return false;
            }
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示用自定义过滤函数改变输入文字与列表项的匹配方式。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>使用自定义过滤</h3>
        <ol>
            <li>
                清空输入文字，再输入“可选项5”。<br />
                结果：下拉面板只保留匹配第五项的结果，不匹配的第一项被隐藏。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：用户输入文本时，会从第一个字符开始匹配（尝试输入字符：选）。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>FilterFunction</code>：按本页函数返回的结果过滤下拉项。 本页声明值为 filterDropDownList1。</li>
        </ul>
    </section>
}
