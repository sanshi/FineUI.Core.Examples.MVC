        .Items(
            F.SimpleForm().ID("SimpleForm1").BodyPadding(10).Width(400).ShowBorder(true).Title("下拉列表（MatchFieldWidth）").ShowHeader(true)
                .Items(
                    F.DropDownList().ID("DropDownList1").MatchFieldWidth(false)
                        .Items(
