@{
    ViewBag.Title = "GridTree/CheckBoxHideSome";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("树表格").DataIDField("Id").DataTextField("Name").EnableTree(true).TreeColumn("Name").DataIDField("Id").DataParentIDField("ParentId").TreeCheckBox(true)
        .Columns(
            F.RowNumberField(),
            F.RenderField().ColumnID("Name").ExpandUnusedSpace(true).MinWidth(150).DataField("Name").HeaderText("名称"),
            F.RenderField().Width(150).DataField("Type").HeaderText("类型"),
            F.RenderField().Width(150).DataField("Size").HeaderText("大小"),
            F.RenderField().Width(150).DataField("ModifyDate").HeaderText("修改日期").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        )
        .DataSource(DataSourceUtil.GetTreeDataTable()).RowDataBoundFunction("onGrid1RowDataBound")

    )
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick").MarginRight(5))
    @(F.Button().ID("btnGetCheckedValues").Text("获取选中的复选框").OnClick(Url.Action("btnGetCheckedValues_Click"), Parameter.FromFunction("checkedRows", "getCurrentControlCheckedRowsPostbackValue")))

    <br />
    <br />
    @(F.Label().ID("labResult").EncodeText(false))

    <br />
    <br />

}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlCheckedRowsPostbackValue() {
            return getCheckedRows();
        }

    </script>


    <script src="~/res/js/grid.js"></script>

    <script>
        function getCheckedRows() {
            var result = [];

            var checkedRows = F.ui.Grid1.getCheckedRows(true);
            if (checkedRows.length) {
                $.each(checkedRows, function (index, row) {
                    result.push({
                        id: row.id,
                        text: row.text
                    });
                });
            }

            return F.toJSON(result);
        }

        function onGrid1RowDataBound(rowData) {
            var rowId = rowData.id;

            if (rowId == "50" || rowId == "60") {
                rowData.checkbox = false;
            }
        }

    </script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>隐藏指定目录的树复选框，保留节点与其他操作。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>比较受限与普通节点</h3>
        <ol>
            <li>展开<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>的 basic、res
                等目录，尝试切换<strong>名称</strong>旁的树复选框。<br />结果：basic 与 res 的复选框不显示，但目录<strong>名称</strong>、展开入口及后代仍可查看。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnGetCheckedValues"
                    title="获取选中的复选框">获取选中的复选框</strong>。<br />结果：客户端读取已勾选树节点并交给后台，在结果区域显示标识与<strong>名称</strong>；没有勾选时显示对应提示。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：本树表格默认隐藏 [basic] 和 [res] 两个目录的复选框。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>rowData.checkbox</code>（<strong>行绑定处理</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="树表格">树表格</strong>）：本页为 basic 与 res 指定 false，只隐藏复选框，不删除节点。</li>
            <li><code>getCheckedRows</code>（<strong>读取勾选的页面脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="树表格">树表格</strong>）：读取树复选框结果，不使用 getSelectedRows 代替节点勾选。</li>
        </ul>
    </section>
}
