@{
    ViewBag.Title = "GridTree/GridTreeRowExpander";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("树表格").DataIDField("Id").DataTextField("Name").EnableTree(true).TreeColumn("Name").DataIDField("Id").DataParentIDField("ParentId")
        .Columns(
            F.RowNumberField(),
            F.RenderField().ColumnID("Name").ExpandUnusedSpace(true).MinWidth(150).DataField("Name").HeaderText("名称"),
            F.RenderField().Width(150).DataField("Type").HeaderText("类型"),
            F.RenderField().Width(150).DataField("Size").HeaderText("大小"),
            F.RenderField().Width(150).DataField("ModifyDate").HeaderText("修改日期").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd"),
            F.RenderField().RenderAsRowExpander(true).RendererFunction("renderExpander")
        )
        .DataSource(DataSourceUtil.GetTreeDataTable())

    )
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))

    <br />
    注：行扩展列和树表格同时存在时，需要禁用行扩展列的ExpandOnDblClick属性，以避免与树表格的双击展开节点功能冲突。
}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderExpander(value, params) {
            var rowData = params.rowData;
            return $('<div>').addClass('expander')
                .append($('<p>').html(`<strong>名称：</strong>${rowData.values['Name']}（${rowData.values['Type']}）`))
                .append($('<p>').html(`<strong>日期：</strong>${rowData.values['ModifyDate']}`));
        }

    </script>

}
