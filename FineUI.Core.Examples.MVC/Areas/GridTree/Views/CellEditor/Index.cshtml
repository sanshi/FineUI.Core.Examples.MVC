@{
    ViewBag.Title = "GridTree/CellEditor";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("树表格").DataIDField("Id").DataTextField("Name").EnableTree(true).TreeColumn("Name").DataIDField("Id").DataParentIDField("ParentId").AllowCellEditing(true).ClicksToEdit(1)
        .Columns(
            F.RowNumberField(),
            F.RenderField().ColumnID("Name").ExpandUnusedSpace(true).MinWidth(150).DataField("Name").HeaderText("名称")
                .Editor(
                    F.TextBox().ID("tbxName").Required(true)
                ),
            F.RenderField().ColumnID("Type").DataField("Type").HeaderText("类型").RendererFunction("renderType")
                .Editor(
                    F.DropDownList().ID("ddlType").Required(true)
                        .Items(
                            F.ListItem().Text("文件夹").Value("文件夹"),
                            F.ListItem().Text("CS文件").Value("CS文件"),
                            F.ListItem().Text("CONFIG文件").Value("CONFIG文件"),
                            F.ListItem().Text("ASPX文件").Value("ASPX文件"),
                            F.ListItem().Text("CSS文件").Value("CSS文件"),
                            F.ListItem().Text("PNG文件").Value("PNG文件"),
                            F.ListItem().Text("ICO文件").Value("ICO文件"),
                            F.ListItem().Text("GIF文件").Value("GIF文件"),
                            F.ListItem().Text("XML文件").Value("XML文件"),
                            F.ListItem().Text("ASHX文件").Value("ASHX文件")
                        )
                ),
            F.RenderField().ColumnID("Size").DataField("Size").HeaderText("大小").FieldType(FieldType.Int)
                .Editor(
                    F.NumberBox().ID("tbxSize").NoDecimal(true).NoNegative(true).MinValue(0)
                ),
            F.RenderField().Width(150).ColumnID("ModifyDate").DataField("ModifyDate").HeaderText("修改日期").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
                .Editor(
                    F.DatePicker().ID("DatePicker1").Required(true)
                )
        ).DataSource(ViewBag.Grid1DataSource).RowDataBoundFunction("onGrid1RowDataBound")

    )
    <br>

    @(F.Button().ID("btnSubmit").Text("保存数据").OnClick(Url.Action("btnSubmit_Click"), "Grid1"))

    <br>
    @(F.Label().ID("labResult").EncodeText(false))

    <br />
    <br />

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1RowDataBound(rowData) {
            var rowId = rowData.id;

            // 默认展开的节点
            if (rowId === '50' || rowId === '60') {
                rowData.expanded = true;
            }
        }


        function renderType(value) {
            return F.ui.ddlType.getTextByValue(value);
        }


    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在树表格中编辑节点名称、类型和大小，保存后保留父子层级。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>编辑后保留父子关系</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1"
                    title="树表格">树表格</strong>一个可编辑节点的<strong>名称</strong>，输入<code>新名称</code>，修改<strong>类型</strong>或<strong>大小</strong>后点击<strong
                    class="example-control-reference" data-example-control="btnSubmit"
                    title="保存数据">保存数据</strong>。<br />结果：后台按节点主键更新本轮修改并重新绑定，节点仍属于原父目录；不因改<strong>名称</strong>改变层级。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>AllowCellEditing</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：初始为
                <code>true</code>，让节点数据列采用对应编辑器，树形展示与数据编辑共同保留。
            </li>
            <li><code>DataParentIDField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：初始为
                <code>ParentId</code>，通过父节点标识维护层级；删除父节点时本页处理同时移除后代。
            </li>
        </ul>
    </section>
}
