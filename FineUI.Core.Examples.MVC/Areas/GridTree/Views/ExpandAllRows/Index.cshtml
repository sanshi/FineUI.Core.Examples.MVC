@{
    ViewBag.Title = "GridTree/ExpandAllRows";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("树表格").DataIDField("Id").DataTextField("Name").EnableTree(true).TreeColumn("Name").DataIDField("Id").DataParentIDField("ParentId").ExpandAllTreeNodes(true)
        .Columns(
            F.RowNumberField().EnableTreeNumber(true),
            F.RenderField().ColumnID("Name").ExpandUnusedSpace(true).MinWidth(150).DataField("Name").HeaderText("名称"),
            F.RenderField().Width(150).DataField("Type").HeaderText("类型"),
            F.RenderField().Width(150).DataField("Size").HeaderText("大小"),
            F.RenderField().Width(150).DataField("ModifyDate").HeaderText("修改日期").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        )
        .DataSource(DataSourceUtil.GetTreeDataTable())

    )
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))

    <br />
    <br />


}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>首次加载展开全部树节点，后续仍可单独折叠一个分支。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>核对初始展开范围</h3>
    <ul>
        <li>刚打开页面查看<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>目录与后代，再折叠、重新展开一个目录。<br />结果：全部后代初始可见；只折叠当前分支，不影响其他目录。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：通过设置ExpandAllTreeNodes属性，来展开树表格的全部节点。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>ExpandAllTreeNodes</code>（<strong class="example-control-reference" data-example-control="Grid1" title="树表格">树表格</strong>）：初始为 <code>true</code>，首次绑定时展开全部节点。</li>
    </ul>
</section>
}
