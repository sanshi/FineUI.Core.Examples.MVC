@{
    ViewBag.Title = "GridTree/CheckBoxField";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-cell.hidethis .f-grid-checkbox {
            display: none;
        }
    </style>

}

@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("树表格").DataIDField("Id").DataTextField("Name").EnableTree(true).TreeColumn("Name").DataIDField("Id").DataParentIDField("ParentId")
        .Columns(
            F.RowNumberField().EnableTreeNumber(true),
            F.RenderField().ColumnID("Name").ExpandUnusedSpace(true).MinWidth(150).DataField("Name").HeaderText("名称"),
            F.RenderField().Width(150).DataField("Type").HeaderText("类型"),
            F.RenderField().Width(150).DataField("Size").HeaderText("大小"),
            F.RenderCheckField().ColumnID("FollowFolder").RenderAsStaticField(false).HeaderText("关注目录").RendererFunction("renderFollowFolder"),
            F.RenderField().Width(150).DataField("ModifyDate").HeaderText("修改日期").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd")
        )
        .DataSource(DataSourceUtil.GetTreeDataTable())

    )
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))
    @(F.Button().ID("Button2").Text("关注的目录列表").ClickHandler("onNotifyCheckedFollowFolderClick"))

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderFollowFolder(value, params) {
            var rowData = params.rowData;

            // 类型
            var type = rowData.values.Type;
            if (type !== '文件夹') {
                params.cellCls = 'hidethis';
            }

            return value;
        }

        function onNotifyCheckedFollowFolderClick(event) {
            var grid1 = F.ui.Grid1;

            var rowEls = grid1.getRowEls();

            var result = ['<table class="result">'];
            result.push('<tr>');
            result.push('<th>行号</th>');
            result.push('<th>ID</th>');
            result.push('<th>名称</th>');
            result.push('</tr>');
            rowEls.each(function () {
                var cnode = $(this);
                var rowData = grid1.getRowData(cnode);
                var followFolderEl = cnode.find('.f-grid-cell-FollowFolder .f-grid-checkbox');
                var isChecked = followFolderEl.hasClass('f-checked');

                if (isChecked) {
                    result.push('<tr>');
                    result.push('<td>' + (rowData.index + 1) + '</td>');
                    result.push('<td>' + rowData.id + '</td>');
                    result.push('<td>' + rowData.text + '</td>');
                    result.push('</tr>');
                }
            });
            result.push('</table>');

            F.notify({
                message: F.rawHtml(result.join('')),
                target: '_top',
                header: false,
                messageIcon: '',
                positionX: 'center',
                positionY: 'top'
            });
        }

    </script>
}
