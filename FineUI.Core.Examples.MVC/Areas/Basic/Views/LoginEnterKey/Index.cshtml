@{
    ViewBag.Title = "Basic/LoginEnterKey";
    var F = Html.F();
}


@section body {



    @(F.Window().Width(350).WindowPosition(WindowPosition.GoldenSection).EnableClose(false).IsModal(false).Title("登录表单").ID("Window1")
        .Items(
            F.SimpleForm().ShowHeader(false).BodyPadding(10).RemoveLastFieldsMargin(true).ShowBorder(false).ID("SimpleForm1")
                .Items(
                    F.TextBox().NextFocusControl("tbxPassword").ShowRedStar(true).Required(true).Label("用户名").ID("tbxUserName"),
                    F.TextBox().NextClickControl("btnLogin").ShowRedStar(true).Required(true).TextMode(TextMode.Password).Label("密码").ID("tbxPassword")
                )
        )
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Bottom).ToolbarAlign(ToolbarAlign.Right).ID("Toolbar1")
                .Items(
                        F.Button().ButtonColor(ButtonColor.Primary).OnClick(Url.Action("btnLogin_Click"), "SimpleForm1").ValidateTarget(Target.Top).ValidateForms("SimpleForm1").Type(ButtonType.Button).Text("登录").ID("btnLogin"),
                    F.Button().Type(ButtonType.Reset).Text("重置").ID("btnReset")
                )
        )
    )
    <br>


}


@section exampleDescription {
<section aria-label="页面描述">
    <p>用回车键在用户名、密码和登录按钮之间衔接操作，区别于直接按回车提交整个表单。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>用回车逐步完成登录</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>输入 <code>admin</code>，按回车。<br />结果：焦点移到<strong class="example-control-reference" data-example-control="tbxPassword" title="密码">密码</strong>，此时不提交。</li>
        <li>在<strong class="example-control-reference" data-example-control="tbxPassword" title="密码">密码</strong>输入 <code>admin</code>，按回车。<br />结果：触发登录按钮；验证通过后回发，后台比对凭据并提示成功登录。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <div>
        用户名：admin
        <br />
        密码：admin
        <br />
        <br />
        <br />
        注意：在表单内按回车键会导航到下一个控件。
    </div>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>NextFocusControl</code>（<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>）：初始为 <code>tbxPassword</code>，在此字段按回车时，把焦点移到指定字段。</li>
        <li><code>NextClickControl</code>（<strong class="example-control-reference" data-example-control="tbxPassword" title="密码">密码</strong>）：初始为 <code>btnLogin</code>，在此字段按回车时，触发指定按钮。</li>
    </ul>
</section>
}
