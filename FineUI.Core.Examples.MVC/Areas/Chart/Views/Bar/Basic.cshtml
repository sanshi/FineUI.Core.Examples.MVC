@model object
@{
    ViewBag.Title = "基础柱状图";
    var F = Html.F();
}

@section body {
    @(F.Chart().ID("ChartBar").Height(550).DataCategoryField("Category")
        .Series("value", ChartSeriesType.Bar, "数值", "Value")
        .ShowTooltip(false)
        .DataSource(Model))


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>把分类和数值绑定为柱状图，以柱高比较各分类大小。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照基础柱状图</h3>
    <ul>
        <li>对照<strong class="example-control-reference" data-example-control="ChartBar" title="图表">图表</strong>中的分类、数值和形状。<br />结果：柱高表示各分类的数值，分类和数值沿用官网示例。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <a href="https://echarts.apache.org/examples/zh/editor.html?c=bar-simple" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>.DataCategoryField(&quot;Category&quot;)</code>（<strong class="example-control-reference" data-example-control="ChartBar" title="图表">图表</strong>）：从每行的 Category 字段读取横轴分类，例如 Mon。</li>
        <li><code>ChartSeriesType.Bar / .Series(&quot;value&quot;, ChartSeriesType.Bar, &quot;数值&quot;, &quot;Value&quot;)</code>（<strong class="example-control-reference" data-example-control="ChartBar" title="图表">图表</strong>）：在系列声明中选择柱状类型，最后一个参数 Value 指定柱高使用的数据字段。</li>
    </ul>
</section>
}
