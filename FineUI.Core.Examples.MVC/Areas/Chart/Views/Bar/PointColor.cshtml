@model object
@{
    ViewBag.Title = "单柱配色";
    var F = Html.F();
}

@section body {
    @(F.Chart().ID("ChartBarPointColor").Height(550).CategoryField("Category")
        .ShowTooltip(false)
        .Series(new ChartSeries
        {
            Key = "value",
            Type = ChartSeriesType.Bar,
            Name = "数值",
            ValueField = "Value",
            ColorField = "PointColor"
        })
        .DataSource(Model))
    <p>为星期二的数据行指定颜色，其余柱子沿用系列配色。<a href="https://echarts.apache.org/examples/zh/editor.html?c=bar-data-color" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>。</p>
}
