@model object
@{
    ViewBag.Title = "带背景色的柱状图";
    var F = Html.F();
}

@section body {
    @(F.Chart().ID("ChartBarBackground").Height(550).CategoryField("Category")
        .ShowTooltip(false)
        .Series(new ChartSeries
        {
            Key = "value",
            Type = ChartSeriesType.Bar,
            Name = "数值",
            ValueField = "Value",
            ShowBackground = true
        })
        .DataSource(Model))
    <p>每根柱子后方显示浅色背景，用来对照柱高。<a href="https://echarts.apache.org/examples/zh/editor.html?c=bar-background" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>。</p>
}
