@model object
@{
    ViewBag.Title = "阶梯折线图";
    var F = Html.F();
}

@section body {
    @(F.Chart().ID("ChartLineStep").Height(550).CategoryField("Category")
        .Title("Step Line")
        .TitleAlign(TextAlign.Left)
        .ShowLegend(true)
        .ShowSaveAsImage(true)
        .Series(new ChartSeries
        {
            Key = "start",
            Type = ChartSeriesType.Line,
            Name = "Step Start",
            ValueField = "AtStart",
            Step = "start"
        })
        .Series(new ChartSeries
        {
            Key = "middle",
            Type = ChartSeriesType.Line,
            Name = "Step Middle",
            ValueField = "AtMiddle",
            Step = "middle"
        })
        .Series(new ChartSeries
        {
            Key = "end",
            Type = ChartSeriesType.Line,
            Name = "Step End",
            ValueField = "AtEnd",
            Step = "end"
        })
        .DataSource(Model))
    <p>三条系列分别在前一个数据点、两点之间的中点和后一个数据点改变高度。<a href="https://echarts.apache.org/examples/zh/editor.html?c=line-step" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li>
                <code>Step = "start"</code>
                在前一个数据点的位置改变高度。
            </li>
            <li>
                <code>Step = "middle"</code>
                在两个相邻数据点的中间改变高度。
            </li>
            <li>
                <code>Step = "end"</code>
                到后一个数据点的位置才改变高度。
            </li>
        </ul>
    </section>
}
