@model object
@{
    ViewBag.Title = "堆叠折线图";
    var F = Html.F();
}

@section body {
    @(F.Chart().ID("ChartLineStacked").Height(550).DataCategoryField("Category")
        .Title("Stacked Line")
        .TitleAlign(TextAlign.Left)
        .ShowLegend(true)
        .CategoryBoundaryGap(false)
        .ShowSaveAsImage(true)
        .Series(new ChartSeries
        {
            Key = "email",
            Type = ChartSeriesType.Line,
            Name = "Email",
            DataValueField = "Email",
            Stack = "Total"
        })
        .Series(new ChartSeries
        {
            Key = "unionAds",
            Type = ChartSeriesType.Line,
            Name = "Union Ads",
            DataValueField = "UnionAds",
            Stack = "Total"
        })
        .Series(new ChartSeries
        {
            Key = "videoAds",
            Type = ChartSeriesType.Line,
            Name = "Video Ads",
            DataValueField = "VideoAds",
            Stack = "Total"
        })
        .Series(new ChartSeries
        {
            Key = "direct",
            Type = ChartSeriesType.Line,
            Name = "Direct",
            DataValueField = "Direct",
            Stack = "Total"
        })
        .Series(new ChartSeries
        {
            Key = "searchEngine",
            Type = ChartSeriesType.Line,
            Name = "Search Engine",
            DataValueField = "SearchEngine",
            Stack = "Total"
        })
        .DataSource(Model))


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>让同组折线按分类累计，同时保留各系列的原始提示值。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照堆叠折线图</h3>
    <ul>
        <li>对照<strong class="example-control-reference" data-example-control="ChartLineStacked" title="Stacked Line">Stacked Line</strong>中的分类、数值和形状。<br />结果：同组折线按分类累计。悬停可查看各来源的原始值，右上角可保存图片。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <a href="https://echarts.apache.org/examples/zh/editor.html?c=line-stack" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Stack </code>（<strong>图表系列</strong>，位于<strong class="example-control-reference" data-example-control="ChartLineStacked" title="Stacked Line">Stacked Line</strong>）：初始为 <code>Total</code>，同组折线按天累计，悬停提示仍显示各系列的原始值。</li>
        <li><code>.ShowSaveAsImage(true)</code>（<strong class="example-control-reference" data-example-control="ChartLineStacked" title="Stacked Line">Stacked Line</strong>）：在图表右上角显示保存图片按钮。</li>
    </ul>
</section>
}
