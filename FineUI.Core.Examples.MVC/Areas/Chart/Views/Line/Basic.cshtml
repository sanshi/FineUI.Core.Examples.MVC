@model object
@{
    ViewBag.Title = "基础折线图";
    var F = Html.F();
}

@section body {
    @(F.Chart().ID("ChartLine").Height(550).CategoryField("Category")
        .Series("value", ChartSeriesType.Line, "数值", "Value")
        .ShowTooltip(false)
        .DataSource(Model))
    <p>折线连接一周的七个数据点，分类和数值沿用官网示例。<a href="https://echarts.apache.org/examples/zh/editor.html?c=line-simple" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li>
                <code>ChartSeriesType.Line</code>
                按分类的顺序连接数值，显示一周内的变化。
            </li>
        </ul>
    </section>
}
