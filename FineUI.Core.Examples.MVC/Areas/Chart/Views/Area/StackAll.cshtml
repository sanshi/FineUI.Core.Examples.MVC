@model object
@{
    ViewBag.Title = "正负值堆叠面积图";
    var F = Html.F();
}

@section body {
    @(F.Chart().ID("ChartAreaStackAll").Height(550).DataCategoryField("Category")
        .ShowTooltip(false)
        .Series(new ChartSeries
        {
            Key = "baseline",
            Type = ChartSeriesType.Line,
            Name = "stack",
            DataValueField = "Baseline",
            Stack = "stack",
            StackStrategy = "all"
        })
        .Series(new ChartSeries
        {
            Key = "change",
            Type = ChartSeriesType.Area,
            Name = "stack",
            DataValueField = "Change",
            Stack = "stack",
            StackStrategy = "all"
        })
        .DataSource(Model))
    <p>面积系列绘制第二组数据叠加到基准折线后的结果，正负值可以相抵。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li>
                <code>Stack = "stack"</code>
                将基准折线和填充面积放入同一个堆叠组，面积系列在基准折线之后声明。
            </li>
            <li>
                <code>StackStrategy = "all"</code>
                允许异号值相加。第 4 类的基准值 −1 加上变动值 1，得到 0。默认同号堆叠下，第二个值会从零单独累计。
            </li>
        </ul>
    </section>
}
