@model object
@{
    ViewBag.Title = "基础面积图";
    var F = Html.F();
}

@section body {
    @(F.Chart().ID("ChartArea").Height(550).DataCategoryField("Category")
        .Series("value", ChartSeriesType.Area, "数值", "Value")
        .ShowTooltip(false).CategoryBoundaryGap(false)
        .DataSource(Model))
    <p>面积图填充折线下方区域，分类和数值沿用官网示例。<a href="https://echarts.apache.org/examples/zh/editor.html?c=area-basic" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li>
                <code>ChartSeriesType.Area</code>
                在折线下方填充区域。
            </li>
            <li>
                <code>.CategoryBoundaryGap(false)</code>
                首尾分类贴到绘图区边缘，使面积填充延伸到两侧。
            </li>
        </ul>
    </section>
}
