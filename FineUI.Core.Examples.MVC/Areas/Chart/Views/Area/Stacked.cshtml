@model object
@{
    ViewBag.Title = "堆叠面积图";
    var F = Html.F();
}

@section body {
    @(F.Chart().ID("ChartAreaStacked").Height(550).DataCategoryField("Category")
        .Title("Stacked Area Chart")
        .TitleAlign(TextAlign.Left)
        .ShowLegend(true)
        .CategoryBoundaryGap(false)
        .AxisPointerType("cross")
        .AxisPointerLabelColor("#6a7985")
        .ShowSaveAsImage(true)
        .Series(new ChartSeries
        {
            Key = "email",
            Type = ChartSeriesType.Area,
            Name = "Email",
            DataValueField = "Email",
            Stack = "Total",
            FocusSeries = true
        })
        .Series(new ChartSeries
        {
            Key = "unionAds",
            Type = ChartSeriesType.Area,
            Name = "Union Ads",
            DataValueField = "UnionAds",
            Stack = "Total",
            FocusSeries = true
        })
        .Series(new ChartSeries
        {
            Key = "videoAds",
            Type = ChartSeriesType.Area,
            Name = "Video Ads",
            DataValueField = "VideoAds",
            Stack = "Total",
            FocusSeries = true
        })
        .Series(new ChartSeries
        {
            Key = "direct",
            Type = ChartSeriesType.Area,
            Name = "Direct",
            DataValueField = "Direct",
            Stack = "Total",
            FocusSeries = true
        })
        .Series(new ChartSeries
        {
            Key = "searchEngine",
            Type = ChartSeriesType.Area,
            Name = "Search Engine",
            DataValueField = "SearchEngine",
            Stack = "Total",
            FocusSeries = true,
            ShowLabel = true
        })
        .DataSource(Model))
    <p>同组系列沿纵轴累计。指向数据点可查看对应分类，右上角按钮可保存图表。<a href="https://echarts.apache.org/examples/zh/editor.html?c=area-stack" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>。</p>
    <section aria-label="关键属性">
        <p><strong>关键属性</strong></p>
        <ul>
            <li>
                <code>Stack = "Total"</code>
                五个来源按同一天累计，每层面积表示一个来源。
            </li>
            <li>
                <code>.AxisPointerType("cross")</code>、<code>.AxisPointerLabelColor("#6a7985")</code>
                悬停时显示十字线，并设置轴上提示标签的背景色。
            </li>
            <li>
                <code>ShowLabel = true</code>
                只为最上层的 Search Engine 系列显示数值标签。标签显示原始值，例如 Mon 的 820。
            </li>
        </ul>
    </section>
}
