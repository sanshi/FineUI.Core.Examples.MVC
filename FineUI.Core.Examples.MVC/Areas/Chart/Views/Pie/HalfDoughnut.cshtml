@model object
@{
    ViewBag.Title = "半环形图";
    var F = Html.F();
}

@section body {
    @(F.Chart().ID("ChartPieHalfDoughnut").Height(550).DataCategoryField("Category")
        .ShowLegend(true)
        .LegendTop("5%")
        .PieRadius("40%,70%")
        .PieCenter("50%,70%")
        .PieStartAngle("180")
        .PieEndAngle("360")
        .Series("source", ChartSeriesType.Pie, "Access From", "Value")
        .DataSource(Model))


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>通过起止角度与圆心位置，把环形图限制在上半圆。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照半环形图</h3>
        <ul>
            <li>对照<strong class="example-control-reference" data-example-control="ChartPieHalfDoughnut" title="图表">图表</strong>中的分类、数值和形状。<br />结果：将起止角度设为 180° 和
                360°，在上半圆绘制各分类。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <a href="https://echarts.apache.org/examples/zh/editor.html?c=pie-half-donut" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>.PieStartAngle(&quot;180&quot;) / .PieEndAngle(&quot;360&quot;)</code>（<strong class="example-control-reference"
                    data-example-control="ChartPieHalfDoughnut" title="图表">图表</strong>）：将全部扇区限制在 180° 至 360°，绘制成上半环。</li>
            <li><code>.PieCenter(&quot;50%,70%&quot;)</code>（<strong class="example-control-reference" data-example-control="ChartPieHalfDoughnut"
                    title="图表">图表</strong>）：横向居中，并把圆心放到图表高度的 70% 处，给上半环留出空间。</li>
        </ul>
    </section>
}
