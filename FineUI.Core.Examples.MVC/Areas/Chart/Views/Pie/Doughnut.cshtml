@model object
@{
    ViewBag.Title = "环形图";
    var F = Html.F();
}

@section body {
    @(F.Chart().ID("ChartPieDoughnut").Height(550).DataCategoryField("Category")
        .ShowLegend(true)
        .LegendTop("5%")
        .PieRadius("40%,70%")
        .PieShowLabel(false)
        .PieLabelPosition("center")
        .PieEmphasisLabelSize(40)
        .PieEmphasisLabelFontWeight("bold")
        .Series("source", ChartSeriesType.Pie, "Access From", "Value")
        .DataSource(Model))


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>用内外半径形成环形，并在悬停时把分类名称显示在中央。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照环形图</h3>
    <ul>
        <li>将鼠标移到<strong class="example-control-reference" data-example-control="ChartPieDoughnut" title="图表">图表</strong>中的一个扇区。<br />结果：中央显示该分类名称，同时可对照本页内外半径、圆角或扇区间距。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <a href="https://echarts.apache.org/examples/zh/editor.html?c=pie-doughnut" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>.PieRadius(&quot;40%,70%&quot;)</code>（<strong class="example-control-reference" data-example-control="ChartPieDoughnut" title="图表">图表</strong>）：同时指定内外半径，圆心处留空形成环形。</li>
        <li><code>.LegendTop(&quot;5%&quot;)</code>（<strong class="example-control-reference" data-example-control="ChartPieDoughnut" title="图表">图表</strong>）：图例从距离图表顶部 5% 的位置开始显示。</li>
        <li><code>.PieShowLabel(false) / .PieLabelPosition(&quot;center&quot;)</code>（<strong class="example-control-reference" data-example-control="ChartPieDoughnut" title="图表">图表</strong>）：平时隐藏扇区标签和引导线，标签位置设在环形中央。</li>
        <li><code>.PieEmphasisLabelSize(40) / .PieEmphasisLabelFontWeight(&quot;bold&quot;)</code>（<strong class="example-control-reference" data-example-control="ChartPieDoughnut" title="图表">图表</strong>）：指向扇区时，以 40 像素粗体在中央显示该扇区的名称。</li>
    </ul>
</section>
}
