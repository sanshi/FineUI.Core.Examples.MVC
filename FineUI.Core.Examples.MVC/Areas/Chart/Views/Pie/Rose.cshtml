@model object
@{
    ViewBag.Title = "南丁格尔玫瑰图";
    var F = Html.F();
}

@section body {
    @(F.Chart().ID("ChartPieRose").Height(550).DataCategoryField("Category")
        .ShowTooltip(false)
        .PieRoseType("area")
        .PieRadius("50%")
        .Series("value", ChartSeriesType.Pie, "value", "Value")
        .DataSource(Model))


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>用相同角度、不同半径的扇区比较数值，形成南丁格尔玫瑰图。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照南丁格尔玫瑰图</h3>
    <ul>
        <li>对照<strong class="example-control-reference" data-example-control="ChartPieRose" title="图表">图表</strong>中的分类、数值和形状。<br />结果：五个扇区角度相同，数值较大的扇区向外伸得更远。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <a href="https://echarts.apache.org/handbook/zh/how-to/chart-types/pie/rose/" target="_blank" rel="noopener">查看 Apache ECharts 原始示例</a>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>.PieRoseType(&quot;area&quot;)</code>（<strong class="example-control-reference" data-example-control="ChartPieRose" title="图表">图表</strong>）：用等角扇区比较半径。若设为 radius，角度也会随数值变化。</li>
        <li><code>.PieRadius(&quot;50%&quot;)</code>（<strong class="example-control-reference" data-example-control="ChartPieRose" title="图表">图表</strong>）：外半径取容器短边的一半再乘以 50%，和原例的默认半径一致。</li>
    </ul>
</section>
}
