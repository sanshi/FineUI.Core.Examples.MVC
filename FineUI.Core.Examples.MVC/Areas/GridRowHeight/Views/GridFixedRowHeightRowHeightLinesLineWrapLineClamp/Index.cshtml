@{
    ViewBag.Title = "GridRowHeight/GridFixedRowHeightRowHeightLinesLineWrapLineClamp";
    var F = Html.F();
}



@section head {

    <style>
        /* 最多显示 3 行文字，超出则显示省略号 */
        .f-grid-row .f-grid-cell-text {
            white-space: normal;
            word-break: break-all;
            overflow: hidden;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            display: -webkit-box;
        }
    </style>

}




@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableCheckBoxSelect(true).FixedRowHeight(true).RowHeightLines(3)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("个人简介").ColumnID("Desc").DataField("Desc").Width(400),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd")
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>
    <br>


    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))

    <br />
    <br />
    手工设置行高时：
    <ul>
        <li>尽量将行高设置为默认行高的整数倍，防止文字换行时被部分遮挡的问题。</li>
        <li>使用 RowHeightLines 属性可以快速设置所有显示模式下的行高（容纳几行文字）。</li>
    </ul>
    <br />
    <br />
    <table class="result" style="width: 850px;">
        <tbody>
            <tr>
                <th></th>
                <th>默认行高（px）</th>
                <th>
                    设置的行高可以容纳 3 行文字<br />
                    RowHeightLines=3
                </th>
                <th>计算的行高（px）</th>
            </tr>
            <tr>
                <td>紧凑模式</td>
                <td>16</td>
                <td>-</td>
                <td>16 * 3 = 48</td>
            </tr>
            <tr>
                <td>小字体模式</td>
                <td>16</td>
                <td>-</td>
                <td>16 * 3 = 48</td>
            </tr>
            <tr>
                <td>普通模式</td>
                <td>20</td>
                <td>-</td>
                <td>20 * 3 = 60</td>
            </tr>
            <tr>
                <td>大间距模式</td>
                <td>24</td>
                <td>-</td>
                <td>24 * 3 = 72</td>
            </tr>
            <tr>
                <td>大字体模式</td>
                <td>24</td>
                <td>-</td>
                <td>24 * 3 = 72</td>
            </tr>
        </tbody>
    </table>
}


@section script {

    <script src="~/res/js/grid.js"></script>

}
