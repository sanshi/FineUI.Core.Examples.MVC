@{
    ViewBag.Title = "Window/Form";
    var F = Html.F();
}


@section body {

    @(F.Window().IsModal(false).Layout(LayoutType.Fit).BodyPadding(10).EnableResize(true).EnableMaximize(true).Title("窗体").Icon(Icon.TagBlue).Height(300).Width(650).ID("Window1")
        .Items(
            F.Form().Title("表单 1").ShowHeader(false).ShowBorder(false).LabelWidth(100).ID("Form2").BodyPadding(10)
                .Rows(
                    F.FormRow().ColumnWidths("50% 50%")
                        .Items(
                            F.Label().Text("标签的值").Label("标签").ID("Label1"),
                            F.CheckBox().Label("复选框").Text("复选框").ID("CheckBox1")
                        ),
                    F.FormRow().ColumnWidths("50% 50%")
                        .Items(
                            F.DropDownList().AutoSelectFirstItem(false).ShowRedStar(true).Required(true).Label("下拉列表").ID("DropDownList1")
                                .Items(
                                    F.ListItem().Value("Value1").Text("可选项1"),
                                    F.ListItem().EnableSelect(false).Value("Value2").Text("可选项2（不可选择）"),
                                    F.ListItem().EnableSelect(false).Value("Value3").Text("可选项3（不可选择）"),
                                    F.ListItem().Value("Value4").Text("可选项4"),
                                    F.ListItem().Value("Value5").Text("可选项5"),
                                    F.ListItem().Value("Value6").Text("可选项6"),
                                    F.ListItem().Value("Value7").Text("可选择项7"),
                                    F.ListItem().Value("Value8").Text("可选择项8")
                                ),
                            F.TextBox().Text("").Required(true).Label("文本框").ShowRedStar(true).ID("TextBox1")
                        )
                )
        )
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Top).ID("Toolbar3")
                .Items(
                    F.ToolbarText().ID("ToolbarText3").Text("工具条文本一"),
                    F.ToolbarSeparator().ID("ToolbarSeparator2"),
                    F.ToolbarText().ID("ToolbarText4").Text("工具条文本二"),
                    F.ToolbarSeparator().ID("ToolbarSeparator1"),
                    F.Button().ClickHandler("onToolbarButtonClick").Text("工具栏按钮").ID("Button1")
                ),
            F.Toolbar().ToolbarAlign(ToolbarAlign.Right).Position(ToolbarPosition.Bottom)
                .Items(
                    F.Button().OnClick(Url.Action("btnSubmit_Click"), "Form2").ID("btnSubmit").ValidateForms("Form2").Text("验证此表单并提交"),
                    F.Button().Text("关闭窗体").ClickHandler("onCloseWindow1Click").ID("btnClose")
                )
        )
    )
    <br>


}

@section script {

    <script type="text/javascript">

        function onToolbarButtonClick(event) {
            F.alert('你点击了工具栏按钮。');
        }

        function onCloseWindow1Click(event) {
            F.ui.Window1.hide();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>在窗体中容纳完整表单，并在窗体工具栏提交该表单的字段。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>只验证窗体中的表单</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="btnSubmit" title="验证此表单并提交">验证此表单并提交</strong>。<br />结果：必填下拉列表和文本框未填写时显示验证提示，窗体保持打开。</li>
        <li>为<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>选择可选项1，在<strong class="example-control-reference" data-example-control="TextBox1" title="文本框">文本框</strong>输入 <code>窗体表单测试</code>，再次提交。<br />结果：后台读取窗体表单当前字段，通知中显示提交内容。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>）：初始为 <code>LayoutType.Fit</code>，规定容器内子控件的排列和空间分配方式。</li>
        <li><code>ValidateForms</code>（<strong class="example-control-reference" data-example-control="btnSubmit" title="验证此表单并提交">验证此表单并提交</strong>）：初始为 <code>Form2</code>，提交前验证指定表单；验证失败时显示提示并阻止回发。</li>
        <li><code>Required</code>（<strong class="example-control-reference" data-example-control="DropDownList1" title="下拉列表">下拉列表</strong>、<strong class="example-control-reference" data-example-control="TextBox1" title="文本框">文本框</strong>）：初始为 <code>true</code>，要求先填写或选择该字段，未通过时阻止表单提交。</li>
    </ul>
</section>
}
