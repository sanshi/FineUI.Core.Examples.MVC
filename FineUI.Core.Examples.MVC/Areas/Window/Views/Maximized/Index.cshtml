@{
    ViewBag.Title = "Window/Maximized";
    var F = Html.F();
}


@section body {

    <div id="content1">



    </div>

    @(F.Button().Text("显示窗体（设置最大化）").ID("btnShowWindowMax").ClickHandler("onOpenWindowMaximizedClick"))
    <br>
    <br>

    @(F.Button().Text("显示窗体（设置大小为 900px * 450px）").ID("btnShowWindow900").ClickHandler("onOpenWindow900Click"))
    <br>
    <br>

    @*设置一个非常大的高度，这样无论外部页面的高度如何，弹出窗体的高度会占满整个页面（初始）*@
    @(F.Button().Text("显示窗体（高度占满整个页面）").ID("btnShowWindowLargeHeight").ClickHandler("onOpenWindowLargeHeightClick"))
    <br>
    <br>

    @(F.Button().Text("显示窗体（使用初始值）").ID("btnShowWindow").ClickHandler("onOpenWindow1Click"))
    <br>
    <br>

    @(F.Button().Text("关闭窗体").ID("btnCloseWindow").ClickHandler("onCloseWindow1Click"))
    <br>
    <br>
    <br>

    @(F.Window().Maximized(true).EnableMaximize(true).BodyPadding(10).AutoScroll(true).IsModal(false).EnableResize(true).Title("窗体").Icon(Icon.TagBlue).Height(300).Width(650).ID("Window1").ContentEl("#content1"))
    <br>


}

@section script {

    <script type="text/javascript">

        function onOpenWindowMaximizedClick(event) {
            F.ui.Window1.show();F.ui.Window1.maximize();
        }

        function onOpenWindow900Click(event) {
            F.ui.Window1.show(900,450);
        }

        function onOpenWindowLargeHeightClick(event) {
            F.ui.Window1.show(900,10000);
        }

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onCloseWindow1Click(event) {
            F.ui.Window1.hide();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>让窗体初次显示时最大化，并可通过标题工具还原。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-window" aria-hidden="true"></i>对照本页窗体效果</h3>
        <ul>
            <li>查看<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>。点击窗体标题栏的最大化或还原图标。<br />结果：窗体在最大化与初始尺寸之间切换。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Maximized</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>）：初始为
                <code>true</code>，控制窗体初次显示时是否最大化。
            </li>
            <li><code>EnableMaximize</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>）：初始为
                <code>true</code>，控制标题栏是否显示最大化与还原入口。
            </li>
        </ul>
    </section>
}
