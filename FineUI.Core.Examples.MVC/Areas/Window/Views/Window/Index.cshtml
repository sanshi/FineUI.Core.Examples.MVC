@{
    ViewBag.Title = "Window/Window";
    var F = Html.F();
}


@section body {

    <div id="content1">



    </div>


    @(F.Button().OnClick(Url.Action("btnShowInServer_Click")).Text("显示窗体（服务端代码）").CssClass("marginr").ID("btnShowInServer"))

    @(F.Button().OnClick(Url.Action("btnHideInServer_Click")).Text("隐藏窗体（服务端代码）").ID("btnHideInServer"))
    <br>
    <br>

    @(F.Button().Text("显示窗体（客户端代码）").CssClass("marginr").ID("btnShowInClient").ClickHandler("onOpenWindow1Click"))

    @(F.Button().Text("隐藏窗体（客户端代码）").CssClass("marginr").ID("btnHideInClient").ClickHandler("onCloseWindow1Click"))

    @(F.Button().Text("隐藏窗体，回发弹出窗体").ID("btnHideInClient2").ClickHandler("onCloseWindow1PostBackClick"))
    <br>
    <br>

    @(F.Window().BodyPadding(10).EnableCollapse(true).AutoScroll(true).OnClose(Url.Action("Window1_Close")).CloseAction(CloseAction.HidePostBack).IsModal(false).EnableResize(true).EnableMaximize(true).Title("窗体").Icon(Icon.TagBlue).Height(300).Width(650).ID("Window1").ContentEl("#content1").Listener("resize", "onWindowResize"))
    <br>
    <br>



}


@section script {

    <script>

        // Window窗体大小改变的客户端事件
        function onWindowResize(event) {
            var el = this.el;
            F.notify("窗体大小改变，宽度：" + el.width() + " 高度：" + el.height());
        }


        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onCloseWindow1Click(event) {
            F.ui.Window1.hide();
        }

        function onCloseWindow1PostBackClick(event) {
            F.ui.Window1.hidePostBack();
        }

    </script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>对照后台与客户端显示、隐藏窗体，并查看关闭回发与附加参数。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-window" aria-hidden="true"></i>显示与隐藏</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="btnShowInServer"
                    title="显示窗体（服务端代码）">显示窗体（服务端代码）</strong>。<br />结果：窗体显示。按钮先回发，由后台更新显示状态。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnHideInServer"
                    title="隐藏窗体（服务端代码）">隐藏窗体（服务端代码）</strong>。<br />结果：窗体隐藏。按钮先回发，由后台更新显示状态。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnShowInClient"
                    title="显示窗体（客户端代码）">显示窗体（客户端代码）</strong>。<br />结果：窗体显示。浏览器直接改变显示状态。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnHideInClient"
                    title="隐藏窗体（客户端代码）">隐藏窗体（客户端代码）</strong>。<br />结果：窗体隐藏。浏览器直接改变显示状态。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnHideInClient2"
                    title="隐藏窗体，回发弹出窗体">隐藏窗体，回发弹出窗体</strong>。<br />结果：窗体隐藏。浏览器直接改变显示状态。</li>
            <li>重新显示<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>，点击其标题栏关闭图标。<br />结果：窗体隐藏，并按关闭动作配置触发后台关闭事件。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul>
            <li>
                CloseAction 的默认值为 Hide，关闭窗体时不会触发 OnClose 事件；
            </li>
            <li>
                本示例设置了 CloseAction=HidePostBack，点击窗体关闭按钮或者按下ESC键时，会触发 OnClose 事件。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>CloseAction</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>）：初始为
                <code>CloseAction.HidePostBack</code>，指定关闭时仅隐藏还是同时触发关闭回发。
            </li>
            <li><code>IsModal</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>）：初始为
                <code>false</code>，显示窗体遮罩，限制对遮罩后方内容的操作。
            </li>
            <li><code>EnableResize</code>（<strong class="example-control-reference" data-example-control="Window1" title="窗体">窗体</strong>）：初始为
                <code>true</code>，控制是否允许拖动窗体边缘调整大小。
            </li>
        </ul>
    </section>
}
