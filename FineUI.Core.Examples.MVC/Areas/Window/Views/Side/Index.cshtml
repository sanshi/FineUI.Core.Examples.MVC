@{
    ViewBag.Title = "Window/Side";
    var F = Html.F();
}


@section head {

    <style>
        body {
            background: url(@Url.Content("~/res/images/bg/small/3.jpg")) !important;
            overflow: hidden;
        }
    </style>


}


@section body {

    @(F.Window().Hidden(true).EnableDefaultCorner(false).ShowHeader(false).BodyPadding(10).AutoScroll(true).HideOnMaskClick(true).IsModal(true).PercentHeight("100%").Width(200).PositionX(Position.Left).ID("Window1").Content("PositionX=Left Width=200px PercentHeight=100% IsModal=true HideOnMaskClick=true"))


    @(F.Window().Hidden(true).EnableDefaultCorner(false).ShowHeader(false).BodyPadding(10).AutoScroll(true).HideOnMaskClick(true).IsModal(true).PercentHeight("100%").Width(200).PositionX(Position.Right).ID("Window2").Content("PositionX=Right Width=200px PercentHeight=100% IsModal=true HideOnMaskClick=true"))


    @(F.Window().Hidden(true).EnableDefaultCorner(false).ShowHeader(false).BodyPadding(10).AutoScroll(true).HideOnMaskClick(true).IsModal(true).PercentWidth("100%").Height(100).PositionY(Position.Top).ID("Window3").Content("PositionY=Top Height=100px PercentWidth=100% IsModal=true HideOnMaskClick=true"))



    @(F.Window().Hidden(true).EnableDefaultCorner(false).ShowHeader(false).BodyPadding(10).AutoScroll(true).HideOnMaskClick(true).IsModal(true).PercentWidth("100%").Height(100).PositionY(Position.Bottom).ID("Window4").Content("PositionY=Bottom Height=100 PercentWidth=100% IsModal=true HideOnMaskClick=true"))


    @(F.Window().IsModal(false).ShowHeader(false).BodyPadding(10).AutoScroll(true).PositionY(Position.Center).PositionX(Position.Center).BoxConfigSpace(5).Layout(LayoutType.VBox).Width(300).ID("Window5")
        .Items(
            F.Button().Text("左侧窗体").ID("Button1").ClickHandler("onOpenWindow1Click"),
            F.Button().Text("右侧窗体").ID("Button2").ClickHandler("onOpenWindow2Click"),
            F.Button().Text("顶部窗体").ID("Button3").ClickHandler("onOpenWindow3Click"),
            F.Button().Margin(0).Text("底部窗体").ID("Button4").ClickHandler("onOpenWindow4Click")
        )
    )

    <br>


}

@section script {

    <script type="text/javascript">

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onOpenWindow2Click(event) {
            F.ui.Window2.show();
        }

        function onOpenWindow3Click(event) {
            F.ui.Window3.show();
        }

        function onOpenWindow4Click(event) {
            F.ui.Window4.show();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>从页面四个方向显示带遮罩的侧边窗体，点击遮罩即可关闭。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-window" aria-hidden="true"></i>切换四个方向</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="Button1"
                    title="左侧窗体">左侧窗体</strong>，再点击窗体外的遮罩。<br />结果：对应方向的窗体显示，遮罩后方暂时不能操作；点击遮罩后窗体隐藏。</li>
            <li>点击<strong class="example-control-reference" data-example-control="Button2"
                    title="右侧窗体">右侧窗体</strong>，再点击窗体外的遮罩。<br />结果：对应方向的窗体显示，遮罩后方暂时不能操作；点击遮罩后窗体隐藏。</li>
            <li>点击<strong class="example-control-reference" data-example-control="Button3"
                    title="顶部窗体">顶部窗体</strong>，再点击窗体外的遮罩。<br />结果：对应方向的窗体显示，遮罩后方暂时不能操作；点击遮罩后窗体隐藏。</li>
            <li>点击<strong class="example-control-reference" data-example-control="Button4"
                    title="底部窗体">底部窗体</strong>，再点击窗体外的遮罩。<br />结果：对应方向的窗体显示，遮罩后方暂时不能操作；点击遮罩后窗体隐藏。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>PositionX</code>（<strong class="example-control-reference" data-example-control="Window1" title="第 1 个窗口">第 1 个窗口</strong>、<strong
                    class="example-control-reference" data-example-control="Window2" title="第 2 个窗口">第 2 个窗口</strong>、<strong class="example-control-reference"
                    data-example-control="Window5" title="第 5 个窗口">第 5 个窗口</strong>）：初始为
                <code>Position.Left</code>、<code>Position.Right</code>、<code>Position.Center</code>，指定窗体在水平方向的对齐位置。
            </li>
            <li><code>PositionY</code>（<strong class="example-control-reference" data-example-control="Window3" title="第 3 个窗口">第 3 个窗口</strong>、<strong
                    class="example-control-reference" data-example-control="Window4" title="第 4 个窗口">第 4 个窗口</strong>、<strong class="example-control-reference"
                    data-example-control="Window5" title="第 5 个窗口">第 5 个窗口</strong>）：初始为
                <code>Position.Top</code>、<code>Position.Bottom</code>、<code>Position.Center</code>，指定窗体在垂直方向的对齐位置。
            </li>
            <li><code>PercentWidth</code>（<strong class="example-control-reference" data-example-control="Window3" title="第 3 个窗口">第 3 个窗口</strong>、<strong
                    class="example-control-reference" data-example-control="Window4" title="第 4 个窗口">第 4 个窗口</strong>）：初始为 <code>100%</code>，按可用视口宽度的百分比计算窗体宽度。
            </li>
            <li><code>PercentHeight</code>（<strong class="example-control-reference" data-example-control="Window1" title="第 1 个窗口">第 1 个窗口</strong>、<strong
                    class="example-control-reference" data-example-control="Window2" title="第 2 个窗口">第 2 个窗口</strong>）：初始为 <code>100%</code>，按可用视口高度的百分比计算窗体高度。
            </li>
            <li><code>HideOnMaskClick</code>（<strong class="example-control-reference" data-example-control="Window1" title="第 1 个窗口">第 1 个窗口</strong>、<strong
                    class="example-control-reference" data-example-control="Window2" title="第 2 个窗口">第 2 个窗口</strong>、<strong class="example-control-reference"
                    data-example-control="Window3" title="第 3 个窗口">第 3 个窗口</strong>）：初始为 <code>true</code>，点击窗体遮罩时隐藏窗体。</li>
            <li><code>IsModal</code>（<strong class="example-control-reference" data-example-control="Window1" title="第 1 个窗口">第 1 个窗口</strong>、<strong
                    class="example-control-reference" data-example-control="Window2" title="第 2 个窗口">第 2 个窗口</strong>、<strong class="example-control-reference"
                    data-example-control="Window3" title="第 3 个窗口">第 3 个窗口</strong>）：初始为 <code>true</code>、<code>false</code>，显示窗体遮罩，限制对遮罩后方内容的操作。</li>
        </ul>
    </section>
}
