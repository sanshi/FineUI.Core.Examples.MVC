@{
    ViewBag.Title = "Window/Percent";
    var F = Html.F();
}


@section body {

    <div id="content1">


    </div>

    @(F.Button().Text("显示窗体").ID("btnShowWindow").ClickHandler("onOpenWindow1Click"))
    <br>
    <br>

    @(F.Button().Text("隐藏窗体").ID("btnHideInClient").ClickHandler("onCloseWindow1Click"))


    @(F.Window().BodyPadding(10).AutoScroll(true).IsModal(false).PercentHeight("50%").PercentWidth("50%").Title("窗体（PercentWidth=50% PercentHeight=50%）").Icon(Icon.TagBlue).ID("Window1").ContentEl("#content1"))
    <br>


}

@section script {

    <script type="text/javascript">

        function onOpenWindow1Click(event) {
            F.ui.Window1.show();
        }

        function onCloseWindow1Click(event) {
            F.ui.Window1.hide();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>让窗体宽高分别占当前视口的一半。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-window" aria-hidden="true"></i>对照本页窗体效果</h3>
        <ul>
            <li>查看<strong class="example-control-reference" data-example-control="Window1" title="窗体（PercentWidth=50% PercentHeight=50%）">窗体（PercentWidth=50%
                    PercentHeight=50%）</strong>。<strong class="example-control-reference" data-example-control="btnShowWindow"
                    title="显示窗体">显示窗体</strong>后调整浏览器窗口大小，关闭后再次打开。<br />结果：宽高按当前视口的 50% 计算，重新打开仍使用该比例。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>PercentWidth</code>（<strong class="example-control-reference" data-example-control="Window1"
                    title="窗体（PercentWidth=50% PercentHeight=50%）">窗体（PercentWidth=50% PercentHeight=50%）</strong>）：初始为 <code>50%</code>，按可用视口宽度的百分比计算窗体宽度。</li>
            <li><code>PercentHeight</code>（<strong class="example-control-reference" data-example-control="Window1"
                    title="窗体（PercentWidth=50% PercentHeight=50%）">窗体（PercentWidth=50% PercentHeight=50%）</strong>）：初始为 <code>50%</code>，按可用视口高度的百分比计算窗体高度。</li>
        </ul>
    </section>
}
