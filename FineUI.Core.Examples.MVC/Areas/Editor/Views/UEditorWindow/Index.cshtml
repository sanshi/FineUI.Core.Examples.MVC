@{
    ViewBag.Title = "Editor/UEditorWindow";
    var F = Html.F();
}


@section body {

    @(F.Window().ID("Window1").Width(900).Height(500).Layout(LayoutType.Fit).BodyPadding(10).Title("简单表单").IsModal(false).EnableResize(true)
        .Items(
            F.SimpleForm().ID("SimpleForm1").Layout(LayoutType.Fit).LabelAlign(LabelAlign.Top).ShowBorder(false).ShowHeader(false)
                .Items(
                    F.HtmlEditor().Label("文本编辑器").ID("HtmlEditor1").Editor(Editor.UEditor)
                        .BasePath(Url.Content("~/res/third-party/ueditor/")).ToolbarSet(EditorToolbarSet.Full)
                        .Options(
                            F.OptionItem().Key("zIndex").Value("99999")
                        ).Text("<p>FineUI.Core<br>.NET 企业级全栈 UI 框架<br><br>支持的浏览器<br>Chrome、Firefox、Safari、Edge<br><br>相关链接<br>首页：http://fineui.com/<br>示例：https://fineui.com/core/demo-mvc/</p>")
                )
        )
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Bottom).ToolbarAlign(ToolbarAlign.Right)
                .Items(
                    F.Button().ID("Button2").CssClass("marginr").Text("设置编辑器的值").OnClick(Url.Action("Button2_Click")),
                    F.Button().ID("Button1").Text("获取编辑器的值").OnClick(Url.Action("Button1_Click"),
                            new Parameter("text", "F.ui.HtmlEditor1.getValue()"))
                )
        )
    )
    <br>
    注：本示例不支持文件上传，请根据UEditor官网文档自行配置。



}

