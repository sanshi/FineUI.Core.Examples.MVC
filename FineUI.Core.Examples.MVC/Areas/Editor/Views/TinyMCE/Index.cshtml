@{
    ViewBag.Title = "Editor/TinyMCE";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).LabelAlign(LabelAlign.Top).Title("表单")
        .Items(
            F.HtmlEditor().Label("文本编辑器").ID("HtmlEditor1").Editor(Editor.TinyMCE)
                .BasePath(Url.Content("~/res/third-party/tinymce/")).ToolbarSet(EditorToolbarSet.Full).Height(350).Readonly(true).Text("<p>FineUI.Core<br>.NET 企业级全栈 UI 框架<br><br>支持的浏览器<br>Chrome、Firefox、Safari、Edge<br><br>相关链接<br>首页：http://fineui.com/<br>示例：https://fineui.com/core/demo-mvc/</p>")
        )
    )
    <br>

    @(F.Button().ID("Button2").CssClass("marginr").Text("设置编辑器的值").OnClick(Url.Action("Button2_Click")))
    @(F.Button().ID("Button1").Text("获取编辑器的值").OnClick(Url.Action("Button1_Click"),
            new Parameter("text", "F.ui.HtmlEditor1.getValue()"))
    )

    <br>
    <br>
    @(F.Button().ID("Button3").CssClass("marginr").Text("设置编辑器只读").ClickHandler("onSetReadonlyClick"))
    @(F.Button().ID("Button4").Text("取消编辑器只读").ClickHandler("onCancelReadonlyClick"))
    <br>
    <br>
    注：默认编辑器处于只读状态。


}

@section script {

    <script type="text/javascript">

        function onSetReadonlyClick(event) {
            F.ui.HtmlEditor1.setReadonly(true);
        }

        function onCancelReadonlyClick(event) {
            F.ui.HtmlEditor1.setReadonly(false);
        }

    </script>
}
