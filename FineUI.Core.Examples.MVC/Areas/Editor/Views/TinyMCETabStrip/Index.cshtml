@{
    ViewBag.Title = "Editor/TinyMCETabStrip";
    var F = Html.F();
}


@section body {

    @(F.TabStrip().IsFluid(true).ID("TabStrip1").Height(500).ShowBorder(true).TabPosition(TabPosition.Top).EnableTabCloseMenu(false).ActiveTabIndex(0)
        .Tabs(
            F.Tab().ID("Tab1").Title("选项卡一").BodyPadding(10).Layout(LayoutType.Anchor)
                .Items(
                    F.HtmlEditor().Label("编辑器一").ID("HtmlEditor1").Editor(Editor.TinyMCE)
                        .BasePath(Url.Content("~/res/third-party/tinymce/")).ToolbarSet(EditorToolbarSet.Full).Height(300).Text("<p>FineUI.Core<br>.NET 企业级全栈 UI 框架<br><br>支持的浏览器<br>Chrome、Firefox、Safari、Edge<br><br>相关链接<br>首页：http://fineui.com/<br>示例：https://fineui.com/core/demo-mvc/</p>")
                ),
            F.Tab().ID("Tab2").Title("选项卡二").BodyPadding(10).Layout(LayoutType.Fit)
                .Items(
                    F.HtmlEditor().Label("编辑器二").ID("HtmlEditor2").Editor(Editor.TinyMCE)
                        .BasePath(Url.Content("~/res/third-party/tinymce/")).ToolbarSet(EditorToolbarSet.Basic).Text("<p>这是编辑器二的值</p>")
                )
        )
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Bottom)
                .Items(
                    F.Button().Text("获取编辑器的值").ID("Button1").OnClick(Url.Action("Button1_Click"),
                            Parameter.FromFunction("text1", "getHtmlEditor1Text1PostbackValue"),
                            Parameter.FromFunction("text2", "getHtmlEditor2Text2PostbackValue"))
                )
        )
    )


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getHtmlEditor1Text1PostbackValue() {
            return F.ui.HtmlEditor1.getValue();
        }

        function getHtmlEditor2Text2PostbackValue() {
            return F.ui.HtmlEditor2.getValue();
        }

    </script>
}
