@{
    ViewBag.Title = "FormLayout/LayoutCenterButton";
    var F = Html.F();
}


@section head {

    <style>
        
        .f-panel.mypanel {
            padding-top: 10px;
            margin-top: 10px;
            border-left-width: 0;
            border-right-width: 0;
            border-bottom-width: 0;
            border-radius: 0;
        }

    </style>

}

@section body {


    @(F.Form().IsFluid(true).BodyPadding(10).ID("Form1").LabelWidth(100).Title("表单").FormRowItemSpace(20)
        .Rows(
            F.FormRow().ColumnWidths("40% 60%")
                .Items(
                    F.Label().ID("Label1").Label("标签").Text("标签的值"),
                    F.CheckBox().ID("CheckBox1").Text("复选框").Label("复选框")
                ),
            F.FormRow().ColumnWidths("40% 60%")
                .Items(
                    F.DropDownList().ID("DropDownList1").Label("下拉列表").EmptyText("请选择一项").Required(true).ShowRedStar(true).AutoSelectFirstItem(false)
                        .Items(
                            F.ListItem().Text("可选项 1").Value("0"),
                            F.ListItem().Text("可选项 2").Value("1")
                        ),
                    F.TextBox().ID("TextBox1").ShowRedStar(true).Label("文本框").Required(true).Text("")
                ),
            F.FormRow()
                .Items(
                    F.Panel().ID("Panel1").ShowBorder(true).CssClass("mypanel").ShowHeader(false).Layout(LayoutType.HBox).BoxConfigPosition(BoxLayoutPosition.Center).BoxConfigSpace(5)
                        .Items(
                            F.Button().Text("验证此表单并提交").ValidateForms("Form1").ID("btnSubmit").OnClick(Url.Action("btnSubmit_Click"), "Form1"),
                            F.Button().ID("btnResetForm1").Text("重置表单").ClickHandler("onResetClick")
                        )
                )
        )
    )


}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.Form1.reset();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示将表单底部的操作按钮水平居中排列。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照标题或按钮布局</h3>
        <ul>
            <li>
                对照字段区域和底部操作按钮。<br />
                结果：提交和重置按钮作为一组居中显示，不依赖字段标签宽度。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>BoxConfigPosition</code>（<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>）：初始为
                <code>Center</code>，使 <code>HBox</code> 内的按钮组水平居中。
            </li>
        </ul>
    </section>
}
