@{
    ViewBag.Title = "FormLayout/LayoutMultiLineButtons";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).BodyPadding(10).ID("Form1").LabelWidth(100).Title("表单")
        .Items(
            F.Label().ID("Label1").Label("标签").Text("标签的值"),
            F.CheckBox().ID("CheckBox1").Text("复选框").Label("复选框"),
            F.DropDownList().ID("DropDownList1").Label("下拉列表").EmptyText("请选择一项").Required(true).ShowRedStar(true).AutoSelectFirstItem(false)
                .Items(
                    F.ListItem().Text("可选项 1").Value("0"),
                    F.ListItem().Text("可选项 2").Value("1")
                ),
            F.TextBox().ID("TextBox1").ShowRedStar(true).Label("文本框").Required(true).Text(""),
            F.Panel().ID("Panel1").ShowBorder(false).CssClass("f-field").ShowHeader(false)
                .Items(
                    F.Button().CssClass("marginr").Text("按钮一"),
                    F.Button().ID("Button3").CssClass("marginr").Text("按钮二")
                ),
            F.Panel().ID("Panel2").ShowBorder(false).ShowHeader(false)
                .Items(
                    F.Button().Text("验证此表单并提交").CssClass("marginr").ValidateForms("Form1").ID("btnSubmit").OnClick(Url.Action("btnSubmit_Click"), "Form1"),
                    F.Button().ID("btnResetForm1").CssClass("marginr").Text("重置表单").ClickHandler("onResetClick")
                )
        )
    )




}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.Form1.reset();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示表单中多组按钮的换行和排列方式。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照标题或按钮布局</h3>
        <ul>
            <li>
                对照字段区域和底部操作按钮。<br />
                结果：两组按钮分别占一行，都使用 f-field 保持字段间距。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：第一行按钮所在的面板设置了样式：CssClass="f-field"。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>CssClass</code>：f-field 为指定按钮容器提供与字段一致的间距。</li>
        </ul>
    </section>
}
