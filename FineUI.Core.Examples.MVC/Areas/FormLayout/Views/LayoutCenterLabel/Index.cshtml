@{
    ViewBag.Title = "FormLayout/LayoutCenterLabel";
    var F = Html.F();
}


@section head {
    <style>
        .formtitle .f-field-body {
            text-align: center;
            font-size: 20px;
            line-height: 1.2em;
            margin: 10px 0;
        }
    </style>

}

@section body {

    @(F.Form().IsFluid(true).BodyPadding(10).ID("Form1").LabelWidth(100).ShowHeader(false).Title("表单")
        .Rows(
            F.FormRow()
                .Items(
                    F.Label().ID("Label2").CssClass("formtitle f-widget-header").Text("这是表单标题")
                ),
            F.FormRow().ColumnWidths("40% 60%")
                .Items(
                    F.Label().ID("Label1").Label("标签").Text("标签的值"),
                    F.CheckBox().ID("CheckBox1").Text("复选框").Label("复选框")
                ),
            F.FormRow().ColumnWidths("40% 60%")
                .Items(
                    F.DropDownList().ID("DropDownList1").Label("下拉列表").EmptyText("请选择一项").Required(true).ShowRedStar(true).AutoSelectFirstItem(false)
                        .Items(
                            F.ListItem().Text("可选项 1").Value("0"),
                            F.ListItem().Text("可选项 2").Value("1")
                        ),
                    F.TextBox().ID("TextBox1").ShowRedStar(true).Label("文本框").Required(true).Text("")
                )
        )
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Bottom).ToolbarAlign(ToolbarAlign.Center)
                .Items(
                    F.Button().Text("验证此表单并提交").CssClass("mybutton").ValidateForms("Form1").ID("btnSubmit").OnClick(Url.Action("btnSubmit_Click"), "Form1"),
                    F.Button().ID("btnResetForm1").CssClass("mybutton").Text("重置表单").ClickHandler("onResetClick")
                )
        )
    )


}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.Form1.reset();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示用普通 Label 构造水平居中的表单标题。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照标题或按钮布局</h3>
        <ul>
            <li>
                查看表单顶端“这是表单标题”。<br />
                结果：默认表单标题栏隐藏，自定义 Label 横跨表单并居中显示。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>CssClass</code>：formtitle 和主题标题类构造自定义标题。</li>
        </ul>
    </section>
}
