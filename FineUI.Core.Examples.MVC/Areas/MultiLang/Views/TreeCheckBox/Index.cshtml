@{
    ViewBag.Title = "MultiLang/TreeCheckBox";
    var F = Html.F();
}


@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IHtmlLocalizer<FineUI.Core.Examples.MVC.Areas.MultiLang.Controllers.TreeCheckBoxController> Localizer
@functions {
    ParamsFunc<string, object, LocalizedString> _R => Localizer.GetString;
}


@section body {

    @(F.Tree().IsFluid(true).ID("Tree1").ShowHeader(true).Title(@_R("树控件")).EnableCheckBox(true)
        .Nodes(
            F.TreeNode().Text(@_R("中国")).Expanded(true)
                .Nodes(
                    F.TreeNode().Text(@_R("河南省")).Expanded(true).Checked(true)
                        .Nodes(
                            F.TreeNode().Text(@_R("驻马店市")).NodeID("zhumadian")
                                .Nodes(
                                    F.TreeNode().Text(@_R("遂平县")).NodeID("suiping"),
                                    F.TreeNode().Text(@_R("西平县")).NodeID("xiping")
                                ),
                            F.TreeNode().Text(@_R("漯河市")).NodeID("luohe")
                        ),
                    F.TreeNode().Text(@_R("安徽省")).Expanded(true).NodeID("anhui")
                        .Nodes(
                            F.TreeNode().Text(@_R("合肥市")).NodeID("hefei"),
                            F.TreeNode().Text(@_R("黄山市")).NodeID("huangshan")
                        )
                )
        )
    )
    <br>

    @(F.Button().ID("btnGetCheckedValues").Text(@_R("获取选中的复选框")).OnClick(Url.Action("btnGetCheckedValues_Click"), new Parameter("checkedNodes", "getCheckedNodes()")))
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}


@section script {

    <script>
        function getCheckedNodes() {
            var result = [];

            var checkedNodes = F.ui.Tree1.getCheckedNodes(true);
            if (checkedNodes.length) {
                $.each(checkedNodes, function (index, node) {
                    result.push({
                        id: node.id,
                        text: node.text
                    });
                });
            }

            return F.toJSON(result);
        }
    </script>

}
