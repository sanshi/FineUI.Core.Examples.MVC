@{
    ViewBag.Title = "MultiLang/TreeCheckBox";
    var F = Html.F();
}


@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IHtmlLocalizer<FineUI.Core.Examples.MVC.Areas.MultiLang.Controllers.TreeCheckBoxController> Localizer
@functions {
    ParamsFunc<string, object, LocalizedString> _R => Localizer.GetString;
}


@section body {

    @(F.Tree().IsFluid(true).ID("Tree1").ShowHeader(true).Title(@_R("树控件")).EnableCheckBox(true)
        .Nodes(
            F.TreeNode().Text(@_R("中国")).Expanded(true)
                .Nodes(
                    F.TreeNode().Text(@_R("河南省")).Expanded(true).Checked(true)
                        .Nodes(
                            F.TreeNode().Text(@_R("驻马店市")).NodeID("zhumadian")
                                .Nodes(
                                    F.TreeNode().Text(@_R("遂平县")).NodeID("suiping"),
                                    F.TreeNode().Text(@_R("西平县")).NodeID("xiping")
                                ),
                            F.TreeNode().Text(@_R("漯河市")).NodeID("luohe")
                        ),
                    F.TreeNode().Text(@_R("安徽省")).Expanded(true).NodeID("anhui")
                        .Nodes(
                            F.TreeNode().Text(@_R("合肥市")).NodeID("hefei"),
                            F.TreeNode().Text(@_R("黄山市")).NodeID("huangshan")
                        )
                )
        )
    )
    <br>

    @(F.Button().ID("btnGetCheckedValues").Text(@_R("获取选中的复选框")).OnClick(Url.Action("btnGetCheckedValues_Click"), Parameter.FromFunction("checkedNodes", "getCurrentControlCheckedNodesPostbackValue")))
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlCheckedNodesPostbackValue() {
            return getCheckedNodes();
        }

    </script>


    <script>
        function getCheckedNodes() {
            var result = [];

            var checkedNodes = F.ui.Tree1.getCheckedNodes(true);
            if (checkedNodes.length) {
                $.each(checkedNodes, function (index, node) {
                    result.push({
                        id: node.id,
                        text: node.text
                    });
                });
            }

            return F.toJSON(result);
        }
    </script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>从本地化资源生成界面文字，对照同一页面的中文和英文。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换界面语言</h3>
        <ul>
            <li>使用页面提供的中文、英文语言链接分别进入本页。<br />结果：<strong class="example-control-reference" data-example-control="Tree1"
                    title="树控件">树控件</strong>的标题、字段标签或列头、按钮文字按所选语言重新生成；此操作重新加载页面。</li>
            <li>对照中英文界面中的相同记录或节点。<br />结果：业务标识与数据含义保持，显示文字按当前语言翻译。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>_R()</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：读取当前语言的资源文字，分别用于标题、字段、按钮或节点。
            </li>
            <li><code>语言参数</code>（<strong class="example-control-reference" data-example-control="Tree1"
                    title="树控件">树控件</strong>）：语言链接重新请求当前页面，由本端语言设置选择资源，不是仅替换一段可见文本。</li>
        </ul>
    </section>
}
