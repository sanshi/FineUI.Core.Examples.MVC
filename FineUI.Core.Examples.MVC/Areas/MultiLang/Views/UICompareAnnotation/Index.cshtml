@{
    ViewBag.SourceFiles = "~/Areas/MultiLang/Models/UICompareModel.cs";
    ViewBag.Title = "MultiLang/UICompareAnnotation";
    var F = Html.F();
}

@model FineUI.Core.Examples.MVC.Areas.MultiLang.Models.UICompareModel


@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IHtmlLocalizer<FineUI.Core.Examples.MVC.Areas.MultiLang.Controllers.UICompareAnnotationController> Localizer
@functions {
    ParamsFunc<string, object, LocalizedString> _R => Localizer.GetString;
}


@section body {


    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).LabelWidth(200).ShowBorder(true).ShowHeader(true).Title(@_R("简单表单"))
        .Items(
            F.DatePickerFor(m => m.StartDate),
            F.DatePickerFor(m => m.EndDate),
            F.Label(),
            F.TextBoxFor(m => m.Password),
            F.TextBoxFor(m => m.ConfirmPassword),
            F.Label(),
            F.NumberBoxFor(m => m.Number1),
            F.NumberBoxFor(m => m.Number2),
            F.Label(),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").CssClass("marginr").Text(@_R("提交表单")).OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1"),
            F.Button().ID("btnReset").Text(@_R("重置表单")).ClickHandler("onResetClick")
        )
    )

}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }

    </script>
}
