
@{
    ViewBag.SourceFiles = "~/Areas/MultiLang/Models/User.cs";
    ViewBag.Title = "MultiLang/LoginAnnotation";
    var F = Html.F();
}

@model FineUI.Core.Examples.MVC.Areas.MultiLang.Models.User


@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IHtmlLocalizer<FineUI.Core.Examples.MVC.Areas.MultiLang.Controllers.LoginAnnotationController> Localizer
@functions {
    ParamsFunc<string, object, LocalizedString> _R => Localizer.GetString;
}


@section body {
    
    <div>
        @Html.Raw(_R("Notice"))
    </div>

    @(F.Window().Width(350).WindowPosition(WindowPosition.GoldenSection).EnableClose(false).IsModal(false).Title(@_R("登录表单")).ID("Window1")
        .Items(
            F.SimpleForm().ShowHeader(false).BodyPadding(10).ShowBorder(false).ID("SimpleForm1")
                .Items(
                    F.TextBoxFor(m => m.UserName),
                    F.TextBoxFor(m => m.Password)
                )
        )
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Bottom).ToolbarAlign(ToolbarAlign.Right)
                .Items(
                    F.Button().OnClick(Url.Action("btnLogin_Click"), "SimpleForm1").ValidateTarget(Target.Top).ValidateForms("SimpleForm1").Type(ButtonType.Submit).Text(@_R("登录")).ID("btnLogin"),
                    F.Button().Type(ButtonType.Reset).Text(@_R("重置")).ID("btnReset")
                )
        )
    )
    <br>


}

