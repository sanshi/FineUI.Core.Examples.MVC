@{
    ViewBag.SourceFiles = "~/Areas/MultiLang/Models/User.cs";
    ViewBag.Title = "MultiLang/LoginAnnotation";
    var F = Html.F();
}

@model FineUI.Core.Examples.MVC.Areas.MultiLang.Models.User


@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IHtmlLocalizer<FineUI.Core.Examples.MVC.Areas.MultiLang.Controllers.LoginAnnotationController> Localizer
@functions {
    ParamsFunc<string, object, LocalizedString> _R => Localizer.GetString;
}


@section body {

    <div>
        @Html.Raw(_R("Notice"))
    </div>

    @(F.Window().Width(350).WindowPosition(WindowPosition.GoldenSection).EnableClose(false).IsModal(false).Title(@_R("登录表单")).ID("Window1")
        .Items(
            F.SimpleForm().ShowHeader(false).BodyPadding(10).ShowBorder(false).ID("SimpleForm1")
                .Items(
                    F.TextBoxFor(m => m.UserName),
                    F.TextBoxFor(m => m.Password)
                )
        )
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Bottom).ToolbarAlign(ToolbarAlign.Right)
                .Items(
                    F.Button().OnClick(Url.Action("btnLogin_Click"), "SimpleForm1").ValidateTarget(Target.Top).ValidateForms("SimpleForm1").Type(ButtonType.Submit).Text(@_R("登录")).ID("btnLogin"),
                    F.Button().Type(ButtonType.Reset).Text(@_R("重置")).ID("btnReset")
                )
        )
    )
    <br>


}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>从本地化资源和模型注解生成多语言界面，验证提示也随语言切换。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换界面语言</h3>
        <ul>
            <li>使用页面提供的中文、英文语言链接分别进入本页。<br />结果：<strong class="example-control-reference" data-example-control="SimpleForm1"
                    title="表单">表单</strong>的标题、字段标签或列头、按钮文字按所选语言重新生成；此操作重新加载页面。</li>
            <li>在英文界面清空必填字段，再点击登录。<br />结果：验证提示也使用当前语言；标签翻译和验证消息保持一致。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Display / 验证注解</code>（<strong class="example-control-reference" data-example-control="SimpleForm1"
                    title="表单">表单</strong>）：字段或列的显示名称与验证消息引用本地化资源，按当前语言解析。</li>
            <li><code>语言参数</code>（<strong class="example-control-reference" data-example-control="SimpleForm1"
                    title="表单">表单</strong>）：语言链接重新请求当前页面，由本端语言设置选择资源，不是仅替换一段可见文本。</li>
        </ul>
    </section>
}
