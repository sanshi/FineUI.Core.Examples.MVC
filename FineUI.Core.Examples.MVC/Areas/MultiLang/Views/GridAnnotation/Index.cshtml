@using FineUI.Core.Examples.MVC.Areas.MultiLang.Models;
@{
    ViewBag.SourceFiles = "~/Areas/MultiLang/Models/Student.cs;~/Areas/MultiLang/Models/StudentHelper.cs";
    ViewBag.Title = "MultiLang/GridAnnotation";
    var F = Html.F();
    var jsonSettings = new Newtonsoft.Json.JsonSerializerSettings
    {
        StringEscapeHandling = Newtonsoft.Json.StringEscapeHandling.EscapeHtml
    };
    var resources = new Newtonsoft.Json.Linq.JObject();
    foreach (var resource in FineUI.Core.PageContext.GetLocalizer<SharedJavaScriptResources>().GetAllStrings(includeParentCultures: true))
    {
        resources[resource.Name] = resource.Value;
    }
}

@model IList<FineUI.Core.Examples.MVC.Areas.MultiLang.Models.Student>


@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IHtmlLocalizer<FineUI.Core.Examples.MVC.Areas.MultiLang.Controllers.GridAnnotationController> Localizer
@functions {
    ParamsFunc<string, object, LocalizedString> _R => Localizer.GetString;
}

@section body {


    @(F.Grid().IsFluid(true).Title(@_R("表格")).ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .Columns(
            F.RowNumberField(),
            F.RenderFieldFor(m => m.Name).Width(120),
            F.RenderFieldFor(m => m.Gender).RendererFunction("renderGender").Width(120),
            F.RenderFieldFor(m => m.EntranceYear).Width(120),
            F.RenderCheckFieldFor(m => m.AtSchool).RenderAsStaticField(true).Width(120),
            F.RenderFieldFor(m => m.Major).RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderFieldFor(m => m.Group).RendererFunction("renderGroup").Width(120),
            F.RenderFieldFor(m => m.EntranceDate).Width(120)
        ).DataSource(Model)
    )
    <br>
    <br>

    @(F.Button().Text(@_R("选中了哪些行")).ID("Button1").ClickHandler("onNotifySelectedRowsClick"))

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <!-- 翻译文本作为 JSON 数据输出，避免把引号或 HTML 拼进可执行脚本。 -->
    <script id="grid-resources" type="application/json">@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(resources, jsonSettings))</script>
    <script type="text/javascript">
        F.setResources(JSON.parse(document.getElementById('grid-resources').textContent));
    </script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>从本地化资源和模型注解生成多语言界面，验证提示也随语言切换。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换界面语言</h3>
        <ul>
            <li>使用页面提供的中文、英文语言链接分别进入本页。<br />结果：<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>的标题、字段标签或列头、按钮文字按所选语言重新生成；此操作重新加载页面。</li>
            <li>对照中英文界面中的相同记录或节点。<br />结果：业务标识与数据含义保持，显示文字按当前语言翻译。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Display / 验证注解</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：字段或列的显示名称与验证消息引用本地化资源，按当前语言解析。</li>
            <li><code>语言参数</code>（<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：语言链接重新请求当前页面，由本端语言设置选择资源，不是仅替换一段可见文本。</li>
        </ul>
    </section>
}
