@{
    ViewBag.Title = "Form/Image";
    var F = Html.F();
}


@section body {

    Icon="World"：
    <br>

    @(F.Image().ID("Image1").Icon(Icon.World))

    <br>
    ImageUrl="~/res/icon/world.png"：
    <br>

    @(F.Image().ID("Image2").ImageUrl("~/res/icon/world.png"))

    <br>
    ImageUrl="~/res/images/logo/favicon.ico" ImageCssStyle="border:solid 1px #ccc;padding:5px;"：
    <br>

    @(F.Image().ID("Image3").ImageWidth(32).ImageHeight(32).ImageCssStyle("border:solid 1px #ccc;padding:5px;").ImageUrl("~/res/images/logo/favicon.ico"))
    <br>

    @(F.Button().Text("改变图片的大小").ID("Button1").OnClick(Url.Action("Button1_Click"), Parameter.FromFunction("imageWidth", "getImage3ImageWidthPostbackValue")))


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getImage3ImageWidthPostbackValue() {
            return F.ui.Image3.getWidth();
        }

    </script>
}
