@{
    ViewBag.Title = "Form/FormValidateValidator";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("用户注册表单")
        .Items(
            F.TextBox().ID("tbxUserName").Label("用户名").Required(true).NextFocusControl("tbxPassword").ShowRedStar(true).Text("admin"),
            F.TextBox().ID("tbxPassword").Label("密码").Required(true).ShowRedStar(true).NextClickControl("btnRegister").TextMode(TextMode.Password).ValidatorFunction("passwordValidator"),
            F.Button().ID("btnRegister").Text("注册").OnClick(Url.Action("btnRegister_Click"),
                    Parameter.FromFunction("userName", "gettbxUserNameUserNamePostbackValue"),
                    Parameter.FromFunction("password", "gettbxPasswordPasswordPostbackValue")).ValidateForms("SimpleForm1").ValidateTarget(Target.Top)
        )
    )




}

@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function gettbxUserNameUserNamePostbackValue() {
            return F.ui.tbxUserName.getValue();
        }

        function gettbxPasswordPasswordPostbackValue() {
            return F.ui.tbxPassword.getValue();
        }

    </script>


    <script>
        function passwordValidator() {
            var value = this.getValue();
            if (value.length === 6) {
                return true;
            } else {
                return '密码必须为 6 个字符！';
            }
        }
    </script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示用客户端自定义验证函数检查密码长度，要求恰好输入 <code>6</code> 个字符。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>执行自定义验证</h3>
        <ol>
            <li>
                <strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>保持有值，密码输入<code>123</code>，点击<strong class="example-control-reference" data-example-control="btnRegister" title="注册">注册</strong>。<br />
                结果：密码框显示“密码必须为 <code>6</code> 个字符！”，浏览器阻止回发。
            </li>
            <li>
                关闭验证提示，将密码改为<code>123456</code>，再次点击<strong class="example-control-reference" data-example-control="btnRegister" title="注册">注册</strong>。<br />
                结果：长度检查通过后才回发，后台显示当前<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>和密码。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：</p>
        <ul>
            <li> 提交表单时客户端验证[密码]必须为 <code>6</code> 个字符，否则标记为无效。 </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ValidatorFunction</code>（<strong class="example-control-reference" data-example-control="tbxPassword" title="密码">密码</strong>）：指定 <code>passwordValidator</code>；函数读取当前密码，符合条件返回 <code>true</code>，否则返回错误文字。</li>
        </ul>
    </section>
}
