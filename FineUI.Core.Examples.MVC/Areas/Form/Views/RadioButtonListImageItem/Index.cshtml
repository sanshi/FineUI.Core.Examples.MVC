@{
    ViewBag.Title = "Form/RadioButtonListImageItem";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").LabelWidth(220).BodyPadding(10).ShowBorder(true).ShowHeader(true).Title("单选框列表 - 图标选项（可信 HTML）")
        .Items(
            F.RadioButtonList().ID("RadioButtonList1").Label("① DataBind + DataTextRaw（自动绑定）").ColumnNumber(4)
                .DataValueField("Code").DataTextField("Display").DataTextRaw(true).DataSource(ViewBag.RadioButtonList1Source).SelectedValue("cn"),
            F.RadioButtonList().ID("RadioButtonList2").Label("② 手工构建 Items（TextRawHtml）").ColumnNumber(4)
                .Items((FineUI.Core.RadioItem[])ViewBag.RadioButtonList2Items).SelectedValue("us")
        )
        .Toolbars(
            F.Toolbar().ID("Toolbar1").Position(ToolbarPosition.Bottom).ToolbarAlign(ToolbarAlign.Right)
                .Items(
                    F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
                )
        )
    )



}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>用带国旗图标的选项展示可信 HTML 文本的几种数据供给方式。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-radio-button-checked" aria-hidden="true"></i>选择带图标的国家</h3>
        <ol>
            <li>
                在第一组中选择德国国旗对应的选项。<br />
                结果：第一组仅选中德国，值为 <code>de</code>；其它组保持自己的选择。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnSubmit" title="提交表单">提交表单</strong>。<br />
                结果：回发后由后台显示当前各组的选中数据；本页实际提供 <code>2</code> 组列表。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：<code>MVC</code>（流式 <code>API</code>）演示「<code>DataBind</code> + <code>DataTextRaw</code>」与「手工构建
            <code>Items</code>（<code>TextRawHtml</code>）」两种方式，二者功能与安全性等价——都只信任图标模板与 <code>URL</code>、对数据字段 <code>HtmlEncode</code> 转义。
            <code>OnItemDataBound</code> 为 <code>RazorForms</code> / <code>Pro</code> 专用，<code>MVC</code> 流式模式不适用（可用上述两种方式替代）。
        </p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataTextRaw</code>（<strong class="example-control-reference" data-example-control="RadioButtonList1"
                    title="① DataBind + DataTextRaw（自动绑定）">① DataBind + DataTextRaw（自动绑定）</strong>）：固定国旗 HTML 按可信内容输出，动态国家名称仍应先编码；普通字符串不会因此自动获得可信身份。</li>
        </ul>
    </section>
}
