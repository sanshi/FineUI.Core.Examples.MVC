@{
    ViewBag.Title = "Form/RadioButtonListImageItem";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").LabelWidth(220).BodyPadding(10).ShowBorder(true).ShowHeader(true).Title("单选框列表 - 图标选项（可信 HTML）")
        .Items(
            F.RadioButtonList().ID("RadioButtonList1").Label("① DataBind + DataTextRaw（自动绑定）").ColumnNumber(4)
                .DataValueField("Code").DataTextField("Display").DataTextRaw(true).DataSource(ViewBag.RadioButtonList1Source).SelectedValue("cn"),
            F.RadioButtonList().ID("RadioButtonList2").Label("② 手工构建 Items（TextRawHtml）").ColumnNumber(4)
                .Items((FineUI.Core.RadioItem[])ViewBag.RadioButtonList2Items).SelectedValue("us")
        )
        .Toolbars(
            F.Toolbar().ID("Toolbar1").Position(ToolbarPosition.Bottom).ToolbarAlign(ToolbarAlign.Right)
                .Items(
                    F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
                )
        )
    )

    <br />
    <br />
    注：MVC（流式 API）演示「DataBind + DataTextRaw」与「手工构建 Items（TextRawHtml）」两种方式，二者功能与安全性等价——都只信任图标模板与 URL、对数据字段 HtmlEncode 转义。
    OnItemDataBound 为 RazorForms / Pro 专用，MVC 流式模式不适用（可用上述两种方式替代）。
}
