@{
    ViewBag.Title = "Form/NumberBoxTriggerIcon";
    var F = Html.F();
}

@section head {

    <style>
        .text-align-center input {
            text-align: center;
        }

        .text-align-right input {
            text-align: right;
        }

        /* f-iconfont-minus */
        .custom-trigger-icon .f-field-triggerbox-icon.f-triggericon-numberdown:before {
            content: "\e768";
        }

        /* f-iconfont-plus */
        .custom-trigger-icon .f-field-triggerbox-icon.f-triggericon-numberup:before {
            content: "\e767";
        }
		
		
		/* f-iconfont-triangle-down */
        .custom-trigger-icon2 .f-field-triggerbox-icon.f-triggericon-numberdown:before {
            content: "\e79b";
        }
        /* f-iconfont-triangle-up */
        .custom-trigger-icon2 .f-field-triggerbox-icon.f-triggericon-numberup:before {
            content: "\e79e";
        }
    </style>

}

@section body {

    @(F.SimpleForm().ID("SimpleForm1").IsFluid(true).BodyPadding(10).LabelAlign(LabelAlign.Right).EnableCollapse(false).Title("简单表单").LabelWidth(100)
        .Items(
            F.NumberBox().Label("Stack").ID("NumberBox1").CssClass("custom-trigger-icon2").NoDecimal(true).NoNegative(true).TriggerType(NumberBoxTriggerType.Stack).Text("100"),
            F.NumberBox().Label("Tile").ID("NumberBox2").CssClass("custom-trigger-icon").NoDecimal(true).NoNegative(true).TriggerType(NumberBoxTriggerType.Tile).Text("20"),
            F.NumberBox().Label("None").ID("NumberBox3").NoDecimal(true).NoNegative(true).ShowTrigger(false).Text("20"),
            F.NumberBox().Label("Separate").ID("NumberBox4").CssClass("text-align-center custom-trigger-icon").NoDecimal(true).NoNegative(true).TriggerType(NumberBoxTriggerType.Separate).Width(180).Text("1"),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
        )
    )


}
