@{
    ViewBag.Title = "统一清空选择";
    var F = Html.F();
}

@section body {
    @(F.Panel().ID("Panel1").IsFluid(true).MaxWidth(1000).Layout(LayoutType.Block).BlockConfigSpace(20)
        .ShowHeader(false).ShowBorder(false)
        .Items(
            F.Panel().ID("PanelActions").Block(12).ShowHeader(false).ShowBorder(false)
                .Items(
                    F.Button().ID("btnClearSelection").Text("清空全部选择")
                        .OnClick(Url.Action("btnClearSelection_Click")).CssClass("marginr marginb"),
                    F.Button().ID("btnClearAndSelect").Text("清空后重新选中甲")
                        .OnClick(Url.Action("btnClearAndSelect_Click")).CssClass("marginr marginb"),
                    F.Button().ID("btnReadSelection").Text("读取当前选择").CssClass("marginb")
                        .OnClick(Url.Action("btnReadSelection_Click"),
                            Parameter.FromFunction("selection", "getSelectionSummary"))
                ),
            F.Panel().ID("PanelResult").Block(12).Title("后台读取结果")
                .ShowHeader(true).ShowBorder(true).BodyPadding(10)
                .Items(F.Label().ID("labResult").ShowLabel(false).Text("请先清空，再读取当前选择。")),
            F.Grid().ID("Grid1").Block(12).BlockMD(6).Height(220).Title("表格（Grid）")
                .ShowHeader(true).ShowBorder(true).DataIDField("Id").DataTextField("Name")
                .EnableCheckBoxSelect(true).EnableMultiSelect(true).SelectedRowIDArray("a", "b")
                .RowDataBoundFunction("onGridRowDataBound")
                .DataSource(new[] { new { Id = "a", Name = "甲" }, new { Id = "b", Name = "乙（不可选）" } })
                .Columns(F.RenderField().ColumnID("Name").DataField("Name").HeaderText("名称").ExpandUnusedSpace(true)),
            F.Tree().ID("Tree1").Block(12).BlockMD(6).Height(220).Title("树（Tree）")
                .ShowHeader(true).ShowBorder(true).EnableMultiSelect(true).EnableCheckBox(true).SelectedNodeIDArray("a", "b")
                .Nodes(F.TreeNode().NodeID("root").Text("分组").Expanded(true).EnableCheckBox(false)
                    .Nodes(
                        F.TreeNode().NodeID("a").Text("甲").Checked(true),
                        F.TreeNode().NodeID("b").Text("乙（不可选）").Selectable(false)
                    ))
                .Toolbars(F.Toolbar().ID("ToolbarTree").Position(ToolbarPosition.Bottom)
                    .Items(F.Button().ID("btnUncheckNodes").Text("取消树节点勾选")
                        .OnClick(Url.Action("btnUncheckNodes_Click")))),
            F.SimpleForm().ID("SimpleFormDropDownList").Block(12).BlockMD(6)
                .Title("下拉列表（DropDownList）").ShowHeader(true).ShowBorder(true).BodyPadding(10)
                .Items(F.DropDownList().ID("DropDownList1").Label("下拉列表").ShowLabel(false)
                    .EnableMultiSelect(true).MultiSelectMode(MultiSelectMode.Tags).SelectedValueArray("a", "b")
                    .Items(F.ListItem().Value("a").Text("甲"), F.ListItem().Value("b").Text("乙"))),
            F.SimpleForm().ID("SimpleFormDropDownBox").Block(12).BlockMD(6)
                .Title("下拉选择框（DropDownBox）").ShowHeader(true).ShowBorder(true).BodyPadding(10)
                .Items(F.DropDownBox().ID("DropDownBox1").Label("下拉选择框").ShowLabel(false)
                    .DataControlID("CheckBoxList2").EnableMultiSelect(true).MultiSelectMode(MultiSelectMode.Tags)
                    .EnableEdit(true).Values("a", "b").Texts("甲", "乙")
                    .PopPanel(F.SimpleForm().ID("SimpleForm1").Hidden(true).ShowHeader(false).BodyPadding(10)
                        .Items(F.CheckBoxList().ID("CheckBoxList2").AutoColumnWidth(true)
                            .Items(F.CheckItem().Value("a").Text("甲"), F.CheckItem().Value("b").Text("乙"))))),
            F.Panel().ID("PanelDataList").Block(12).BlockMD(6).Title("数据列表（DataList）")
                .ShowHeader(true).ShowBorder(true).BodyPadding(10)
                .Items(F.DataList().ID("DataList1").EnableSelect(true).EnableMultiSelect(true).SelectedValueArray("a", "b")
                    .Items(
                        F.DataListItem().Value("a").Text("甲"),
                        F.DataListItem().Value("b").Text("乙（不可选）").EnableSelect(false)
                    )),
            F.SimpleForm().ID("SimpleFormCheckBoxList").Block(12).BlockMD(6)
                .Title("复选框列表（CheckBoxList）").ShowHeader(true).ShowBorder(true).BodyPadding(10)
                .Items(F.CheckBoxList().ID("CheckBoxList1").Label("复选框列表").ShowLabel(false)
                    .AutoColumnWidth(true).SelectedValueArray("a", "b")
                    .Items(F.CheckItem().Value("a").Text("甲"), F.CheckItem().Value("b").Text("乙（禁用）").Enabled(false))),
            F.SimpleForm().ID("SimpleFormRadioButtonList").Block(12).BlockMD(6)
                .Title("单选框列表（RadioButtonList）").ShowHeader(true).ShowBorder(true).BodyPadding(10)
                .Items(F.RadioButtonList().ID("RadioButtonList1").Label("单选框列表").ShowLabel(false)
                    .AutoColumnWidth(true).SelectedValue("a")
                    .Items(F.RadioItem().Value("a").Text("甲"), F.RadioItem().Value("b").Text("乙")))
        ))
    <br />
    <p>七类控件都使用 ClearSelection 清空选择，数据保留，禁用项的旧选择也会清除。</p>
    <p>树的清空选择只取消节点高亮，保留节点勾选和展开状态；取消勾选请使用树区域内的按钮。</p>
    <p>UIHelper 发送客户端动作；点击“读取当前选择”时，后台接收浏览器当前的选择。</p>
}

@section script {
    <script>
        function onGridRowDataBound(rowData) {
            if (rowData.id === 'b') {
                rowData.unselectable = true;
            }
        }

        // 点击“读取当前选择”时，把浏览器中的选择数量提交给后台显示。
        function getSelectionSummary() {
            var controls = ['Grid1', 'DropDownBox1', 'DropDownList1', 'DataList1',
                'Tree1', 'CheckBoxList1', 'RadioButtonList1'].map(function (id) {
                    return F.ui[id];
                });
            var counts = [
                controls[0].getSelectedRows().length,
                (controls[1].getValue() || []).length,
                (controls[2].getValue() || []).length,
                controls[3].getSelectedItems().length,
                controls[4].getSelectedNodes().length,
                controls[5].getValue().length,
                controls[6].getValue() == null ? 0 : 1
            ];
            var cell = controls[0].getSelectedCell();
            return '：表格 ' + counts[0]
                + '；下拉选择框 ' + counts[1]
                + '；下拉列表 ' + counts[2]
                + '；数据列表 ' + counts[3]
                + '；树 ' + counts[4]
                + '；复选框列表 ' + counts[5]
                + '；单选框列表 ' + counts[6]
                + '；单元格 ' + (cell && cell.length ? 1 : 0)
                + '；树勾选 ' + controls[4].getCheckedNodes().length;
        }

        function uncheckTreeNodes() {
            var tree = F.ui.Tree1;
            tree.uncheckNodes(tree.getCheckedNodes());
        }
    </script>
}
