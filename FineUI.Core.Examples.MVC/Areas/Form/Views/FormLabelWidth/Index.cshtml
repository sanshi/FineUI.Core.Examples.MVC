@{
    ViewBag.Title = "Form/FormLabelWidth";
    var F = Html.F();
}


@section body {

    @(F.Form().IsFluid(true).BodyPadding(10).ID("Form1").LabelWidth(120).LabelAlign(LabelAlign.Right).Title("表单（LabelWidth=120 LabelAlign=Right）")
        .Rows(
            F.FormRow().ColumnWidths("50% 50%")
                .Items(
                    F.Label().ID("Label1").Label("标签").LabelWidth(150).LabelAlign(LabelAlign.Left).Text("标签的值"),
                    F.CheckBox().ID("CheckBox1").Text("复选框").Label("复选框")
                ),
            F.FormRow().ColumnWidths("50% 50%")
                .Items(
                    F.DropDownList().ID("DropDownList1").Required(true).LabelWidth(150).LabelAlign(LabelAlign.Left).ShowRedStar(true).AutoSelectFirstItem(false).Label("下拉列表（长标签）")
                        .Items(
                            F.ListItem().Text("可选项 1").Value("0"),
                            F.ListItem().Text("可选项 2").Value("1")
                        ),
                    F.TextBox().ID("TextBox1").ShowRedStar(true).Label("文本框").Required(true).Text("")
                ),
            F.FormRow()
                .Items(
                    F.Panel().ID("Panel1").CssStyle("text-align: right;").ShowBorder(false).ShowHeader(false)
                        .Items(
                            F.Button().Text("验证此表单并提交").ValidateForms("Form1").ID("btnSubmitForm1").OnClick(Url.Action("btnSubmitForm1_Click"), "Form1")
                        )
                )
        )
    )




}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示表单级标签宽度和对齐方式，以及字段级设置如何覆盖它们。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对比继承与覆盖</h3>
        <ul>
            <li>
                对照“标签”“下拉列表（长标签）”与“文本框”的标签区域。<br />
                结果：表单默认标签宽 120 像素且靠右；前两个字段单独改为 150 像素并靠左，文本框仍使用表单默认值。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：表单字段定义的 LabelWidth 和 LabelAlign 属性会覆盖 Form 的同名属性</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>LabelWidth</code>：表单为 120，特定字段覆盖为 150。</li>
            <li><code>LabelAlign</code>：字段级配置覆盖表单级配置。</li>
        </ul>
    </section>
}
