@{
    ViewBag.Title = "Form/NumberBoxTextChanged";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).LabelAlign(LabelAlign.Top).Title("简单表单").LabelWidth(120)
        .Items(
            F.NumberBox().Label("非负整数").ID("NumberBox3").EmptyText("比如 99").OnTextChanged(Url.Action("NumberBox3_TextChanged"), Parameter.FromFunction("text", "getNumberBox3TextPostbackValue")).NoDecimal(true).NoNegative(true).Required(true).ShowRedStar(true),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), Parameter.FromFunction("text", "getNumberBox3TextPostbackValue"))
        )
    )
    <br>
    <br>
    注：手工输入数字，或者点击右侧上下箭头都会触发文本改变事件。


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getNumberBox3TextPostbackValue() {
            return F.ui.NumberBox3.getValue();
        }

    </script>
}
