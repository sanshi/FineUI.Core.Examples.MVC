@{
    ViewBag.Title = "Form/TwinTriggerBox";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("表单").ShowHeader(true)
        .Items(
            F.TwinTriggerBox().ID("TwinTriggerBox1").ShowLabel(false).OnTrigger1Click(Url.Action("TwinTriggerBox1_Trigger1Click")).OnTrigger2Click(Url.Action("TwinTriggerBox1_Trigger2Click"), Parameter.FromFunction("text", "getTwinTriggerBox1TextPostbackValue")).Trigger1Icon(TriggerIcon.Clear).ShowTrigger1(false).EmptyText("搜索用户名").Trigger2Icon(TriggerIcon.Search)
        )
    )

}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getTwinTriggerBox1TextPostbackValue() {
            return F.ui.TwinTriggerBox1.getValue();
        }

    </script>
}
