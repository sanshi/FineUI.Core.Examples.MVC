@{
    ViewBag.Title = "Form/FormCompareNumberBox";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).LabelWidth(200).ShowBorder(true).ShowHeader(true).Title("简单表单").LabelAlign(LabelAlign.Top)
        .Items(
            F.NumberBox().ID("NumberBox1").Required(true).Label("数字框 1（必填项）"),
            F.NumberBox().ID("NumberBox2").Required(true).Label("数字框 2（必填项，大于等于数字框 1）").CompareControl("NumberBox1").CompareOperator(Operator.GreaterThanEqual).CompareMessage("数字框 2 应该大于等于数字框 1!"),
            F.NumberBox().ID("NumberBox3").Label("数字框 3（可为空）"),
            F.NumberBox().ID("NumberBox4").Label("数字框 4（可为空，大于等于数字框 3）").CompareControl("NumberBox3").CompareOperator(Operator.GreaterThanEqual).CompareMessage("数字框 4 应该大于等于数字框 3!"),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").CssClass("marginr").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1"),
            F.Button().ID("btnReset").Text("重置表单").ClickHandler("onResetClick")
        )
    )


}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }

    </script>
}
