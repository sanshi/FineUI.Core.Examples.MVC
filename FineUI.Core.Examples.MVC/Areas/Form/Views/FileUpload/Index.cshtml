@{
    ViewBag.Title = "Form/FileUpload";
    var F = Html.F();
}

@section head {

    <style type="text/css">
        .result img {
            border: 1px solid #CCCCCC;
            max-width: 550px;
            padding: 3px;
        }
    </style>

}


@section body {


    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("表单").ShowHeader(true)
        .Items(
            F.TextBox().Label("用户名").ID("tbxUserName").EmptyText("请输入用户名").Required(true).ShowRedStar(true),
            F.FileUpload().ID("filePhoto").EmptyText("请选择一张照片").Label("个人头像").Required(true).ShowRedStar(true),
            F.Button().ID("btnSubmit").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1").ValidateForms("SimpleForm1").Text("提交")
        )
    )
    @(F.Label().ID("labResult").EncodeText(false).CssClass("result"))



}

@section script {

    <script>
        // 两个标记用于观察保存与表单清空的调用顺序。
        function markUploadSaved() {
            window.a = 12;
        }

        function markUploadFormReset() {
            window.b = 12;
        }
    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>填写<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>并上传<strong class="example-control-reference"
                data-example-control="filePhoto" title="个人头像">个人头像</strong>，后台校验文件后显示图片结果。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-upload" aria-hidden="true"></i>校验并上传头像</h3>
        <ol>
            <li>
                <strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>输入 <code>tom</code>，选择一张合格图片，再点击<strong
                    class="example-control-reference" data-example-control="btnSubmit" title="提交">提交</strong>。<br />
                结果：后台校验并保存图片，下方显示<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>
                <code>tom</code>、文件名和头像，成功后清空表单和文件选择。
            </li>
            <li>
                重新填写<strong class="example-control-reference" data-example-control="tbxUserName" title="用户名">用户名</strong>，选择不符合类型或大小限制的文件，再提交。<br />
                结果：后台提示具体校验错误，清空无效文件选择，不把该文件保存为头像。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：由于浏览器安全限制，部分浏览器下只显示文件名（<code>1</code>.<code>png</code>）或者假路径（<code>C</code>:\<code>fakepath</code>\<code>1</code>.<code>png</code>）。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Required</code>（<strong class="example-control-reference" data-example-control="filePhoto" title="个人头像">个人头像</strong>）：限制为空时能否通过表单验证。
                本页<strong class="example-control-reference" data-example-control="filePhoto" title="个人头像">个人头像</strong>声明值为 <code>true</code>。</li>
        </ul>
    </section>
}
