@{
    ViewBag.Title = "Form/FormValidate";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("用户注册表单")
        .Items(
            F.TextBox().ID("tbxUserName").Label("用户名").Required(true).NextFocusControl("tbxPassword").ShowRedStar(true).Text("admin"),
            F.TextBox().ID("tbxPassword").Label("密码").Required(true).ShowRedStar(true).NextClickControl("btnRegister").TextMode(TextMode.Password),
            F.Button().ID("btnRegister").Text("注册").OnClick(Url.Action("btnRegister_Click"),
                    Parameter.FromFunction("userName", "gettbxUserNameUserNamePostbackValue"),
                    Parameter.FromFunction("password", "gettbxPasswordPasswordPostbackValue")).ValidateForms("SimpleForm1").ValidateTarget(Target.Top)
        )
    )
    <br>
    <br>
    注：
    <ul>
        <li>
            提交表单时验证[用户名]不能为 admin，否则标记为无效
        </li>
    </ul>


}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function gettbxUserNameUserNamePostbackValue() {
            return F.ui.tbxUserName.getValue();
        }

        function gettbxPasswordPasswordPostbackValue() {
            return F.ui.tbxPassword.getValue();
        }

    </script>
}
