@{
    ViewBag.Title = "Form/RadioButtonList";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").LabelWidth(120).BodyPadding(10).ShowBorder(true).ShowHeader(true).Title("简单表单")
        .Items(
            F.RadioButtonList().ID("RadioButtonList1").Label("列表一")
                .Items(
                    F.RadioItem().Text("可选项 1").Value("value1"),
                    F.RadioItem().Text("可选项 2").Value("value2").Selected(true),
                    F.RadioItem().Text("可选项 3").Value("value3")
                ),
            F.Button().ID("btnUpdateList1").CssClass("marginr").Text("更新列表一").OnClick(Url.Action("btnUpdateList1_Click")),
            F.Button().ID("btnCheckedItemsList1").Text("获取列表一的选中项").OnClick(Url.Action("btnCheckedItemsList_Click"),
                    Parameter.FromData("name", "列表一"),
                    Parameter.FromFunction("selected", "getCurrentControlSelectedPostbackValue")),
            F.Label(),
            F.RadioButtonList().ID("RadioButtonList2").Label("列表二（竖排）").ColumnNumber(3).ColumnVertical(true).DataTextField("Name").DataValueField("Id").DataSource(ViewBag.RadioButtonList2DataSource).SelectedValue(ViewBag.RadioButtonList2SelectedValue),
            F.Button().ID("btnUpdateList2").CssClass("marginr").Text("更新列表二").OnClick(Url.Action("btnUpdateList2_Click")),
            F.Button().ID("btnCheckedItemsList2").Text("获取列表二的选中项").OnClick(Url.Action("btnCheckedItemsList_Click"),
                    Parameter.FromData("name", "列表二"),
                    Parameter.FromFunction("selected", "getCurrentControlSelectedPostbackValue2")),
            F.Label(),
            F.RadioButtonList().ID("RadioButtonList4").Label("列表四").ColumnNumber(3).ColumnVertical(false),
            F.Button().ID("btnUpdateList4").CssClass("marginr").Text("更新列表四（可反复操作）").OnClick(Url.Action("btnUpdateList4_Click"), Parameter.FromFunction("count", "getRadioButtonList4CountPostbackValue")),
            F.Button().ID("btnCheckedItemsList4").Text("获取列表四的选中项").OnClick(Url.Action("btnCheckedItemsList_Click"),
                    Parameter.FromData("name", "列表四"),
                    Parameter.FromFunction("selected", "getCurrentControlSelectedPostbackValue3"))
        )
    )
    <br>
    <br>

    @(F.RadioButtonList().ID("RadioButtonList3").Width(700).Label("列表三").ColumnNumber(3).ColumnVertical(false)
        .Items(
            F.RadioItem().Text("可选项 1").Value("value1"),
            F.RadioItem().Text("可选项 2").Value("value2"),
            F.RadioItem().Text("可选项 3").Value("value3"),
            F.RadioItem().Text("可选项 4").Value("value4"),
            F.RadioItem().Text("可选项 5").Value("value5").Selected(true),
            F.RadioItem().Text("可选项 6").Value("value6"),
            F.RadioItem().Text("可选项 7").Value("value7"),
            F.RadioItem().Text("可选项 8").Value("value8")
        )
    )
    <br>

    @(F.Button().ID("btnUpdateList3").CssClass("marginr").Text("更新列表三").OnClick(Url.Action("btnUpdateList3_Click")))
    @(F.Button().ID("btnCheckedItemsList3").Text("获取列表三的选中项").OnClick(Url.Action("btnCheckedItemsList_Click"),
            Parameter.FromData("name", "列表三"),
            Parameter.FromFunction("selected", "getCurrentControlSelectedPostbackValue4"))
    )
    <br>


}

@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlSelectedPostbackValue() {
            return getRadioButtonListSelected('RadioButtonList1');
        }

        function getCurrentControlSelectedPostbackValue2() {
            return getRadioButtonListSelected('RadioButtonList2');
        }

        function getRadioButtonList4CountPostbackValue() {
            return F.ui.RadioButtonList4.items.length;
        }

        function getCurrentControlSelectedPostbackValue3() {
            return getRadioButtonListSelected('RadioButtonList4');
        }

        function getCurrentControlSelectedPostbackValue4() {
            return getRadioButtonListSelected('RadioButtonList3');
        }

    </script>


    <script>

        function getRadioButtonListSelected(cbxListID) {
            return F.all[cbxListID].getValue();
        }


    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>重新绑定单选列表的数据并同时指定新的选中项，也可反复填充和清空。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>更新后读取选择</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnUpdateList1" title="更新列表一">更新列表一</strong>。<br />
                结果：回发后由后台替换为 <code>4</code> 个“数据绑定值”选项，并选中 <code>value1</code>。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnCheckedItemsList1" title="获取列表一的选中项">获取列表一的选中项</strong>。<br />
                结果：显示更新后的当前选中值 <code>value1</code>。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>反复填充和清空</h3>
        <ol>
            <li>
                <strong class="example-control-reference" data-example-control="RadioButtonList4" title="列表四">列表四</strong>为空时点击<strong class="example-control-reference" data-example-control="btnUpdateList4" title="更新列表四（可反复操作）">更新列表四（可反复操作）</strong>。<br />
                结果：<strong class="example-control-reference" data-example-control="RadioButtonList4" title="列表四">列表四</strong>填入选项并出现默认选择。
            </li>
            <li>
                再点同一个按钮。<br />
                结果：<strong class="example-control-reference" data-example-control="RadioButtonList4" title="列表四">列表四</strong>全部选项清空；继续点击可以重新填充。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataSource()</code>（<strong class="example-control-reference" data-example-control="RadioButtonList2" title="列表二（竖排）">列表二（竖排）</strong>）：后台返回新选项及选中值；获取按钮把客户端当前值作为请求参数提交。</li>
        </ul>
    </section>
}
