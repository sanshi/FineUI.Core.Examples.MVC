@{
    ViewBag.Title = "Form/TwinTriggerBoxBlurClearIcon";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("表单").ShowHeader(true)
        .Items(
            F.TwinTriggerBox().ID("TwinTriggerBox1").ShowLabel(false).OnTrigger1Click(Url.Action("TwinTriggerBox1_Trigger1Click")).OnTrigger2Click(Url.Action("TwinTriggerBox1_Trigger2Click"), new Parameter("text", "F.ui.TwinTriggerBox1.getValue()")).Trigger1Icon(TriggerIcon.Clear).ShowTrigger1(false).EmptyText("搜索用户名").Trigger2Icon(TriggerIcon.Search)
                .AutoShowClearIcon(true).Listener("change", "onTwinTriggerBox1Change")

        )
    )
    <br />

}

@section script{
    <script>

        // 记录上一次 TwinTriggerBox1 的值
        var __lastTriggerBoxValue;
        var __changeTimer;

        function onTwinTriggerBox1Change(event) {
            if (__changeTimer) {
                window.clearTimeout(__changeTimer);
                __changeTimer = undefined;
            }
            __changeTimer = window.setTimeout(postBackTriggerBoxChange, 1000);
        }

        function postBackTriggerBoxChange() {
            var value = F.ui.TwinTriggerBox1.getValue();
            // 值改变时才回发
            if (value !== __lastTriggerBoxValue) {
                __lastTriggerBoxValue = value;

                // 触发后台事件
                F.doPostBack({
                    url: '@Url.Action("TwinTriggerBox1_Trigger2Click")',
                    params: {
                        'text': F.ui.TwinTriggerBox1.getValue()
                    }
                });
            }
        }

        function updateLastTriggerBoxValue(text) {
            __lastTriggerBoxValue = text;
        }

        F.ready(function () {
            // 设置 TwinTriggerBox1 初始值
            __lastTriggerBoxValue = F.ui.TwinTriggerBox1.getValue();
        });

    </script>
}
