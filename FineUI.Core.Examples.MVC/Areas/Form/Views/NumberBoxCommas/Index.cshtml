@{
    ViewBag.Title = "Form/NumberBoxCommas";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).LabelAlign(LabelAlign.Top).Title("简单表单").LabelWidth(120)
        .Items(
            F.NumberBox().Label("小数").ID("NumberBox1").Text("-123456789.2345").EnableCommas(true).Required(true).ShowRedStar(true),
            F.NumberBox().Label("正整数").ID("NumberBox2").NoDecimal(true).NoNegative(true).Text("987654321").EnableCommas(true).ShowTrigger(false),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示整数与小数按千分位分组显示。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>格式化长数字</h3>
        <ul>
            <li>
                在“小数”中输入“-12345.6789”，然后移开焦点。<br />
                结果：按两位小数显示为 -12,345.68。
            </li>
            <li>
                在“正整数”中输入“12345678”，然后移开焦点。<br />
                结果：显示为 12,345,678，且不显示增减图标。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableCommas</code>：两个字段均设为 true，用逗号分隔千分位。</li>
        </ul>
    </section>
}
