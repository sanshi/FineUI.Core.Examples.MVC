@{
    ViewBag.Title = "Form/CheckBoxSwitch";
    var F = Html.F();
}

@section head {
    <style>
        .mycheckbox .f-field-checkbox-switch .f-field-checkbox-switch-text {
            min-width: 40px;
        }
    </style>
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("简单表单").LabelWidth(200)
        .Items(
            F.CheckBox().ID("CheckBox1").ShowLabel(false).Text("复选框").Checked(true).DisplayType(CheckBoxDisplayType.Switch),
            F.Button().ID("btnSelectCheckBox").CssClass("marginr").Text("选择/反选复选框").OnClick(Url.Action("btnSelectCheckBox_Click"), Parameter.FromFunction("isChecked", "getCheckBox1IsCheckedPostbackValue")),
            F.Button().ID("btnChangeCheckStatus").CssClass("marginr").Text("选择/反选复选框（客户端脚本）").ClickHandler("onChangeCheckStatusClick"),
            F.Button().ID("btnChangeEnabled").CssClass("marginr").Text("禁用/启用复选框（客户端脚本）").ClickHandler("onChangeEnabledClick"),
            F.Button().ID("btnDisableCheckBox").CssClass("marginr").Text("启用/禁用复选框").OnClick(Url.Action("btnDisableCheckBox_Click"), Parameter.FromFunction("isDisabled", "getCheckBox1IsDisabledPostbackValue")),
            F.Label().ID("Label1"),
            F.CheckBox().ID("CheckBox2").Label("OnCheckedChanged").OnCheckedChanged(Url.Action("CheckBox2_CheckedChanged"), Parameter.FromFunction("isChecked", "getCheckBox2IsCheckedPostbackValue")).Checked(true).DisplayType(CheckBoxDisplayType.Switch),
            F.Label().ID("Label2"),
            F.CheckBox().ID("CheckBox3").Label("开关文本").Checked(true).DisplayType(CheckBoxDisplayType.Switch).SwitchTextVisible(true),
            F.CheckBox().ID("CheckBox4").Label("开关文本（自定义）").DisplayType(CheckBoxDisplayType.Switch).SwitchTextVisible(true).SwitchOnText("1").SwitchOffText("0"),
            F.CheckBox().ID("CheckBox5").Label("开关文本（图标字体）").DisplayType(CheckBoxDisplayType.Switch).SwitchTextVisible(true).SwitchOnTextRawHtml(new RawHtml((string)ViewBag.CheckBox5SwitchOnText)).SwitchOffTextRawHtml(new RawHtml((string)ViewBag.CheckBox5SwitchOffText)),
            F.CheckBox().ID("CheckBox6").CssClass("mycheckbox").Label("开关文本（自定义）").DisplayType(CheckBoxDisplayType.Switch).SwitchTextVisible(true).SwitchOnText("开启").SwitchOffText("关闭")
        )
    )


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCheckBox1IsCheckedPostbackValue() {
            return F.ui.CheckBox1.isChecked();
        }

        function getCheckBox1IsDisabledPostbackValue() {
            return F.ui.CheckBox1.isDisabled();
        }

        function getCheckBox2IsCheckedPostbackValue() {
            return F.ui.CheckBox2.isChecked();
        }

    </script>

    <script>

        function onChangeCheckStatusClick(event) {
            var checkbox = F.ui.CheckBox1;
            checkbox.setValue(!checkbox.getValue());
        }

        function onChangeEnabledClick(event) {
            var checkbox = F.ui.CheckBox1;
            checkbox.setDisabled(!checkbox.isDisabled());
        }


    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示将<strong class="example-control-reference" data-example-control="CheckBox1" title="复选框">复选框</strong>显示为开关，并自定义开关文字、图标及可用状态。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-power-off" aria-hidden="true"></i>切换开关状态</h3>
        <ul>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnSelectCheckBox" title="选择/反选复选框">选择/反选复选框</strong>。<br />
                结果：回发后由后台切换第一个开关的开关状态。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对比开关内容</h3>
        <ul>
            <li>
                依次切换下方的<strong class="example-control-reference" data-example-control="CheckBox3" title="开关文本">开关文本</strong><strong class="example-control-reference" data-example-control="CheckBox4" title="第 4 个复选框（开关文本（自定义））">第 4 个复选框（开关文本（自定义））</strong>、<strong class="example-control-reference" data-example-control="CheckBox6" title="第 6 个复选框（开关文本（自定义））">第 6 个复选框（开关文本（自定义））</strong>和<strong class="example-control-reference" data-example-control="CheckBox5" title="开关文本（图标字体）">开关文本（图标字体）</strong>。<br />
                结果：分别看到默认文字、<code>1</code> / <code>0</code>、勾 / 叉图标，以及开启 / 关闭文字随状态改变；这些外观切换在浏览器完成。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DisplayType</code>（本页全部<strong class="example-control-reference" data-example-control="CheckBox1" title="复选框">复选框</strong>，如<strong class="example-control-reference" data-example-control="CheckBox1" title="复选框">复选框</strong>）：设为 <code>Switch</code>，使用开关外观，当前状态仍由 <code>Checked</code> 表示。</li>
            <li><code>SwitchTextVisible</code>（<strong class="example-control-reference" data-example-control="CheckBox3" title="开关文本">开关文本</strong>、<strong class="example-control-reference" data-example-control="CheckBox4" title="第 4 个复选框（开关文本（自定义））">第 4 个复选框（开关文本（自定义））</strong>、<strong class="example-control-reference" data-example-control="CheckBox5" title="开关文本（图标字体）">开关文本（图标字体）</strong>、<strong class="example-control-reference" data-example-control="CheckBox6" title="第 6 个复选框（开关文本（自定义））">第 6 个复选框（开关文本（自定义））</strong>）：设为 <code>true</code>，显示开关内的文字或图标。</li>
            <li><code>SwitchOnText</code>（<strong class="example-control-reference" data-example-control="CheckBox4" title="第 4 个复选框（开关文本（自定义））">第 4 个复选框（开关文本（自定义））</strong>、<strong class="example-control-reference" data-example-control="CheckBox6" title="第 6 个复选框（开关文本（自定义））">第 6 个复选框（开关文本（自定义））</strong>）：开启状态文字，本例使用 <code>1</code> 或“开启”。</li>
            <li><code>SwitchOffText</code>（<strong class="example-control-reference" data-example-control="CheckBox4" title="第 4 个复选框（开关文本（自定义））">第 4 个复选框（开关文本（自定义））</strong>、<strong class="example-control-reference" data-example-control="CheckBox6" title="第 6 个复选框（开关文本（自定义））">第 6 个复选框（开关文本（自定义））</strong>）：关闭状态文字，本例使用 <code>0</code> 或“关闭”。</li>
            <li><code>SwitchOnTextRawHtml</code>（<strong class="example-control-reference" data-example-control="CheckBox5" title="开关文本（图标字体）">开关文本（图标字体）</strong>）：设置开启状态的可信 HTML，本例使用固定勾图标。</li>
            <li><code>SwitchOffTextRawHtml</code>（<strong class="example-control-reference" data-example-control="CheckBox5" title="开关文本（图标字体）">开关文本（图标字体）</strong>）：设置关闭状态的可信 HTML，本例使用固定叉图标。</li>
        </ul>
    </section>
}
