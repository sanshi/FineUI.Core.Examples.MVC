@{
    ViewBag.Title = "Form/RadioButton";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").LabelWidth(150).Title("简单表单").BodyPadding(10).ShowBorder(true).ShowHeader(true)
        .Items(
            F.RadioButton().ID("rbtnSingleRadio").Label("单选框").Text("可选项").Attribute("data-qtip", "通过Attributes属性设置的提示信息"),
            F.Button().ID("btnSelectSingleRadio").CssClass("marginr").Text("选择/反选单选框").OnClick(Url.Action("btnSelectSingleRadio_Click"), Parameter.FromFunction("isChecked", "getrbtnSingleRadioIsCheckedPostbackValue")),
            F.Button().ID("btnChangeCheckStatus").CssClass("marginr").Text("选择/反选单选框（客户端脚本）").ClickHandler("onChangeCheckStatusClick"),
            F.Label(),
            F.RadioButton().ID("rbtnFirst").Label("单选框（分组）").Checked(true).GroupName("MyRadioGroup1").Text("可选项 1"),
            F.RadioButton().ID("rbtnSecond").GroupName("MyRadioGroup1").ShowEmptyLabel(true).Text("可选项 2"),
            F.RadioButton().ID("rbtnThird").GroupName("MyRadioGroup1").ShowEmptyLabel(true).Text("可选项 3"),
            F.Button().ID("btnSelectSecondRadio").Text("选中分组单选框中的下一个").OnClick(Url.Action("btnSelectSecondRadio_Click"), Parameter.FromFunction("checkedRadio", "getCurrentControlCheckedRadioPostbackValue")),
            F.Label(),
            F.RadioButton().ID("rbtnFirstAuto").Label("单选框（选中改变事件）").Checked(true).GroupName("MyRadioGroup2").Text("可选项 1").OnCheckedChanged(Url.Action("rbtnAuto_CheckedChanged"), Parameter.FromFunction("checkedRadio", "getCurrentControlCheckedRadioPostbackValue2")),
            F.RadioButton().ID("rbtnSecondAuto").GroupName("MyRadioGroup2").ShowEmptyLabel(true).Text("可选项 2").OnCheckedChanged(Url.Action("rbtnAuto_CheckedChanged"), Parameter.FromFunction("checkedRadio", "getCurrentControlCheckedRadioPostbackValue2")),
            F.RadioButton().ID("rbtnThirdAuto").GroupName("MyRadioGroup2").ShowEmptyLabel(true).Text("可选项 3").OnCheckedChanged(Url.Action("rbtnAuto_CheckedChanged"), Parameter.FromFunction("checkedRadio", "getCurrentControlCheckedRadioPostbackValue2"))
        )
    )


}

@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getrbtnSingleRadioIsCheckedPostbackValue() {
            return F.ui.rbtnSingleRadio.getValue();
        }

        function getCurrentControlCheckedRadioPostbackValue() {
            return $('[name=MyRadioGroup1]:checked').val();
        }

        function getCurrentControlCheckedRadioPostbackValue2() {
            return this.getInputLabel();
        }

    </script>


    <script>

        function onChangeCheckStatusClick(event) {
            var radio = F.ui.rbtnSingleRadio;
            radio.setValue(!radio.getValue());
        }


    </script>

}
