@{
    ViewBag.Title = "Form/CheckBoxClientServerEvent";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("简单表单")
        .Items(
            F.CheckBox().ID("CheckBox1").ShowLabel(false).Text("复选框1（先执行客户端事件，再执行服务端事件）")
                .OnCheckedChanged(Url.Action("CheckBox1_CheckedChanged"), Parameter.FromFunction("isChecked", "getCheckBox1IsCheckedPostbackValue")).Checked(true)
                .Listener("change", "onCheckBox1Changed"),
            F.CheckBox().ID("CheckBox2").ShowLabel(false).Text("复选框2（只执行客户端事件）")
                .OnCheckedChanged(Url.Action("CheckBox2_CheckedChanged"), Parameter.FromFunction("isChecked", "getCheckBox2IsCheckedPostbackValue")).Checked(true)
                .Listener("change", "onCheckBox2Changed"),
            F.Label().ID("labResult").EncodeText(false).ShowLabel(false)
        )
    )


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCheckBox1IsCheckedPostbackValue() {
            return F.ui.CheckBox1.isChecked();
        }

        function getCheckBox2IsCheckedPostbackValue() {
            return F.ui.CheckBox2.isChecked();
        }

    </script>

    <script>

        function onCheckBox1Changed(event, checked) {
            F.ui.labResult.setValue("【客户端】复选框1的状态：" + (checked ? "选中" : "未选中"));
        }

        function onCheckBox2Changed(event, checked) {
            F.ui.labResult.setValue("【客户端】复选框2的状态：" + (checked ? "选中" : "未选中"));

            // 客户端事件（change）显式返回false，用于阻止服务端事件的执行（OnCheckedChanged）
            return false;
        }

    </script>
}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>对比客户端变化回调继续回发与返回 false 阻止回发的效果。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-send" aria-hidden="true"></i>决定是否继续后台处理</h3>
        <ul>
            <li>
                切换第一个复选框。<br />
                结果：先写入客户端结果，再由后台更新；最终结果以“【服务端】复选框1的状态”开头。
            </li>
            <li>
                切换第二个复选框。<br />
                结果：客户端回调返回 false，停留在“【客户端】复选框2的状态”结果，不执行后台事件。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>OnCheckedChanged</code>：后台变化事件；客户端对应回调返回 false 时不会请求。</li>
        </ul>
    </section>
}
