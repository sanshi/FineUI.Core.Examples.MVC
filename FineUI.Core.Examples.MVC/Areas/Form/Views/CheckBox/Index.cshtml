@{
    ViewBag.Title = "Form/CheckBox";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).Title("简单表单")
        .Items(
            F.CheckBox().ID("CheckBox1").ShowLabel(false).Text("复选框").Checked(true),
            F.Button().ID("btnSelectCheckBox").CssClass("marginr").Text("选择/反选复选框").OnClick(Url.Action("btnSelectCheckBox_Click"), Parameter.FromFunction("isChecked", "getCheckBox1IsCheckedPostbackValue")),
            F.Button().ID("btnChangeCheckStatus").CssClass("marginr").Text("选择/反选复选框（客户端脚本）").ClickHandler("onChangeCheckStatusClick"),
            F.Button().ID("btnChangeText").Text("改变复选框文本").CssClass("marginr").OnClick(Url.Action("btnChangeText_Click")),
            F.Button().ID("btnDisableCheckBox").CssClass("marginr").Text("启用/禁用复选框").OnClick(Url.Action("btnDisableCheckBox_Click"), Parameter.FromFunction("isDisabled", "getCheckBox1IsDisabledPostbackValue")),
            F.Label().ID("Label1"),
            F.CheckBox().ID("CheckBox2").ShowLabel(false).Text("复选框（OnCheckedChanged）").OnCheckedChanged(Url.Action("CheckBox2_CheckedChanged"), Parameter.FromFunction("isChecked", "getCheckBox2IsCheckedPostbackValue")).Checked(true),
            F.Label().ID("labResult").EncodeText(false).ShowLabel(false)
        )
    )


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCheckBox1IsCheckedPostbackValue() {
            return F.ui.CheckBox1.isChecked();
        }

        function getCheckBox1IsDisabledPostbackValue() {
            return F.ui.CheckBox1.isDisabled();
        }

        function getCheckBox2IsCheckedPostbackValue() {
            return F.ui.CheckBox2.isChecked();
        }

    </script>

    <script>

        function onChangeCheckStatusClick(event) {
            var checkbox = F.ui.CheckBox1;
            checkbox.setValue(!checkbox.getValue());
        }

    </script>
}
