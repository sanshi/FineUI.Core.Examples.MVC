@{
    ViewBag.Title = "Form/NumberBoxPrefix";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).LabelAlign(LabelAlign.Top).Title("简单表单").LabelWidth(120)
        .Items(
            F.NumberBox().Label("人民币").ID("NumberBox1").Text("3000000").EnableCommas(true).Required(true).ShowRedStar(true).NoDecimal(true).NoNegative(true).NumberPrefix("￥"),
            F.NumberBox().Label("美元").ID("NumberBox2").Text("100000").EnableCommas(true).Required(true).ShowRedStar(true).NoDecimal(true).NoNegative(true).NumberPrefix("$"),
            F.NumberBox().Label("百分比").ID("NumberBox3").NoDecimal(false).DecimalPrecision(2).NoNegative(true).Text("42.567").NumberSuffix("%"),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示在数值前后显示货币符号或百分号，并在重新输入后保留格式。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>输入后保留符号</h3>
        <ul>
            <li>
                在<strong class="example-control-reference" data-example-control="NumberBox1" title="人民币">人民币</strong>中输入 <code>999</code>，然后移开焦点。<br />
                结果：显示为 ￥<code>999</code>；初始长数字按千分位分组。
            </li>
            <li>
                在<strong class="example-control-reference" data-example-control="NumberBox3" title="百分比">百分比</strong>中输入 <code>10.5</code>，然后移开焦点。<br />
                结果：显示为 <code>10.5%</code>，符号不需要用户手动输入。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>NumberPrefix</code>（<strong class="example-control-reference" data-example-control="NumberBox1" title="人民币">人民币</strong>、<strong
                    class="example-control-reference" data-example-control="NumberBox2" title="美元">美元</strong>）：<strong class="example-control-reference"
                    data-example-control="NumberBox1" title="人民币">人民币</strong>和美元字段分别使用 ￥、$。</li>
            <li><code>NumberSuffix</code>（<strong class="example-control-reference" data-example-control="NumberBox3" title="百分比">百分比</strong>）：<strong
                    class="example-control-reference" data-example-control="NumberBox3" title="百分比">百分比</strong>字段使用 %，只控制显示单位，不自动除以 <code>100</code>。</li>
        </ul>
    </section>
}
