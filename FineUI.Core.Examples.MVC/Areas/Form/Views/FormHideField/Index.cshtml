@{
    ViewBag.Title = "Form/FormHideField";
    var F = Html.F();
}


@section body {

    @(F.Form().IsFluid(true).LabelWidth(100).BodyPadding(10).ID("Form1").Title("表单")
        .Rows(
            F.FormRow()
                .Items(
                    F.Label().ID("labTitle").HideMode(HideMode.Visibility).Label("标题").Text("申请单"),
                    F.Label().ID("labLiuShuiHao").Label("流水号").Text("123456789")
                ),
            F.FormRow().ID("FormRow2")
                .Items(
                    F.Label().ID("labPhone").Label("电话").Text("0551-1234567"),
                    F.Label().ID("Label16").Label("申请人").Text("admin")
                ),
            F.FormRow().ID("FormRow3").HideMode(HideMode.Visibility)
                .Items(
                    F.Label().ID("Label4").Label("编号").Text("200804170006"),
                    F.TextBox().ID("TextBox2").Required(true).ShowRedStar(true).Label("电子邮箱").EmptyText("请输入常用电子邮箱").RegexPattern(RegexPattern.EMAIL).RegexMessage("请输入有效的邮箱地址")
                ),
            F.FormRow()
                .Items(
                    F.DropDownList().ID("DropDownList3").Label("审批人").Required(true).EmptyText("请选择审批人").ShowRedStar(true).AutoSelectFirstItem(false)
                        .Items(
                            F.ListItem().Text("老大甲").Value("0"),
                            F.ListItem().Text("老大乙").Value("1"),
                            F.ListItem().Text("老大丙").Value("2")
                        ),
                    F.NumberBox().ID("NumberBox1").Label("申请数量").NoDecimal(true).NoNegative(true).EmptyText("请输入申请数量").MaxValue(1000).Required(true).ShowRedStar(true)
                ),
            F.FormRow()
                .Items(
                    F.TextArea().ID("TextArea1").Label("描述").ShowRedStar(true).Required(true)
                ),
            F.FormRow()
                .Items(
                    F.Panel().ID("Panel2").ShowBorder(false).ShowHeader(false)
                        .Items(
                            F.Button().ID("btnSubmit").Text("验证表单并提交").CssClass("marginr").OnClick(Url.Action("btnSubmit_Click"), "Form1").ValidateForms("Form1")
                        )
                )
        )
    )
    <br>

    @(F.Button().ID("btnShowHideTitle").Text("显示隐藏[标题]").CssClass("marginr").ClickHandler("onToggleTitleClick"))
    @(F.Button().ID("btnShowHidePhone").Text("显示隐藏[电话]").ClickHandler("onTogglePhoneClick"))
    <br>
    <br>

    @(F.Button().ID("btnShowHideFormRow2").Text("显示隐藏第二行").CssClass("marginr").ClickHandler("onToggleFormRow2Click"))
    @(F.Button().ID("btnShowHideFormRow3").Text("显示隐藏第三行（隐藏后显示空白行）").CssClass("marginr").ClickHandler("onToggleFormRow3Click"))




}

@section script {

    <script type="text/javascript">

        function onToggleTitleClick(event) {
            F.ui.labTitle.toggleVisible();
        }

        function onTogglePhoneClick(event) {
            F.ui.labPhone.toggleVisible();
        }

        function onToggleFormRow2Click(event) {
            F.ui.FormRow2.toggleVisible();
        }

        function onToggleFormRow3Click(event) {
            F.ui.FormRow3.toggleVisible();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示隐藏单个字段或整行，并对比保留空白位置与释放布局空间这两种隐藏方式。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>隐藏单个字段</h3>
        <ul>
            <li>
                点击“显示隐藏[标题]”。<br />
                结果：浏览器直接隐藏“标题”，原来的位置仍为空白，同行的“流水号”不向左补位。
            </li>
            <li>
                点击“显示隐藏[电话]”。<br />
                结果：浏览器直接隐藏“电话”，释放其占用空间，同一行的“申请人”向左补位。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>隐藏整行</h3>
        <ul>
            <li>
                点击“显示隐藏第二行”。<br />
                结果：“电话、申请人”整行隐藏并释放高度，后面的行向上补位。
            </li>
            <li>
                点击“显示隐藏第三行（隐藏后显示空白行）”。<br />
                结果：“编号、电子邮箱”整行隐藏，仍保留一整行空白。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>恢复显示</h3>
        <ul>
            <li>
                再次点击对应的显示隐藏按钮。<br />
                结果：相应字段或整行恢复显示；各次切换都在浏览器完成，无需回发。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：</p>
        <ul>
            <li> 对比隐藏[标题]和隐藏[电话]的不同之处（[标题]的HideMode=Visibility） </li>
            <li> 对比隐藏第二行和隐藏第三行的不同之处（FormRow3的HideMode=Visibility） </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>HideMode</code>：标题和第三行设为 Visibility，隐藏后占位；电话和第二行使用默认 Display，隐藏后释放空间。</li>
            <li><code>toggleVisible()</code>：在浏览器切换字段或整行的显示状态。</li>
        </ul>
    </section>
}
