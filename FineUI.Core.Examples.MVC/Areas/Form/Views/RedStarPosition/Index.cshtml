@{
    ViewBag.Title = "Form/RedStarPosition";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").Title("表单").ShowBorder(true).BodyPadding(10).ShowHeader(true)
        .Items(
            F.TextBox().ID("tbxUserName").Label("用户名").Required(true).ShowRedStar(true),
            F.TextBox().ID("tbxPassword").Label("密码").TextMode(TextMode.Password).Required(true).ShowRedStar(true)
        )
        .Toolbars(
            F.Toolbar().ID("Toolbar1").ToolbarAlign(ToolbarAlign.Right).Position(ToolbarPosition.Bottom)
                .Items(
                    F.Button().ID("btnLogin").Text("登录").Type(ButtonType.Button).ValidateForms("SimpleForm1").ValidateTarget(Target.Top).OnClick(Url.Action("btnLogin_Click"), "SimpleForm1")
                )
        )
    )
    <br>
    <br>

    @(F.SimpleForm().ID("SimpleForm2")
        .Title("表单(RedStarPosition=BeforeText LabelAlign=Right)").IsFluid(true).ShowBorder(true).BodyPadding(10).ShowHeader(true).RedStarPosition(RedStarPosition.BeforeText).LabelAlign(LabelAlign.Right)
        .Items(
            F.TextBox().ID("TextBox1").Label("用户名").Required(true).ShowRedStar(true),
            F.TextBox().ID("TextBox2").Label("密码").TextMode(TextMode.Password).Required(true).ShowRedStar(true)
        )
        .Toolbars(
            F.Toolbar().ID("Toolbar2").ToolbarAlign(ToolbarAlign.Right).Position(ToolbarPosition.Bottom)
                .Items(
                    F.Button().ID("Button1").Text("登录").Type(ButtonType.Button).ValidateForms("SimpleForm2").ValidateTarget(Target.Top).OnClick(Url.Action("btnLogin_Click"), "SimpleForm2")
                )
        )
    )
    <br>
    <br>

    @(F.SimpleForm().ID("SimpleForm3")
        .Title("表单(RedStarPosition=AfterSeparator LabelAlign=Top)").IsFluid(true).ShowBorder(true).BodyPadding(10).ShowHeader(true).RedStarPosition(RedStarPosition.AfterSeparator).LabelAlign(LabelAlign.Top)
        .Items(
            F.TextBox().ID("TextBox3").Label("用户名").Required(true).ShowRedStar(true),
            F.TextBox().ID("TextBox4").Label("密码").TextMode(TextMode.Password).Required(true).ShowRedStar(true)
        )
        .Toolbars(
            F.Toolbar().ID("Toolbar3").ToolbarAlign(ToolbarAlign.Right).Position(ToolbarPosition.Bottom)
                .Items(
                    F.Button().ID("Button3").Text("登录").Type(ButtonType.Button).ValidateForms("SimpleForm3").ValidateTarget(Target.Top).OnClick(Url.Action("btnLogin_Click"), "SimpleForm3")
                )
        )
    )


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>对比必填星号在标签文字前后及分隔符后的显示位置。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照三个表单</h3>
        <ul>
            <li>
                对照三组用户名和密码字段。<br />
                结果：默认表单、文字前星号、分隔符后星号采用不同显示方式；其中标签靠右和位于上方的设置也不同。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RedStarPosition</code>（<strong class="example-control-reference" data-example-control="SimpleForm2"
                    title="表单(RedStarPosition=BeforeText LabelAlign=Right)">表单(RedStarPosition=BeforeText LabelAlign=Right)</strong>、<strong
                    class="example-control-reference" data-example-control="SimpleForm3"
                    title="表单(RedStarPosition=AfterSeparator LabelAlign=Top)">表单(RedStarPosition=AfterSeparator
                    LabelAlign=Top)</strong>）：对比默认位置、<code>BeforeText</code> 与 <code>AfterSeparator</code>。</li>
        </ul>
    </section>
}
