@{
    ViewBag.Title = "Form/FormColumnWidths";
    var F = Html.F();
}


@section head {

    <style>
        .speciallabel {
            color: red;
        }
    </style>

}


@section body {

    @(F.Form().IsFluid(true).BodyPadding(10).LabelAlign(LabelAlign.Left).ID("Form1").Title("表单")
        .Rows(
            F.FormRow().ColumnWidths("20px 50% 50%")
                .Items(
                    F.Label().CssClass("speciallabel").Text("1."),
                    F.Label().ID("Label3").Label("电话").Text("0551-1234567"),
                    F.Label().ID("Label16").Label("申请人").Text("admin")
                ),
            F.FormRow().ColumnWidths("20px 50% 50%")
                .Items(
                    F.Label().ID("Label1").CssClass("speciallabel").Text("2."),
                    F.Label().ID("Label4").Label("编号").Text("200804170006"),
                    F.TextBox().ID("TextBox2").Required(true).ShowRedStar(true).Label("电子邮箱").RegexPattern(RegexPattern.EMAIL).RegexMessage("请输入有效的邮箱地址")
                ),
            F.FormRow().ColumnWidths("20px 100%")
                .Items(
                    F.Label().ID("Label2").CssClass("speciallabel").Text("3."),
                    F.DropDownList().ID("DropDownList3").Label("审批人").ForceSelection(false).Required(true).ShowRedStar(true)
                        .Items(
                            F.ListItem().Text("老大甲").Value("0"),
                            F.ListItem().Text("老大乙").Value("1"),
                            F.ListItem().Text("老大丙").Value("2")
                        )
                ),
            F.FormRow().ColumnWidths("20px 100%")
                .Items(
                    F.Label().ID("Label5").CssClass("speciallabel").Text("4."),
                    F.NumberBox().ID("NumberBox1").Label("申请数量").NoDecimal(true).NoNegative(true).MaxValue(1000).Required(true).ShowRedStar(true)
                ),
            F.FormRow().ColumnWidths("20px 100%")
                .Items(
                    F.Label().ID("Label6").CssClass("speciallabel").Text("5."),
                    F.TextArea().ID("TextArea1").Label("描述").ShowRedStar(true).Required(true)
                ),
            F.FormRow()
                .Items(
                    F.Panel().ID("Panel2").ShowBorder(false).ShowHeader(false)
                        .Items(
                            F.Button().ID("btnSubmit").Text("提交表单").CssClass("marginr").OnClick(Url.Action("btnSubmit_Click"), "Form1").ValidateForms("Form1")
                        )
                )
        )
    )





}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示一行内混用固定宽度和百分比，让编号列固定、其余字段按比例伸展。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照固定列与伸展列</h3>
        <ul>
            <li>
                对照每行开头的编号与后面的字段。<br />
                结果：编号区域使用 20 像素宽度，其余一列占满或两列等分剩余空间。
            </li>
            <li>
                调整浏览器宽度，再填写邮箱、审批人、申请数量和描述。<br />
                结果：编号仍保持固定宽度，输入区域随容器伸缩，原输入不丢失。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：假设行的总宽度是 100px，行的属性 ColumnWidths="20px 50% 50%"，则：</p>
        <ul>
            <li>第一个字段宽度：20px</li>
            <li>第二个字段宽度：40px</li>
            <li>第三个字段宽度：40px</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ColumnWidths</code>：本页使用 20px 50% 50% 或 20px 100%。</li>
            <li><code>IsFluid</code>：表单随父容器伸缩。</li>
        </ul>
    </section>
}
