@{
    ViewBag.Title = "Form/FileUploadTool";
    var F = Html.F();
}

@section head {

    <style>
        .photo {
            height: 150px;
            line-height: 150px;
            overflow: hidden;
        }

            .photo img {
                height: 150px;
                vertical-align: middle;
            }
    </style>

}

@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("表单").ShowHeader(true)
        .Items(
            F.Image().ID("imgPhoto").CssClass("photo").ImageUrl(Url.Content("~/res/images/blank.png")).ShowEmptyLabel(true),
            F.TextBox().Label("用户名").ID("tbxUserName").Required(true).ShowRedStar(true),
            F.TextBox().Label("邮箱").ID("tbxEmail").Required(true).RegexPattern(RegexPattern.EMAIL).RegexMessage("请输入有效的邮箱地址").ShowRedStar(true),
            F.Button().ID("btnSubmit").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1", Parameter.FromFunction("imgPhotoUrl", "getimgPhotoImgPhotoUrlPostbackValue")).ValidateForms("SimpleForm1").Text("提交表单")
        )
        .Tools(
            F.Tool().IconFont(IconFont._Upload).Text("上传头像").ClickHandler("onUploadClick")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))
    @(F.FileUpload().ID("filePhoto").Hidden(true).OnFileSelected(Url.Action("filePhoto_FileSelected"), "filePhoto"))

}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getimgPhotoImgPhotoUrlPostbackValue() {
            return F.ui.imgPhoto.el.find('img').attr('src');
        }

    </script>


    <script>

        function onUploadClick(event) {
            F.ui.filePhoto.el.find('.f-field-fileupload-fileinput').click();
        }

    </script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示由工具图标触发隐藏的文件选择框。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-upload" aria-hidden="true"></i>先上传头像</h3>
        <ol>
            <li>
                点击表单标题栏的“上传头像”工具图标，选择一张合格图片。<br />
                结果：文件选中事件立即回发；后台校验并保存图片，头像区域由空白图变为新头像，同时清空文件选择。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Hidden</code>（<strong class="example-control-reference" data-example-control="filePhoto"
                    title="上传控件">上传控件</strong>）：隐藏上传字段，由工具图标触发系统选择对话框。 本页声明值为 <code>true</code>。</li>
        </ul>
    </section>
}
