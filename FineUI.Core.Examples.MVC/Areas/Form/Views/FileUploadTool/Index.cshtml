@{
    ViewBag.Title = "Form/FileUploadTool";
    var F = Html.F();
}

@section head {

    <style>
        .photo {
            height: 150px;
            line-height: 150px;
            overflow: hidden;
        }

            .photo img {
                height: 150px;
                vertical-align: middle;
            }
    </style>

}

@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("表单").ShowHeader(true)
        .Items(
            F.Image().ID("imgPhoto").CssClass("photo").ImageUrl(Url.Content("~/res/images/blank.png")).ShowEmptyLabel(true),
            F.TextBox().Label("用户名").ID("tbxUserName").Required(true).ShowRedStar(true),
            F.TextBox().Label("邮箱").ID("tbxEmail").Required(true).RegexPattern(RegexPattern.EMAIL).RegexMessage("请输入有效的邮箱地址").ShowRedStar(true),
            F.Button().ID("btnSubmit").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1", new Parameter("imgPhotoUrl", "F.ui.imgPhoto.el.find('img').attr('src')")).ValidateForms("SimpleForm1").Text("提交表单")
        )
        .Tools(
            F.Tool().IconFont(IconFont._Upload).Text("上传头像").ClickHandler("onUploadClick")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))
    @(F.FileUpload().ID("filePhoto").Hidden(true).OnFileSelected(Url.Action("filePhoto_FileSelected"), "filePhoto"))

}


@section script {

    <script>

        function onUploadClick(event) {
            F.ui.filePhoto.el.find('.f-field-fileupload-fileinput').click();
        }

    </script>

}
