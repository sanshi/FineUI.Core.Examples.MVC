@{
    ViewBag.Title = "Form/NumberBoxProgress";
    var F = Html.F();
}


@section body {

    @(F.NumberBox().ID("NumberBox1").Width(500).Text("25").DisplayType(NumberBoxDisplayType.Progress))
    <br>
    <br>

    @(F.NumberBox().ID("NumberBox2").Width(500).Text("50").DisplayType(NumberBoxDisplayType.Progress))
    <br>
    <br>

    @(F.NumberBox().ID("NumberBox3").Width(500).Text("75").DisplayType(NumberBoxDisplayType.Progress).ProgressTextVisible(true))
    <br>
    <br>

    @(F.NumberBox().ID("NumberBox4").Width(500).Text("95").DisplayType(NumberBoxDisplayType.Progress).ProgressTextVisible(true).ProgressHeight(15))
    <br>
    <br>
    <br>

    @(F.NumberBox().ID("NumberBox5").Width(500).Text("25").DisplayType(NumberBoxDisplayType.Progress).ProgressTextVisible(true).ProgressTextInside(true).ProgressHeight(15))
    <br>
    <br>

    @(F.NumberBox().ID("NumberBox6").Width(500).Text("50").DisplayType(NumberBoxDisplayType.Progress).ProgressTextVisible(true).ProgressTextInside(true).ProgressHeight(15))
    <br>
    <br>

    @(F.NumberBox().ID("NumberBox7").Width(500).Text("75").DisplayType(NumberBoxDisplayType.Progress).ProgressTextVisible(true).ProgressTextInside(true).ProgressHeight(15))
    <br>
    <br>

    @(F.NumberBox().ID("NumberBox8").Width(500).Text("95").DisplayType(NumberBoxDisplayType.Progress).ProgressTextVisible(true).ProgressTextInside(true).ProgressHeight(15))
    <br>
    <br>
    <br>

    @(F.Button().Text("0%").ClickHandler("onChangeTo0Click").MarginRight(5))
    @(F.Button().Text("25%").ClickHandler("onChangeTo25Click").MarginRight(5))
    @(F.Button().Text("50%").ClickHandler("onChangeTo50Click").MarginRight(5))
    @(F.Button().Text("75%").ClickHandler("onChangeTo75Click").MarginRight(5))
    @(F.Button().Text("100%").ClickHandler("onChangeTo100Click").MarginRight(5))
    <br>
    <br>

}


@section script {

    <script>

        function changeTo(num) {
            F.ui.NumberBox1.setValue(num);
            F.ui.NumberBox2.setValue(num);
            F.ui.NumberBox3.setValue(num);
            F.ui.NumberBox4.setValue(num);
            F.ui.NumberBox5.setValue(num);
            F.ui.NumberBox6.setValue(num);
            F.ui.NumberBox7.setValue(num);
            F.ui.NumberBox8.setValue(num);
        }

        function onChangeTo0Click(event) {
            changeTo(0);
        }

        function onChangeTo25Click(event) {
            changeTo(25);
        }

        function onChangeTo50Click(event) {
            changeTo(50);
        }

        function onChangeTo75Click(event) {
            changeTo(75);
        }

        function onChangeTo100Click(event) {
            changeTo(100);
        }

    </script>

}