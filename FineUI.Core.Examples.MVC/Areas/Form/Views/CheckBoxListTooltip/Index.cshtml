@{
    ViewBag.Title = "Form/CheckBoxListTooltip";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").LabelWidth(160).BodyPadding(10).ShowBorder(true).ShowHeader(true).Title("简单表单")
        .Items(
            F.CheckBoxList().ID("CheckBoxList1").Label("列表一")
                .Items(
                    F.CheckItem().Text("可选项 1").Value("value1"),
                    F.CheckItem().Text("可选项 2").Value("value2").Selected(true),
                    F.CheckItem().Text("可选项 3").Value("value3").Selected(true)
                ),
            F.CheckBoxList().ID("CheckBoxList2").Label("列表二（一列）").ColumnNumber(1).DataTextField("Name").DataValueField("Id").DataSource(ViewBag.CheckBoxList2DataSource).SelectedValueArray(ViewBag.CheckBoxList2SelectedValueArray)
        )
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Bottom).ToolbarAlign(ToolbarAlign.Right)
                .Items(
                    F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
                )
        )
    )


    <br />
    <br />
    注：在页面视图上，通过遍历数据源来更新下拉列表每一项的属性。

    @{
        CheckBoxList CheckBoxList1 = F.GetControl<CheckBoxList>("CheckBoxList1");
        // 手工设置复选框列表项的提示信息
        CheckBoxList1.Items[0].Attributes["data-qtip"] = "这是第一个选项的提示信息";
        CheckBoxList1.Items[1].Attributes["data-qtip"] = "这是第二个选项的提示信息";
        CheckBoxList1.Items[2].Attributes["data-qtip"] = "这是第三个选项的提示信息";




        CheckBoxList CheckBoxList2 = F.GetControl<CheckBoxList>("CheckBoxList2");

        // 视图中设置控件的DataSource属性，会延迟到页面渲染时才调用DataBind函数。如果需要在视图中访问Items属性，需要手工调用DataBind函数。
        CheckBoxList2.DataBind();

        foreach (var item in CheckBoxList2.Items)
        {
            item.Attributes["data-qtip"] = String.Format("{0}（值：{1}）", item.Text, item.Value);
        }

    }
}

