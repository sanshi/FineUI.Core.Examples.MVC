@{
    ViewBag.Title = "Form/CheckBoxListSwitch";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").LabelWidth(160).BodyPadding(10).ShowBorder(true).ShowHeader(true).Title("简单表单")
        .Items(
            F.CheckBoxList().ID("CheckBoxList1").Label("列表一").DisplayType(CheckBoxDisplayType.Switch)
                .Items(
                    F.CheckItem().Text("可选项 1").Value("value1"),
                    F.CheckItem().Text("可选项 2").Value("value2").Selected(true),
                    F.CheckItem().Text("可选项 3").Value("value3").Selected(true)
                ),
            F.Button().ID("btnServerSetSelectedValue").CssClass("marginr").Text("选中上面列表中的第一项和第三项").OnClick(Url.Action("btnServerSetSelectedValue_Click")),
            F.Button().ID("btnServerGetSelectedValue").CssClass("marginr").Text("获取上面列表的选中项").OnClick(Url.Action("btnServerGetSelectedValue_Click"), Parameter.FromFunction("selected", "getCurrentControlSelectedPostbackValue")),
            F.Button().ID("btnClientGetSelectedValue").Text("获取上面列表的选中项（JavaScript 脚本）").ClickHandler("onAlertSelectedValueClick"),
            F.Label(),
            F.CheckBoxList().ID("CheckBoxList2").Label("列表二（一列）").ColumnNumber(1).DataTextField("Name").DataValueField("Id").DataSource(ViewBag.CheckBoxList2DataSource).SelectedValueArray(ViewBag.CheckBoxList2SelectedValueArray).DisplayType(CheckBoxDisplayType.Switch),
            F.Label(),
            F.CheckBoxList().ID("CheckBoxList3").OnSelectedIndexChanged(Url.Action("CheckBoxList3_SelectedIndexChanged"), Parameter.FromFunction("selected", "getCurrentControlSelectedPostbackValue2")).Label("列表三（选中项改变事件）").ColumnNumber(3).ShowRedStar(true).Required(true).DisplayType(CheckBoxDisplayType.Switch).SwitchTextVisible(true)
                .Items(
                    F.CheckItem().Text("可选项 1（很长很长很长很长很长很长的可选项）").Value("value1"),
                    F.CheckItem().Text("可选项 2").Value("value2"),
                    F.CheckItem().Text("可选项 3").Value("value3"),
                    F.CheckItem().Text("可选项 4").Value("value4"),
                    F.CheckItem().Text("可选项 5").Value("value5"),
                    F.CheckItem().Text("可选项 6").Value("value6"),
                    F.CheckItem().Text("可选项 7").Value("value7"),
                    F.CheckItem().Text("可选项 8").Value("value8")
                ),
            F.Label(),
            F.CheckBoxList().ID("rblVertical").Label("列表四（竖排）").ColumnNumber(3).ColumnVertical(true).ShowRedStar(true).Required(true).DisplayType(CheckBoxDisplayType.Switch).SwitchTextVisible(true).SwitchOnText("是").SwitchOffText("否")
                .Items(
                    F.CheckItem().Text("可选项 1").Value("value1"),
                    F.CheckItem().Text("可选项 2").Value("value2"),
                    F.CheckItem().Text("可选项 3").Value("value3"),
                    F.CheckItem().Text("可选项 4").Value("value4"),
                    F.CheckItem().Text("可选项 5").Value("value5"),
                    F.CheckItem().Text("可选项 6").Value("value6"),
                    F.CheckItem().Text("可选项 7").Value("value7"),
                    F.CheckItem().Text("可选项 8").Value("value8")
                )
        )
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Bottom).ToolbarAlign(ToolbarAlign.Right)
                .Items(
                    F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1")
                )
        )
    )


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlSelectedPostbackValue() {
            return getCheckBoxList1Selected();
        }

        function getCurrentControlSelectedPostbackValue2() {
            return this.getValue();
        }

    </script>

    <script type="text/javascript">

        function onAlertSelectedValueClick(event) {
            var list1 = F.ui.CheckBoxList1;

            var selectedValues = list1.getValue();
            if (selectedValues.length) {
                top.F.alert("列表一的选中项：" + selectedValues.join(','));
            } else {
                top.F.alert("列表一没有选中项！");
            }
        }


        function getCheckBoxList1Selected() {
            var list = F.ui.CheckBoxList1;

            var result = [];
            $.each(list.items, function (index, item) {
                if (item.isChecked()) {
                    result.push({
                        'label': item.getInputLabel(),
                        'value': item.getInputValue()
                    });
                }
            });

            return F.toJSON(result);
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>将复选列表显示为开关，并对比默认、自定义状态文字。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-power-off" aria-hidden="true"></i>切换开关选项</h3>
        <ol>
            <li>
                切换列表一的第一个开关。<br />
                结果：该项的选中状态改变，其它开关独立保持当前状态。
            </li>
            <li>
                切换带状态文字的列表四开关。<br />
                结果：状态文字随开关在“是”和“否”间改变。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DisplayType</code>：使用开关外观，选择值仍是复选列表的多值集合。 本页“列表一”声明值为 CheckBoxDisplayType.Switch。</li>
            <li><code>SwitchTextVisible</code>：显示开关状态文字。 本页“列表三（选中项改变事件）”声明值为 true。</li>
            <li><code>SwitchOnText</code>：开关开启状态的文字。 本页“列表四（竖排）”声明值为 是。</li>
            <li><code>SwitchOffText</code>：开关关闭状态的文字。 本页“列表四（竖排）”声明值为 否。</li>
        </ul>
    </section>
}
