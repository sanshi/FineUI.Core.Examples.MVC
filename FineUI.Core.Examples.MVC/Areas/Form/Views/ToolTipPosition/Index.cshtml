@{
    ViewBag.Title = "Form/ToolTipPosition";
    var F = Html.F();
}


@section body {

    <div style="padding: 50px 150px; width: 900px;">
    <table style="width: 100%; border-spacing: 20px;">
        <tr>
            <td></td>
            <td style="text-align: center;">
                @(F.Button().ID("btnTopStart").CssClass("marginr").Text("TopStart").ToolTip("这是提示信息").ToolTipType(ToolTipType.Qtip).ToolTipPosition(ToolTipPosition.TopStart).Width(100))
                @(F.Button().ID("btnTop").CssClass("marginr").Text("Top").ToolTip("这是提示信息").ToolTipType(ToolTipType.Qtip).ToolTipPosition(ToolTipPosition.Top).Width(100))
                @(F.Button().ID("btnTopEnd").Text("TopEnd").ToolTip("这是提示信息").ToolTipType(ToolTipType.Qtip).ToolTipPosition(ToolTipPosition.TopEnd).Width(100))
            </td>
            <td></td>
        </tr>
        <tr>
            <td style="text-align: right;">
                @(F.Button().Text("LeftStart").ToolTipRawHtml(new RawHtml("这是提示信息<br>这是第二行提示信息")).ToolTipType(ToolTipType.Qtip).ToolTipPosition(ToolTipPosition.LeftStart).Width(100))
            </td>
            <td></td>
            <td style="text-align: left;">
                @(F.Button().Text("RightStart").ToolTipRawHtml(new RawHtml("这是提示信息<br>这是第二行提示信息")).ToolTipType(ToolTipType.Qtip).ToolTipPosition(ToolTipPosition.RightStart).Width(100))
            </td>
        </tr>
        <tr>
            <td style="text-align: right;">
                @(F.Button().ID("btnLeft").Text("Left").ToolTipRawHtml(new RawHtml("这是提示信息<br>这是第二行提示信息")).ToolTipType(ToolTipType.Qtip).ToolTipPosition(ToolTipPosition.Left).Width(100))
            </td>
            <td></td>
            <td style="text-align: left;">
                @(F.Button().ID("btnRight").Text("Right").ToolTipRawHtml(new RawHtml("这是提示信息<br>这是第二行提示信息")).ToolTipType(ToolTipType.Qtip).ToolTipPosition(ToolTipPosition.Right).Width(100))
            </td>
        </tr>
        <tr>
            <td style="text-align: right;">
                @(F.Button().Text("LeftEnd").ToolTipRawHtml(new RawHtml("这是提示信息<br>这是第二行提示信息")).ToolTipType(ToolTipType.Qtip).ToolTipPosition(ToolTipPosition.LeftEnd).Width(100))
            </td>
            <td></td>
            <td style="text-align: left;">
                @(F.Button().Text("RightEnd").ToolTipRawHtml(new RawHtml("这是提示信息<br>这是第二行提示信息")).ToolTipType(ToolTipType.Qtip).ToolTipPosition(ToolTipPosition.RightEnd).Width(100))
            </td>
        </tr>
        <tr>
            <td></td>
            <td style="text-align: center;">
                @(F.Button().CssClass("marginr").Text("BottomStart").ToolTip("这是提示信息").ToolTipType(ToolTipType.Qtip).ToolTipPosition(ToolTipPosition.BottomStart).Width(100))
                @(F.Button().ID("btnBottom").CssClass("marginr").Text("Bottom").ToolTip("这是提示信息").ToolTipType(ToolTipType.Qtip).ToolTipPosition(ToolTipPosition.Bottom).Width(100))
                @(F.Button().Text("BottomEnd").ToolTip("这是提示信息").ToolTipType(ToolTipType.Qtip).ToolTipPosition(ToolTipPosition.BottomEnd).Width(100))
            </td>
            <td></td>
        </tr>
    </table>
</div>

}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示提示框在控件上、下、左、右及各方向起止位置的排列。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对比提示位置和多行内容</h3>
        <ul>
            <li>
                分别悬停 <strong class="example-control-reference" data-example-control="btnTop" title="Top">Top</strong>、<strong class="example-control-reference" data-example-control="btnBottom" title="Bottom">Bottom</strong>、<strong class="example-control-reference" data-example-control="btnLeft" title="Left">Left</strong>、<strong class="example-control-reference" data-example-control="btnRight" title="Right">Right</strong> 等按钮。<br />
                结果：提示出现在按钮文字指定的相对方向，<code>Start</code>、<code>End</code> 控制沿该方向的对齐位置。
            </li>
            <li>
                悬停左右方向的按钮。<br />
                结果：提示中显示两行文字，换行由本页固定 HTML 内容提供。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ToolTipPosition</code>（<strong class="example-control-reference" data-example-control="btnTopStart" title="TopStart">TopStart</strong>、<strong class="example-control-reference" data-example-control="btnTop" title="Top">Top</strong>、<strong class="example-control-reference" data-example-control="btnTopEnd" title="TopEnd">TopEnd</strong>、<strong class="example-control-reference" data-example-control="btnBottom" title="Bottom">Bottom</strong>）：使用 <code>TopStart</code>、<code>Top</code>、<code>TopEnd</code>、<code>Bottom</code> 及左右方向的对应位置。</li>
        </ul>
    </section>
}
