@{
    ViewBag.Title = "Form/CheckBoxListUpdate";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").LabelWidth(120).BodyPadding(10).ShowBorder(true).ShowHeader(true).Title("简单表单")
        .Items(
            F.CheckBoxList().ID("CheckBoxList1").Label("列表一")
                .Items(
                    F.CheckItem().Text("可选项 1").Value("value1"),
                    F.CheckItem().Text("可选项 2").Value("value2").Selected(true),
                    F.CheckItem().Text("可选项 3").Value("value3").Selected(true)
                ),
            F.Button().ID("btnUpdateList1").CssClass("marginr").Text("更新列表一").OnClick(Url.Action("btnUpdateList1_Click")),
            F.Button().ID("btnCheckedItemsList1").Text("获取列表一的选中项").OnClick(Url.Action("btnCheckedItemsList_Click"),
                    Parameter.FromData("name", "列表一"),
                    Parameter.FromFunction("selected", "getCurrentControlSelectedPostbackValue")),
            F.Label(),
            F.CheckBoxList().ID("CheckBoxList2").Label("列表二（竖排）").ColumnNumber(3).ColumnVertical(true).DataTextField("Name").DataValueField("Id").DataSource(ViewBag.CheckBoxList2DataSource).SelectedValueArray(ViewBag.CheckBoxList2SelectedValueArray),
            F.Button().ID("btnUpdateList2").CssClass("marginr").Text("更新列表二").OnClick(Url.Action("btnUpdateList2_Click")),
            F.Button().ID("btnCheckedItemsList2").Text("获取列表二的选中项").OnClick(Url.Action("btnCheckedItemsList_Click"),
                    Parameter.FromData("name", "列表二"),
                    Parameter.FromFunction("selected", "getCurrentControlSelectedPostbackValue2")),
            F.Label(),
            F.CheckBoxList().ID("CheckBoxList4").Label("列表四").ColumnNumber(3).ColumnVertical(false),
            F.Button().ID("btnUpdateList4").CssClass("marginr").Text("更新列表四（可反复操作）").OnClick(Url.Action("btnUpdateList4_Click"), Parameter.FromFunction("count", "getCheckBoxList4CountPostbackValue")),
            F.Button().ID("btnCheckedItemsList4").Text("获取列表四的选中项").OnClick(Url.Action("btnCheckedItemsList_Click"),
                    Parameter.FromData("name", "列表四"),
                    Parameter.FromFunction("selected", "getCurrentControlSelectedPostbackValue3"))
        )
    )
    <br>
    <br>

    @(F.CheckBoxList().ID("CheckBoxList3").Width(700).Label("列表三").ColumnNumber(3).ColumnVertical(false)
        .Items(
            F.CheckItem().Text("可选项 1").Value("value1"),
            F.CheckItem().Text("可选项 2").Value("value2"),
            F.CheckItem().Text("可选项 3").Value("value3"),
            F.CheckItem().Text("可选项 4").Value("value4"),
            F.CheckItem().Text("可选项 5").Value("value5").Selected(true),
            F.CheckItem().Text("可选项 6").Value("value6").Selected(true),
            F.CheckItem().Text("可选项 7").Value("value7").Selected(true),
            F.CheckItem().Text("可选项 8").Value("value8")
        )
    )
    <br>

    @(F.Button().ID("btnUpdateList3").CssClass("marginr").Text("更新列表三").OnClick(Url.Action("btnUpdateList3_Click")))
    @(F.Button().ID("btnCheckedItemsList3").Text("获取列表三的选中项").OnClick(Url.Action("btnCheckedItemsList_Click"),
            Parameter.FromData("name", "列表三"),
            Parameter.FromFunction("selected", "getCurrentControlSelectedPostbackValue4"))
    )
    <br>


}

@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlSelectedPostbackValue() {
            return getCheckBoxListSelected('CheckBoxList1');
        }

        function getCurrentControlSelectedPostbackValue2() {
            return getCheckBoxListSelected('CheckBoxList2');
        }

        function getCheckBoxList4CountPostbackValue() {
            return F.ui.CheckBoxList4.items.length;
        }

        function getCurrentControlSelectedPostbackValue3() {
            return getCheckBoxListSelected('CheckBoxList4');
        }

        function getCurrentControlSelectedPostbackValue4() {
            return getCheckBoxListSelected('CheckBoxList3');
        }

    </script>

    <script>

        function getCheckBoxListSelected(cbxListID) {
            return F.ui[cbxListID].getValue();
        }


    </script>
}
