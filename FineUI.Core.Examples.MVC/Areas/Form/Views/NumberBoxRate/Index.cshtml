@{
    ViewBag.Title = "Form/NumberBoxRate";
    var F = Html.F();
}


@section body {

    @(F.NumberBox().ID("NumberBox1").DisplayType(NumberBoxDisplayType.Rate).Text("3"))
    <br>
    <br>
    半星评分：
    <br>
    @(F.NumberBox().ID("NumberBox2").DisplayType(NumberBoxDisplayType.Rate).Text("3.5").RateAllowHalf(true))
    <br>
    <br>
    只读：
    <br>
    @(F.NumberBox().ID("NumberBox3").DisplayType(NumberBoxDisplayType.Rate).Text("2").Readonly(true))
    <br>
    <br>
    禁用点击清除：
    <br>
    @(F.NumberBox().ID("NumberBox4").DisplayType(NumberBoxDisplayType.Rate).Text("3").RateAllowClear(false))
    <br>
    <br>
    自定义字符、图标、个数：
    <br>
    @(F.NumberBox().ID("NumberBox5").DisplayType(NumberBoxDisplayType.Rate).Text("3").RateCharacter("A"))
    <br>
    @(F.NumberBox().ID("NumberBox6").DisplayType(NumberBoxDisplayType.Rate).Text("4").RateCharacter("好"))
    <br>
    @(F.NumberBox().ID("NumberBox7").DisplayType(NumberBoxDisplayType.Rate).Text("5").RateIconFont(IconFont._SmileO).RateCount(10))
    <br>
    @(F.NumberBox().ID("NumberBox8").DisplayType(NumberBoxDisplayType.Rate).Text("6").RateIconFont(IconFont._ThumbsUp).RateCount(10))
    <br>
    @(F.NumberBox().ID("NumberBox9").DisplayType(NumberBoxDisplayType.Rate).Text("7").RateIconFont(IconFont._Heart).RateCount(10))
    <br>
    <br>
    评分文本：
    <br>
    @(F.NumberBox().ID("NumberBox10").DisplayType(NumberBoxDisplayType.Rate).Text("3").RateTextVisible(true).RateTextRendererFunction("renderNumberBox10"))
    <br>
    @(F.NumberBox().ID("NumberBox11").DisplayType(NumberBoxDisplayType.Rate).Text("3.5").RateAllowHalf(true).RateTextVisible(true))
    <br>
    <br>
    后台更新：
    <br>
    @(F.NumberBox().ID("NumberBox12").DisplayType(NumberBoxDisplayType.Rate).Text("3"))
    <br>
    @(F.Button().ID("Button1").Text("更新").OnClick(Url.Action("Button1_Click"), new Parameter("currentNum", "F.ui.NumberBox12.getValue()")))
    <br>



}


@section script {

    <script>
        var desc = ['terrible', 'bad', 'normal', 'good', 'wonderful'];

        function renderNumberBox10(val) {
            var rateText = 'not yet rated';
            if (val > 0) {
                rateText = desc[val - 1];
            }
            return rateText;
        }
    </script>

}