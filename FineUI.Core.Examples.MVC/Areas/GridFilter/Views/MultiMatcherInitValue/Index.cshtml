@{
    ViewBag.Title = "GridFilter/MultiMatcherInitValue";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").AllowFilters(true).OnFilterChanged(Url.Action("Grid1_FilterChanged"), "Grid1")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name").EnableFilter(true)
                .Filter(F.GridFilter().EnableMultiConditions(true).MaxConditions(5).MatcherDefault("any")
                    .Operator(
                        F.DropDownList()
                            .Items(
                                F.ListItem().Text("等于").Value("equal"),
                                F.ListItem().Text("包含").Value("contain").Selected(true),
                                F.ListItem().Text("开始于").Value("start"),
                                F.ListItem().Text("结束于").Value("end")
                            )
                    )
                ),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd")
        )
        .DataSource(ViewBag.Grid1DataSource).FilteredData(ViewBag.Grid1FilteredData)
	)
	<br>
	<br>
	@(F.Button().ID("btnUpdateFilteredData").CssClass("marginr").Text("后台更新过滤数据").OnClick(Url.Action("btnUpdateFilteredData_Click"), "Grid1"))
    <br />
    <br />
    注：本例修改了姓名列对应过滤器的MaxConditions属性（最大条件数，默认为2）。
	<br />
	<br />

	@(F.Label().ID("labResult").EncodeText(false).Text(ViewBag.labResultText))

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
