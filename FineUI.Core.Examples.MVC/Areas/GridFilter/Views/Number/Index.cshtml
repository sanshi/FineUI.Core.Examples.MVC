@{
    ViewBag.Title = "GridFilter/Number";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").AllowFilters(true).OnFilterChanged(Url.Action("Grid1_FilterChanged"), "Grid1")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int).EnableFilter(true)
                .Filter(F.GridFilter().EnableMultiConditions(true)
                    .Operator(
                        F.DropDownList()
                            .Items(
                                F.ListItem().Text("大于").Value("greater").Selected(true),
                                F.ListItem().Text("小于").Value("less"),
                                F.ListItem().Text("等于").Value("equal")
                            )
                    )
                    .Field(
                        F.NumberBox().ID("NumberBox1").NoDecimal(true).NoNegative(true)
                    )
                ),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd").EnableFilter(true)
                .Filter(F.GridFilter().EnableMultiConditions(true)
                    .Operator(
                        F.DropDownList()
                            .Items(
                                F.ListItem().Text("大于").Value("greater").Selected(true),
                                F.ListItem().Text("小于").Value("less"),
                                F.ListItem().Text("等于").Value("equal")
                            )
                    )
                    .Field(
                        F.DatePicker().DateFormatString("yyyy-MM-dd")
                    )
                )
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>
    <br>


    @(F.Label().ID("labResult").EncodeText(false))

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>使用数字与日期输入过滤器，按实际数值或日期比较。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>分别按年份与日期筛选</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>的<strong>入学年份</strong>列表头过滤菜单输入<code>2000</code>，保留大于比较并点击过滤面板的确定。<br />结果：过滤条件回发，后台按本页匹配规则筛选示例数据并重新绑定，下方同步显示过滤参数。显示年份大于 2000 的记录，不按文本字母顺序比较。</li>
        <li>在<strong>注册日期</strong>过滤中选择一个日期并应用。<br />结果：记录进一步按日期条件筛选；清除日期条件只撤销日期限制，已设置的年份条件保留。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Filter.Field</code>（<strong>入学年份与注册日期过滤器</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：分别使用 NumberBox 与 DatePicker，让输入类型与匹配数据类型一致；日期按页面格式解析。</li>
    </ul>
</section>
}
