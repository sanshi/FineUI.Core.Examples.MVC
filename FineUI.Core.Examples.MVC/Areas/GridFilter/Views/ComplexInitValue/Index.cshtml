@{
    ViewBag.Title = "GridFilter/ComplexInitValue";
    var F = Html.F();
}

@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").AllowFilters(true).OnFilterChanged(Url.Action("Grid1_FilterChanged"), "Grid1")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name").EnableFilter(true)
                .Filter(F.GridFilter().EnableMultiConditions(true).MatcherDefault("any")
                    .Operator(
                        F.DropDownList()
                            .Items(
                                F.ListItem().Text("等于").Value("equal"),
                                F.ListItem().Text("包含").Value("contain").Selected(true),
                                F.ListItem().Text("开始于").Value("start"),
                                F.ListItem().Text("结束于").Value("end")
                            )
                    )
                ),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").EnableFilter(true)
                .Filter(F.GridFilter()
                    .Field(
                        F.RadioButtonList()
                            .Items(
                                F.RadioItem().Text("男").Value("1"),
                                F.RadioItem().Text("女").Value("0")
                            )
                    )
                ),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int).EnableFilter(true)
                .Filter(F.GridFilter().EnableMultiConditions(true)
                    .Operator(
                        F.DropDownList()
                            .Items(
                                F.ListItem().Text("大于").Value("greater").Selected(true),
                                F.ListItem().Text("小于").Value("less"),
                                F.ListItem().Text("等于").Value("equal")
                            )
                    )
                    .Field(
                        F.NumberBox().ID("NumberBox1").NoDecimal(true).NoNegative(true)
                    )
                ),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true).EnableFilter(true)
                .Filter(F.GridFilter()
                    .Field(
                        F.RadioButtonList()
                            .Items(
                                F.RadioItem().Text("在校").Value("true"),
                                F.RadioItem().Text("已离校").Value("false")
                            )
                    )
                ),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150).EnableFilter(true)
                .Filter(F.GridFilter()
                    .Field(
                        F.CheckBoxList().ColumnNumber(1)
                            .Items(
                                F.CheckItem().Text("材料科学与工程系").Value("材料科学与工程系"),
                                F.CheckItem().Text("化学系").Value("化学系"),
                                F.CheckItem().Text("物理系").Value("物理系"),
                                F.CheckItem().Text("数学系").Value("数学系"),
                                F.CheckItem().Text("自动化系").Value("自动化系")
                            )
                    )
                ),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup").EnableFilter(true)
                .Filter(F.GridFilter()
                    .Field(
                        F.DropDownList().ID("groupList").EnableMultiSelect(true).AutoSelectFirstItem(false).MultiSelectMode(MultiSelectMode.Tags).Items(ViewBag.groupListItems)
                    )
                ),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd").EnableFilter(true)
                .Filter(F.GridFilter().EnableMultiConditions(true)
                    .Operator(
                        F.DropDownList()
                            .Items(
                                F.ListItem().Text("大于").Value("greater").Selected(true),
                                F.ListItem().Text("小于").Value("less"),
                                F.ListItem().Text("等于").Value("equal")
                            )
                    )
                    .Field(
                        F.DatePicker().DateFormatString("yyyy/MM/dd")
                    )
                )
        )
        .DataSource(ViewBag.Grid1DataSource).FilteredData(ViewBag.Grid1FilteredData)
    )
    <br>
    <br>
    @(F.Button().ID("btnUpdateFilteredData").CssClass("marginr").Text("后台更新过滤数据").OnClick(Url.Action("btnUpdateFilteredData_Click"), "Grid1"))
    <br />
    <br />

    @(F.Label().ID("labResult").EncodeText(false).Text(ViewBag.labResultText))

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
