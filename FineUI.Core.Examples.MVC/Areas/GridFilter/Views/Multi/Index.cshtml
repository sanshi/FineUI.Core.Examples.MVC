@{
    ViewBag.Title = "GridFilter/Multi";
    var F = Html.F();
}

@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").AllowFilters(true).OnFilterChanged(Url.Action("Grid1_FilterChanged"), "Grid1")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name").EnableFilter(true)
                .Filter(F.GridFilter().EnableMultiConditions(true).MatcherDefault("any")
                    .Operator(
                        F.DropDownList()
                            .Items(
                                F.ListItem().Text("等于").Value("equal"),
                                F.ListItem().Text("包含").Value("contain").Selected(true),
                                F.ListItem().Text("开始于").Value("start"),
                                F.ListItem().Text("结束于").Value("end")
                            )
                    )
                ),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>
    <br>


    @(F.Label().ID("labResult").EncodeText(false))

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>为姓名配置多个条件，并选择满足任意一项或全部条件。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>比较任一与全部匹配</h3>
    <ol>
        <li>打开<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>的<strong>姓名</strong>列表头过滤菜单，设置包含<code>国</code>与包含<code>张</code>两个条件，使用任一匹配并确定。<br />结果：<strong>姓名</strong>包含国或张的记录保留；多个条件属于同一列，按当前匹配方式组合。</li>
        <li>保留两个条件，将匹配方式改为全部并确定。<br />结果：只有同时满足两个包含条件的<strong>姓名</strong>才保留；无匹配记录时显示空表，不沿用之前结果。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableMultiConditions / MatcherDefault</code>（<strong>姓名列过滤器</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：允许同列多个条件，初始匹配方式为 <code>any</code>；any 表示任一条件满足，all 表示全部满足。</li>
    </ul>
</section>
}
