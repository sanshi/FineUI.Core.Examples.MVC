@{
    ViewBag.Title = "GridFilter/InlineFilterComplexInitValue";
    var F = Html.F();
}

@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").AllowFilters(true).InlineFilters(true).OnFilterChanged(Url.Action("Grid1_FilterChanged"), "Grid1")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name").Width(200).EnableFilter(true)
                .Filter(F.GridFilter().EnableMultiConditions(true).MatcherDefault("any")
                    .Operator(
                        F.DropDownList()
                            .Items(
                                F.ListItem().Text("等于").Value("equal"),
                                F.ListItem().Text("包含").Value("contain").Selected(true),
                                F.ListItem().Text("开始于").Value("start"),
                                F.ListItem().Text("结束于").Value("end")
                            )
                    )
                ),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").Width(200).EnableFilter(true)
                .Filter(F.GridFilter()
                    .Field(
                        F.DropDownList().AutoSelectFirstItem(false)
                            .Items(
                                F.ListItem().Text("男").Value("1"),
                                F.ListItem().Text("女").Value("0")
                            )
                    )
                ),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int).Width(200).EnableFilter(true)
                .Filter(F.GridFilter().EnableMultiConditions(true)
                    .Operator(
                        F.DropDownList()
                            .Items(
                                F.ListItem().Text("大于").Value("greater").Selected(true),
                                F.ListItem().Text("小于").Value("less"),
                                F.ListItem().Text("等于").Value("equal")
                            )
                    )
                    .Field(
                        F.NumberBox().ID("NumberBox1").NoDecimal(true).NoNegative(true)
                    )
                ),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true).Width(200).EnableFilter(true)
                .Filter(F.GridFilter()
                    .Field(
                        F.DropDownList().AutoSelectFirstItem(false)
                            .Items(
                                F.ListItem().Text("在校").Value("true"),
                                F.ListItem().Text("已离校").Value("false")
                            )
                    )
                ),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(200).EnableFilter(true)
                .Filter(F.GridFilter()
                    .Field(
                        F.DropDownList().EnableMultiSelect(true).AutoSelectFirstItem(false).MultiSelectMode(MultiSelectMode.Tags)
                            .Items(
                                F.ListItem().Text("材料科学与工程系").Value("材料科学与工程系"),
                                F.ListItem().Text("化学系").Value("化学系"),
                                F.ListItem().Text("物理系").Value("物理系"),
                                F.ListItem().Text("数学系").Value("数学系"),
                                F.ListItem().Text("自动化系").Value("自动化系")
                            )
                    )
                ),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup").Width(260).EnableFilter(true)
                .Filter(F.GridFilter()
                    .Field(
                        F.DropDownList().ID("groupList").EnableMultiSelect(true).AutoSelectFirstItem(false).MultiSelectMode(MultiSelectMode.Tags).Items(ViewBag.groupListItems)
                    )
                ),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd").Width(200).EnableFilter(true)
                .Filter(F.GridFilter().EnableMultiConditions(true)
                    .Operator(
                        F.DropDownList()
                            .Items(
                                F.ListItem().Text("大于").Value("greater").Selected(true),
                                F.ListItem().Text("小于").Value("less"),
                                F.ListItem().Text("等于").Value("equal")
                            )
                    )
                    .Field(
                        F.DatePicker().DateFormatString("yyyy-MM-dd")
                    )
                )
        )
		.DataSource(ViewBag.Grid1DataSource).FilteredData(ViewBag.Grid1FilteredData)
	)
    <br>
    <br>
	@(F.Button().ID("btnUpdateFilteredData").CssClass("marginr").Text("后台更新过滤数据").OnClick(Url.Action("btnUpdateFilteredData_Click"), "Grid1"))
    <br />
    <br />

	@(F.Label().ID("labResult").EncodeText(false).Text(ViewBag.labResultText))

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>初次加载即应用内联过滤条件，并允许由后台按钮替换整组条件。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>核对初始过滤与后续替换</h3>
        <ol>
            <li>刚打开页面时查看<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>及对应过滤入口。<br />结果：<strong><strong>入学年份</strong></strong>、<strong>所学专业</strong>与<strong>分组</strong>已带有初始条件，记录已经按这些条件筛选；再次打开过滤区域可看到相同的当前条件。
            </li>
            <li>点击<strong class="example-control-reference" data-example-control="btnUpdateFilteredData"
                    title="后台更新过滤数据">后台更新过滤数据</strong>。<br />结果：后台先清除旧过滤，再设置新条件并重新绑定；原专业、<strong>分组</strong>等条件被替换，改用按钮指定的<strong>性别</strong>与年份条件。过滤入口、记录和下方参数同步更新。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ColumnFilteredData / FilteredData</code>（<strong>列过滤状态与表格过滤集合</strong>，位于<strong class="example-control-reference"
                    data-example-control="Grid1" title="表格">表格</strong>）：初始条件在首次绑定前设置；替换时清除旧集合，避免新旧条件意外叠加。</li>
            <li><code>InlineFilters</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，把当前条件直接显示在列下方，不通过独立弹出面板输入。
            </li>
        </ul>
    </section>
}
