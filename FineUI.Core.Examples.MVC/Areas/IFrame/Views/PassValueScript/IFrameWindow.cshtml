@{
    ViewBag.SourceFiles = "~/Areas/IFrame/Views/PassValueScript/IFrameWindow.cshtml";
    ViewBag.Title = "IFrame/PassValueScript/IFrameWindow";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsViewPort(true).ID("SimpleForm1").LabelAlign(LabelAlign.Top).ShowBorder(false).ShowHeader(false).CssClass("f-widget-content").Title("SimpleForm").BodyPadding(10).AutoScroll(true)
        .Items(
            F.RadioButtonList().ID("ddlSheng").Label("请选择省份").ColumnNumber(4).Listener("change", "onDdlShengChange").DataSource(ProvinceCityCountyData.Provinces).DataTextField("Name").DataValueField("Code").SelectedValue(ProvinceCityCountyData.ProvinceCode(Context.Request.Query["selected"]))
        )
    )

}

@section script {

    <script>

        function onDdlShengChange(event) {
            // 返回当前活动Window对象（浏览器窗口对象通过F.getActiveWindow().window获取）
            var activeWindow = F.getActiveWindow();
            var selectedCode = this.getValue();
            for (var i = 0; i < this.items.length; i++) {
                if (this.items[i].inputValue === selectedCode) {
                    activeWindow.window.updateProvince(this.items[i].inputLabel);
                    break;
                }
            }
            activeWindow.hide();
        }

    </script>
}
