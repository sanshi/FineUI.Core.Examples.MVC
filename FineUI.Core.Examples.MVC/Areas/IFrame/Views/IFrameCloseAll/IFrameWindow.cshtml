@{
    ViewBag.Title = "IFrame/IFrameCloseAll/IFrameWindow";
    var F = Html.F();
}


@section body {

    @(F.Panel().ID("formPanel").ShowBorder(false).ShowHeader(false).CssClass("f-widget-content").IsViewPort(true).BodyPadding(10)
        .Toolbars(
            F.Toolbar()
                .Items(
                    F.Button().ID("btnPostBackClose").ClickHandler("onCloseActiveWindowPostBackClick").Text("回发弹出窗体"),
                    F.Button().ID("Button1").Text("本页面弹出窗体").ClickHandler("onOpenWindow3Click"),
                    F.Button().ID("Button2").Text("父页面弹出窗体").ClickHandler("onOpenWindow4Click")
                )
        )
        .Items(
            F.Label().ID("labResult").EncodeText(false).CssStyle("font-weight:bold;")
                .Text("页面加载时间：" + DateTime.Now.ToLongTimeString())
        )
    )
    @(F.Window().ID("Window3").EnableIFrame(true).IFrameUrl(Url.Content("~/IFrame/IFrameCloseAll/IFrameWindow2")).EnableMaximize(true).EnableResize(true).OnClose(Url.Action("Window3_Close")).Height(300).Width(600).Title("窗体三").Hidden(true))
    @(F.Window().ID("Window4").EnableIFrame(true).IFrameUrl(Url.Content("~/IFrame/IFrameCloseAll/IFrameWindow2")).OnClose(Url.Action("Window4_Close")).EnableMaximize(true).EnableResize(true).Target(Target.Parent).Height(300).Width(600).Title("窗体四").Hidden(true))


}

@section script {

    <script type="text/javascript">

        function onCloseActiveWindowPostBackClick(event) {
            F.activeWindow.hidePostBack();
        }

        function onOpenWindow3Click(event) {
            F.ui.Window3.show();
        }

        function onOpenWindow4Click(event) {
            F.ui.Window4.show();
        }

    </script>
}
