@{
    ViewBag.Title = "Tree/TreeNoIcon";
    var F = Html.F();
}

@section body {

    @(F.Tree().IsFluid(true).ID("Tree1").ShowHeader(true).Title("树控件（隐藏节点图标）").EnableIcons(false)
        .Nodes(
            F.TreeNode().Text("中国").NodeID("china").Expanded(true)
                .Nodes(
                    F.TreeNode().Text("河南省").NodeID("henan").Expanded(true)
                        .Nodes(
                            F.TreeNode().Text("驻马店市").Expanded(true).NodeID("zhumadian")
                                .Nodes(
                                    F.TreeNode().Text("遂平县").Icon(Icon.TagBlue).NodeID("suiping"),
                                    F.TreeNode().Text("西平县").Icon(Icon.TagBlue).NodeID("xiping")
                                ),
                            F.TreeNode().Text("漯河市").NodeID("luohe").IconUrl(Url.Content("~/res/icon/tag_orange.png"))
                        ),
                    F.TreeNode().Text("安徽省").Expanded(true).NodeID("anhui")
                        .Nodes(
                            F.TreeNode().Expanded(true).Text("合肥市").NodeID("hefei")
                                .Nodes(
                                    F.TreeNode().Text("中国科学技术大学（链接）").NavigateUrl("http://www.ustc.edu.cn/").Target("_blank").ToolTip("点击跳转到科大主页").NodeID("ustc")
                                ),
                            F.TreeNode().Text("黄山市").NodeID("huangshan")
                        )
                )
        )
    )
    <br>


    @(F.Button().ID("btnGetSelectedNode").OnClick(Url.Action("btnGetSelectedNode_Click"), Parameter.FromFunction("selectedNode", "getCurrentControlSelectedNodePostbackValue")).CssClass("marginr").Text("获取选中的节点"))
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlSelectedNodePostbackValue() {
            return getSelectedNode();
        }

    </script>


    <script>
        function getSelectedNode() {
            var result;

            var selectedNode = F.ui.Tree1.getSelectedNode(true);
            if (selectedNode) {
                result = {
                    id: selectedNode.id,
                    text: selectedNode.text
                };
            }

            return F.toJSON(result);
        }
    </script>


}