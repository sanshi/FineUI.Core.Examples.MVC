@{
    ViewBag.Title = "Tree/TreeNodeExpand";
    var F = Html.F();
}


@section body {

    @(F.Tree().IsFluid(true).ID("Tree1").ShowHeader(true).OnNodeExpand(Url.Action("Tree1_NodeExpand"), Parameter.FromFunction("nodeInfo", "getCurrentControlNodeInfoPostbackValue")).OnNodeCollapse(Url.Action("Tree1_NodeCollapse"), Parameter.FromFunction("nodeInfo", "getCurrentControlNodeInfoPostbackValue")).Title("树控件")
        .Nodes(
            F.TreeNode().Text("中国").NodeID("china").Expanded(true)
                .Nodes(
                    F.TreeNode().Text("河南省").NodeID("henan").Expanded(true)
                        .Nodes(
                            F.TreeNode().Text("驻马店市").NodeID("zhumadian").Expanded(true)
                                .Nodes(
                                    F.TreeNode().Text("遂平县").Leaf(false).NodeID("suiping")
                                        .Nodes(
                                            F.TreeNode().Text("槐树乡").Leaf(false).NodeID("huaishu")
                                                .Nodes(
                                                    F.TreeNode().Text("陈庄村").NodeID("chenzhuang")
                                                )
                                        )
                                ),
                            F.TreeNode().Text("漯河市").NodeID("luohe")
                        ),
                    F.TreeNode().Text("安徽省").Expanded(true).NodeID("anhui")
                        .Nodes(
                            F.TreeNode().Text("合肥市").Expanded(true).NodeID("hefei")
                                .Nodes(
                                    F.TreeNode().Text("金色池塘小区").NodeID("golden"),
                                    F.TreeNode().Text("中国科学技术大学").NodeID("ustc")
                                )
                        )
                )
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlNodeInfoPostbackValue() {
            return getNodeInfo(arguments[1]);
        }

    </script>


    <script>

        function getNodeInfo(nodeId) {
            var nodeData = F.ui.Tree1.getNodeData(nodeId);

            return F.toJSON({
                id: nodeId,
                text: nodeData.text
            });
        }

    </script>

}