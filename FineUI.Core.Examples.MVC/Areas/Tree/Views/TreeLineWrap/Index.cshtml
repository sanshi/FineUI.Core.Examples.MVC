@{
    ViewBag.Title = "Tree/TreeLineWrap";
    var F = Html.F();
}


@section head {

    <style>
        .nodetitle {
            font-weight: bold;
        }

        .f-tree-node .f-tree-cell-text {
            white-space: normal;
            word-break: break-all;
        }
    </style>

}




@section body {

    @(F.Tree().IsFluid(true).ID("Tree1").ShowHeader(true).Title("树控件").Width(350)
        .Nodes(
            F.TreeNode().Text("中国").Expanded(true).NodeID("china")
                .Nodes(
                    F.TreeNode().Text("河南省").Expanded(true).NodeID("henan")
                        .Nodes(
                            F.TreeNode().TextRawHtml(new RawHtml("<span class='nodetitle'>驻马店市</span>，位于河南省南部，地处淮河流域，历史悠久，文化底蕴深厚。因古时设驿站而得名，素有“豫州之腹地、天下之最中”之称。农业发达，是全国重要的粮食生产基地，被誉为“中原粮仓”。")).NodeID("zhumadian")
                                .Nodes(
                                    F.TreeNode().Text("遂平县").Leaf(false).NodeID("suiping")
                                        .Nodes(
                                            F.TreeNode().Text("槐树乡").Leaf(false).NodeID("huaishu")
                                                .Nodes(
                                                    F.TreeNode().Text("陈庄村").NodeID("chenzhuang")
                                                )
                                        )
                                ),
                            F.TreeNode().Text("漯河市").NodeID("luohe")
                        ),
                    F.TreeNode().Text("安徽省").Expanded(true).NodeID("anhui")
                        .Nodes(
                            F.TreeNode().Text("合肥市").Expanded(true).NodeID("hefei")
                                .Nodes(
                                    F.TreeNode().Text("金色池塘小区").NodeID("golden"),
                                    F.TreeNode().Text("中国科学技术大学").NodeID("ustc")
                                )
                        )
                )
        )
    )


}

