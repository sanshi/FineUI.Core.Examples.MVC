@{
    ViewBag.SourceFiles = "~/Areas/Tree/Content/website.xml";
    ViewBag.Title = "Tree/DataBindDocumentCustom";
    var F = Html.F();
}


@section body {

    @(F.Tree().IsFluid(true).ID("Tree1").ShowHeader(true).Title("树控件（点击树节点回发）").OnNodeClick(Url.Action("Tree1_NodeClick"), Parameter.FromFunction("nodeInfo", "getCurrentControlNodeInfoPostbackValue"))
        .Nodes((TreeNode[])ViewBag.Tree1Nodes)
    )

    @(F.Label().ID("labResult").EncodeText(false))




    <br>
    <br>
    注：从 XmlDocument 手工创建节点列表，并将 Xml 节点属性 Highlight 转化为树节点的 CssClass 属性。

}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlNodeInfoPostbackValue() {
            return getNodeInfo(arguments[1]);
        }

    </script>


    <script>

        function getNodeInfo(nodeId) {
            var nodeData = F.ui.Tree1.getNodeData(nodeId);

            return F.toJSON({
                id: nodeId,
                text: nodeData.text,
                highlight: nodeData.cls === 'highlight'
            });
        }

    </script>

}