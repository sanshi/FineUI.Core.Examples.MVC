@{
    ViewBag.Title = "Tree/TreeIconFont";
    var F = Html.F();
}

@section body {

    @(F.Tree().IsFluid(true).ID("Tree1").ShowHeader(true).Title("树控件")
        .Nodes(
            F.TreeNode().Text("中国").NodeID("china").Expanded(true)
                .Nodes(
                    F.TreeNode().Text("河南省").NodeID("henan").Expanded(true)
                        .Nodes(
                            F.TreeNode().Text("驻马店市").Expanded(true).IconFont(IconFont._Flag).NodeID("zhumadian")
                                .Nodes(
                                    F.TreeNode().Text("遂平县").IconFont(IconFont._Tag).NodeID("suiping"),
                                    F.TreeNode().Text("西平县").IconFont(IconFont._Book).NodeID("xiping")
                                ),
                            F.TreeNode().Text("漯河市").NodeID("luohe").IconFont(IconFont._Bookmark)
                        ),
                    F.TreeNode().Text("安徽省").Expanded(true).NodeID("anhui")
                        .Nodes(
                            F.TreeNode().Expanded(true).Text("合肥市").NodeID("hefei")
                                .Nodes(
                                    F.TreeNode().Text("中国科学技术大学（链接）").NavigateUrl("http://www.ustc.edu.cn/").Target("_blank").ToolTip("点击跳转到科大主页").NodeID("ustc")
                                ),
                            F.TreeNode().Text("黄山市").NodeID("huangshan")
                        )
                )
        )
    )
    <br>

    @(F.Button().ID("btnGetSelectedNode").OnClick(Url.Action("btnGetSelectedNode_Click"), Parameter.FromFunction("selectedNode", "getCurrentControlSelectedNodePostbackValue")).CssClass("marginr").Text("获取选中的节点"))
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlSelectedNodePostbackValue() {
            return getSelectedNode();
        }

    </script>


    <script>
        function getSelectedNode() {
            var result;

            var selectedNode = F.ui.Tree1.getSelectedNode(true);
            if (selectedNode) {
                result = {
                    id: selectedNode.id,
                    text: selectedNode.text
                };
            }

            return F.toJSON(result);
        }
    </script>


}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示用字体图标代替树节点的图片图标。</p>
    <h3><i class="f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照字体图标</h3>
    <ul>
        <li>展开<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>，对照目录与叶子节点的图标。<br />结果：节点按各自配置显示字体图标，不需要为每个图标提供图片文件。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>IconFont</code>（<strong>树节点</strong>，位于<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：指定节点的字体图标，目录和叶子可分别配置。</li>
    </ul>
</section>
}
