@{
    ViewBag.Title = "Tree/TreeLazyLoadSmart";
    var F = Html.F();
}


@section body {

    @(F.Tree().Width(300).Height(400).ID("Tree1").OnNodeLazyLoad(Url.Action("Tree1_NodeLazyLoad"), new Parameter("nodeId", "arguments[1]")).ShowHeader(false).AutoLeafIdentification(false)
        .EnableSingleClickExpand(true)
        .Nodes(
            F.TreeNode().Text("中国").Expanded(true).IconFont(IconFont._Home)
                .Nodes(
                    F.TreeNode().Text("河南省").Expanded(true)
                        .Nodes(
                            F.TreeNode().Text("驻马店市（延迟加载）").NodeID("zhumadian"),
                            F.TreeNode().Text("漯河").NodeID("luohe").Leaf(true)
                        ),
                    F.TreeNode().Text("安徽省").Expanded(true).NodeID("anhui")
                        .Nodes(
                            F.TreeNode().Text("合肥市").NodeID("hefei")
                                .Nodes(
                                    F.TreeNode().Text("金色池塘小区").NodeID("golden").Leaf(true),
                                    F.TreeNode().Text("中国科学技术大学").NodeID("ustc").Leaf(true)
                                )
                        )
                ),
            F.TreeNode().Text("美国").Expanded(true).NodeID("mg").IconFont(IconFont._Plane).Icon(Icon.Cake)
                .Nodes(
                    F.TreeNode().Text("加利福尼亚州").NodeID("mg-jlfny").Leaf(true),
                    F.TreeNode().Text("马萨诸塞州").Expanded(true).NodeID("mg-mszs").Leaf(true)
                )
        )
    )

    <br>
    @(F.CheckBox().ID("cbxMiniMode").ShowLabel(false).Text("启用微型模式").Listener("change", "onMiniModeCheckChanged"))


    <br>
    <br>
    @(F.Button().ID("btnGetSelectedNode").OnClick(Url.Action("btnGetSelectedNode_Click"), new Parameter("selectedNode", "getSelectedNode()")).CssClass("marginr").Text("获取选中的节点"))
    <br>
    @(F.Label().ID("labResult").EncodeText(false))


}


@section script {

    <script>
        function getSelectedNode() {
            var result;

            var selectedNode = F.ui.Tree1.getSelectedNode(true);
            if (selectedNode) {
                result = {
                    id: selectedNode.id,
                    text: selectedNode.text
                };
            }

            return F.toJSON(result);
        }

        function onMiniModeCheckChanged(event, checked) {
            var tree1 = F.ui.Tree1;

            tree1.miniMode = checked;

            // 如果启用微型模式，则强制启用其他属性（建议微型模式的最小宽度为60px）
            if (checked) {
                tree1.width = 60;

                tree1.hideHScrollbar = true;
                tree1.hideVScrollbar = true;
                tree1.expanderToRight = true;
                tree1.headerStyle = true;
            } else {
                tree1.width = 300;

                tree1.hideHScrollbar = false;
                tree1.hideVScrollbar = false;
                tree1.expanderToRight = false;
                tree1.headerStyle = false;
            }

            // 重新加载树控件
            tree1.loadData();
        }
    </script>


}