@{
    ViewBag.Title = "Tree/TreeLazyLoadSmart";
    var F = Html.F();
}


@section body {

    @(F.Tree().Width(300).Height(400).ID("Tree1").OnNodeLazyLoad(Url.Action("Tree1_NodeLazyLoad"), Parameter.FromEventArgument("nodeId", 1)).ShowHeader(false).AutoLeafIdentification(false)
        .EnableSingleClickExpand(true)
        .Nodes(
            F.TreeNode().Text("中国").NodeID("china").Expanded(true).IconFont(IconFont._Home)
                .Nodes(
                    F.TreeNode().Text("河南省").NodeID("henan").Expanded(true)
                        .Nodes(
                            F.TreeNode().Text("驻马店市（延迟加载）").NodeID("zhumadian"),
                            F.TreeNode().Text("漯河").NodeID("luohe").Leaf(true)
                        ),
                    F.TreeNode().Text("安徽省").Expanded(true).NodeID("anhui")
                        .Nodes(
                            F.TreeNode().Text("合肥市").NodeID("hefei")
                                .Nodes(
                                    F.TreeNode().Text("金色池塘小区").NodeID("golden").Leaf(true),
                                    F.TreeNode().Text("中国科学技术大学").NodeID("ustc").Leaf(true)
                                )
                        )
                ),
            F.TreeNode().Text("美国").Expanded(true).NodeID("mg").IconFont(IconFont._Plane).Icon(Icon.Cake)
                .Nodes(
                    F.TreeNode().Text("加利福尼亚州").NodeID("mg-jlfny").Leaf(true),
                    F.TreeNode().Text("马萨诸塞州").Expanded(true).NodeID("mg-mszs").Leaf(true)
                )
        )
    )

    <br>
    @(F.CheckBox().ID("cbxMiniMode").ShowLabel(false).Text("启用微型模式").Listener("change", "onMiniModeCheckChanged"))


    <br>
    <br>
    @(F.Button().ID("btnGetSelectedNode").OnClick(Url.Action("btnGetSelectedNode_Click"), Parameter.FromFunction("selectedNode", "getCurrentControlSelectedNodePostbackValue")).CssClass("marginr").Text("获取选中的节点"))
    <br>
    @(F.Label().ID("labResult").EncodeText(false))


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlSelectedNodePostbackValue() {
            return getSelectedNode();
        }

    </script>


    <script>
        function getSelectedNode() {
            var result;

            var selectedNode = F.ui.Tree1.getSelectedNode(true);
            if (selectedNode) {
                result = {
                    id: selectedNode.id,
                    text: selectedNode.text
                };
            }

            return F.toJSON(result);
        }

        function onMiniModeCheckChanged(event, checked) {
            var tree1 = F.ui.Tree1;

            tree1.miniMode = checked;

            // 如果启用微型模式，则强制启用其他属性（建议微型模式的最小宽度为60px）
            if (checked) {
                tree1.width = 60;

                tree1.hideHScrollbar = true;
                tree1.hideVScrollbar = true;
                tree1.expanderToRight = true;
                tree1.headerStyle = true;
            } else {
                tree1.width = 300;

                tree1.hideHScrollbar = false;
                tree1.hideVScrollbar = false;
                tree1.expanderToRight = false;
                tree1.headerStyle = false;
            }

            // 重新加载树控件
            tree1.loadData();
        }
    </script>


}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示按需加载子节点，并在同一棵树上切换微型导航外观。</p>
    <h3><i class="f-iconfont f-iconfont-list" aria-hidden="true"></i>逐层加载子节点</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Tree1" title="树">树</strong>展开<code>驻马店市</code>，再展开新增的<code>遂平县</code>。<br />结果：每次展开尚未加载的目录都会回发，后台按节点 <code>ID</code> 添加县级或乡级子节点；已经加载的子树无需再次创建。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-layout" aria-hidden="true"></i>切换微型模式</h3>
    <ul>
        <li>切换<strong class="example-control-reference" data-example-control="cbxMiniMode" title="启用微型模式">启用微型模式</strong>。<br />结果：树收起文字，保留图标；取消勾选后恢复完整节点文字。</li>
    </ul>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>AutoLeafIdentification</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树">树</strong>）：设为 <code>false</code>，首次没有子节点的目录仍可以显示展开入口。 本页使用<code>false</code>。</li>
        <li><code>nodelazyload</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树">树</strong>）：展开尚未加载的节点时取得其 <code>ID</code>，并加载对应的子节点。</li>
        <li><code>MiniMode</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树">树</strong>）：由本页复选框切换，只改变导航外观，不清空节点。</li>
    </ul>
</section>
}
