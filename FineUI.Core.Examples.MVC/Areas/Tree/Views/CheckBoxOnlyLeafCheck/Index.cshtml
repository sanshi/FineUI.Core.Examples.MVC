@{
    ViewBag.Title = "Tree/CheckBoxOnlyLeafCheck";
    var F = Html.F();
}


@section body {

    @(F.Tree().IsFluid(true).ID("Tree1").ShowHeader(true).Title("树控件").EnableCheckBox(true).OnlyLeafCheck(true)
        .Nodes(
            F.TreeNode().Text("中国").Expanded(true)
                .Nodes(
                    F.TreeNode().Text("河南省").Expanded(true)
                        .Nodes(
                            F.TreeNode().Text("驻马店市").NodeID("zhumadian")
                                .Nodes(
                                    F.TreeNode().Text("遂平县").NodeID("suiping"),
                                    F.TreeNode().Text("西平县").NodeID("xiping")
                                ),
                            F.TreeNode().Text("漯河市").NodeID("luohe")
                        ),
                    F.TreeNode().Text("安徽省").Expanded(true).NodeID("anhui")
                        .Nodes(
                            F.TreeNode().Text("合肥市").NodeID("hefei"),
                            F.TreeNode().Text("黄山市").NodeID("huangshan")
                        )
                )
        )
    )
    <br>

    @(F.Button().ID("btnGetCheckedValues").Text("获取选中的复选框").OnClick(Url.Action("btnGetCheckedValues_Click"), new Parameter("checkedNodes", "getCheckedNodes()")))
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}


@section script {

    <script>
        function getCheckedNodes() {
            var result = [];

            var checkedNodes = F.ui.Tree1.getCheckedNodes(true);
            if (checkedNodes.length) {
                $.each(checkedNodes, function (index, node) {
                    result.push({
                        id: node.id,
                        text: node.text
                    });
                });
            }

            return F.toJSON(result);
        }
    </script>

}
