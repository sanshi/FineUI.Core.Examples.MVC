@{
    ViewBag.Title = "Tree/CheckBox";
    var F = Html.F();
}


@section body {

    @(F.Tree().IsFluid(true).ID("Tree1").ShowHeader(true).Title("树控件").EnableCheckBox(true)
        .Nodes(
            F.TreeNode().Text("中国").NodeID("china").Expanded(true)
                .Nodes(
                    F.TreeNode().Text("河南省").NodeID("henan").Expanded(true).Checked(true)
                        .Nodes(
                            F.TreeNode().Text("驻马店市").NodeID("zhumadian")
                                .Nodes(
                                    F.TreeNode().Text("遂平县").NodeID("suiping"),
                                    F.TreeNode().Text("西平县").NodeID("xiping")
                                ),
                            F.TreeNode().Text("漯河市").NodeID("luohe")
                        ),
                    F.TreeNode().Text("安徽省").Expanded(true).NodeID("anhui")
                        .Nodes(
                            F.TreeNode().Text("合肥市").NodeID("hefei"),
                            F.TreeNode().Text("黄山市").NodeID("huangshan")
                        )
                )
        )
    )
    <br>

    @(F.Button().ID("btnGetCheckedValues").Text("获取选中的复选框").OnClick(Url.Action("btnGetCheckedValues_Click"), Parameter.FromFunction("checkedNodes", "getCurrentControlCheckedNodesPostbackValue")))
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlCheckedNodesPostbackValue() {
            return getCheckedNodes();
        }

    </script>


    <script>
        function getCheckedNodes() {
            var result = [];

            var checkedNodes = F.ui.Tree1.getCheckedNodes(true);
            if (checkedNodes.length) {
                $.each(checkedNodes, function (index, node) {
                    result.push({
                        id: node.id,
                        text: node.text
                    });
                });
            }

            return F.toJSON(result);
        }
    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示树节点的复选框勾选、通过按钮设置勾选项以及读取当前勾选集合。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-check-box" aria-hidden="true"></i>勾选并读取节点</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>勾选<code>驻马店市</code>与<code>漯河市</code>前的复选框。<br />结果：两项可以同时勾选；复选框勾选与点击节点文字产生的选择高亮相互独立。</li>
        <li>点击<strong class="example-control-reference" data-example-control="btnGetCheckedValues" title="获取选中的复选框">获取选中的复选框</strong>。<br />结果：读取当前勾选集合并显示节点名称及标识；没有勾选时显示空选择提示。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableCheckBox</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：初始为<code>true</code>，为树节点显示复选框。</li>
        <li><code>getCheckedNodes()</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：读取本页当前勾选的节点集合，不把文字高亮选择当作复选框状态。</li>
    </ul>
</section>
}
