@{
    ViewBag.Title = "Tree/TreeIconFontColor";
    var F = Html.F();
}


@section head {

    <style>
        .tn-color-red .f-tree-folder {
            color: red;
        }

        .tn-color-purple .f-tree-folder {
            color: purple;
        }

        .tn-color-green .f-tree-folder {
            color: green;
        }

        .tn-color-blue .f-tree-folder {
            color: blue;
        }

        .tn-color-orange .f-tree-folder {
            color: orange;
        }
    </style>


}

@section body {

    @(F.Tree().IsFluid(true).ID("Tree1").ShowHeader(true).Title("树控件")
        .Nodes(
            F.TreeNode().Text("中国").NodeID("china").Expanded(true)
                .Nodes(
                    F.TreeNode().Text("河南省").NodeID("henan").Expanded(true)
                        .Nodes(
                            F.TreeNode().Text("驻马店市").Expanded(true).IconFont(IconFont._Flag).CssClass("tn-color-red").NodeID("zhumadian")
                                .Nodes(
                                    F.TreeNode().Text("遂平县").IconFont(IconFont._Tag).CssClass("tn-color-purple").NodeID("suiping"),
                                    F.TreeNode().Text("西平县").IconFont(IconFont._Book).CssClass("tn-color-green").NodeID("xiping")
                                ),
                            F.TreeNode().Text("漯河市").NodeID("luohe").CssClass("tn-color-blue").IconFont(IconFont._Bookmark)
                        ),
                    F.TreeNode().Text("安徽省").Expanded(true).CssClass("tn-color-orange").NodeID("anhui")
                        .Nodes(
                            F.TreeNode().Expanded(true).Text("合肥市").NodeID("hefei")
                                .Nodes(
                                    F.TreeNode().Text("中国科学技术大学（链接）").NavigateUrl("http://www.ustc.edu.cn/").Target("_blank").ToolTip("点击跳转到科大主页").NodeID("ustc")
                                ),
                            F.TreeNode().Text("黄山市").NodeID("huangshan")
                        )
                )
        )
    )
    <br>

    @(F.Button().ID("btnGetSelectedNode").OnClick(Url.Action("btnGetSelectedNode_Click"), Parameter.FromFunction("selectedNode", "getCurrentControlSelectedNodePostbackValue")).CssClass("marginr").Text("获取选中的节点"))
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlSelectedNodePostbackValue() {
            return getSelectedNode();
        }

    </script>


    <script>
        function getSelectedNode() {
            var result;

            var selectedNode = F.ui.Tree1.getSelectedNode(true);
            if (selectedNode) {
                result = {
                    id: selectedNode.id,
                    text: selectedNode.text
                };
            }

            return F.toJSON(result);
        }
    </script>


}
@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示为不同树节点的字体图标设置不同颜色。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>对照节点图标颜色</h3>
        <ul>
            <li>展开<strong class="example-control-reference" data-example-control="Tree1"
                    title="树控件">树控件</strong>，对照各节点前的彩色字体图标。<br />结果：同一棵树的节点可以使用不同颜色，颜色只作用于相应图标。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>IconFont</code>（<strong>树节点</strong>，位于<strong class="example-control-reference" data-example-control="Tree1"
                    title="树控件">树控件</strong>）：指定节点使用的字体图标。</li>
            <li><code>IconFontColor</code>（<strong>树节点</strong>，位于<strong class="example-control-reference" data-example-control="Tree1"
                    title="树控件">树控件</strong>）：设置当前节点图标颜色，不改变节点文字内容。</li>
        </ul>
    </section>
}
