@{
    ViewBag.Title = "Tree/CheckBoxCheckAll";
    var F = Html.F();
}


@section body {

    @(F.Tree().IsFluid(true).ID("Tree1").ShowHeader(true).Title("树控件").EnableCheckBox(true)
        .Nodes(
            F.TreeNode().Text("中国").NodeID("china").Expanded(true)
                .Nodes(
                    F.TreeNode().Text("河南省").NodeID("henan").Expanded(true)
                        .Nodes(
                            F.TreeNode().Text("驻马店市").NodeID("zhumadian")
                                .Nodes(
                                    F.TreeNode().Text("遂平县").NodeID("suiping"),
                                    F.TreeNode().Text("西平县").NodeID("xiping")
                                ),
                            F.TreeNode().Text("漯河市").NodeID("luohe")
                        ),
                    F.TreeNode().Text("安徽省").Expanded(true).NodeID("anhui")
                        .Nodes(
                            F.TreeNode().Text("合肥市").NodeID("hefei"),
                            F.TreeNode().Text("黄山市").NodeID("huangshan")
                        )
                )
        ).Listener("nodecheck", "onTreeNodeCheck")
    )
    <br>

    @(F.Button().ID("btnGetCheckedValues").Text("获取选中的复选框").OnClick(Url.Action("btnGetCheckedValues_Click"), Parameter.FromFunction("checkedNodes", "getCurrentControlCheckedNodesPostbackValue")))
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlCheckedNodesPostbackValue() {
            return getCheckedNodes();
        }

    </script>


    <script>

        function onTreeNodeCheck(event, nodeId, checked) {
            var me = this;
            F.noEvent(function () {
                if (checked) {
                    me.checkNode(nodeId, {
                        deep: true, // 是否递归调用子节点
                    });
                } else {
                    me.uncheckNode(nodeId, {
                        deep: true, // 是否递归调用子节点
                    });
                }
            });
        }

        function getCheckedNodes() {
            var result = [];

            var checkedNodes = F.ui.Tree1.getCheckedNodes(true);
            if (checkedNodes.length) {
                $.each(checkedNodes, function (index, node) {
                    result.push({
                        id: node.id,
                        text: node.text
                    });
                });
            }

            return F.toJSON(result);
        }

    </script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>演示用节点勾选事件递归全选或取消当前目录的子孙节点。</p>
    <h3><i class="f-iconfont f-iconfont-check-box" aria-hidden="true"></i>递归勾选当前分支</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>勾选<code>河南省</code>。<br />结果：该目录及它的可勾选子孙节点一起勾选，其它省份不受影响。</li>
        <li>再次取消<code>河南省</code>的勾选。<br />结果：同一分支的可勾选子孙节点一起取消。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableCheckBox</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：显示树复选框。 本页使用<code>true</code>。</li>
        <li><code>nodecheck</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：客户端处理当前节点的勾选变化，并递归更新它的子孙节点。</li>
    </ul>
</section>
}
