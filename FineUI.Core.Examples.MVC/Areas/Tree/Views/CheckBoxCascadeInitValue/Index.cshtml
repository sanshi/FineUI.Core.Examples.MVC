@{
    ViewBag.Title = "Tree/CheckBoxCascadeInitValue";
    var F = Html.F();
}


@section body {

    @(F.Tree().IsFluid(true).ID("Tree1").ShowHeader(true).Title("树控件").EnableCheckBox(true).CascadeCheck(true)
        .Nodes(
            F.TreeNode().Text("中国").NodeID("china").Expanded(true)
                .Nodes(
                    F.TreeNode().Text("河南省").NodeID("henan").Expanded(true)
                        .Nodes(
                            F.TreeNode().Text("驻马店市").NodeID("zhumadian")
                                .Nodes(
                                    F.TreeNode().Text("遂平县").NodeID("suiping"),
                                    F.TreeNode().Text("西平县").NodeID("xiping")
                                ),
                            F.TreeNode().Text("漯河市").NodeID("luohe").Checked(true)
                        ),
                    F.TreeNode().Text("安徽省").Expanded(true).NodeID("anhui")
                        .Nodes(
                            F.TreeNode().Text("合肥市").NodeID("hefei"),
                            F.TreeNode().Text("黄山市").NodeID("huangshan")
                        )
                )
        )
    )
    <br>

    @(F.Button().ID("btnGetCheckedValues").Text("获取选中的复选框").OnClick(Url.Action("btnGetCheckedValues_Click"), Parameter.FromFunction("checkedNodes", "getCurrentControlCheckedNodesPostbackValue")))
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlCheckedNodesPostbackValue() {
            return getCheckedNodes();
        }

    </script>


    <script>
        function getCheckedNodes() {
            var result = [];

            var checkedNodes = F.ui.Tree1.getCheckedNodes(true);
            if (checkedNodes.length) {
                $.each(checkedNodes, function (index, node) {
                    result.push({
                        id: node.id,
                        text: node.text
                    });
                });
            }

            return F.toJSON(result);
        }
    </script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>演示树的初始勾选集合与父子级联勾选之间的关系。</p>
    <h3><i class="f-iconfont f-iconfont-check-box" aria-hidden="true"></i>核对级联勾选</h3>
    <ol>
        <li>打开页面后核对<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>中已勾选的节点。<br />结果：本页声明的初始选择已经显示；父节点的全选或部分选中外观反映子节点集合。</li>
        <li>在<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>勾选或取消<code>河南省</code>。<br />结果：启用级联时，可勾选子孙节点跟随父节点，父节点状态也随子节点变化。</li>
    </ol>
    <h3><i class="f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>CascadeCheck</code>（<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：设为<code>true</code>，启用父子级联勾选，不等同于节点的文字高亮选择。</li>
        <li><code>Checked</code>（<strong>树节点</strong>，位于<strong class="example-control-reference" data-example-control="Tree1" title="树控件">树控件</strong>）：指定本页初始勾选节点，首次加载即可显示。</li>
    </ul>
</section>
}
