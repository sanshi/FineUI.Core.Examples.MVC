@{
    ViewBag.SourceFiles = "~/Areas/DataModel/Models/Student.cs;~/Areas/DataModel/Models/Family.cs;~/Areas/DataModel/Models/StudentHelper.cs";
    ViewBag.Title = "DataModel/ComplexProperty";
    var F = Html.F();
}

@model IList<FineUI.Core.Examples.MVC.Areas.DataModel.Models.Student>

@section body {

    @(F.Grid().ID("Grid1").IsFluid(true).ShowBorder(true).ShowHeader(true).Title("表格").DataIDField("Id").DataTextField("Name")
        .Columns(
            F.RenderFieldFor(m => m.Name),
            F.RenderFieldFor(m => m.Gender).RendererFunction("renderGender"),
            F.RenderFieldFor(m => m.EntranceYear),
            F.RenderCheckFieldFor(m => m.AtSchool).RenderAsStaticField(true),
            F.RenderFieldFor(m => m.Major).RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderFieldFor(m => m.Family.FatherName).Width(220),
            F.RenderFieldFor(m => m.Family.MotherName).Width(220)
        ).DataSource(Model)

    )


}

@section script {

    <script src="~/res/js/grid.js"></script>

}
