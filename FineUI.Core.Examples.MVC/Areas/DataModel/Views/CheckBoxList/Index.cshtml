@{
    ViewBag.SourceFiles = "~/Areas/DataModel/Models/CheckBoxListModel.cs";
    ViewBag.Title = "DataModel/CheckBoxList";
    var F = Html.F();
}

@model FineUI.Core.Examples.MVC.Areas.DataModel.Models.CheckBoxListModel


@section body {


    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).LabelWidth(150).ShowBorder(true).ShowHeader(true).Title("简单表单")
        .Items(
            F.CheckBoxFor(m => m.IsChecked).Text("复选框"),
            F.CheckBoxListFor(m=> m.CheckBoxList1).ColumnNumber(3)
                .Items(Model.CheckBoxList1Items.ToArray()),
            F.RadioButtonListFor(m => m.RadioButtonList1).ColumnNumber(3)
                .Items(Model.RadioButton1Items.ToArray()),
            F.RadioButtonListFor(m => m.Gender).ColumnNumber(3)
                .Items(
                    F.RadioItem().Text("男").Value("1"),
                    F.RadioItem().Text("女").Value("0")
                ),
            F.RadioButtonListFor(m => m.GenderType).ColumnNumber(3)
                .Items(
                    F.RadioItem().Text("男").Value("1"),
                    F.RadioItem().Text("女").Value("0")
                ),
            F.DropDownListFor(m => m.GenderType).ID("GenderType2").Name("GenderType2")
                .Items(
                    F.ListItem().Text("男").Value("1"),
                    F.ListItem().Text("女").Value("0")
                ),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").CssClass("marginr").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1"),
            F.Button().ID("btnReset").Text("重置表单").ClickHandler("onResetClick")
        )
    )

}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>把布尔值、值集合和枚举绑定到不同选择控件，提交时分别读取模型值和独立字段值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>读取并提交模型值</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="SimpleForm1"
                    title="简单表单">简单表单</strong>中，更改复选框、复选列表和性别选项；把独立性别下拉列表设为与模型性别不同，再提交。<br />结果：后台回显模型数据及独立下拉列表的值，两组性别可以不同；连续提交保持各自选择。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>For</code>（<strong class="example-control-reference" data-example-control="SimpleForm1" title="简单表单">简单表单</strong>、<strong
                    class="example-control-reference" data-example-control="SimpleForm1" title="简单表单">简单表单</strong>、<strong class="example-control-reference"
                    data-example-control="SimpleForm1" title="简单表单">简单表单</strong>）：初始为
                <code>IsChecked</code>、<code>CheckBoxList1</code>、<code>RadioButtonList1</code>、<code>Gender</code>、<code>GenderType</code>，绑定模型属性路径，读取初始值、字段名称及验证注解，并在提交时接收字段值。
            </li>
        </ul>
    </section>
}
