@{
    ViewBag.Title = "DataModel/Login";
    var F = Html.F();
}


@section body {



    @(F.Window().Width(350).WindowPosition(WindowPosition.GoldenSection).EnableClose(false).IsModal(false).Title("登录表单").ID("Window1")
        .Items(
            F.SimpleForm().ShowHeader(false).BodyPadding(10).ShowBorder(false).ID("SimpleForm1")
                .Items(
                    F.TextBox().ShowRedStar(true).Required(true).Label("用户名").MaxLength(20).ID("UserName"),
                    F.TextBox().ShowRedStar(true).Required(true).RequiredMessage("密码不能为空！").EnableValidateTrim(false).TextMode(TextMode.Password).Label("密码").MaxLength(9).MaxLengthMessage("密码最大为 9 个字符！").MinLength(3).MinLengthMessage("密码最小为 3 个字符！")
                        .Regex("^(?:[0-9]+[a-zA-Z]|[a-zA-Z]+[0-9])[a-zA-Z0-9]*$").RegexMessage("密码至少包含一个字母和数字！").ID("Password")
                )
        )
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Bottom).ToolbarAlign(ToolbarAlign.Right)
                .Items(
                    F.Button().OnClick(Url.Action("btnLogin_Click"), "SimpleForm1").ValidateTarget(Target.Top).ValidateForms("SimpleForm1").Type(ButtonType.Submit).Text("登录").ID("btnLogin"),
                    F.Button().Type(ButtonType.Reset).Text("重置").ID("btnReset")
                )
        )
    )
    <br>


}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>手写字段标签和验证规则，作为模型注解登录页的对照。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>验证字段配置</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="btnLogin" title="登录">登录</strong>。<br />结果：空字段显示必填提示，浏览器阻止提交。</li>
            <li>在<strong class="example-control-reference" data-example-control="UserName" title="用户名">用户名</strong>输入 <code>admin</code>，在<strong
                    class="example-control-reference" data-example-control="Password" title="密码">密码</strong>输入
                <code>admin888</code>，点击登录。<br />结果：验证通过后回发，后台读取控件当前文字，显示成功登录提示。
            </li>
            <li>把密码改为 <code>abcdef</code>并再次登录。<br />结果：密码缺少数字，浏览器显示正则验证提示，不执行登录。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <div>
            用户名：admin
            <br />
            密码：admin888
            <br />
            <br />
            <br />
            注意：在任意输入框内按回车键都会触发表单的提交（相当于点击【登录】按钮）。
        </div>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Required</code>（<strong class="example-control-reference" data-example-control="UserName" title="用户名">用户名</strong>、<strong
                    class="example-control-reference" data-example-control="Password" title="密码">密码</strong>）：初始为 <code>true</code>，要求先填写或选择该字段，未通过时阻止表单提交。</li>
            <li><code>Regex</code>（<strong class="example-control-reference" data-example-control="Password" title="密码">密码</strong>）：使用本页正则表达式验证输入格式。</li>
            <li><code>MinLength</code>（<strong class="example-control-reference" data-example-control="Password" title="密码">密码</strong>）：初始为
                <code>3</code>，限制有效输入的最小字符数。
            </li>
            <li><code>MaxLength</code>（<strong class="example-control-reference" data-example-control="UserName" title="用户名">用户名</strong>、<strong
                    class="example-control-reference" data-example-control="Password" title="密码">密码</strong>）：初始为 <code>20</code>、<code>9</code>，限制可输入的最大字符数。
            </li>
            <li><code>ValidateForms</code>（<strong class="example-control-reference" data-example-control="btnLogin" title="登录">登录</strong>）：初始为
                <code>SimpleForm1</code>，提交前验证指定表单；验证失败时显示提示并阻止回发。
            </li>
        </ul>
    </section>
}
