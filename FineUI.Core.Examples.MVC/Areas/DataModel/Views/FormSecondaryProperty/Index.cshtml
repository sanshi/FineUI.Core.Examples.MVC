@{
    ViewBag.SourceFiles = "~/Areas/DataModel/Models/Student.cs;~/Areas/DataModel/Models/Score.cs";
    ViewBag.Title = "DataModel/FormSecondaryProperty";
    var F = Html.F();
}

@model FineUI.Core.Examples.MVC.Areas.DataModel.Models.Student


@section body {


    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).ShowHeader(true).Title("简单表单")
        .Items(
            F.HiddenFieldFor(m => m.Id),
            F.TextBoxFor(m => m.Name),
            F.RadioButtonListFor(m => m.Gender).ColumnNumber(3)
                .Items(
                    F.RadioItem().Text("男").Value("1"),
                    F.RadioItem().Text("女").Value("0")
                ),
            F.CheckBoxFor(m => m.AtSchool),
            F.TextBoxFor(m => m.Major),
            F.DatePickerFor(m => m.EntranceDate),
            F.GroupPanel().Title("考试成绩").EnableCollapse(true).CssClass("f-field")
                .Items(
                    F.NumberBoxFor(m => m.Score.Chinese),
                    F.NumberBoxFor(m => m.Score.Math),
                    F.NumberBoxFor(m => m.Score.Physics),
                    F.NumberBoxFor(m => m.Score.Chemistry)
                )
        )
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Bottom)
                .Items(
                    F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").CssClass("marginr").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1"),
                    F.Button().ID("btnResetScore").Text("重置成绩").OnClick(Url.Action("btnResetScore_Click"))
                )
        )
    )



}
