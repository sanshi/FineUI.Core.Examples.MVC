@{
    ViewBag.SourceFiles = "~/Areas/DataModel/Models/Student.cs;~/Areas/DataModel/Models/Score.cs";
    ViewBag.Title = "DataModel/FormSecondaryProperty";
    var F = Html.F();
}

@model FineUI.Core.Examples.MVC.Areas.DataModel.Models.Student


@section body {


    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).ShowHeader(true).Title("简单表单")
        .Items(
            F.HiddenFieldFor(m => m.Id),
            F.TextBoxFor(m => m.Name),
            F.RadioButtonListFor(m => m.Gender).ColumnNumber(3)
                .Items(
                    F.RadioItem().Text("男").Value("1"),
                    F.RadioItem().Text("女").Value("0")
                ),
            F.CheckBoxFor(m => m.AtSchool),
            F.TextBoxFor(m => m.Major),
            F.DatePickerFor(m => m.EntranceDate),
            F.GroupPanel().Title("考试成绩").EnableCollapse(true).CssClass("f-field")
                .Items(
                    F.NumberBoxFor(m => m.Score.Chinese),
                    F.NumberBoxFor(m => m.Score.Math),
                    F.NumberBoxFor(m => m.Score.Physics),
                    F.NumberBoxFor(m => m.Score.Chemistry)
                )
        )
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Bottom)
                .Items(
                    F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").CssClass("marginr").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1"),
                    F.Button().ID("btnResetScore").Text("重置成绩").OnClick(Url.Action("btnResetScore_Click"))
                )
        )
    )



}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>把学生的基本资料与 Score 对象中的各科成绩一起绑定到表单。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>读取并提交模型值</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="SimpleForm1" title="简单表单">简单表单</strong>中，把<strong
                    class="example-control-reference" data-example-control="Score_Chinese" title="语文">语文</strong>改为 <code>90</code>，保留其它成绩，点击<strong
                    class="example-control-reference" data-example-control="btnSubmit" title="提交表单">提交表单</strong>。<br />结果：后台模型中的 Score.Chinese 更新为
                90，其它科目仍保留自己的值，通知展示完整学生数据。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>For</code>（<strong class="example-control-reference" data-example-control="Score_Chinese" title="语文">语文</strong>、<strong
                    class="example-control-reference" data-example-control="Score_Math" title="数学">数学</strong>、<strong class="example-control-reference"
                    data-example-control="Score_Physics" title="物理">物理</strong>）：初始为
                <code>Score.Chinese</code>、<code>Score.Math</code>、<code>Score.Physics</code>、<code>Score.Chemistry</code>，绑定模型属性路径，读取初始值、字段名称及验证注解，并在提交时接收字段值。
            </li>
        </ul>
    </section>
}
