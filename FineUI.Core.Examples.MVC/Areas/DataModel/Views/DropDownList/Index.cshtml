@{
    ViewBag.SourceFiles = "~/Areas/DataModel/Models/DropDownListModel.cs";
    ViewBag.Title = "DataModel/DropDownList";
    var F = Html.F();
}

@model FineUI.Core.Examples.MVC.Areas.DataModel.Models.DropDownListModel


@section body {


    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).LabelWidth(120).ShowBorder(true).ShowHeader(true).Title("简单表单")
        .Items(
            F.DropDownListFor(m => m.DropDownList1)
                .Items(Model.DropDownList1Items.ToArray()),
            F.DropDownListFor(m => m.DropDownList2)
                .Items(Model.DropDownList2Items.ToArray()).EnableMultiSelect(true),
            F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").CssClass("marginr").Text("提交表单").OnClick(Url.Action("btnSubmit_Click"), "SimpleForm1"),
            F.Button().ID("btnReset").Text("重置表单").ClickHandler("onResetClick")
        )
    )

}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>对照单选值和多个值集合的下拉列表模型绑定。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>读取并提交模型值</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="SimpleForm1" title="简单表单">简单表单</strong>中，在单选下拉列表改选可选项，再在多选下拉列表追加一个选项，点击提交。<br />结果：后台显示单选值和完整多选集合，多选追加不会覆盖已有选择。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>For</code>（<strong class="example-control-reference" data-example-control="SimpleForm1" title="简单表单">简单表单</strong>、<strong class="example-control-reference" data-example-control="SimpleForm1" title="简单表单">简单表单</strong>）：初始为 <code>DropDownList1</code>、<code>DropDownList2</code>，绑定模型属性路径，读取初始值、字段名称及验证注解，并在提交时接收字段值。</li>
        <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="SimpleForm1" title="简单表单">简单表单</strong>）：初始为 <code>true</code>，允许同时选择多个选项。</li>
    </ul>
</section>
}
