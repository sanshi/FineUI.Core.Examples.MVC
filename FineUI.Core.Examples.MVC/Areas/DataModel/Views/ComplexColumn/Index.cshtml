@{
    ViewBag.SourceFiles = "~/Areas/DataModel/Models/Student.cs;~/Areas/DataModel/Models/Family.cs;~/Areas/DataModel/Models/StudentViewModel.cs;~/Areas/DataModel/Models/StudentHelper.cs";
    ViewBag.Title = "DataModel/ComplexColumn";
    var F = Html.F();
}

@model IList<FineUI.Core.Examples.MVC.Areas.DataModel.Models.StudentViewModel>

@section body {

    @(F.Grid().ID("Grid1").IsFluid(true).ShowBorder(true).ShowHeader(true).Title("表格").DataIDField("Id").DataTextField("Name")
        .Columns(
            F.RenderFieldFor(m => m.Name),
            F.RenderFieldFor(m => m.Gender).RendererFunction("renderGender"),
            F.RenderFieldFor(m => m.EntranceYear),
            F.RenderCheckFieldFor(m => m.AtSchool).RenderAsStaticField(true),
            F.RenderFieldFor(m => m.Major).RendererFunction("renderMajor").Width(150),
            F.RenderFieldFor(m => m.FamilyInfo).Width(220),
            F.RenderFieldFor(m => m.HobbyInfo).ExpandUnusedSpace(true).MinWidth(150)
        ).DataSource(Model)

    )


}

@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在继承模型中增加计算属性，把家庭信息和爱好预先转换成显示文字。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>对照模型与表格显示</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>中，对照家庭信息与爱好两列。<br />结果：首行显示父亲、母亲的组合文字和逗号分隔的爱好，客户端无需再拼接对象。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataIDField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>Id</code>，从数据行读取稳定的业务标识，供选择或点击事件使用。
            </li>
            <li><code>For</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：列按模型属性取值，属性路径和显示注解决定当前示例的列内容。
            </li>
        </ul>
    </section>
}
