@using FineUI.Core.Examples.MVC.Areas.DataModel.Models;
@{
    ViewBag.SourceFiles = "~/Areas/DataModel/Models/Student.cs;~/Areas/DataModel/Models/StudentHelper.cs";
    ViewBag.Title = "DataModel/Grid";
    var F = Html.F();
}

@model IList<FineUI.Core.Examples.MVC.Areas.DataModel.Models.Student>

@section body {


    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .Columns(
            F.RowNumberField(),
            F.RenderFieldFor(m => m.Name),
            F.RenderFieldFor(m => m.Gender).RendererFunction("renderGender"),
            F.RenderFieldFor(m => m.EntranceYear),
            F.RenderCheckFieldFor(m => m.AtSchool).RenderAsStaticField(true),
            F.RenderFieldFor(m => m.Major).RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderFieldFor(m => m.Group).RendererFunction("renderGroup"),
            F.RenderFieldFor(m => m.EntranceDate)
        ).DataSource(Model)
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
