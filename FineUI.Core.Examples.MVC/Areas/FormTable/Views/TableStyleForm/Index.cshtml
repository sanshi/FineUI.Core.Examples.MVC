@{
    ViewBag.Title = "FormTable/TableStyleForm";
    var F = Html.F();
}


@section body {

    @(F.Form().IsFluid(true).ID("Form1").LabelWidth(100).ShowBorder(false).ShowHeader(false).EnableTableStyle(true).MessageTarget(MessageTarget.Qtip)
        .Rows(
            F.FormRow().ColumnWidths("50% 50%")
                .Items(
                    F.Label().ID("Label1").Label("标签").Text("标签的值"),
                    F.CheckBox().ID("CheckBox1").Text("复选框").Label("复选框")
                ),
            F.FormRow().ColumnWidths("50% 50%")
                .Items(
                    F.DropDownList().ID("DropDownList1").Required(true).ShowRedStar(true).AutoSelectFirstItem(false).Label("下拉列表")
                        .Items(
                            F.ListItem().Text("可选项 1").Value("0"),
                            F.ListItem().Text("可选项 2").Value("1")
                        ),
                    F.TextBox().ID("TextBox1").ShowRedStar(true).Label("文本框").Required(true).Text("")
                )
        )
    )
    @(F.Button().Text("验证此表单并提交").CssClass("marginr").ValidateForms("Form1").ID("btnSubmitForm1").OnClick(Url.Action("btnSubmitForm_Click"), "Form1").MarginTop(5))
    <br>
    <br>

    @(F.Form().IsFluid(true).LabelWidth(100).ID("Form2").ShowBorder(false).ShowHeader(false).EnableTableStyle(true).MessageTarget(MessageTarget.Qtip)
        .Rows(
            F.FormRow()
                .Items(
                    F.Label().ID("Label3").Label("电话").Text("0551-1234567"),
                    F.Label().ID("Label16").Label("申请人").Text("admin")
                ),
            F.FormRow()
                .Items(
                    F.Label().ID("Label4").Label("编号").Text("200804170006"),
                    F.TextBox().ID("TextBox2").Required(true).ShowRedStar(true).Label("电子邮箱").RegexPattern(RegexPattern.EMAIL).RegexMessage("请输入有效的邮箱地址")
                ),
            F.FormRow()
                .Items(
                    F.DropDownList().ID("DropDownList3").Label("审批人").ForceSelection(false).Required(true).ShowRedStar(true).EmptyText("请选择审批人").AutoSelectFirstItem(false)
                        .Items(
                            F.ListItem().Text("老大甲").Value("0"),
                            F.ListItem().Text("老大乙").Value("1"),
                            F.ListItem().Text("老大丙").Value("2")
                        )
                ),
            F.FormRow()
                .Items(
                    F.NumberBox().ID("NumberBox1").Label("申请数量").NoDecimal(true).NoNegative(true).MaxValue(1000).Required(true).ShowRedStar(true)
                ),
            F.FormRow()
                .Items(
                    F.TextArea().ID("TextArea1").Label("描述").ShowRedStar(true).Required(true)
                )
        )
    )
    @(F.Button().ID("btnSubmitForm2").Text("验证此表单并提交").CssClass("marginr").OnClick(Url.Action("btnSubmitForm_Click"), "Form2").ValidateForms("Form2").MarginTop(5))
    <br>

    @(F.Button().ID("btnSubmitAll").Text("验证两个表单并提交").CssClass("marginr").OnClick(Url.Action("btnSubmitForm_Click"), "Form1,Form2").ValidateForms("Form1,Form2").MarginTop(5))


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示表格风格中标签、输入区域和单元格边线的对齐。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照表格风格的字段排列</h3>
        <ol>
            <li>
                对照本页各组字段的标签区域、输入区域与单元格边线。<br />
                结果：不同字段放在各自单元格中，标签与输入区按表格布局对齐；操作按钮保留在原来的位置。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableTableStyle</code>（<strong class="example-control-reference" data-example-control="Form1" title="第 1 个表单">第 1 个表单</strong>、<strong
                    class="example-control-reference" data-example-control="Form2" title="第 2 个表单">第 2 个表单</strong>）：两个表单分别启用表格风格。</li>
        </ul>
    </section>
}
