@{
    ViewBag.Title = "FormTable/TableStyleFormCompare";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).LabelWidth(200).ShowBorder(true).ShowHeader(true).MessageTarget(MessageTarget.Qtip).Title("简单表单")
        .Items(
            F.SimpleForm().ID("SimpleForm3").ShowBorder(false).ShowHeader(false).EnableTableStyle(true).MarginBottom(10)
                .Items(
                    F.DatePicker().ID("DatePicker1").Label("开始日期").SelectedDate(DateTime.Now).Required(true),
                    F.DatePicker().ID("DatePicker2").Label("结束日期（大于开始日期）").Required(true).CompareControl("DatePicker1").CompareOperator(Operator.GreaterThan).CompareMessage("结束日期应该大于开始日期！")
                ),
            F.SimpleForm().ID("SimpleForm4").ShowBorder(false).ShowHeader(false).EnableTableStyle(true).MarginBottom(10)
                .Items(
                    F.TextBox().ID("TextBox1").Required(true).Label("文本框 1").Text("FineUI.Core"),
                    F.TextBox().ID("TextBox2").Required(true).Label("文本框 2（等于文本框 1）").CompareControl("TextBox1").CompareOperator(Operator.Equal).CompareMessage("文本框 2 应该等于文本框 1！")
                ),
            F.SimpleForm().ID("SimpleForm5").ShowBorder(false).ShowHeader(false).EnableTableStyle(true).MarginBottom(10)
                .Items(
                    F.NumberBox().ID("NumberBox1").Required(true).Label("数字框 1").Text("30"),
                    F.NumberBox().ID("NumberBox2").Required(true).Label("数字框 2（大于等于数字框 1）").CompareControl("NumberBox1").CompareOperator(Operator.GreaterThanEqual).CompareMessage("数字框 2 应该大于等于数字框 1!")
                ),
            F.SimpleForm().ID("SimpleForm6").ShowBorder(false).ShowHeader(false).EnableTableStyle(true)
                .Items(
                    F.Label().ID("Label1").Label("标签 1").Text("88"),
                    F.NumberBox().ID("NumberBox3").Required(true).Label("文本框 3（大于等于标签 1）").CompareControl("Label1").CompareOperator(Operator.GreaterThanEqual).CompareType(CompareType.Int).CompareMessage("文本框 3 应该大于等于标签 1！")
                )
        )
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Bottom)
                .Items(
                    F.Button().ID("btnSubmit").ValidateForms("SimpleForm1").CssClass("marginr").Text("提交表单"),
                    F.Button().ID("btnReset").Text("重置表单").ClickHandler("onResetClick")
                )
        )
    )


}

@section script {

    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示表格风格中标签、输入区域和单元格边线的对齐。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照表格风格的字段排列</h3>
        <ol>
            <li>
                对照本页各组字段的标签区域、输入区域与单元格边线。<br />
                结果：不同字段放在各自单元格中，标签与输入区按表格布局对齐；操作按钮保留在原来的位置。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableTableStyle</code>（<strong class="example-control-reference" data-example-control="SimpleForm3" title="第 2 个表单">第 2 个表单</strong>、<strong class="example-control-reference" data-example-control="SimpleForm4" title="第 3 个表单">第 3 个表单</strong>、<strong class="example-control-reference" data-example-control="SimpleForm5" title="第 4 个表单">第 4 个表单</strong>、<strong class="example-control-reference" data-example-control="SimpleForm6" title="第 5 个表单">第 5 个表单</strong>）：各组比较字段放在独立的表格风格表单中。</li>
        </ul>
    </section>
}
