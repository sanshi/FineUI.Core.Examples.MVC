@{
    ViewBag.Title = "GridPaging/PagingType";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).EnableCheckBoxSelect(true).ShowHeader(true).ShowBorder(true).Title("表格").ID("Grid1").DataIDField("Id").DataTextField("Name").AllowPaging(true).PageSize(10).IsDatabasePaging(true).OnPageIndexChanged(Url.Action("Grid1_PageIndexChanged"), "Grid1").ShowPagingMessage(ViewBag.ShowPagingMessage).PagingType(ViewBag.Grid1PagingType).MaxPagingNumberButton(ViewBag.MaxPagingNumberButton)
        .Columns(
            F.RowNumberField().Width(60).EnablePagingNumber(true),
            F.RenderField().HeaderText("ID").DataField("Id").Width(150),
            F.RenderField().HeaderText("Time").DataField("EntranceTime").ExpandUnusedSpace(true).MinWidth(150).FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd HH:mm:ss")
        ).RecordCount(ViewBag.Grid1RecordCount).DataSource(ViewBag.Grid1DataSource)

    )
    <br>

    @(F.CheckBox().ID("cbxShowPagingMessage").Text("显示分页信息").Checked(ViewBag.ShowPagingMessage).Listener("change", "OnCheckBoxChange"))
    <br>
    <br>
    分页工具栏的类型：
    <br>
    <br>

    @(F.ButtonGroup().ID("bgPagingType").EnablePressGroup(true)
        .Items(
            F.Button().Text("Arrow").EnablePress(true).Pressed(ViewBag.PagingType == "Arrow"),
            F.Button().Text("NumberBox").EnablePress(true).Pressed(ViewBag.PagingType == "NumberBox"),
            F.Button().Text("ArrowNumberBox").EnablePress(true).Pressed(ViewBag.PagingType == "ArrowNumberBox"),
            F.Button().ID("btnNumber").Text("NumberButton").EnablePress(true).Pressed(ViewBag.PagingType == "NumberButton"),
            F.Button().Text("ArrowNumberButton").EnablePress(true).Pressed(ViewBag.PagingType == "ArrowNumberButton")
        ).Listener("presschange", "onButtonGroupPressChange")
    )
    <br>
    数字分页按钮的个数：
    <br>
    <br>

    @(F.DropDownList().ID("ddlMaxPagingNumberButton").Width(120)
        .Items(
            F.ListItem().Text("5").Value("5").Selected(true),
            F.ListItem().Text("8").Value("8"),
            F.ListItem().Text("10").Value("10")
        ).Enabled(ViewBag.ddlMaxPagingNumberButtonEnabled)
        .SelectedValue(ViewBag.MaxPagingNumberButton.ToString()).Listener("change", "onDropDownListChange")
    )

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function getPressedPaingType() {
            var pressedPaingType = '';
            $.each(F.ui.bgPagingType.items, function (index, item) {
                if (item.isPressed()) {
                    pressedPaingType = item.getText();
                    return false; // break
                }
            });
            return pressedPaingType;
        }

        function reloadPage() {
            var pressedPaingType = getPressedPaingType();
            window.location.href = '@Url.Content("~/GridPaging/PagingType")?type=' + pressedPaingType + '&message=' + F.ui.cbxShowPagingMessage.isChecked() + '&maxnumberbutton=' + F.ui.ddlMaxPagingNumberButton.getValue();
        }

        function OnCheckBoxChange(event, checked) {
            reloadPage();
        }

        function onButtonGroupPressChange(event, btnObj, btnChecked) {
            reloadPage();
        }

        function onDropDownListChange(event) {
            reloadPage();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>切换分页栏的箭头、页码输入框和数字按钮组合，并调整分页信息及数字按钮数量。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换分页栏组成</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="btnNumber" title="NumberButton">NumberButton</strong>，再尝试点击其他分页类型按钮。<br />结果：页面重新采用所选分页类型，数字按钮、输入框及箭头随类型变化；仍可通过新分页栏换页。</li>
        <li>切换<strong class="example-control-reference" data-example-control="cbxShowPagingMessage" title="显示分页信息">显示分页信息</strong>，修改旁边的数字按钮数量选项。<br />结果：分页统计文字及最多显示的数字页码数量随配置变化。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>PagingType</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：选择箭头、输入框或数字按钮组成的分页栏。</li>
        <li><code>ShowPagingMessage</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：控制分页统计文字是否显示。</li>
        <li><code>MaxPagingNumberButton</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：限制数字分页按钮的数量。</li>
    </ul>
</section>
}
