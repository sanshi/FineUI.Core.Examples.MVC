@{
    ViewBag.Title = "GridPaging/PageItemsPageSize";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).EnableCheckBoxSelect(true).Height(350).ShowHeader(true).ShowBorder(true).Title("表格（内存分页）").ID("Grid1").DataIDField("Id").DataTextField("Name").AllowPaging(true).PageSize(5)
        .Columns(
            F.RowNumberField().EnablePagingNumber(true),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        )
        .PageItems(
            F.ToolbarText().Text("每页记录数："),
            F.DropDownList().ID("ddlPageSize").Width(100).Listener("change", "onDdlPageSizeChange")
                .Items(
                    F.ListItem().Text("5").Value("5"),
                    F.ListItem().Text("10").Value("10"),
                    F.ListItem().Text("15").Value("15"),
                    F.ListItem().Text("20").Value("20")
                )
        )
        .DataSource(DataSourceUtil.GetDataTable2())

    )
    <br>

    @(F.Button().Text("选中了哪些行").CssClass("marginr").ClickHandler("onNotifySelectedRowsClick"))
    <br>
    <br>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onDdlPageSizeChange(event) {
            var grid1 = F.ui.Grid1;


            var pageSize = parseInt(F.ui.ddlPageSize.getValue(), 10);

            // 设置每页显示记录数
            grid1.setPageSize(pageSize);

            // 加载当前分页数据
            grid1.loadPageData();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>使用自定义下拉列表修改页大小，对照浏览器对已有记录重新分页的结果。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>修改每页记录数</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="ddlPageSize" title="下拉列表">每页记录数</strong>中选择另一项，例如从 5 改为 10 或从 10 改为 20。<br />结果：浏览器按新的页大小重新分页，当前页可显示的记录数和总页数一起变化。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>PageSize</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（内存分页）">表格（内存分页）</strong>）：初始为 <code>5</code>，指定每页最多显示的记录数。</li>
    </ul>
</section>
}
