@{
    ViewBag.Title = "GridPaging/PageSizeOptions";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).EnableCheckBoxSelect(true).Height(350).ShowHeader(true).ShowBorder(true).Title("表格（内存分页 + 页大小选择器）").ID("Grid1").DataIDField("Id").DataTextField("Name").AllowPaging(true).PageSize(10)
        .ShowPageSizeSelector(true)
        .Columns(
            F.RowNumberField().EnablePagingNumber(true),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        )
        .DataSource(DataSourceUtil.GetDataTable2())

    )
    <br>

    @(F.Button().Text("选中了哪些行").CssClass("marginr").ClickHandler("onNotifySelectedRowsClick"))
    <br>
    <br>
    <strong>只需调用 .ShowPageSizeSelector(true) 即可显示页大小选择器（未设置 PageSizeOptions 时使用默认选项 10,20,50,100）。</strong>


}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>使用分页栏自带的页大小选择器，对照浏览器对已有记录重新分页的结果。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>修改每页记录数</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>分页栏的<strong>每页记录数</strong>中选择另一项，例如从 5 改为 10 或从 10
                改为 20。<br />结果：浏览器按新的页大小重新分页，当前页可显示的记录数和总页数一起变化。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>自定义选项须在创建表格前设置为正整数数组；回发中修改已有表格的选项不会重建选择器。当前选中的每页记录数由 PageSize 属性控制。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>PageSize</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>10</code>，指定每页最多显示的记录数。
            </li>
            <li><code>ShowPageSizeSelector</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，在分页栏中显示内置页大小选择器。
            </li>
        </ul>
    </section>
}
