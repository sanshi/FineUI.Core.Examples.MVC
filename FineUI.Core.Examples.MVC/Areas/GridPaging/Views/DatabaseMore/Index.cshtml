@{
    ViewBag.Title = "GridPaging/DatabaseMore";
    var F = Html.F();
}


@section head {

    <style>
        .morebutton {
            width: 100%;
            text-align: center;
            margin: 8px 0;
        }
    </style>

}


@section body {

    @(F.Panel().IsFluid(true).Height(350).Title("面板").AutoScroll(true)
        .Items(
            F.Grid().EnableCheckBoxSelect(true).ShowHeader(false).ShowBorder(false).Title("表格").ID("Grid1")
                .DataIDField("Id").DataTextField("Name").Attribute("data-index", "0").DataSource(@ViewBag.Grid1DataSource)
                .PagingToolbarVisible(false)
                .Columns(
                    F.RowNumberField(),
                    F.RenderField().HeaderText("姓名").DataField("Name"),
                    F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                    F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
                    F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
                    F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
                    F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
                    F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
                ),
            F.LinkButton().CssClass("morebutton").Text("加载更多...").ID("btnMore").OnClick(@Url.Action("btnMore_Click"), "Grid1", Parameter.FromFunction("dataIndex", "getGrid1DataIndexPostbackValue"))
        )
    )

    <br>

    @(F.Button().Text("选中了哪些行").CssClass("marginr").ClickHandler("onNotifySelectedRowsClick"))
    <br>
    <br>

}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getGrid1DataIndexPostbackValue() {
            return F.ui.Grid1.getAttr('data-index');
        }

    </script>


    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>点击加载更多，把下一批记录追加到已有数据后面。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>逐批追加记录</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="btnMore" title="加载更多...">加载更多...</strong>。<br />结果：触发本页加载处理，后台读取下一批记录并追加，已显示的记录仍保留。</li>
        <li>继续加载，直到没有剩余记录。<br />结果：加载入口变为不可继续加载的状态；不会重复追加最后一批记录。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>AppendData</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：把新一批数据追加到表格；区别于重新绑定时替换现有记录。</li>
        <li><code>PagingToolbarVisible</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>false</code>，隐藏常规分页栏，改由加载更多入口追加记录。</li>
    </ul>
</section>
}
