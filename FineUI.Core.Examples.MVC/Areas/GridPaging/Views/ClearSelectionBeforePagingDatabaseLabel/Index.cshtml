@{
    ViewBag.Title = "GridPaging/ClearSelectionBeforePagingDatabaseLabel";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).EnableCheckBoxSelect(true).ShowHeader(true).ShowBorder(true).Title("表格（跨页选中行）").ID("Grid1").DataIDField("Id").DataTextField("Name").AllowPaging(true).PageSize(5).IsDatabasePaging(true).OnPageIndexChanged(Url.Action("Grid1_PageIndexChanged"), "Grid1").KeepCurrentSelection(true).ClearSelectionBeforePaging(false).KeepPagedSelection(true)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd")
        )
        .RecordCount(ViewBag.Grid1RecordCount).DataSource(ViewBag.Grid1DataSource)
        .Listener("dataload", "onGrid1DataLoad").Listener("selectionchange", "onGrid1SelectionChange")
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))
    <br>
    <br>
    注意设置属性：
    <ul>
        <li>DataIDField=Id：行标识符字段</li>
        <li>ClearSelectionBeforePaging=false：分页前清空选中项（客户端）</li>
        <li>KeepCurrentSelection=true：多选时保持当前已选中行（客户端）</li>
        <li>KeepPagedSelection=true：多选时保持分页中已选中行（客户端）</li>
    </ul>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 缓存的行数据
        var cachedRows = {};

        function updateLabelResult() {
            var selectedRowIds = F.ui.Grid1.getSelectedRows();

            if (!selectedRowIds.length) {
                F.ui.labResult.setText('尚未选中行');
            } else {
                var result = [];
                $.each(selectedRowIds, function (index, item) {
                    var rowId = item, rowData = cachedRows[rowId];
                    result.push(`${rowData.text}（${rowId}，${rowData.values['Major']}）`);
                });
                F.ui.labResult.setText(`选中了 <strong>${result.length}</strong> 行：${result.join(', ')}`);
            }
        }

        // 缓存当前页选中行的数据
        function cacheCurrentPage() {
            // 数据库分页，并且启用了跨页保持选中行，注意如下区别：
            // getSelectedRows()：返回所有分页选中行标识符数组，例如：['104', '108', '113']
            // getSelectedRows(true)：返回当前页选中行数据数组，例如：[{"id":"113","text":"曹飞","values":{"Name":"曹飞","Gender":1,"EntranceYear":2008,"Major":"信息工程"}}]
            $.each(F.ui.Grid1.getSelectedRows(true), function (index, item) {
                var rowId = item.id;
                if (!cachedRows[rowId]) {
                    cachedRows[rowId] = item;
                }
            });
        }

        function onGrid1SelectionChange(event) {
            cacheCurrentPage();
            updateLabelResult();
        }

        function onGrid1DataLoad(event) {
            cacheCurrentPage();
            updateLabelResult();
        }


    </script>

}
