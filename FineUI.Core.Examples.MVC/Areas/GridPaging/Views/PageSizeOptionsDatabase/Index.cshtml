@{
    ViewBag.Title = "GridPaging/PageSizeOptionsDatabase";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).EnableCheckBoxSelect(true).Height(350).ShowHeader(true).ShowBorder(true).Title("表格（数据库分页 + 页大小选择器）").ID("Grid1").DataIDField("Id").DataTextField("Name").AllowPaging(true).PageSize(5).IsDatabasePaging(true)
        .ShowPageSizeSelector(true).PageSizeOptions(5, 10, 15, 20)
        .Listener("paging", "onGrid1PageIndexChanged").Listener("pagesizechange", "onGrid1PageSizeChange")
        .Columns(
            F.RowNumberField().EnablePagingNumber(true),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd")
        ).RecordCount(ViewBag.Grid1RecordCount).DataSource(ViewBag.Grid1DataSource)

    )
    <br>

    @(F.Button().Text("选中了哪些行").CssClass("marginr").ClickHandler("onNotifySelectedRowsClick"))
    <br>
    <br>

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function doPostBackReBindGrid() {
            var grid1 = F.ui.Grid1;

            // 触发后台事件（grid1.pageSize 已是切换后的新值，grid1.pageIndex 已重置为 0）
            F.doPostBack({
                url: '@Url.Action("Grid1_ReBindGrid")',
                params: {
                    fields: grid1.fields,
                    pageIndex: grid1.pageIndex,
                    pageSize: grid1.pageSize
                }
            });

        }

        function onGrid1PageIndexChanged(event) {
            doPostBackReBindGrid();
        }

        function onGrid1PageSizeChange(event, newPageSize, oldPageSize) {
            doPostBackReBindGrid();
        }

    </script>
}
