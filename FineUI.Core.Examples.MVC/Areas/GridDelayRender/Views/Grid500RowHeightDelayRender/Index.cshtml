@{
    ViewBag.Title = "GridDelayRender/Grid500RowHeightDelayRender";
    var F = Html.F();
}

@section head {

}

@section body {

    @(F.Grid().ID("Grid1").ShowBorder(true).ShowHeader(true).Title("500行（行高固定，延迟渲染）").DataIDField("Id").DataTextField("Name")
        .IsFluid(true).Height(500).FixedRowHeight(true).EnableDelayRender(true)
        .Columns(
            F.RowNumberField().Width(100),
            F.RenderField().HeaderText("标识").DataField("ID"),
            F.RenderField().HeaderText("姓名").DataField("Name").Width(150),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").Width(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().Width(300).DataField("GUID").HeaderText("GUID"),
            F.RenderField().Width(200).HeaderText("爱好").DataField("Hobby").RendererFunction("renderHobby"),
            F.RenderField().DataField("EntranceDate").HeaderText("入学时间"),
            F.RenderField().DataField("ChineseScore").HeaderText("语文成绩"),
            F.RenderField().DataField("MathScore").HeaderText("数学成绩"),
            F.RenderField().DataField("TotalScore").HeaderText("总成绩"),
            F.RenderField().DataField("ShenGao").HeaderText("身高"),
            F.RenderField().DataField("TiZhong").HeaderText("体重"),
            F.RenderField().DataField("XueYaDi").HeaderText("血压（低）"),
            F.RenderField().DataField("XueYaGao").HeaderText("血压（高）"),
            F.RenderField().DataField("ShiLiZuo").HeaderText("视力（左）"),
            F.RenderField().DataField("ShiLiYou").HeaderText("视力（右）"),
            F.RenderField().Width(150).DataField("ShiLiZuoJiaoZhen").HeaderText("矫正视力（左）"),
            F.RenderField().Width(150).DataField("ShiLiYouJiaoZhen").HeaderText("矫正视力（右）")
        ).Listener("render", "onGridRender").DataSource(ViewBag.Grid1DataSource)


    )

	
    <br />
    注：
    <ul>
        <li>
            启用延迟渲染的表格需满足如下条件：
            <ul>
                <li>每行的行高相同（FixedRowHeight=true）。</li>
                <li>表格高度固定或者位于布局中。</li>
            </ul>
        </li>
        <li>
            延迟渲染表格有一定局限性。
            <ul>
                <li>不支持树表格、行分组。</li>
                <li>不支持复杂的特性（比如单元格编辑、单元格合并...）。</li>
                <li>不支持模板列中放置输入字段（比如文本输入框、下拉列表、复选框列表...）。</li>
            </ul>
        </li>
    </ul>

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>
        // 等所有JS资源下载完毕后开始
        var __STARTTIME = new Date();

        // 表格渲染完毕后结束
        function onGridRender(event) {
            this.setTitle(this.getTitle() + ' - 渲染时间：' + ((new Date() - __STARTTIME) / 1000).toFixed(2));
        }

        function renderHobby(value, params) {
            var result = [];

            // Hobby：reading,basketball,travel,movie,music
            // 爱好：读书, 篮球, 旅游, 电影, 音乐
            var hobbies = value.split(',');

            $.each(hobbies, function (index, hobby) {
                if (hobby == "reading") {
                    result.push("读书");
                }
                else if (hobby == "basketball") {
                    result.push("篮球");
                }
                else if (hobby == "travel") {
                    result.push("旅游");
                }
                else if (hobby == "movie") {
                    result.push("电影");
                }
                else if (hobby == "music") {
                    result.push("音乐");
                }
            });

            return result.join(',');
        }

    </script>
}