@{
    ViewBag.Title = "GridDelayRender/Grid100LockColumnRowHeight";
    var F = Html.F();
}


@section head {

}


@section body {

    @(F.Grid().ID("Grid1").ShowBorder(true).ShowHeader(true).Title("500行（行高固定，列锁定）").DataIDField("Id").DataTextField("Name")
        .IsFluid(true).Height(500).AllowColumnLocking(true).FixedRowHeight(true)
        .Columns(
            F.RowNumberField().Width(100),
            F.RenderField().HeaderText("标识").EnableLock(true).Locked(true).DataField("ID"),
            F.RenderField().HeaderText("姓名").EnableLock(true).Locked(true).DataField("Name").Width(150),
            F.RenderField().HeaderText("性别").EnableLock(true).DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").EnableLock(true).DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderField().HeaderText("所学专业").EnableLock(true).DataField("Major").RendererFunction("renderMajor").Width(150),
            F.RenderField().HeaderText("分组").EnableLock(true).DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().Width(300).EnableLock(true).DataField("GUID").HeaderText("GUID"),
            F.RenderField().Width(200).HeaderText("爱好").EnableLock(true).DataField("Hobby").RendererFunction("renderHobby"),
            F.RenderField().EnableLock(true).DataField("EntranceDate").HeaderText("入学时间"),
            F.RenderField().EnableLock(true).DataField("ChineseScore").HeaderText("语文成绩"),
            F.RenderField().EnableLock(true).DataField("MathScore").HeaderText("数学成绩"),
            F.RenderField().EnableLock(true).DataField("TotalScore").HeaderText("总成绩"),
            F.RenderField().EnableLock(true).DataField("ShenGao").HeaderText("身高"),
            F.RenderField().EnableLock(true).DataField("TiZhong").HeaderText("体重"),
            F.RenderField().EnableLock(true).DataField("XueYaDi").HeaderText("血压（低）"),
            F.RenderField().EnableLock(true).DataField("XueYaGao").HeaderText("血压（高）"),
            F.RenderField().EnableLock(true).DataField("ShiLiZuo").HeaderText("视力（左）"),
            F.RenderField().EnableLock(true).DataField("ShiLiYou").HeaderText("视力（右）"),
            F.RenderField().Width(150).EnableLock(true).DataField("ShiLiZuoJiaoZhen").HeaderText("矫正视力（左）"),
            F.RenderField().Width(150).EnableLock(true).DataField("ShiLiYouJiaoZhen").HeaderText("矫正视力（右）")
        ).Listener("render", "onGridRender").DataSource(ViewBag.Grid1DataSource)


    )


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>
        // 等所有JS资源下载完毕后开始
        var __STARTTIME = new Date();

        // 表格渲染完毕后结束
        function onGridRender(event) {
            this.setTitle(this.getTitle() + ' - 渲染时间：' + ((new Date() - __STARTTIME) / 1000).toFixed(2));
        }

        function renderHobby(value, params) {
            var result = [];

            // Hobby：reading,basketball,travel,movie,music
            // 爱好：读书, 篮球, 旅游, 电影, 音乐
            var hobbies = value.split(',');

            $.each(hobbies, function (index, hobby) {
                if (hobby == "reading") {
                    result.push("读书");
                }
                else if (hobby == "basketball") {
                    result.push("篮球");
                }
                else if (hobby == "travel") {
                    result.push("旅游");
                }
                else if (hobby == "movie") {
                    result.push("电影");
                }
                else if (hobby == "music") {
                    result.push("音乐");
                }
            });

            return result.join(',');
        }

    </script>
}