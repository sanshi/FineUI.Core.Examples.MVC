@{
    ViewBag.SourceFiles = "~/Areas/Partial/Views/Layout/PartialView.cshtml";
    ViewBag.Title = "Partial/Layout";
    var F = Html.F();
}


@section body {

    @{
        var PartialViewIndex = 0;
    }

    @(F.Panel().ID("Panel1").IsFluid(true).EnableCollapse(false).Height(300).Layout(LayoutType.VBox).BoxConfigAlign(BoxLayoutAlign.Stretch).BoxConfigPosition(BoxLayoutPosition.Start).BodyPadding(10).BoxConfigChildMargin("0 0 5 0").Title("面板一")
        .Items(
            F.PartialConnector().Content(await Html.PartialAsync("PartialView", new ViewDataDictionary(ViewData) { { "PartialViewIndex", PartialViewIndex++ }, { "UserName", "陈萍萍" }, { "UserAge", 20 }, { "UserCountry", "合肥" } })),
            F.Panel().BodyPadding(10).BoxFlex(1).Margin(0).Title("面板二")
                .Items(
                    F.Label().Text("胡斐今年22岁，住在驻马店。")
                )
        )
    )
    <br>

    @(F.Panel().ID("Panel2").IsFluid(true).EnableCollapse(false).Height(300).Layout(LayoutType.VBox).BodyPadding(10).BoxConfigChildMargin("0 0 5 0").Title("面板三")
        .Items(
            F.PartialConnector().Content(await Html.PartialAsync("PartialView", new ViewDataDictionary(ViewData) { { "PartialViewIndex", PartialViewIndex++ }, { "UserName", "陈萍萍" }, { "UserAge", 20 }, { "UserCountry", "合肥" }, { "BoxFlex", 1 } })),
            F.PartialConnector().Content(await Html.PartialAsync("PartialView", new ViewDataDictionary(ViewData) { { "PartialViewIndex", PartialViewIndex++ }, { "UserName", "胡斐" }, { "UserAge", 22 }, { "UserCountry", "驻马店" }, { "BoxFlex", 1 }, { "Margin", 0 } }))
        )
    )
    <br>

    @(F.Panel().ID("Panel4").IsFluid(true).EnableCollapse(false).Height(300).Layout(LayoutType.HBox).BodyPadding(10).BoxConfigChildMargin("0 5 0 0").Title("面板四")
        .Items(
            F.PartialConnector().Content(await Html.PartialAsync("PartialView", new ViewDataDictionary(ViewData) { { "PartialViewIndex", PartialViewIndex++ }, { "UserName", "陈萍萍" }, { "UserAge", 20 }, { "UserCountry", "合肥" }, { "BoxFlex", 1 } })),
            F.PartialConnector().Content(await Html.PartialAsync("PartialView", new ViewDataDictionary(ViewData) { { "PartialViewIndex", PartialViewIndex++ }, { "UserName", "陈萍萍" }, { "UserAge", 20 }, { "UserCountry", "合肥" }, { "BoxFlex", 1 }, { "Margin", 0 } }))
        )
    )


}

