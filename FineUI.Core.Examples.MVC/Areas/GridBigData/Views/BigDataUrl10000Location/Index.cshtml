@{
    ViewBag.SourceFiles = "~/Areas/GridBigData/Controllers/BigDataUrlDataController.cs";
    ViewBag.Title = "GridBigData/BigDataUrl10000Location";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Height(500).Title("表格（网址数据源，10000行）").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableCheckBoxSelect(true)
        .DataUrl(Url.Content("~/GridBigData/BigDataUrlData?total=10000&type=simple")).EnableBigData(true).FixedRowHeight(true)
        .EnableBigDataRowTip(false).PagingToolbarVisible(false)
        .Columns(
            F.RowNumberField().Width(50),
            F.RenderField().HeaderText("姓名").DataField("Name").Width(150),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup")
        )
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Bottom)
                .Items(
                    F.Label().Text("转到行："),
                    F.NumberBox().ID("nbRowNumber").MinValue(1).MaxValue(10000).Text("1000").Increment(100).EnableCommas(true),
                    F.Button().ID("btnGoToRow").Text("Go").ClickHandler("onGotoRow"),
                    F.ToolbarFill(),
                    F.Label().ID("labCurrentPosition")
                )
        )
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 转到行
        function onGotoRow(event) {
            // scrollToRow的参数是行索引，而 nbRowNumber 取得的是行序号
            F.ui.Grid1.scrollToRow(F.ui.nbRowNumber.getValue() - 1);
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>输入从 1 开始的行号，把大数据表格滚动到指定记录。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>直接跳到中间记录</h3>
    <ol>
        <li>在<strong class="example-control-reference" data-example-control="nbRowNumber" title="转到行">转到行</strong>输入<code>5000</code>，点击<strong class="example-control-reference" data-example-control="btnGoToRow" title="Go">Go</strong>。<br />结果：浏览器滚动到第 5000 行附近并渲染该位置的记录，不必逐页翻到该行。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>scrollToRow</code>（<strong>定位脚本</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格（网址数据源，10000行）">表格（网址数据源，10000行）</strong>）：方法接收从 0 开始的行索引，本页把输入行号减 1 后再传入。</li>
        <li><code>EnableBigDataRowTip</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格（网址数据源，10000行）">表格（网址数据源，10000行）</strong>）：初始为 <code>false</code>，本页关闭默认悬浮行数提示，定位或自定义标签按本页脚本处理。</li>
    </ul>
</section>
}
