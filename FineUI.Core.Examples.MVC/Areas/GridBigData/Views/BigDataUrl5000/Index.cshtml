@{
    ViewBag.SourceFiles = "~/Areas/GridBigData/Controllers/BigDataUrlDataController.cs";
    ViewBag.Title = "GridBigData/BigDataUrl5000";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Height(500).Title("表格（网址数据源，5000行）").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableCheckBoxSelect(true)
        .DataUrl(Url.Content("~/GridBigData/BigDataUrlData?total=5000&type=simple")).EnableBigData(true).FixedRowHeight(true)
        .EnableBigDataRowTip(true).PagingToolbarVisible(false)
        .Columns(
            F.RowNumberField().Width(50),
            F.RenderField().HeaderText("姓名").DataField("Name").Width(150),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup")
        )
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))
   
}


@section script {

    <script src="~/res/js/grid.js"></script>

}
