@model IReadOnlyList<FineUI.Core.Examples.MVC.Areas.Config.Controllers.GlobalPropertiesController.PropertyRow>
@{
    var F = Html.F();
    ViewBag.Title = "全局配置属性";
    ViewBag.IsDarkerBG = true;
    ViewBag.SourceFiles = "~/res/js/global-properties.js";
}

@section head {
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        .config-property-detail {
            box-sizing: border-box;
            max-width: min(76ch, calc(100vw - 6rem));
            white-space: normal;
            overflow-wrap: anywhere;
        }

        .config-property-detail pre {
            white-space: pre-wrap;
        }
    </style>
}

@section body {
    @(F.Grid().ID("Grid1").IsFluid(true).ShowBorder(true).ShowBorderShadow(true)
        .ShowHeader(true).Title("全局配置属性").DataIDField("name").DataTextField("name")
        .AllowPaging(true).PageSize(100).EnableTextSelection(true).EnableMultiSelect(false)
        .EmptyText("未找到匹配的配置项，可缩短关键词或清除筛选条件。")
        .Toolbars(
            F.Toolbar().ID("ToolbarFilters").Position(ToolbarPosition.Top).Layout(LayoutType.HBox)
                .BoxConfigSpace(10).BodyPadding(5).Items(
                    F.DropDownList().ID("ddlCategory").Label("配置分类").LabelAlign(LabelAlign.Top)
                        .BoxFlex(2).EmptyText("全部分类").AutoSelectFirstItem(false).AutoShowClearIcon(true)
                        .Listener("change", "onConfigQueryChange"),
                    F.TriggerBox().ID("tbxSearch").Label("搜索配置项").LabelAlign(LabelAlign.Top)
                        .BoxFlex(3).EmptyText("名称、含义或可选值").TriggerIcon(TriggerIcon.Clear)
                        .AutoShowClearIcon(true).Listener("change", "onConfigQueryChange")),
            F.Toolbar().ID("ToolbarOptions").Position(ToolbarPosition.Top).Items(
                F.ToolbarFill(), F.Label().ID("labResultCount").ShowLabel(false)))
        .Columns(
            F.RenderField().DataField("name").RenderAsRowExpander(true)
                .ExpandOnDblClick(false).RendererFunction("ConfigPropertyQuery.renderDetail"),
            F.RenderField().ColumnID("name").HeaderText("配置名称").DataField("name").Width(234)
                .RendererFunction("ConfigPropertyQuery.renderName"),
            F.RenderField().ColumnID("description").HeaderText("含义").DataField("description")
                .ExpandUnusedSpace(true).MinWidth(220),
            F.RenderField().ColumnID("initialValue").HeaderText("初始值").DataField("initialText").Width(140),
            F.RenderField().ColumnID("options").HeaderText("可选值或格式").DataField("options").Width(245))
        .Listener("rowclick", "onConfigRowClick")
        .Listener("rowexpanderexpand", "onConfigRowExpand")
        .Listener("rowexpandercollapse", "onConfigRowCollapse"))

    <p>初始值取自 FineUI.Core 的空配置。点击配置名称或左侧加号可查看完整取值和使用条件。配置示例写在 <code>appsettings.json</code> 的 <code>FineUI</code> 节内。</p>
    <p>首次接入 FineUI 的服务注册、中间件和配置文件位置，见<a href="~/Config/ModifyWebConfig">配置入门</a>。</p>
}

@section script {
    <script type="application/json" id="configPropertyCatalog" data-format="json" data-example-label="FineUI 节内写法"
            data-grid="Grid1" data-category="ddlCategory" data-search="tbxSearch" data-count="labResultCount">@Json.Serialize(Model)</script>
    <script src="~/res/js/global-properties.js"></script>
}
