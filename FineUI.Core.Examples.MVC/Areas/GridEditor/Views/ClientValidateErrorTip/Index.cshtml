@{
    ViewBag.Title = "GridEditor/ClientValidateErrorTip";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-cell.errortip {
            background-image: url(@Url.Content("~/res/images/errortip.gif"));
            background-repeat: repeat-x;
            background-position: bottom;
        }
    </style>

}

@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("表格（双击编辑）").DataIDField("Id").DataTextField("Name").AllowCellEditing(true).ClicksToEdit(2).EnableCheckBoxSelect(true)
        .Columns(
            F.RowNumberField(),
            F.RenderField().ColumnID("Name").DataField("Name").HeaderText("姓名")
                .Editor(
                    F.TextBox().ID("tbxName")
            //.Required(true) 为了演示，本示例会在保存时自定义验证
                ),
            F.RenderField().ColumnID("Gender").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").HeaderText("性别")
                .Editor(
                    F.DropDownList().ID("ddlGender").Required(true)
                        .Items(
                            F.ListItem().Text("男").Value("1"),
                            F.ListItem().Text("女").Value("0")
                        )
                ),
            F.RenderField().ColumnID("EntranceYear").DataField("EntranceYear").FieldType(FieldType.Int).HeaderText("入学年份")
                .Editor(
                    F.NumberBox().ID("nbxEntranceYear").NoDecimal(true).NoNegative(true).MinValue(2000).MaxValue(2025)
                ),
            F.RenderField().Width(150).ColumnID("EntranceDate").DataField("EntranceDate").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd").HeaderText("入学日期")
                .Editor(
                    F.DatePicker().ID("dpEntranceDate").Required(true)
                ),
            F.RenderCheckField().ColumnID("AtSchool").DataField("AtSchool").HeaderText("是否在校"),
            F.RenderField().ColumnID("Major").DataField("Major").ExpandUnusedSpace(true).MinWidth(150).HeaderText("所学专业")
                .Editor(
                    F.TextBox().ID("tbxMajor").Required(true)
                ),
            F.RenderField().EnableHeaderMenu(false).RendererFunction("renderDeleteAction")
        )
        .Toolbars(
            F.Toolbar().ID("Toolbar1")
                .Items(
                    F.Button().ID("btnNew").Text("新增数据").Icon(Icon.Add).ClickHandler("onNewClick"),
                    F.Button().ID("btnDelete").Text("删除选中行").Icon(Icon.Delete).ClickHandler("onDeleteClick"),
                    F.ToolbarFill(),
                    F.Button().ID("btnReset").Text("重置表格数据").ClickHandler("onResetClick")
                )
        ).Listener("afteredit", "onGrid1AfterEdit").DataSource(ViewBag.Grid1DataSource)
    )
    <br>

    @(F.Button().ID("btnSubmit").Text("保存数据").ClickHandler("onSubmitClick"))

    <br>
    @(F.Label().ID("labResult").EncodeText(false))

    <br>


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // v12.0 - 清空所有行中姓名单元格的样式
        function clearAllNameCls() {
            var grid1 = F.ui.Grid1;

            $.each(grid1.data, function (index, rowData) {
                // 使用 'ColumnID.cls' 更新单元格样式，例如 'Name.cls' 表示这一列的样式。
                // https://fineui.com/js/api/FineUI.Grid.html#updateCellValue
                grid1.updateCellValue(rowData.id, { 'Name.cls': '' });
            });
        }


        function onGrid1AfterEdit(event, value, params) {
            // var grid = this, rowId = params.rowId, columnId = params.columnId;

            // if (columnId === 'Name') {
            //     var cellEl = params.td;
            //     if (!value) {
            //         cellEl.addClass('errortip');
            //     } else {
            //         cellEl.removeClass('errortip');
            //     }
            // }

            var grid1 = this, rowId = params.rowId, columnId = params.columnId;
            if (columnId === 'Name') {
                if (!value) {
                    grid1.updateCellValue(rowId, { 'Name.cls': 'errortip' });
                } else {
                    grid1.updateCellValue(rowId, { 'Name.cls': '' });
                }
            }
        }

        function isValid() {
            var grid1 = F.ui.Grid1;
            var valid = true, modifiedData = grid1.getModifiedData();

            $.each(modifiedData, function (index, rowData) {

                // rowData.id: 行ID
                // rowData.status: 行状态（newadded, modified, deleted）
                // rowData.values: 行中修改单元格对象，比如 { "Name": "刘国2", "Gender": 0, "EntranceYear": 2003 }
                if (rowData.status === 'deleted') {
                    return true; // continue
                }

                var name = rowData.values['Name'];
                // 更改了姓名列，并且为空字符串
                if (typeof (name) != 'undefined' && $.trim(name) == '') {
                    F.alert({
                        message: '姓名不能为空！',
                        ok: function () {
                            grid1.startEdit(rowData.id, 'Name');
                        }
                    });

                    valid = false;

                    return false; // break
                }
            });


            return valid;
        }

        function onSubmitClick(event) {
            var grid1 = F.ui.Grid1;

            // 自定义验证是否通过
            if (!isValid()) {
                return;
            }

            // 触发后台事件
            F.doPostBack({
                url: '@Url.Action("btnSubmit_Click")',
                params: {
                    Grid1_fields: grid1.fields,
                    Grid1_modifiedData: F.toJSON(grid1.getModifiedData())
                }
            });
        }

        function onNewClick(event) {
            var grid1 = F.ui.Grid1;

            // 新增一行（返回新增行的ID）
            var addedRowId = grid1.addNewRecord({
                'Name': '新用户',
                'Gender': '1',
                'EntranceYear': '2015',
                'EntranceDate': '2016-11-15',
                'AtSchool': false,
                'Major': '化学系'
            }, true);

        }

        function onResetClick(event) {
            F.confirm({
                message: '确定要重置表格数据？',
                ok: function () {
                    F.ui.Grid1.rejectChanges();

                    // v12.0 - 清空所有行中姓名单元格的样式
                    clearAllNameCls();
                }
            });
        }

        function onDeleteClick(event) {
            var grid1 = F.ui.Grid1;
            if (!grid1.hasSelection()) {
                F.alert('没有选中项！');
                return;
            }

            var selectedRows = grid1.getSelectedRows();
            F.confirm({
                message: F.rawHtml('你确定要删除选中的&nbsp;<b>' + selectedRows.length + '</b>&nbsp;行数据吗？'),
                target: '_top',
                ok: function () {
                    grid1.deleteRows(selectedRows);
                }
            });
        }


        F.ready(function () {

            var grid1 = F.ui.Grid1;
            grid1.el.on('click', 'a.action-btn.delete', function (event) {
                // 删除链接是按钮型占位地址，先取消默认导航，避免改写页面 hash。
                event.preventDefault();

                var cnode = $(this);
                var rowData = grid1.getRowData(cnode.closest('.f-grid-row'));

                F.confirm({
                    message: '删除选中行？',
                    target: '_top',
                    ok: function () {
                        grid1.deleteRow(rowData);
                    }
                });
            });

        });

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>结束姓名编辑时用波浪线标出空值，提交前再拦截未填写姓名的记录。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>标出空值并阻止保存</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="btnNew"
                    title="新增数据">新增数据</strong>，将新行<strong>姓名</strong>清空并结束编辑。<br />结果：<strong>姓名</strong>单元格出现错误波浪线；这一步由浏览器标记，不向后台保存。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnSubmit"
                    title="保存数据">保存数据</strong>。<br />结果：浏览器提示<strong>姓名</strong>不能为空，停止本次保存；关闭提示后重新进入对应<strong>姓名</strong>编辑器。</li>
            <li>填写<strong>姓名</strong><code>新学生</code>并再次保存。<br />结果：波浪线清除，验证通过后才提交，后台读取本轮变更并更新示例数据。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>getModifiedData / startEdit</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（双击编辑）">表格（双击编辑）</strong>）：检查待保存记录，跳过删除项；<strong>姓名</strong>为空时停止提交，并重新打开该行<strong>姓名</strong>编辑器。</li>
            <li><code>Required / 提交前验证</code>（<strong>姓名编辑器与保存处理</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（双击编辑）">表格（双击编辑）</strong>）：编辑器必填验证用于正在编辑的输入；新增记录尚未逐格编辑时仍可能有空<strong>姓名</strong>，因此提交前还要统一检查待保存数据。</li>
            <li><code>updateCellValue / Name.cls</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（双击编辑）">表格（双击编辑）</strong>）：<strong>姓名</strong>结束编辑后设置或清除 errortip 样式；重置时还会清掉已添加的错误样式。</li>
        </ul>
    </section>
}
