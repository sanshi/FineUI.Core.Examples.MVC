@{
    ViewBag.Title = "GridEditor/DropDownListMulti";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("表格（单击编辑）").DataIDField("Id").DataTextField("Name").AllowCellEditing(true).ClicksToEdit(1)
        .Columns(
            F.RowNumberField(),
            F.RenderField().ColumnID("Name").DataField("Name").HeaderText("姓名")
                .Editor(
                    F.TextBox().ID("tbxName").Required(true)
                ),
            F.RenderField().ColumnID("Gender").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").HeaderText("性别")
                .Editor(
                    F.DropDownList().ID("ddlGender").Required(true)
                        .Items(
                            F.ListItem().Text("男").Value("1"),
                            F.ListItem().Text("女").Value("0")
                        )
                ),
            F.RenderField().ColumnID("EntranceYear").DataField("EntranceYear").FieldType(FieldType.Int).HeaderText("入学年份")
                .Editor(
                    F.NumberBox().ID("nbxEntranceYear").NoDecimal(true).NoNegative(true).MinValue(2000).MaxValue(2025)
                ),
            F.RenderField().Width(150).ColumnID("EntranceDate").DataField("EntranceDate").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd").HeaderText("入学日期")
                .Editor(
                    F.DatePicker().ID("dpEntranceDate").Required(true)
                ),
            F.RenderCheckField().ColumnID("AtSchool").DataField("AtSchool").HeaderText("是否在校"),
            F.RenderField().ColumnID("Hobby").DataField("Hobby").ExpandUnusedSpace(true).MinWidth(150).HeaderText("兴趣爱好").RendererFunction("renderHobby")
                .Editor(
                    F.DropDownList().ID("ddlHobby").EnableMultiSelect(true).TopSpaceFirst(true)
                        .Items(
                            F.ListItem().Text("读书").Value("reading"),
                            F.ListItem().Text("篮球").Value("basketball"),
                            F.ListItem().Text("旅游").Value("travel"),
                            F.ListItem().Text("电影").Value("movie"),
                            F.ListItem().Text("音乐").Value("music")
                        )
                )
        ).DataSource(ViewBag.Grid1DataSource)
    )
    <br>

    @(F.Button().ID("btnSubmit").Text("保存数据").OnClick(Url.Action("btnSubmit_Click"), "Grid1"))

    <br>
    @(F.Label().ID("labResult").EncodeText(false))

    <br />


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderHobby(value) {
            // 兴趣爱好下拉列表的实例
            var ddlHobby = F.ui.ddlHobby;

            var hobbies = value.split(',');

            return $.map(hobbies, function (hobby, index) {
                return ddlHobby.getTextByValue(hobby);
            }).join(', ');
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>把可多选的下拉列表用作兴趣爱好单元格编辑器，显示名称并保存多项值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>在同一单元格选择多个兴趣</h3>
        <ul>
            <li>打开<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单击编辑）">表格（单击编辑）</strong>的<strong>兴趣爱好</strong>编辑器，选中两项后结束编辑，再次打开。<br />结果：单元格显示多个兴趣名称；重新编辑时对应选项仍被选中，取消其中一项后只保留其余项。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：[兴趣爱好]列的编辑器属性TopSpaceFirst=true，优先在上部空间显示弹出框。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="ddlHobby"
                    title="兴趣爱好列的下拉列表">兴趣爱好列的下拉列表</strong>）：初始为 <code>true</code>，同一个下拉编辑器可同时保留多个选项。</li>
            <li><code>RendererFunction</code>（<strong>兴趣爱好列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单击编辑）">表格（单击编辑）</strong>）：把保存的多项值转换为对应选项文字，显示文字与实际值分别处理。</li>
        </ul>
    </section>
}
