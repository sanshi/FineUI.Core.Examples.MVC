@{
    ViewBag.Title = "GridEditor/GridEditorProgress";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true)
        .Title("表格").DataIDField("Id").DataTextField("Name").AllowCellEditing(true).ClicksToEdit(1)
        .Columns(
            F.RowNumberField(),
            F.RenderField().ColumnID("Name").DataField("Name").HeaderText("姓名")
                .Editor(
                    F.TextBox().ID("tbxName").Required(true)
                ),
            F.RenderField().ColumnID("Gender").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").HeaderText("性别")
                .Editor(
                    F.DropDownList().ID("ddlGender").Required(true)
                        .Items(
                            F.ListItem().Text("男").Value("1"),
                            F.ListItem().Text("女").Value("0")
                        )
                ),
            F.RenderField().Width(200).ColumnID("Progress1").DataField("Progress1").HeaderText("进度条1").FieldType(FieldType.Int).RendererFunction("renderProgress1"),
            F.RenderField().Width(200).ColumnID("Progress2").DataField("Progress2").HeaderText("进度条2").FieldType(FieldType.Int).RendererFunction("renderProgress2"),
            F.RenderField().ColumnID("Major").DataField("Major").ExpandUnusedSpace(true).MinWidth(150).HeaderText("所学专业")
                .Editor(
                    F.TextBox().ID("tbxMajor").Required(true)
                )
        ).DataSource(ViewBag.Grid1DataSource)
    )
    <br>

    @(F.Button().Text("[进度条1]加5%").ClickHandler("onIncreaseProgressClick").MarginRight(5))
    @(F.Button().Text("[进度条1]减5%").ClickHandler("onDecreaseProgressClick"))
    <br>
    <br>
    @(F.Button().ID("btnSubmit").Text("保存数据").OnClick(Url.Action("btnSubmit_Click"), "Grid1"))

    <br>
    @(F.Label().ID("labResult").EncodeText(false))


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderProgress1(value) {
            return F.progressHtml(value, {
                textVisible: true
            });
        }

        function renderProgress2(value) {
            return F.progressHtml(value, {
                height: 15,
                textVisible: true,
                textInside: true
            });
        }


        function changeProgress1(increment) {
            var grid1 = F.ui.Grid1;
            grid1.getRowEls().each(function () {
                var rowEl = $(this);
                var progressEl = rowEl.find('.f-grid-cell-Progress1 .f-progressbar-outer');
                var progressValue = parseInt(progressEl.attr('data-progressvalue'));

                progressValue += increment;

                if (progressValue > 100) {
                    progressValue = 100;
                } else if (progressValue < 0) {
                    progressValue = 0;
                }

                grid1.updateCellValue(rowEl, 'Progress1', progressValue);
            });
        }

        function onIncreaseProgressClick(event) {
            changeProgress1(5);
        }

        function onDecreaseProgressClick(event) {
            changeProgress1(-5);
        }

    </script>
}
