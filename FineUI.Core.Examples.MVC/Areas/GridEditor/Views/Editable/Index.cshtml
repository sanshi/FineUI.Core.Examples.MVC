@{
    ViewBag.Title = "GridEditor/Editable";
    var F = Html.F();
}


@section head {

    <style>
        /* 除了序号列和可编辑列，其他列变灰 */
        .f-grid-cell-text {
            opacity: .5;
            filter: alpha(opacity=50);
        }

        .f-grid-cell-editable .f-grid-cell-text {
            opacity: 1;
            filter: alpha(opacity=100);
        }

        .f-grid-rownumberfield .f-grid-cell-text {
            opacity: 1;
            filter: alpha(opacity=100);
        }
    </style>

}

@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("表格（单击编辑）").DataIDField("Id").DataTextField("Name").AllowCellEditing(true).ClicksToEdit(1)
        .Columns(
            F.RowNumberField(),
            F.RenderField().ColumnID("Name").DataField("Name").HeaderText("姓名")
                .Editor(
                    F.TextBox().ID("tbxName").Required(true)
                ),
            F.RenderField().ColumnID("Gender").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").HeaderText("性别")
                .Editor(
                    F.DropDownList().ID("ddlGender").Required(true)
                        .Items(
                            F.ListItem().Text("男").Value("1"),
                            F.ListItem().Text("女").Value("0")
                        )
                ),
            F.RenderField().ColumnID("EntranceYear").DataField("EntranceYear").FieldType(FieldType.Int).HeaderText("入学年份")
                .Editor(
                    F.NumberBox().ID("nbxEntranceYear").NoDecimal(true).NoNegative(true).MinValue(2000).MaxValue(2025)
                ),
            F.RenderField().Width(150).ColumnID("EntranceDate").DataField("EntranceDate").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd").HeaderText("入学日期")
                .Editor(
                    F.DatePicker().ID("dpEntranceDate").Required(true)
                ),
            F.RenderCheckField().ColumnID("AtSchool").DataField("AtSchool").HeaderText("是否在校"),
            F.RenderField().ColumnID("Major").DataField("Major").ExpandUnusedSpace(true).MinWidth(150).HeaderText("所学专业").EnableColumnEdit(false)
                .Editor(
                    F.TextBox().ID("tbxMajor").Required(true)
                )
        ).DataSource(ViewBag.Grid1DataSource)
    )
    <br>

    @(F.Button().ID("btnChangeEntranceDateEditable").CssClass("marginr").Text("切换[入学日期]列的可编辑状态").ClickHandler("onChangeEntranceDateEditableClick"))
    @(F.Button().ID("btnChangeAtSchoolEditable").CssClass("marginr").Text("切换[是否在校]列的可编辑状态").ClickHandler("onChangeAtSchoolEditableClick"))
    @(F.Button().ID("btnChangeMajorEditable").Text("切换[所学专业]列的可编辑状态").ClickHandler("onChangeMajorEditableClick"))
    <br>
    <br>

    @(F.Button().ID("btnSubmit").Text("保存数据").OnClick(Url.Action("btnSubmit_Click"), "Grid1"))

    <br>
    @(F.Label().ID("labResult").EncodeText(false))

    <br>


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onChangeEntranceDateEditableClick(event) {
            var column = F.ui.Grid1.getColumn('EntranceDate');
            column.toggleEditable();
        }

        function onChangeAtSchoolEditableClick(event) {
            var column = F.ui.Grid1.getColumn('AtSchool');
            column.toggleEditable();
        }

        function onChangeMajorEditableClick(event) {
            var column = F.ui.Grid1.getColumn('Major');
            column.toggleEditable();
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>在浏览器中切换指定列的可编辑状态，保留其他列的编辑能力。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>切换入学日期列</h3>
    <ul>
        <li>先尝试编辑<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>的<strong>入学日期</strong>，点击<strong class="example-control-reference" data-example-control="btnChangeEntranceDateEditable" title="切换[入学日期]列的可编辑状态">切换[入学日期]列的可编辑状态</strong>后再次尝试。<br />结果：脚本立即切换列状态，该列在可编辑与禁止编辑之间切换；再点一次恢复先前状态。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>切换是否在校列</h3>
    <ul>
        <li>先尝试编辑<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>的<strong>是否在校</strong>，点击<strong class="example-control-reference" data-example-control="btnChangeAtSchoolEditable" title="切换[是否在校]列的可编辑状态">切换[是否在校]列的可编辑状态</strong>后再次尝试。<br />结果：脚本立即切换列状态，该列在可编辑与禁止编辑之间切换；再点一次恢复先前状态。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>切换所学专业列</h3>
    <ul>
        <li>先尝试编辑<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>的<strong>所学专业</strong>，点击<strong class="example-control-reference" data-example-control="btnChangeMajorEditable" title="切换[所学专业]列的可编辑状态">切换[所学专业]列的可编辑状态</strong>后再次尝试。<br />结果：脚本立即切换列状态，该列在可编辑与禁止编辑之间切换；再点一次恢复先前状态。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableColumnEdit</code>（<strong>所学专业</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：初始为 <code>false</code>，控制该列是否接受编辑；本页按钮切换这个状态。</li>
        <li><code>toggleEditable</code>（<strong>页面脚本中的目标列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：从表格取得指定列后切换编辑状态，不需要重新绑定所有记录。</li>
    </ul>
</section>
}
