@{
    ViewBag.Title = "GridEditor/ClientHtmlEncodeToolTip";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("表格（单击编辑）").DataIDField("Id").DataTextField("Name").AllowCellEditing(true).ClicksToEdit(1)
        .Columns(
            F.RowNumberField(),
            F.RenderField().Width(150).ColumnID("Name").DataField("Name").HeaderText("姓名（提示信息）").RendererFunction("renderName")
                .Editor(
                    F.TextBox().ID("tbxName").Required(true)
                ),
            F.RenderField().ColumnID("Gender").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").HeaderText("性别")
                .Editor(
                    F.DropDownList().ID("ddlGender").Required(true)
                        .Items(
                            F.ListItem().Text("男").Value("1"),
                            F.ListItem().Text("女").Value("0")
                        )
                ),
            F.RenderField().ColumnID("EntranceYear").DataField("EntranceYear").FieldType(FieldType.Int).HeaderText("入学年份")
                .Editor(
                    F.NumberBox().ID("nbxEntranceYear").NoDecimal(true).NoNegative(true).MinValue(2000).MaxValue(2025)
                ),
            F.RenderField().Width(150).ColumnID("EntranceDate").DataField("EntranceDate").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd").HeaderText("入学日期")
                .Editor(
                    F.DatePicker().ID("dpEntranceDate").Required(true)
                ),
            F.RenderCheckField().ColumnID("AtSchool").DataField("AtSchool").HeaderText("是否在校"),
            F.RenderField().ColumnID("Major").DataField("Major").ExpandUnusedSpace(true).MinWidth(150).HeaderText("所学专业（提示信息）").RendererFunction("renderMajor")
                .Editor(
                    F.TextBox().ID("tbxMajor").Required(true)
                )
        ).DataSource(ViewBag.Grid1DataSource)
    )
    <br>

    @(F.Button().ID("btnSubmit").Text("保存数据").OnClick(Url.Action("btnSubmit_Click"), "Grid1"))

    <br>
    @(F.Label().ID("labResult").EncodeText(false))

    <br>


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderName(value, params) {
            params.cellAttrs = {
                'data-qtip': F.htmlEncode(value)
            };
            // 列渲染函数可以直接返回包含HTML标签的字符串，系统不会对返回值进行编码处理，所以需要自行对列渲染函数的返回值进行必要的HTML编码
            return F.htmlEncode(value);
        }

        function renderMajor(value, params) {
            params.cellAttrs = {
                'data-qtip': F.htmlEncode(value)
            };
            // 列渲染函数可以直接返回包含HTML标签的字符串，系统不会对返回值进行编码处理，所以需要自行对列渲染函数的返回值进行必要的HTML编码
            return F.htmlEncode(value);
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>在单元格和提示信息中同时编码用户文字，含 HTML 标签的输入按原文显示。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>对照单元格与悬停提示</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>的所学专业中输入<code>&lt;b&gt;示例&lt;/b&gt;</code>并结束编辑，再把鼠标移到该单元格上。<br />结果：单元格与提示信息都显示带标签的字面文字，不把它当成加粗的 HTML 内容；姓名提示采用相同处理。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>默认最后一行的[所学专业]包含HTML标签</li>
        <li>[姓名]和[所学专业]列中单元格有提示信息，修改单元格值后提示信息随之改变</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>RendererFunction</code>（<strong>姓名、所学专业列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：自定义渲染函数对正文返回值和 data-qtip 提示内容分别执行 HTML 编码。</li>
        <li><code>F.htmlEncode</code>（<strong>本页的渲染函数</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：把尖括号等字符转成文本内容；自定义 HTML 渲染函数中返回用户文字时同样需要编码。</li>
    </ul>
</section>
}
