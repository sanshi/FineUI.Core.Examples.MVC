@{
    ViewBag.SourceFiles = "~/GridEditor/SelectFromWindowIFrameWindow";
    ViewBag.Title = "GridEditor/SelectFromWindow";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("表格（进入编辑状态后，从弹出窗体中选择用户）").Height(350).DataIDField("Id").DataTextField("Name").AllowCellEditing(true).ClicksToEdit(1)
        .Columns(
            F.RowNumberField(),
            F.RenderField().ColumnID("Name").DataField("Name").HeaderText("姓名")
                .Editor(
                    F.TriggerBox().ID("tbxEditorName").TriggerIcon(TriggerIcon.Search).Listener("triggerclick", "onNameSearchTriggerClick")
                ),
            F.RenderField().ColumnID("Gender").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").HeaderText("性别")
                .Editor(
                    F.DropDownList().ID("ddlGender").Required(true)
                        .Items(
                            F.ListItem().Text("男").Value("1"),
                            F.ListItem().Text("女").Value("0")
                        )
                ),
            F.RenderField().ColumnID("EntranceYear").DataField("EntranceYear").FieldType(FieldType.Int).HeaderText("入学年份")
                .Editor(
                    F.NumberBox().ID("nbxEntranceYear").NoDecimal(true).NoNegative(true).MinValue(2000).MaxValue(2025)
                ),
            F.RenderField().Width(150).ColumnID("EntranceDate").DataField("EntranceDate").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd").HeaderText("入学日期")
                .Editor(
                    F.DatePicker().ID("dpEntranceDate").Required(true)
                ),
            F.RenderCheckField().ColumnID("AtSchool").DataField("AtSchool").HeaderText("是否在校"),
            F.RenderField().ColumnID("Major").DataField("Major").ExpandUnusedSpace(true).MinWidth(150).HeaderText("所学专业")
                .Editor(
                    F.TextBox().ID("tbxMajor").Required(true)
                ),
            F.RenderField().EnableHeaderMenu(false).RendererFunction("renderDeleteAction")
        )
        .Toolbars(
            F.Toolbar().ID("Toolbar1")
                .Items(
                    F.Button().ID("btnNew").Text("新增数据").Icon(Icon.Add).ClickHandler("onNewClick"),
                    F.Button().ID("btnDelete").Text("删除选中行").Icon(Icon.Delete).ClickHandler("onDeleteClick"),
                    F.ToolbarFill(),
                    F.Button().ID("btnReset").Text("重置表格数据").ClickHandler("onResetClick")
                )
        ).DataSource(ViewBag.Grid1DataSource)
    )
    <br>

    @(F.Button().ID("btnSubmit").Text("保存数据").ClickHandler("onSubmitClick"))

    <br>
    @(F.Label().ID("labResult").EncodeText(false))

    <br>

    @(F.Window().ID("Window1").EnableIFrame(true).EnableMaximize(true).EnableResize(true).Target(Target.Top).Height(350).Width(700).Title("选择用户").Hidden(true))

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 供子页面调用
        function updateGridRow(rowId, values) {
            var grid1 = F.ui.Grid1;

            // cancelEdit用来取消编辑
            grid1.cancelEdit();

            // 多列更新通过对象传入各列的新值，列名使用 ColumnID。
            // https://fineui.com/js/api/FineUI.Grid.html#updateCellValue
            grid1.updateCellValue(rowId, values);
        }


        function onNameSearchTriggerClick(event) {
            var grid1 = F.ui.Grid1;
            var selectedCell = grid1.getSelectedCell();
            if (selectedCell) {
                var iframeWindowUrl = '@Url.Content("~/GridEditor/SelectFromWindowIFrameWindow")';
                F.ui.Window1.show(iframeWindowUrl + '?rowid=' + selectedCell[0]);
            }
        }


        function onSubmitClick(event) {
            var grid1 = F.ui.Grid1;

            // 触发后台事件
            F.doPostBack({
                url: '@Url.Action("btnSubmit_Click")',
                params: {
                    fields: grid1.fields,
                    mergedData: F.toJSON(grid1.getMergedData())
                }
            });
        }

        function onNewClick(event) {
            var grid1 = F.ui.Grid1;

            // 新增一行（返回新增行的ID）
            var addedRowId = grid1.addNewRecord({
                'Name': '',
                'Gender': '1',
                'EntranceYear': '2015',
                'EntranceDate': '2016-11-15',
                'AtSchool': false,
                'Major': '化学系'
            }, true);

        }

        function onResetClick(event) {
            F.confirm({
                message: '确定要重置表格数据？',
                ok: function () {
                    F.ui.Grid1.rejectChanges();
                }
            });
        }

        function onDeleteClick(event) {
            var grid1 = F.ui.Grid1;
            if (!grid1.hasSelection()) {
                F.alert('没有选中项！');
                return;
            }

            var selectedRows = grid1.getSelectedRows();
            F.confirm({
                message: F.rawHtml('你确定要删除选中的&nbsp;<b>' + selectedRows.length + '</b>&nbsp;行数据吗？'),
                target: '_top',
                ok: function () {
                    grid1.deleteRows(selectedRows);
                }
            });
        }


        F.ready(function () {

            var grid1 = F.ui.Grid1;
            grid1.el.on('click', 'a.action-btn.delete', function (event) {
                // 删除链接是按钮型占位地址，先取消默认导航，避免改写页面 hash。
                event.preventDefault();

                var cnode = $(this);
                var rowData = grid1.getRowData(cnode.closest('.f-grid-row'));

                F.confirm({
                    message: '删除选中行？',
                    target: '_top',
                    ok: function () {
                        grid1.deleteRow(rowData);
                    }
                });
            });

        });

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>从 IFrame 选择窗体取得用户资料，按原行标识回填当前表格。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>把窗体选择回填到原行</h3>
    <ol>
        <li>点击<strong class="example-control-reference" data-example-control="btnNew" title="新增数据">新增数据</strong>。<br />结果：表格创建待编辑新行，接下来的选择回填作用于这条行。</li>
        <li>单击<strong class="example-control-reference" data-example-control="Grid1" title="表格（进入编辑状态后，从弹出窗体中选择用户）">表格（进入编辑状态后，从弹出窗体中选择用户）</strong>的<strong>姓名</strong>单元格，点击<strong class="example-control-reference" data-example-control="tbxEditorName" title="触发器输入框">触发器输入框</strong>的搜索图标。<br />结果：打开选择窗体，并把当前编辑行标识传给子页面，避免回填到其他行。</li>
        <li>在选择窗体双击张萍萍，或勾选该行后点击选择后关闭。<br />结果：当前行回填张萍萍及其<strong>性别</strong>、年份、专业等资料；子页面调用父页面的更新函数，关闭选择窗体后可继续编辑主表。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableIFrame</code>（<strong class="example-control-reference" data-example-control="Window1" title="选择用户">选择用户</strong>）：初始为 <code>true</code>，在窗体中加载独立的用户选择页。</li>
        <li><code>updateGridRow / cancelEdit / updateCellValue</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格（进入编辑状态后，从弹出窗体中选择用户）">表格（进入编辑状态后，从弹出窗体中选择用户）</strong>）：子页传回原行标识与字段值，父页先结束当前临时编辑，再更新这一行的关联字段。</li>
    </ul>
</section>
}
