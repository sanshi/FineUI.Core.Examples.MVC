@{
    ViewBag.Title = "GridEditor/EditableCellAfterEdit";
    var F = Html.F();
}

@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("表格（单击编辑）").DataIDField("Id").DataTextField("Name").AllowCellEditing(true).ClicksToEdit(1)
        .Columns(
            F.RowNumberField(),
            F.RenderField().ColumnID("Name").DataField("Name").HeaderText("姓名")
                .Editor(
                    F.TextBox().ID("tbxName").Required(true)
                ),
            F.RenderField().ColumnID("Gender").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").HeaderText("性别")
                .Editor(
                    F.DropDownList().ID("ddlGender").Required(true)
                        .Items(
                            F.ListItem().Text("男").Value("1"),
                            F.ListItem().Text("女").Value("0")
                        )
                ),
            F.RenderField().ColumnID("EntranceYear").DataField("EntranceYear").FieldType(FieldType.Int).HeaderText("入学年份")
                .Editor(
                    F.NumberBox().ID("nbxEntranceYear").NoDecimal(true).NoNegative(true).MinValue(2000).MaxValue(2025)
                ),
            F.RenderField().Width(150).ColumnID("EntranceDate").DataField("EntranceDate").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd").HeaderText("入学日期")
                .Editor(
                    F.DatePicker().ID("dpEntranceDate").Required(true)
                ),
            F.RenderCheckField().ColumnID("AtSchool").DataField("AtSchool").HeaderText("是否在校"),
            F.RenderField().ColumnID("Major").DataField("Major").ExpandUnusedSpace(true).MinWidth(150).HeaderText("所学专业").RendererFunction("renderMajor")
                .Editor(
                    F.TextBox().ID("tbxMajor").Required(true)
                )
        )
        .Tools(F.Tool().IconFont(IconFont._Refresh).ToolTip("Refresh").ClickHandler("onRefreshToolClick"))
        .Listener("afteredit", "onGrid1AfterEdit").DataSource(ViewBag.Grid1DataSource)
    )
    <br>
    <br>

    @(F.Button().ID("btnSubmit").Text("保存数据").OnClick(Url.Action("btnSubmit_Click"), "Grid1"))

    <br>
    @(F.Label().ID("labResult").EncodeText(false))

    <br>
    <br />
    <br />
    注：修改[是否在校]会同时改变[所学专业]单元格的可编辑状态。

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderMajor(value, params) {
            if (!params.rowData.values.AtSchool) {
                params.cellCls = 'f-grid-cell-uneditable';
            }

            return value;
        }


        function onGrid1AfterEdit(event, value, params) {
            var grid1 = this, rowId = params.rowId, columnId = params.columnId;

            if (columnId === 'AtSchool') {
                if (!value) {
                    grid1.updateCellValue(rowId, 'Major.cls', 'f-grid-cell-uneditable');
                } else {
                    grid1.updateCellValue(rowId, 'Major.cls', '');
                }
            }
        }

        function onRefreshToolClick(event) {
            F.ui.Grid1.loadData();
        }

    </script>
}
