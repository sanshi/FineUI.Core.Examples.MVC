@{
    ViewBag.Title = "GridEditor/GridEditorRate";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true)
        .Title("表格").DataIDField("Id").DataTextField("Name").AllowCellEditing(true).ClicksToEdit(1)
        .Columns(
            F.RowNumberField(),
            F.RenderField().ColumnID("Name").DataField("Name").HeaderText("姓名")
                .Editor(
                    F.TextBox().ID("tbxName").Required(true)
                ),
            F.RenderField().ColumnID("Gender").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").HeaderText("性别")
                .Editor(
                    F.DropDownList().ID("ddlGender").Required(true)
                        .Items(
                            F.ListItem().Text("男").Value("1"),
                            F.ListItem().Text("女").Value("0")
                        )
                ),
            F.RenderField().Width(150).ColumnID("Rate1").DataField("Rate1").HeaderText("只读评分").FieldType(FieldType.Int).RendererFunction("renderRate1"),
            F.RenderField().Width(200).ColumnID("Rate2").DataField("Rate2").HeaderText("五星评分").FieldType(FieldType.Int).RendererFunction("renderRate2"),
            F.RenderField().Width(200).ColumnID("Rate3").DataField("Rate3").HeaderText("自定义评分").FieldType(FieldType.Float).RendererFunction("renderRate3"),
            F.RenderField().ColumnID("Major").DataField("Major").ExpandUnusedSpace(true).MinWidth(150).HeaderText("所学专业")
                .Editor(
                    F.TextBox().ID("tbxMajor").Required(true)
                )
        ).DataSource(ViewBag.Grid1DataSource)
    )
    <br>
    <br>
    @(F.Button().ID("btnSubmit").Text("保存数据").OnClick(Url.Action("btnSubmit_Click"), "Grid1"))

    <br>
    @(F.Label().ID("labResult").EncodeText(false))


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        var desc = ['terrible', 'bad', 'normal', 'good', 'wonderful'];
        function renderRate2Text(val) {
            var rateText = '-';
            if (val > 0) {
                rateText = desc[val - 1];
            }
            return rateText;
        }


        function renderRate1(value) {
            return F.rateHtml(value, {
                readonly: true
            });
        }

        function renderRate2(value) {
            return F.rateHtml(value, {
                textVisible: true,
                textRenderer: renderRate2Text
            });
        }

        function renderRate3(value) {
            return F.rateHtml(value, {
                allowHalf: true,
                iconFont: 'f-iconfont-trophy',
                textVisible: true
            });
        }


        F.ready(function () {

            var grid1 = F.ui.Grid1;

            // 注册评分事件
            F.rateEvents(grid1.el, function (event, value) {
                var target = $(event.target);
                var cellEl = target.closest('.f-grid-cell');

                var rowId = grid1.getRowId(cellEl);
                var columnId = grid1.getColumnId(cellEl);

                // 更新单元格的值
                grid1.updateCellValue(rowId, columnId, value);
            });

        });

    </script>
}
