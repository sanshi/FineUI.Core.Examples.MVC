@{
    ViewBag.Title = "GridEditor/DropDownBoxGridMulti";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("表格（单击编辑）").DataIDField("Id").DataTextField("Name").AllowCellEditing(true).ClicksToEdit(1)
        .Columns(
            F.RowNumberField(),
            F.RenderField().ColumnID("Name").DataField("Name").HeaderText("姓名")
                .Editor(
                    F.TextBox().ID("tbxName").Required(true)
                ),
            F.RenderField().ColumnID("Gender").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").HeaderText("性别")
                .Editor(
                    F.DropDownList().ID("ddlGender").Required(true)
                        .Items(
                            F.ListItem().Text("男").Value("1"),
                            F.ListItem().Text("女").Value("0")
                        )
                ),
            F.RenderField().ColumnID("EntranceYear").DataField("EntranceYear").FieldType(FieldType.Int).HeaderText("入学年份")
                .Editor(
                    F.NumberBox().ID("nbxEntranceYear").NoDecimal(true).NoNegative(true).MinValue(2000).MaxValue(2025)
                ),
            F.RenderField().Width(150).ColumnID("EntranceDate").DataField("EntranceDate").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd").HeaderText("入学日期")
                .Editor(
                    F.DatePicker().ID("dpEntranceDate").Required(true)
                ),
            F.RenderCheckField().ColumnID("AtSchool").DataField("AtSchool").HeaderText("是否在校"),
            F.RenderField().ColumnID("Hobby").DataField("Hobby").ExpandUnusedSpace(true).MinWidth(150).HeaderText("兴趣爱好").RendererFunction("renderHobby")
                .Editor(
                    F.DropDownBox().ID("DropDownBox1").EmptyText("请选择").EnableMultiSelect(true).AutoShowClearIcon(true)
                        .PopPanel(
                            F.Grid().ID("Grid2").ShowBorder(true).ShowHeader(false).EnableCheckBoxSelect(true).KeepCurrentSelection(true).DataIDField("Code").DataTextField("Name").EnableMultiSelect(true).Hidden(true)
                                .Columns(
                                    F.RowNumberField(),
                                    F.RenderField().ColumnID("Code").DataField("Code").HeaderText("代码"),
                                    F.RenderField().ColumnID("Name").ExpandUnusedSpace(true).MinWidth(150).DataField("Name").HeaderText("姓名")
                                ).DataSource(ViewBag.Grid2DataSource)
                        )
                )
        ).DataSource(ViewBag.Grid1DataSource)
    )
    <br>

    @(F.Button().ID("btnSubmit").Text("保存数据").OnClick(Url.Action("btnSubmit_Click"), "Grid1"))

    <br>
    @(F.Label().ID("labResult").EncodeText(false))

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderHobby(value) {
            if (!value) {
                return '';
            }

            // 兴趣爱好表格的实例
            var grid2 = F.ui.Grid2;

            var hobbies = value.split(',');

            return $.map(hobbies, function (hobby, index) {
                return grid2.getRowData(hobby).text;
            }).join(', ');

        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>用可多选的下拉表格作为单元格编辑器，按记录代码保存多项兴趣。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>在弹出内容中多选</h3>
    <ol>
        <li>打开<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>的<strong>兴趣爱好</strong>编辑器，在弹出的表格中选中两项，再结束编辑。<br />结果：单元格显示所选兴趣名称，实际值保留对应<strong>代码</strong>集合；不把名称和选项<strong>代码</strong>混为同一个字段。</li>
        <li>再次进入同一<strong>兴趣爱好</strong>单元格。<br />结果：编辑器恢复刚才的选择，可继续增减选项。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="兴趣爱好列的下拉框">兴趣爱好列的下拉框</strong>）：初始为 <code>true</code>，允许下拉编辑器保留多项值。</li>
        <li><code>PopPanel</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="兴趣爱好列的下拉框">兴趣爱好列的下拉框</strong>）：弹出内容由本页的复选框列表或表格提供，取其中的值与文字作为单元格编辑结果。</li>
    </ul>
</section>
}
