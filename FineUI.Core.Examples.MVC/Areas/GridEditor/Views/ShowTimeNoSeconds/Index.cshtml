@{
    ViewBag.Title = "GridEditor/ShowTimeNoSeconds";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("表格（单击编辑）").DataIDField("Id").DataTextField("Name").AllowCellEditing(true).ClicksToEdit(1)
        .Columns(
            F.RowNumberField(),
            F.RenderField().ColumnID("Name").DataField("Name").HeaderText("姓名")
                .Editor(
                    F.TextBox().ID("tbxName").Required(true)
                ),
            F.RenderField().ColumnID("Gender").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").HeaderText("性别")
                .Editor(
                    F.DropDownList().ID("ddlGender").Required(true)
                        .Items(
                            F.ListItem().Text("男").Value("1"),
                            F.ListItem().Text("女").Value("0")
                        )
                ),
            F.RenderField().ColumnID("EntranceYear").DataField("EntranceYear").FieldType(FieldType.Int).HeaderText("入学年份")
                .Editor(
                    F.NumberBox().ID("nbxEntranceYear").NoDecimal(true).NoNegative(true).MinValue(2000).MaxValue(2025)
                ),
            F.RenderField().Width(180).ColumnID("EntranceDate").DataField("EntranceDate").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd HH:mm").HeaderText("入学日期")
                .Editor(
                    F.DatePicker().ID("dpEntranceDate").Required(true).DateFormatString("yyyy-MM-dd HH:mm").ShowTime(true).ShowSecond(false)
                ),
            F.RenderCheckField().ColumnID("AtSchool").DataField("AtSchool").HeaderText("是否在校"),
            F.RenderField().ColumnID("Major").DataField("Major").ExpandUnusedSpace(true).MinWidth(150).HeaderText("所学专业")
                .Editor(
                    F.TextBox().ID("tbxMajor").Required(true)
                )
        ).DataSource(ViewBag.Grid1DataSource)
    )
    <br>

    @(F.Button().ID("btnSubmit").Text("保存数据").OnClick(Url.Action("btnSubmit_Click"), "Grid1"))

    <br>
    @(F.Label().ID("labResult").EncodeText(false))

    <br>
    为了正确的显示和编辑时间，请注意如下属性：


}

@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>在单元格日期编辑器中同时选择日期和时间，显示精度保留到分钟，不显示秒。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>修改日期与时间</h3>
    <ul>
        <li>单击<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>的<strong>入学日期</strong>，同时调整日期与时间，再结束编辑。<br />结果：单元格按年月日、时分显示结果；重新进入编辑时可继续调整同样精度的时间。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li><strong>入学日期</strong>列（RenderField）：FieldType="Date" Renderer="Date" RendererArgument="yyyy-MM-dd HH:mm"</li>
        <li><strong><strong>入学日期</strong></strong>的编辑表单字段（DatePicker）：DateFormatString="yyyy-MM-dd HH:mm" ShowTime="true" ShowSecond="false"</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>ShowTime</code>（<strong class="example-control-reference" data-example-control="dpEntranceDate" title="入学日期列的日期选择框">入学日期列的日期选择框</strong>）：初始为 <code>true</code>，在日期弹层中显示时间选择区。</li>
        <li><code>DateFormatString</code>（<strong class="example-control-reference" data-example-control="dpEntranceDate" title="入学日期列的日期选择框">入学日期列的日期选择框</strong>）：初始为 <code>yyyy-MM-dd HH:mm</code>，编辑器按本页格式读取与回显完整日期时间。</li>
        <li><code>RendererArgument</code>（<strong>入学日期</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：初始为 <code>yyyy-MM-dd HH:mm</code>，单元格采用与编辑器一致的日期时间显示精度。</li>
    </ul>
</section>
}
