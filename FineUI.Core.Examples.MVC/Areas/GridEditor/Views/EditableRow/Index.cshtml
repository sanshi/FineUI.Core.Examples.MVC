@{
    ViewBag.Title = "GridEditor/EditableRow";
    var F = Html.F();
}


@section head {

    <style>
        .row-entranceyear-lte-2002 .f-grid-cell-text {
            opacity: .5;
            filter: alpha(opacity=50);
        }
    </style>

}

@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("表格（单击编辑）").DataIDField("Id").DataTextField("Name").AllowCellEditing(true).ClicksToEdit(1)
        .Columns(
            F.RowNumberField(),
            F.RenderField().ColumnID("Name").DataField("Name").HeaderText("姓名")
                .Editor(
                    F.TextBox().ID("tbxName").Required(true)
                ),
            F.RenderField().ColumnID("Gender").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").HeaderText("性别")
                .Editor(
                    F.DropDownList().ID("ddlGender").Required(true)
                        .Items(
                            F.ListItem().Text("男").Value("1"),
                            F.ListItem().Text("女").Value("0")
                        )
                ),
            F.RenderField().ColumnID("EntranceYear").DataField("EntranceYear").FieldType(FieldType.Int).HeaderText("入学年份")
                .Editor(
                    F.NumberBox().ID("nbxEntranceYear").NoDecimal(true).NoNegative(true).MinValue(2000).MaxValue(2025)
                ),
            F.RenderField().Width(150).ColumnID("EntranceDate").DataField("EntranceDate").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd").HeaderText("入学日期")
                .Editor(
                    F.DatePicker().ID("dpEntranceDate").Required(true)
                ),
            F.RenderCheckField().ColumnID("AtSchool").DataField("AtSchool").HeaderText("是否在校"),
            F.RenderField().ColumnID("Major").DataField("Major").ExpandUnusedSpace(true).MinWidth(150).HeaderText("所学专业")
                .Editor(
                    F.TextBox().ID("tbxMajor").Required(true)
                )
        ).RowDataBoundFunction("grid1RowDataBound").Listener("beforeedit", "onGrid1BeforeEdit").DataSource(ViewBag.Grid1DataSource)
    )
    <br>
    <br>

    @(F.Button().ID("btnSubmit").Text("保存数据").OnClick(Url.Action("btnSubmit_Click"), "Grid1"))

    <br>
    @(F.Label().ID("labResult").EncodeText(false))

    <br>


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 在 RowDataBound 中改变行CSS类
        function grid1RowDataBound(rowData) {
            var entranceYear = rowData.values['EntranceYear'];

            if (entranceYear <= 2002) {
                rowData.cls = "row-entranceyear-lte-2002";
            }
        }


        function onGrid1BeforeEdit(event, value, params) {
            // 取消单元格编辑
            if (params.tr.hasClass('row-entranceyear-lte-2002')) {
                return false;
            }
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>根据每行的入学年份决定整行是否允许进入编辑，拦截不符合条件的编辑请求。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>按行判断编辑条件</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>选择<strong>入学年份</strong>小于或等于<code>2002</code>的行，点击<strong>姓名</strong>等原本有编辑器的单元格。<br />结果：编辑前回调返回 false，整行不能进入编辑；年份大于 2002 的其他行仍可编辑。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>beforeedit</code>（<strong>页面脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：进入编辑前按当前行条件返回 false；行样式用于识别受限记录，不以行序号判断。</li>
    </ul>
</section>
}
