@{
    ViewBag.Title = "GridEditor/RenderFunction";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("表格（单击编辑）").DataIDField("Id").DataTextField("Name").AllowCellEditing(true).ClicksToEdit(1)
        .Columns(
            F.RowNumberField(),
            F.RenderField().ColumnID("Name").DataField("Name").HeaderText("姓名")
                .Editor(
                    F.TextBox().ID("tbxName").Required(true)
                ),
            F.RenderField().ColumnID("Gender").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").HeaderText("性别")
                .Editor(
                    F.DropDownList().ID("ddlGender").Required(true)
                        .Items(
                            F.ListItem().Text("男").Value("1"),
                            F.ListItem().Text("女").Value("0")
                        )
                ),
            F.RenderField().ColumnID("EntranceYear").DataField("EntranceYear").FieldType(FieldType.Int).HeaderText("入学年份")
                .Editor(
                    F.NumberBox().ID("nbxEntranceYear").NoDecimal(true).NoNegative(true).MinValue(2000).MaxValue(2025)
                ),
            F.RenderField().Width(150).ColumnID("EntranceDate").DataField("EntranceDate").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd").HeaderText("入学日期")
                .Editor(
                    F.DatePicker().ID("dpEntranceDate").Required(true)
                ),
            F.RenderCheckField().ColumnID("AtSchool").DataField("AtSchool").HeaderText("是否在校"),
            F.RenderField().ColumnID("Major").DataField("Major").ExpandUnusedSpace(true).MinWidth(150).HeaderText("所学专业")
                .Editor(
                    F.DropDownList().ID("ddlMajor").Required(true)
                        .Items(
                            F.ListItem().Text("材料科学与工程系").Value("材料科学与工程系"),
                            F.ListItem().Text("化学系").Value("化学系"),
                            F.ListItem().Text("数学系").Value("数学系"),
                            F.ListItem().Text("物理系").Value("物理系"),
                            F.ListItem().Text("自动化系").Value("自动化系")
                        )
                ),
            F.RenderField().Width(150).ColumnID("Salary").DataField("Salary").FieldType(FieldType.Float).RendererFunction("renderSalary").HeaderText("工资")
                .Editor(
                    F.NumberBox().EnableCommas(true).DecimalPrecision(2).TrimEndZero(false).Required(true)
                )
        ).DataSource(ViewBag.Grid1DataSource)
    )
    <br>

    @(F.Button().ID("btnSubmit").Text("保存数据").OnClick(Url.Action("btnSubmit_Click"), "Grid1"))

    <br>
    @(F.Label().ID("labResult").EncodeText(false))


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderGender(value) {
            return F.ui.ddlGender.getTextByValue(value);
        }

        function renderMajor(value) {
            return F.ui.ddlMajor.getTextByValue(value);
        }

        function renderSalary(value) {
            return F.addCommas(value.toFixed(2));
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>把编辑后的性别、专业代码转换为名称，并按两位小数和千分位显示工资。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>编辑后按列格式重新显示</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单击编辑）">表格（单击编辑）</strong>修改<strong>性别</strong>或<strong>所学专业</strong>，再把<strong>工资</strong>输入为<code>12345.6</code>并结束编辑。<br />结果：下拉列显示所选项的文字，<strong>工资</strong>显示为
                12,345.60；渲染后的显示文字与单元格保留的实际值分开。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RendererFunction</code>（<strong>性别、所学专业及工资列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格（单击编辑）">表格（单击编辑）</strong>）：下拉列按值查文字，<strong>工资</strong>列使用固定两位小数再添加千分位，不把格式化字符串直接当作输入数值。</li>
        </ul>
    </section>
}
