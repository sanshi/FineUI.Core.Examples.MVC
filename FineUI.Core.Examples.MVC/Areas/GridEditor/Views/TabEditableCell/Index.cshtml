@{
    ViewBag.Title = "GridEditor/TabEditableCell";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("表格（单击编辑）").DataIDField("Id").DataTextField("Name").AllowCellEditing(true).ClicksToEdit(1).TabEditableCell(true)
        .Columns(
            F.RowNumberField(),
            F.RenderField().ColumnID("Name").DataField("Name").HeaderText("姓名")
                .Editor(
                    F.TextBox().ID("tbxName").Required(true)
                ),
            F.RenderField().ColumnID("Gender").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").HeaderText("性别（不可编辑）"),
            F.RenderField().ColumnID("EntranceYear").DataField("EntranceYear").FieldType(FieldType.Int).HeaderText("入学年份")
                .Editor(
                    F.NumberBox().ID("nbxEntranceYear").NoDecimal(true).NoNegative(true).MinValue(2000).MaxValue(2025)
                ),
            F.RenderField().Width(150).ColumnID("EntranceDate").DataField("EntranceDate").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd").HeaderText("入学日期")
                .Editor(
                    F.DatePicker().ID("dpEntranceDate").Required(true)
                ),
            F.RenderCheckField().ColumnID("AtSchool").DataField("AtSchool").HeaderText("是否在校"),
            F.RenderField().ColumnID("Major").DataField("Major").ExpandUnusedSpace(true).MinWidth(150).HeaderText("所学专业（不可编辑）")
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>

    @(F.Button().ID("btnSubmit").Text("保存数据").OnClick(Url.Action("btnSubmit_Click"), "Grid1"))

    <br>
    @(F.Label().ID("labResult").EncodeText(false))

    <br>
    快捷键说明：
    <ul>
        <li>方向键在单元格之间导航（非编辑状态）</li>
        <li>回车键使单元格进入编辑状态</li>
        <li>ESC键取消单元格的编辑状态</li>
        <li>Tab键进入水平方向的下一个单元格（如果单元格可编辑，则使其进入编辑状态）</li>
        <li>Shift+Tab键回退到垂直方向的上一个单元格（如果单元格可编辑，则使其进入编辑状态）</li>
        <li><strong>Tab键只在可编辑单元格之间导航</strong></li>
    </ul>

}

@section script {

    <script src="~/res/js/grid.js"></script>

}
