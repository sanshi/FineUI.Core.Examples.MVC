@{
    ViewBag.Title = "GridEditor/Decimal";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("表格（单击编辑）").DataIDField("Id").DataTextField("Name").AllowCellEditing(true).ClicksToEdit(1)
        .Columns(
            F.RowNumberField(),
            F.RenderField().ColumnID("Name").DataField("Name").HeaderText("姓名")
                .Editor(
                    F.TextBox().ID("tbxName").Required(true)
                ),
            F.RenderField().ColumnID("Gender").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").HeaderText("性别")
                .Editor(
                    F.DropDownList().ID("ddlGender").Required(true)
                        .Items(
                            F.ListItem().Text("男").Value("1"),
                            F.ListItem().Text("女").Value("0")
                        )
                ),
            F.RenderField().ColumnID("Major").DataField("Major").ExpandUnusedSpace(true).MinWidth(150).HeaderText("所学专业")
                .Editor(
                    F.TextBox().ID("tbxMajor").Required(true)
                ),
            F.RenderField().ColumnID("ChineseScore").DataField("ChineseScore").FieldType(FieldType.Float).HeaderText("语文成绩")
                .Editor(
                    F.NumberBox().ID("nbChineseScore").NoDecimal(false).NoNegative(true)
                ),
            F.RenderField().ColumnID("MathScore").DataField("MathScore").FieldType(FieldType.Float).HeaderText("数学成绩")
                .Editor(
                    F.NumberBox().ID("nbMathScore").NoDecimal(false).NoNegative(true)
                )
        ).DataSource(ViewBag.Grid1DataSource)
    )
    <br>

    @(F.Button().ID("btnSubmit").Text("保存数据").OnClick(Url.Action("btnSubmit_Click"), "Grid1"))

    <br>
    @(F.Label().ID("labResult").EncodeText(false))

    <br>


}

@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>在成绩单元格中编辑小数或空值，保存时保留小数部分。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>编辑小数成绩</h3>
    <ol>
        <li>单击<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>的<strong>语文成绩</strong>并输入<code>88.5</code>，再结束编辑。<br />结果：单元格保留 88.5，不截断为整数；<strong><strong>数学成绩</strong></strong>可按相同方式填写小数。</li>
        <li>将一个成绩单元格清空，再点击<strong class="example-control-reference" data-example-control="btnSubmit" title="保存数据">保存数据</strong>。<br />结果：后台读取本轮修改，将空值与小数写回示例数据并重新绑定，下方显示提交的修改明细。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <ul>
        <li>成绩可以为小数</li>
        <li>默认[刘国]和[康颖颖]的成绩未定义（DBNull.Value）</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>NoDecimal</code>（<strong class="example-control-reference" data-example-control="nbChineseScore" title="语文成绩列的数字输入框">语文成绩列的数字输入框</strong>）：初始为 <code>false</code>，允许输入小数成绩。</li>
        <li><code>FieldType</code>（<strong>语文、数学成绩列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格（单击编辑）">表格（单击编辑）</strong>）：成绩列使用浮点数类型读取和提交，避免按整数解释小数。</li>
    </ul>
</section>
}
