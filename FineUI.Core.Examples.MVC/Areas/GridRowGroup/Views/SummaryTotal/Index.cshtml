@{
    ViewBag.Title = "GridRowGroup/SummaryTotal";
    var F = Html.F();
}

@section head {

    <style>
        .f-grid-rowgroup-summary .f-grid-cell-Major .f-grid-cell-text {
            text-align: right;
        }

        .f-grid-rowgroup-summary .f-grid-cell-text {
            font-style: italic;
        }

        .f-grid-row-summary .f-grid-cell-Major .f-grid-cell-text {
            text-align: right;
        }

        .f-grid-row-summary .f-grid-cell-text {
            font-weight: bold;
        }
    </style>

}

@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .EnableSummary(true).SummaryPosition(SummaryPosition.Bottom)
        .EnableRowGroup(true).DataRowGroupField("EntranceYear").RowGroupSummary(true)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").ColumnID("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150).RowGroupSummaryText("平均（分组）：").SummaryText("平均（汇总）："),
            F.RenderField().HeaderText("语文成绩").DataField("ChineseScore").ColumnID("ChineseScore").FieldType(FieldType.Int).RowGroupSummaryType(SummaryType.Avg).SummaryType(SummaryType.Avg),
            F.RenderField().HeaderText("数学成绩").DataField("MathScore").ColumnID("MathScore").FieldType(FieldType.Int).RowGroupSummaryType(SummaryType.Avg).SummaryType(SummaryType.Avg)
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>


    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>同时显示每组平均成绩和全表平均成绩，明确两个统计范围。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>对照分组明细与统计值</h3>
        <ul>
            <li>查看<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>一个年份分组的明细及其后统计区域，再查看表格底部统计。<br />结果：组内统计只使用该年份成员；底部平均（汇总）按全表记录计算，不是把各组平均值直接再平均。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RowGroupSummary</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，为分组创建专用统计行。
            </li>
            <li><code>RowGroupSummaryType</code>（<strong>语文与数学成绩列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：成绩列使用 Avg，只读取当前组的数值。</li>
            <li><code>EnableSummary</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，在各组统计以外显示全表汇总行。
            </li>
        </ul>
    </section>
}
