@{
    ViewBag.Title = "GridRowGroup/ExpandedRows";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Height(500).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .EnableRowGroup(true).DataRowGroupField("EntranceYear").RowDataBoundFunction("onGrid1RowDataBound")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>


    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))

    <br />
    <br />

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1RowDataBound(rowData) {
            var groupValue = rowData.rowGroup;

            if (rowData.isRowGroup) {
                if (groupValue === '2000' || groupValue === '2008') {
                    rowData.expanded = false;
                }
            }
        }


    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>首次加载只折叠指定年份分组，其他组继续展开。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>核对初始折叠范围</h3>
        <ul>
            <li>查看<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>的年份<strong>分组</strong>，再点击一个折叠组的展开入口。<br />结果：2000 与 2008 两组初始折叠，其他组展开；单独打开一组不会改变其他组状态。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：本表格默认折叠[入学年份]为 2000 和 2008 的两个行分组。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>rowData.expanded</code>（<strong>分组行绑定处理</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：行绑定时对指定<strong>分组</strong>设置 false，其他组保留展开。</li>
        </ul>
    </section>
}
