@{
    ViewBag.Title = "GridRowGroup/Summary";
    var F = Html.F();
}

@section head {

    <style>
        .f-grid-rowgroup-summary .f-grid-cell-Major .f-grid-cell-text {
            text-align: right;
        }

        .f-grid-rowgroup-summary .f-grid-cell-text {
            font-style: italic;
        }
    </style>

}

@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .EnableRowGroup(true).DataRowGroupField("EntranceYear").RowGroupSummary(true)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").ColumnID("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150).RowGroupSummaryText("平均（分组）："),
            F.RenderField().HeaderText("语文成绩").DataField("ChineseScore").ColumnID("ChineseScore").FieldType(FieldType.Int).RowGroupSummaryType(SummaryType.Avg),
            F.RenderField().HeaderText("数学成绩").DataField("MathScore").ColumnID("MathScore").FieldType(FieldType.Int).RowGroupSummaryType(SummaryType.Avg)
        )
        .DataSource(DataSourceUtil.GetDataTable())
        .RowRendererFunction("grid1RowRenderer")
    )
    <br>


    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))


    <br />
    <br />
    注：如果分组中只有一行数据，则隐藏分组合计。
}


@section script {

    <script src="~/res/js/grid.js"></script>


    <script>

        // 计算分组中的行数（排除分组合计）
        function linesInRowGroup(rowGroup) {
            var lines = 0;
            $.each(F.ui.Grid1.data, function (index, rowData) {
                if (rowData.isRowGroup && rowData.rowGroup === rowGroup) {
                    // 最后一行是分组合计
                    lines = rowData.children.length - 1;
                    return false; // break
                }
            });
            return lines;
        }

        // 在 RowRenderer 中改变行CSS类
        function grid1RowRenderer(params) {
            // 当前行是否分组合计
            var isRowGroupSummary = params.rowData.isRowGroupSummary;
            if (isRowGroupSummary) {
                var rowGroup = params.rowData.rowGroup;

                // 如果分组中只有一行数组，则隐藏分组合计
                if (linesInRowGroup(rowGroup) === 1) {
                    params.rowCls = 'f-hidden';
                }
            }
        }

    </script>

}
