@{
    ViewBag.Title = "GridOther/GridNumberTrailingZero";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Title("表格（尾零省略）").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().Width(150).DataField("EntranceDate").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd").HeaderText("入学日期"),
            F.RenderField().Width(160).DataField("Salary").HeaderText("工资（千分位，尾零省略）").FieldType(FieldType.Double).Renderer(Renderer.Number).RendererArgument("N2").TrimZero(true),
            F.RenderField().Width(150).DataField("GPA").HeaderText("绩点（定点数，尾零省略）").FieldType(FieldType.Double).Renderer(Renderer.Number).RendererArgument("F2").TrimZero(true),
            F.RenderField().Width(160).DataField("AttendanceRate").HeaderText("出勤率（百分比，尾零省略）").FieldType(FieldType.Double).Renderer(Renderer.Number).RendererArgument("P2").TrimZero(true),
            F.RenderField().Width(175).DataField("ResearchFund").HeaderText("科研经费（科学计数法，尾零省略）").FieldType(FieldType.Double).Renderer(Renderer.Number).RendererArgument("E2").TrimZero(true)
        )
        .DataSource(@ViewBag.ExtendedTableSource)
    )
    <br>
    <br>

}


@section script {

    <script src="~/res/js/grid.js"></script>


}
