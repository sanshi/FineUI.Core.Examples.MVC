@{
    ViewBag.Title = "GridOther/LineWrap";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-row .f-grid-cell-text {
            white-space: normal;
            word-break: break-all;
        }
    </style>

}


@section body {

    @(F.Grid().IsFluid(true).Height(400).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableTextSelection(true)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").Width(150),
            F.RenderField().HeaderText("个人简介").DataField("Desc").Width(400).MinWidth(150)
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>让长单元格文字按列宽自动折行，内容较多的行随之增高。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>对照本页样式规则</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>查看专业或描述长文字，再缩窄对应列。<br />结果：同一段文字因可用宽度变化重新折行，行高随内容变化，不强制所有记录等高。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>CSS</code>（<strong>本页列与样式</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：本页单元格文字允许换行，取消默认的单行显示约束。</li>
    </ul>
</section>
}
