@{
    ViewBag.Title = "GridOther/ScrollbarSync";
    var F = Html.F();
}



@section body {

    @(F.Panel().ID("Panel1").Layout(LayoutType.VBox).ShowBorder(false).ShowHeader(false).IsViewPort(true).Margin(10)
        .Items(
            F.Grid().ID("Grid1").BoxFlex(1).ShowBorder(true).ShowHeader(true).Title("表格一").DataIDField("Id").DataTextField("Name")
                .Columns(
                    F.RowNumberField(),
                    F.RenderField().HeaderText("姓名").DataField("Name"),
                    F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                    F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
                    F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").Width(150),
                    F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
                    F.RenderField().Width(300).DataField("GUID").HeaderText("GUID"),
                    F.RenderField().Width(200).HeaderText("爱好").DataField("Hobby").RendererFunction("renderHobby"),
                    F.RenderField().DataField("EntranceDate").HeaderText("入学时间"),
                    F.RenderField().DataField("ChineseScore").HeaderText("语文成绩"),
                    F.RenderField().DataField("MathScore").HeaderText("数学成绩"),
                    F.RenderField().DataField("TotalScore").HeaderText("总成绩"),
                    F.RenderField().DataField("ShenGao").HeaderText("身高"),
                    F.RenderField().DataField("TiZhong").HeaderText("体重"),
                    F.RenderField().DataField("XueYaDi").HeaderText("血压（低）"),
                    F.RenderField().DataField("XueYaGao").HeaderText("血压（高）"),
                    F.RenderField().DataField("ShiLiZuo").HeaderText("视力（左）"),
                    F.RenderField().DataField("ShiLiYou").HeaderText("视力（右）"),
                    F.RenderField().Width(150).DataField("ShiLiZuoJiaoZhen").HeaderText("矫正视力（左）"),
                    F.RenderField().Width(150).DataField("ShiLiYouJiaoZhen").HeaderText("矫正视力（右）")
                ).DataSource(ViewBag.Grid1DataSource),
            F.Grid().ID("Grid2").BoxFlex(1).ShowBorder(true).ShowHeader(true).Title("表格二").DataIDField("Id").DataTextField("Name")
                .Columns(
                    F.RowNumberField(),
                    F.RenderField().HeaderText("姓名").DataField("Name"),
                    F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                    F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
                    F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").Width(150),
                    F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
                    F.RenderField().Width(300).DataField("GUID").HeaderText("GUID"),
                    F.RenderField().Width(200).HeaderText("爱好").DataField("Hobby").RendererFunction("renderHobby"),
                    F.RenderField().DataField("EntranceDate").HeaderText("入学时间"),
                    F.RenderField().DataField("ChineseScore").HeaderText("语文成绩"),
                    F.RenderField().DataField("MathScore").HeaderText("数学成绩"),
                    F.RenderField().DataField("TotalScore").HeaderText("总成绩"),
                    F.RenderField().DataField("ShenGao").HeaderText("身高"),
                    F.RenderField().DataField("TiZhong").HeaderText("体重"),
                    F.RenderField().DataField("XueYaDi").HeaderText("血压（低）"),
                    F.RenderField().DataField("XueYaGao").HeaderText("血压（高）"),
                    F.RenderField().DataField("ShiLiZuo").HeaderText("视力（左）"),
                    F.RenderField().DataField("ShiLiYou").HeaderText("视力（右）"),
                    F.RenderField().Width(150).DataField("ShiLiZuoJiaoZhen").HeaderText("矫正视力（左）"),
                    F.RenderField().Width(150).DataField("ShiLiYouJiaoZhen").HeaderText("矫正视力（右）")
                ).DataSource(ViewBag.Grid1DataSource))
                
    )


}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderHobby(value, params) {
            var result = [];

            // Hobby：reading,basketball,travel,movie,music
            // 爱好：读书, 篮球, 旅游, 电影, 音乐
            var hobbies = value.split(',');

            $.each(hobbies, function (index, hobby) {
                if (hobby == "reading") {
                    result.push("读书");
                }
                else if (hobby == "basketball") {
                    result.push("篮球");
                }
                else if (hobby == "travel") {
                    result.push("旅游");
                }
                else if (hobby == "movie") {
                    result.push("电影");
                }
                else if (hobby == "music") {
                    result.push("音乐");
                }
            });

            return result.join(',');
        }


        function syncGridScrollbar(el1, el2) {
            el1.on('scroll', function () {
                el2.scrollLeft(el1.scrollLeft());
                el2.scrollTop(el1.scrollTop());
            });

            el2.on('scroll', function () {
                el1.scrollLeft(el2.scrollLeft());
                el1.scrollTop(el2.scrollTop());
            });
        }

        F.ready(function () {

            var grid1ScrollEl = F.ui.Grid1.getScrollEl();
            var grid2ScrollEl = F.ui.Grid2.getScrollEl();

            syncGridScrollbar(grid1ScrollEl, grid2ScrollEl);
            syncGridScrollbar(grid2ScrollEl, grid1ScrollEl);

        });

    </script>
}
@section exampleDescription {
<section aria-label="页面描述">
    <p>同步两个表格的横向与纵向滚动位置，便于逐行对照不同列数据。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>从任一侧同步滚动</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Grid1" title="表格一">第一个表格</strong>内部左右或上下滚动，再从<strong class="example-control-reference" data-example-control="Grid2" title="表格二">第二个表格</strong>滚动。<br />结果：另一表格跟随相同的 scrollLeft 和 scrollTop；这里只同步滚动位置，不改变行选择或重新查询数据。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>getScrollEl / scrollLeft / scrollTop</code>（<strong>两个表格的滚动脚本</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1" title="表格一">表格一</strong>）：绑定实际表格滚动元素的 scroll 事件，双向设置对应滚动偏移。</li>
    </ul>
</section>
}
