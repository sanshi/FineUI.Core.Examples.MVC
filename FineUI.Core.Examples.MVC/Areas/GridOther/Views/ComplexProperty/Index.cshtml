@{
    ViewBag.Title = "GridOther/ComplexProperty";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").Title("表格").ShowBorder(true).ShowHeader(true).EnableCheckBoxSelect(true).DataIDField("Id").DataTextField("MyText")
        .Columns(
            F.RowNumberField(),
            F.RenderField().DataField("MyText").HeaderText("姓名"),
            F.RenderField().DataField("Year").HeaderText("入学年份"),
            F.RenderCheckField().DataField("MyCheckBox").HeaderText("是否在校"),
            F.RenderField().HeaderText("是否在校").DataField("MyCheckBox").RendererFunction("renderAtSchool"),
            F.RenderField().ExpandUnusedSpace(true).MinWidth(150).DataField("Info.UserName").HeaderText("老师（二级属性）")
        ).DataSource(ViewBag.Grid1DataSource)
    )


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        // 文本 - 是否在校
        function renderAtSchool(value, params) {
            return value ? '是' : '否';
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>把对象的嵌套属性绑定为表格列，在同一行显示学生资料与关联对象的信息。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>读取关联对象的属性</h3>
    <ul>
        <li>查看<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>的老师等关联信息列。<br />结果：每行显示关联对象中的实际属性，例如首行显示张老师；不把整个关联对象显示为字符串。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>DataField</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：列通过属性路径读取数据，本页包含 <code>Info.UserName</code>；列值来自同一行对象。</li>
    </ul>
</section>
}
