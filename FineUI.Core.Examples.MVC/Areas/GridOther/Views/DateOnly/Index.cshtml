@{
    ViewBag.Title = "GridOther/DateOnly";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableCheckBoxSelect(true)
            .Columns(
                F.RowNumberField(),
                F.RenderField().HeaderText("姓名").DataField("Name"),
                F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
                F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
                F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
                F.RenderField().HeaderText("仅日期").DataField("DateOnly1").Width(150),
                F.RenderField().HeaderText("仅时间").DataField("TimeOnly1").Width(150)
            )
            .DataSource(DataSourceUtil.GetSimpleDataTable())
        )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行（客户端）").CssClass("marginr").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))
    @(F.Button().Text("选中了哪些行（服务端）").ID("Button2").OnClick(Url.Action("Button2_Click"), Parameter.FromFunction("selected", "getCurrentControlSelectedPostbackValue")))

}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlSelectedPostbackValue() {
            return getGridSelectedRows();
        }

    </script>


    <script src="~/res/js/grid.js"></script>


    <script>

        function getGridSelectedRows() {
            var result = [], grid = F.ui.Grid1;

            $.each(grid.getSelectedRows(true), function (index, item) {
                var itemArr = [];
                itemArr.push(item.id);
                itemArr.push(item.text);
                itemArr.push(item.values.Gender);
                itemArr.push(item.values.Major);
                itemArr.push(item.values.DateOnly1);
                itemArr.push(item.values.TimeOnly1);

                result.push(itemArr);
            });

            return F.toJSON(result);
        }

    </script>
}

@section exampleDescription {
<section aria-label="页面描述">
    <p>分别绑定只有日期与只有时间的数据，在各自列中保留对应精度。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>比较日期列与时间列</h3>
    <ul>
        <li>查看<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>的<strong>仅日期</strong>与<strong>仅时间</strong>两列。<br />结果：日期显示为 yyyy-MM-dd，时间显示为 HH:mm:ss；日期列不附加时间，时间列不补出日期。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>DataField / FieldType</code>（<strong>日期与时间列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：各列读取本端日期或时间字段；日期与时间分别绑定，不把它们合成一个完整时间戳。</li>
        <li><code>RendererArgument</code>（<strong>日期与时间列</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：日期格式为 <code>yyyy-MM-dd</code>，时间格式为 <code>HH:mm:ss</code>。</li>
    </ul>
</section>
}
