@{
    ViewBag.Title = "GridOther/DateOnly";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
            .Columns(
                F.RowNumberField(),
                F.RenderField().HeaderText("姓名").DataField("Name"),
                F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
                F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
                F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
                F.RenderField().HeaderText("仅日期").DataField("DateOnly1").Width(150),
                F.RenderField().HeaderText("仅时间").DataField("TimeOnly1").Width(150)
            )
            .DataSource(DataSourceUtil.GetSimpleDataTable())
        )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行（客户端）").CssClass("marginr").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))
    @(F.Button().Text("选中了哪些行（服务端）").ID("Button2").OnClick(Url.Action("Button2_Click"), new Parameter("selected", "getGridSelectedRows()")))

}


@section script {

    <script src="~/res/js/grid.js"></script>


    <script>

        function getGridSelectedRows() {
            var result = [], grid = F.ui.Grid1;

            $.each(grid.getSelectedRows(true), function (index, item) {
                var itemArr = [];
                itemArr.push(item.id);
                itemArr.push(item.text);
                itemArr.push(item.values.Gender);
                itemArr.push(item.values.Major);
                itemArr.push(item.values.DateOnly1);
                itemArr.push(item.values.TimeOnly1);

                result.push(itemArr);
            });

            return F.toJSON(result);
        }

    </script>
}
