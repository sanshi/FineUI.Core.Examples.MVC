@{
    ViewBag.Title = "GridOther/EmptyIconText";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Height(350).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableTextSelection(true)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").Width(350),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd")
        ).Attribute("data-source-key", "source1")
        .ShowEmptyIconText(true)
    )
    <br>

    @(F.Button().OnClick(Url.Action("Button1_Click"),
            new Parameter("fields", "F.ui.Grid1.fields"),
            new Parameter("source", "F.ui.Grid1.getAttr('data-source-key')")).CssClass("marginr").Text("重新绑定表格").ID("Button1")
    )

    <br>
    <br>
    注：默认（不设置 EmptyText、ShowEmptyIconText 为 false）表格为空时显示空白；本例通过 ShowEmptyIconText(true) 开启内置的「图标 + 文案」空状态。也可在 PageManager 上设置 GridShowEmptyIconText(true) 全局开启。

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
