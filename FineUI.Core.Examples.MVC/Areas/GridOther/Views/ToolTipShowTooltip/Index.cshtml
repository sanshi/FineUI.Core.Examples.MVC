@{
    ViewBag.Title = "GridOther/ToolTipShowToolTip";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").ShowToolTip(true).ToolTipPosition(ToolTipPosition.TopStart).Width(150),
            F.RenderField().HeaderText("所学专业").DataField("Major").ShowToolTip(true).ToolTipPosition(ToolTipPosition.TopStart).RendererFunction("renderMajorLink").ExpandUnusedSpace(true).MinWidth(150)
        )
        .DataSource(ViewBag.Grid1DataSource)
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))

}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderMajorLink(value) {
            //var url = 'http://gsa.ustc.edu.cn/search?q=' + F.urlEncode(value);
            //return F.formatString('<a href="{0}" target="_blank">{1}</a>', url, F.htmlEncode(value));
            var encodedValue = F.htmlEncode(value);
            return $('<a>', {
                'target': '_blank',
                'href': 'http://gsa.ustc.edu.cn/search?q=' + F.urlEncode(value),
                'html': encodedValue
            });
        }

    </script>
}
