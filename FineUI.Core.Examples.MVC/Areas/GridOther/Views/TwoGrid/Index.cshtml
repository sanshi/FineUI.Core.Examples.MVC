@{
    ViewBag.Title = "GridOther/TwoGrid";
    var F = Html.F();
}


@section body {

    @(F.RegionPanel().ID("RegionPanel1").ShowBorder(false).Margin(24).IsViewPort(true)
        .Regions(
            F.Region().ID("Region1").ShowBorder(false).ShowHeader(false).RegionPosition(Position.Left).BodyPadding("0 5 0 0").Width(200).Layout(LayoutType.Fit)
                .Items(
                    F.Grid().ID("Grid2").ShowBorder(true).ShowHeader(true).Title("表格（班级）").DataIDField("Id").DataTextField("Name").EnableMultiSelect(false).OnRowSelect(Url.Action("Grid2_RowSelect"), "Grid1",
                            Parameter.FromFunction("selectedRowId", "getCurrentControlSelectedRowIdPostbackValue")).ShowGridHeader(false)
                        .Columns(
                            F.RowNumberField(),
                            F.RenderField().ExpandUnusedSpace(true).MinWidth(150).DataField("Name").HeaderText("姓名")
                        ).DataSource(ViewBag.Grid2DataSource).SelectedRowID(ViewBag.Grid2SelectedRowID)
                ),
            F.Region().ID("Region2").ShowBorder(false).ShowHeader(false).RegionPosition(Position.Center).Layout(LayoutType.VBox).BoxConfigAlign(BoxLayoutAlign.Stretch)
                .Items(
                    F.Panel().ShowHeader(false).BodyPadding(10).ShowBorder(true).MarginBottom(5)
                        .Items(
                            F.Label().ID("labelClassDesc").Text(ViewBag.SelectedClassDesc),
                            F.Label().ID("Label4")
                        ),
                    F.Grid().ID("Grid1").BoxFlex(1).ShowBorder(true).ShowHeader(true).Title("表格（学生）").DataIDField("Id").DataTextField("Name")
                        .Columns(
                            F.RowNumberField(),
                            F.RenderField().HeaderText("姓名").DataField("Name"),
                            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
                            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
                            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
                            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
                            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
                        ).DataSource(ViewBag.Grid1DataSource)
                )
        )
    )


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlSelectedRowIdPostbackValue() {
            return this.getSelectedRow();
        }

    </script>


    <script src="~/res/js/grid.js"></script>

}
@section exampleDescription {
<section aria-label="页面描述">
    <p>选择班级后同步更新班级说明及学生列表，以主表选择驱动从表数据。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>换一个班级查看对应学生</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Grid2" title="表格（班级）">表格（班级）</strong>选择第二个班级。<br />结果：班级选择回发，后台读取当前班级标识，更新班级描述和<strong class="example-control-reference" data-example-control="Grid1" title="表格（学生）">表格（学生）</strong>；新学生列表对应新班级，旧班级记录被替换。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>OnRowSelect / SelectedRowID</code>（<strong>班级表选择处理</strong>，作用于<strong class="example-control-reference" data-example-control="Grid2" title="表格（班级）">表格（班级）</strong>）：按班级稳定主键读取明细，不按当前显示行号猜测班级。</li>
    </ul>
</section>
}
