@{
    ViewBag.Title = "GridOther/LongPrecision";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Title("默认配置（全局配置项 GridConvertLongToString 为 true）：Id 完整").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("Id").DataField("Id").Width(200),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150)
        )
        .DataSource(ViewBag.GridDataSource)
    )

    <br>

    @(F.Grid().IsFluid(true).Title("表格属性 ConvertLongToString 设为 false（关闭转换）：Id 被 JavaScript 改写").ShowHeader(true).ShowBorder(true).ID("Grid2").DataIDField("Id").DataTextField("Name").ConvertLongToString(false)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("Id").DataField("Id").Width(200),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150)
        )
        .DataSource(ViewBag.GridDataSource)
    )

    <br>
    <br>
    注：两个表格绑定的是同一份数据，Id 在数据库中的实际值是 21956392701267968（17 位，超过 JavaScript 能精确表示的整数范围）。请对比两个表格的 Id 列。

}


@section script {

    <script src="~/res/js/grid.js"></script>

}
