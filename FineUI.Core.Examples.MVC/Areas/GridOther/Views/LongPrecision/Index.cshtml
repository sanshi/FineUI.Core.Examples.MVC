@{
    ViewBag.Title = "GridOther/LongPrecision";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Title("默认配置（全局配置项 GridConvertLongToString 为 true）：Id 完整").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("Id").DataField("Id").Width(200),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150)
        )
        .DataSource(ViewBag.GridDataSource)
    )

    <br>

    @(F.Grid().IsFluid(true).Title("表格属性 ConvertLongToString 设为 false（关闭转换）：Id 被 JavaScript 改写").ShowHeader(true).ShowBorder(true).ID("Grid2").DataIDField("Id").DataTextField("Name").ConvertLongToString(false)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("Id").DataField("Id").Width(200),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150)
        )
        .DataSource(ViewBag.GridDataSource)
    )

    <br>
    <br>


}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>对照长整数转为字符串与保留数值两种绑定方式，查看超过 JavaScript 安全整数范围的主键是否完整。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>比较长整数主键</h3>
    <ul>
        <li>对照<strong class="example-control-reference" data-example-control="Grid1" title="默认配置（全局配置项 GridConvertLongToString 为 true）：Id 完整">默认配置（全局配置项 GridConvertLongToString 为 true）：Id 完整</strong>与<strong class="example-control-reference" data-example-control="Grid2" title="表格属性 ConvertLongToString 设为 false（关闭转换）：Id 被 JavaScript 改写">表格属性 ConvertLongToString 设为 false（关闭转换）：Id 被 JavaScript 改写</strong>的首行编号。<br />结果：启用转换时显示完整的长整数；关闭转换时，浏览器数值精度会使末尾数字改变。应把业务主键作为字符串使用。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
    <p>注：两个表格绑定的是同一份数据，Id 在数据库中的实际值是 21956392701267968（17 位，超过 JavaScript 能精确表示的整数范围）。请对比两个表格的 Id 列。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>ConvertLongToString</code>（<strong class="example-control-reference" data-example-control="Grid2" title="表格属性 ConvertLongToString 设为 false（关闭转换）：Id 被 JavaScript 改写">表格属性 ConvertLongToString 设为 false（关闭转换）：Id 被 JavaScript 改写</strong>）：初始为 <code>false</code>，控制绑定时是否把长整数转换为字符串；关闭的对照表仅用于说明精度风险。</li>
    </ul>
</section>
}
