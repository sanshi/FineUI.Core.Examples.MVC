@{
    ViewBag.SourceFiles = "~/Areas/GridOther/Views/NewTab/Window.cshtml";
    ViewBag.Title = "GridOther/NewTabSameTabConfirm";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").Title("表格").ShowBorder(true).ShowHeader(true).EnableCheckBoxSelect(true).DataIDField("Id").DataTextField("Name")
        .Toolbars(
            F.Toolbar().ID("Toolbar1")
                .Items(
                    F.Button().ID("btnNew").Text("新增数据").Icon(Icon.Add).ClickHandler("onNewClick"),
                    F.Button().ID("btnDelete").Text("删除选中行").Icon(Icon.Delete).ClickHandler("onDeleteClick")
                )
        )
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").BoxFlex(1),
            F.RenderField().HeaderText("新标签页打开").RendererFunction("renderOpenNewTab")
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onNewClick(event) {
            // addExampleTab 函数定义在 /Home/Index
            var newTabUrl = '@Url.Content("~/GridOther/NewTab/Window")';
            parent.addExampleTab({
                id: 'grid_newsametab_addnew',
                title: '新增人员',
                iframeUrl: newTabUrl,
                // 如果标签页已经打开，则不作处理
                refreshWhenExist: false,
                iconFont: 'plus'
            });
        }

        function onDeleteClick(event) {
            var grid1 = F.ui.Grid1;

            if (!grid1.hasSelection()) {
                F.alert('请至少选择一项！');
                return;
            }


            var selectedRows = grid1.getSelectedRows(true);

            var selectedRowTexts = $.map(selectedRows, function (item, index) {
                return item.text;
            }).join(',');

            F.alert('删除行：' + selectedRowTexts);
        }

        function openNewTab(id, name) {
            // addExampleTab 函数定义在 /Home/Index
            var newTabUrl = '@Url.Content("~/GridOther/NewTab/Window")';
            parent.addExampleTab({
                id: 'grid_newsametab_edit',
                title: '编辑 - ' + name,
                iframeUrl: F.formatString('{0}?id={1}&name={2}', newTabUrl, id, F.urlEncode(name)),
                // 如果标签页已经打开，则提示用户是否需要更新（refreshWhenExist=false && confirmWhenExist='提示信息'）
                refreshWhenExist: false,
                confirmWhenExist: '当前标签页已经打开，确认放弃修改？',
                iconFont: 'pencil'
            });
        }

        function renderOpenNewTab(value, params) {
            return '<a href="#" class="opennewtab">编辑</a>';
        }


        F.ready(function () {

            var grid1 = F.ui.Grid1;
            grid1.el.on('click', 'a.opennewtab', function (event) {
                event.preventDefault();
                var rowData = grid1.getRowData($(this).closest('.f-grid-row'));

                openNewTab(rowData.id, rowData.text);
            });
        });

    </script>

}
