@{
    ViewBag.Title = "GridOther/CenterColumn";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校（居中）").DataField("AtSchool").RenderAsStaticField(true).TextAlign(TextAlign.Center),
            F.RenderField().HeaderText("所学专业（居中）").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150).TextAlign(TextAlign.Center),
            F.RenderField().HeaderText("分组（内容靠右，标题靠左）").DataField("Group").RendererFunction("renderGroup").Width(250).TextAlign(TextAlign.Right).HeaderTextAlign(TextAlign.Left)
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>
    <br>


}


@section script {

    <script src="~/res/js/grid.js"></script>


}

@section exampleDescription {
<section aria-label="页面描述">
    <p>分别设置列标题与数据文字的水平对齐方式，允许同一列两者不同。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>对照本页样式规则</h3>
    <ul>
        <li>比较<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>的居中列、靠右列，以及分组列的标题和内容。<br />结果：指定数据列按各自配置居中或靠右；分组列的数据靠右而标题靠左，标题与正文对齐互不替代。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>TextAlign / HeaderTextAlign</code>（<strong>本页列与样式</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：分别决定数据文字与表头文字的位置；仅修改一种不会自动覆盖另一种。</li>
    </ul>
</section>
}
