@{
    ViewBag.SourceFiles = "~/Areas/GridOther/Views/NewTabHideRefresh/Window.cshtml";
    ViewBag.Title = "GridOther/NewTabHideRefresh";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1")
        .Title("表格 - 页面加载时间：" + DateTime.Now.ToLongTimeString()).ShowBorder(true).ShowHeader(true).EnableCheckBoxSelect(true).DataIDField("Id").DataTextField("Name")
        .Toolbars(
            F.Toolbar().ID("Toolbar1")
                .Items(
                    F.Button().ID("btnNew").Text("新增数据").Icon(Icon.Add).ClickHandler("onNewClick"),
                    F.Button().ID("btnDelete").Text("删除选中行").Icon(Icon.Delete).ClickHandler("onDeleteClick")
                )
        )
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").BoxFlex(1),
            F.RenderField().HeaderText("新标签页打开").RendererFunction("renderOpenNewTab")
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onNewClick(event) {
            // addExampleTab 函数定义在 /Home/Index
            var newTabUrl = '@Url.Content("~/GridOther/NewTabHideRefresh/Window")';
            parent.addExampleTab({
                id: 'grid_newsametab_addnew',
                title: '新增人员',
                iframeUrl: newTabUrl + '?parenttabid=' + parent.getActiveTabId(),
                refreshWhenExist: true,
                iconFont: 'plus'
            });
        }

        function onDeleteClick(event) {
            var grid1 = F.ui.Grid1;

            if (!grid1.hasSelection()) {
                F.alert('请至少选择一项！');
                return;
            }


            var selectedRows = grid1.getSelectedRows(true);

            var selectedRowTexts = $.map(selectedRows, function (item, index) {
                return item.text;
            }).join(',');

            F.alert('删除行：' + selectedRowTexts);
        }

        function openNewTab(id, name) {
            // addExampleTab 函数定义在 /Home/Index
            var newTabUrl = '@Url.Content("~/GridOther/NewTabHideRefresh/Window")';
            parent.addExampleTab({
                id: 'grid_newsametab_edit',
                title: '编辑 - ' + name,
                iframeUrl: F.formatString('{0}?id={1}&name={2}&parenttabid={3}', newTabUrl, id, F.urlEncode(name), parent.getActiveTabId()),
                refreshWhenExist: true,
                iconFont: 'pencil'
            });
        }

        function renderOpenNewTab(value, params) {
            return '<a href="#" class="opennewtab">编辑</a>';
        }


        F.ready(function () {

            var grid1 = F.ui.Grid1;
            grid1.el.on('click', 'a.opennewtab', function (event) {
                event.preventDefault();
                var rowData = grid1.getRowData($(this).closest('.f-grid-row'));

                openNewTab(rowData.id, rowData.text);
            });
        });

    </script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>子页关闭后刷新来源页签，演示编辑页与父页签之间的返回通知。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>把关闭通知交回来源页</h3>
        <ol>
            <li>在框架主页面打开本例，点击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>某行的编辑入口，再打开另一条记录。<br />结果：网址携带来源页签标识，子页可以在关闭时找到原页面；标题与记录参数对应。</li>
            <li>在子页执行本例提供的关闭或保存后关闭操作。<br />结果：来源页签重新加载，显示它重新读取的页面数据；本例重点是关闭通知，不表示业务保存已接入。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>addExampleTab / id</code>（<strong>框架页签调用</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：通过框架页面提供的函数打开页签，id 决定复用哪一个标签；本例需要在框架中操作。</li>
            <li><code>parenttabid</code>（<strong>父子页参数</strong>，作用于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：网址携带来源页签标识，关闭回调按该标识刷新父页或调用父页更新函数。</li>
        </ul>
    </section>
}
