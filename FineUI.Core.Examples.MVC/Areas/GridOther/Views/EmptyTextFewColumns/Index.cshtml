@{
    ViewBag.Title = "GridOther/EmptyTextFewColumns";
    var F = Html.F();
}


@section head {

    <style>
        .grid-empty-text {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 500px;
            margin-left: -250px;
            margin-top: -15px;
            font-size: 24px;
            text-align: center;
        }
    </style>

}

@section body {

    @(F.Grid().IsFluid(true).Height(350).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name").EnableTextSelection(true)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true).Hidden(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").Width(350).Hidden(true),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup").Hidden(true),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd").Hidden(true)
        ).Attribute("data-source-key", "source1").EmptyTextRawHtml(new RawHtml("<div class=\"grid-empty-text\">Oops...一条数据也没有找到！</div>"))
    )
    <br>

    @(F.Button().OnClick(Url.Action("Button1_Click"),
            Parameter.FromFunction("fields", "getGrid1FieldsPostbackValue"),
            Parameter.FromFunction("source", "getGrid1SourcePostbackValue")).CssClass("marginr").Text("重新绑定表格").ID("Button1")
    )

    <br>
    <br>


}


@section script {
    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getGrid1FieldsPostbackValue() {
            return F.ui.Grid1.fields;
        }

        function getGrid1SourcePostbackValue() {
            return F.ui.Grid1.getAttr('data-source-key');
        }

    </script>


    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>通过绝对定位显示空数据提示，使提示范围不受少量窄列的总宽度限制。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>在有数据与无数据之间切换</h3>
        <ol>
            <li>连续点击<strong class="example-control-reference" data-example-control="Button1"
                    title="重新绑定表格">重新绑定表格</strong>，对照空数据与有数据两种状态。<br />结果：按钮回发后后台切换数据源；无记录时显示自定义图片与文字，重新绑定记录后提示消失，数据行恢复。提示相对表格可用空间定位，列少时不会被挤在狭窄列宽里。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：初始隐藏了很多列，使得表格的宽度不足以放得下空信息，所以将空信息绝对定位。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EmptyText</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：指定无记录时显示的自定义内容。</li>
            <li><code>CSS</code>（<strong>空数据提示元素</strong>，位于<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>）：空状态内容使用绝对定位，位置以表格内容区为参照。</li>
        </ul>
    </section>
}
