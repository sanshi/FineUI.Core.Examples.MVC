@{
    ViewBag.Title = "GridLockColumn/RightRowExpander";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Height(450).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .AllowColumnLocking(true).ColumnLockingRight(true).Width(1000)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name").EnableLock(true).Locked(true),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").EnableLock(true),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int).EnableLock(true).Locked(true).LockedPosition(LockedPosition.Right),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true).EnableLock(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").Width(400).EnableLock(true),
            F.RenderField().EnableLock(true).DataField("ShenGao").HeaderText("身高"),
            F.RenderField().EnableLock(true).DataField("TiZhong").HeaderText("体重"),
            F.RenderField().EnableLock(true).DataField("XueYaDi").HeaderText("血压（低）"),
            F.RenderField().EnableLock(true).DataField("XueYaGao").HeaderText("血压（高）"),
            F.RenderField().EnableLock(true).DataField("ShiLiZuo").HeaderText("视力（左）"),
            F.RenderField().EnableLock(true).DataField("ShiLiYou").HeaderText("视力（右）"),
			F.RenderField().EnableLock(true).HeaderText("分组").DataField("Group").RendererFunction("renderGroup").Locked(true).LockedPosition(LockedPosition.Right),
			F.RenderField().EnableLock(true).HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy/MM/dd"),
            F.RenderField().DataField("Desc").RenderAsRowExpander(true).RendererFunction("renderExpander").EnableLock(true).Locked(true)
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>
    <br>
    @(F.Button().ID("btnExpandRowExpanders").CssClass("marginr").Text("展开全部的行扩展列").ClickHandler("onExpandAllClick"))
    @(F.Button().ID("btnCollapseRowExpanders").Text("折叠全部的行扩展列").ClickHandler("onCollapseAllClick"))


}


@section script {

    <script src="~/res/js/grid.js"></script>
    <script type="text/javascript">

        function onExpandAllClick(event) {
            F.ui.Grid1.expandRowExpanders();
        }

        function onCollapseAllClick(event) {
            F.ui.Grid1.collapseRowExpanders();
        }
    </script>


}
