@{
    ViewBag.Title = "GridLockColumn/SummaryGroupField";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-row-summary .f-grid-cell-text {
            font-weight: bold;
            color: red;
        }
    </style>

}

@section body {

    @(F.Grid().IsFluid(true).EnableCheckBoxSelect(true).Height(500).ShowHeader(true).ShowBorder(true).Title("表格").ID("Grid1").DataIDField("Id").DataTextField("Name")
		.AllowPaging(true).PageSize(5).IsDatabasePaging(true).OnPageIndexChanged(Url.Action("Grid1_PageIndexChanged"), "Grid1")
		.EnableSummary(true).SummaryPosition(SummaryPosition.Bottom)
		.AllowColumnLocking(true).Width(1000)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name").EnableLock(true).Locked(true),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").EnableLock(true),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int).EnableLock(true),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true).EnableLock(true),
            F.GroupField().HeaderText("花费").TextAlign(TextAlign.Center)
                .Columns(
                    F.RenderField().HeaderText("学费").DataField("Fee").EnableLock(true),
                    F.RenderField().HeaderText("学杂费").DataField("ExtraFee").EnableLock(true)
                ),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").Width(400).EnableLock(true),
            F.RenderField().DataField("Desc").RenderAsRowExpander(true).RendererFunction("renderExpander").EnableLock(true).Locked(true),
			F.RenderField().EnableLock(true).DataField("ShenGao").HeaderText("身高"),
            F.RenderField().EnableLock(true).DataField("TiZhong").HeaderText("体重"),
            F.RenderField().EnableLock(true).DataField("XueYaDi").HeaderText("血压（低）"),
            F.RenderField().EnableLock(true).DataField("XueYaGao").HeaderText("血压（高）"),
            F.RenderField().EnableLock(true).DataField("ShiLiZuo").HeaderText("视力（左）"),
            F.RenderField().EnableLock(true).DataField("ShiLiYou").HeaderText("视力（右）"),
			F.RenderField().EnableLock(true).HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
			F.RenderField().EnableLock(true).HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        ).RecordCount(ViewBag.Grid1RecordCount).DataSource(ViewBag.Grid1DataSource).SummaryData(ViewBag.Grid1SummaryData)

    )
    <br>

    @(F.Button().Text("选中了哪些行").CssClass("marginr").ClickHandler("onNotifySelectedRowsClick"))
    <br>
    <br>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
<section aria-label="页面描述">
    <p>在左侧锁定布局中显示多表头、行扩展及合计行，换页后保持合计与列对齐。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>滚动与换页时核对合计</h3>
    <ol>
        <li>横向滚动<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>，对照表头、正文及合计行。<br />结果：锁定列停留在左侧，普通列与其合计一起滚动；合计值仍位于对应费用列下。</li>
        <li>点击分页栏下一页。<br />结果：后台读取新页记录；本页全量费用合计保持，不把新页局部金额误当成总计。</li>
    </ol>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>EnableSummary</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>true</code>，显示与锁定列及普通列对应的合计区域。</li>
        <li><code>SummaryPosition</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>SummaryPosition.Bottom</code>，按本页位置把合计行固定到表格底部。</li>
        <li><code>SummaryData</code>（<strong>表格合计数据</strong>，位于<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：后台提供完整示例数据的费用统计；分页只切换正文记录，不缩小统计范围。</li>
    </ul>
</section>
}
