@{
    ViewBag.Title = "GridLockColumn/LineWrapLineClamp";
    var F = Html.F();
}


@section head {

    <style>
             /* 最多显示 3 行文字，超出则显示省略号 */
            .f-grid-row .f-grid-cell-text {
                white-space: normal;
                word-break: break-all;
                overflow: hidden;
                -webkit-line-clamp: 3;
                -webkit-box-orient: vertical;
                display: -webkit-box;
            }
    </style>

}


@section body {

    @(F.Grid().IsFluid(true).Height(450).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
		.AllowColumnLocking(true).Width(1000)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name").EnableLock(true).Locked(true),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender").EnableLock(true),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int).EnableLock(true),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true).EnableLock(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").Width(200).EnableLock(true),
            F.RenderField().DataField("Desc").HeaderText("个人简介").Width(400),
			F.RenderField().EnableLock(true).DataField("ShenGao").HeaderText("身高"),
            F.RenderField().EnableLock(true).DataField("TiZhong").HeaderText("体重"),
            F.RenderField().EnableLock(true).DataField("XueYaDi").HeaderText("血压（低）"),
            F.RenderField().EnableLock(true).DataField("XueYaGao").HeaderText("血压（高）"),
            F.RenderField().EnableLock(true).DataField("ShiLiZuo").HeaderText("视力（左）"),
            F.RenderField().EnableLock(true).DataField("ShiLiYou").HeaderText("视力（右）"),
			F.RenderField().EnableLock(true).HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
			F.RenderField().EnableLock(true).HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        )
        .DataSource(DataSourceUtil.GetDataTable())
    )
    <br>
    <br>

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在列锁定表格中显示多行长文本，最多保留三行并省略超出部分。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>查看三行省略与锁定对齐</h3>
        <ul>
            <li>查看<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>的<strong>个人简介</strong>等长文本，横向与纵向滚动。<br />结果：长文字在单元格内换行，最多显示三行，超出部分省略；左侧锁定内容仍与当前行对应。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>CSS / white-space / -webkit-line-clamp</code>（<strong>单元格文字元素</strong>，位于<strong class="example-control-reference"
                    data-example-control="Grid1" title="表格">表格</strong>）：页面把文字设为可换行，并用 -webkit-line-clamp: 3 限定三行；省略只影响显示，不截断源数据。</li>
        </ul>
    </section>
}
