@{
    ViewBag.Title = "Toolbar/FormFields";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).ID("Grid1").ShowBorder(true).ShowHeader(true).Title("表格").Height(350).DataIDField("Id").DataTextField("Name")
        .Toolbars(
            F.Toolbar().ID("Toolbar1").ToolbarAlign(ToolbarAlign.Right)
                .Items(
                    F.DatePicker().Width(250).Required(true).DateFormatString("yyyy-MM-dd").LabelWidth(120).LabelAlign(LabelAlign.Right).Label("销毁统计时间段").EmptyText("请选择开始日期").ID("dpStartDate").EnableEdit(false),
                    F.DatePicker().ID("dpEndDate").Width(130).Required(true).Readonly(false).CompareControl("dpStartDate").DateFormatString("yyyy-MM-dd").CompareOperator(Operator.GreaterThan).CompareMessage("结束日期应该大于开始日期").EmptyText("请选择结束日期").ShowLabel(false).Label("销毁统计时间段").EnableEdit(false),
                    F.Button().ID("btnClearDate").Text("重置起止时间").OnClick(Url.Action("btnClearDate_Click"), "Grid1"),
                    F.ToolbarSeparator(),
                    F.Button().ID("btnSearch").Text("查询").ValidateForms("Toolbar1").OnClick(Url.Action("btnSearch_Click"), "Grid1")
                )
        )
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().HeaderText("注册日期").DataField("LogTime").FieldType(FieldType.Date).Renderer(Renderer.Date).RendererArgument("yyyy-MM-dd")
        )
    )


}

@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示把起止日期字段放在表格工具栏中，先验证日期再加载示例数据。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>验证日期并加载数据</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="btnSearch"
                    title="查询">查询</strong>。<br />结果：日期为空或结束日期不大于开始日期时显示验证错误，不继续执行查询按钮处理。</li>
            <li>将<strong class="example-control-reference" data-example-control="dpStartDate" title="第 1 个日期选择框（销毁统计时间段）">第 1
                    个日期选择框（销毁统计时间段）</strong>设为<code>2026-06-10</code>，将第二个日期字段设为<code>2026-06-11</code>，再点击<strong class="example-control-reference"
                    data-example-control="btnSearch" title="查询">查询</strong>。<br />结果：验证通过后才回发，后台把示例数据绑定到表格；本页未按日期条件查询数据库。</li>
            <li>点击<strong class="example-control-reference" data-example-control="btnClearDate" title="重置起止时间">重置起止时间</strong>。<br />结果：两个日期恢复初始状态，同时清空本页表格数据。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>CompareControl</code>（<strong class="example-control-reference" data-example-control="dpEndDate" title="第 2 个日期选择框（销毁统计时间段）">第 2
                    个日期选择框（销毁统计时间段）</strong>）：初始为<code>dpStartDate</code>，结束日期以开始日期为比较对象。</li>
            <li><code>CompareOperator</code>（<strong class="example-control-reference" data-example-control="dpEndDate" title="第 2 个日期选择框（销毁统计时间段）">第 2
                    个日期选择框（销毁统计时间段）</strong>）：初始为<code>Operator.GreaterThan</code>，结束日期必须大于开始日期。</li>
            <li><code>ValidateForms</code>（<strong class="example-control-reference" data-example-control="btnSearch"
                    title="查询">查询</strong>）：初始为<code>Toolbar1</code>，查询按钮先验证工具栏中的日期字段。</li>
        </ul>
    </section>
}
