@{
    ViewBag.Title = "Toolbar/Menu";
    var F = Html.F();
}


@section body {

    @(F.Panel().ID("PanelExample1").IsFluid(true).Title("面板").Height(300).BodyPadding(10).ShowBorder(true)
        .Toolbars(
            F.Toolbar()
                .Items(
                    F.ToolbarText().Text("内联菜单"),
                    F.ToolbarSeparator(),
                    F.Button().ID("btnUniversityMenu").Text("中国科学技术大学")
                        .Menu(F.Menu()
                            .Items(
                                F.MenuHyperLink().Text("化学与材料科学学院").NavigateUrl("http://scms.ustc.edu.cn/").Target("_blank").ID("MenuHyperLink1"),
                                F.MenuHyperLink().Text("管理学院").NavigateUrl("http://business.ustc.edu.cn/zh_CN/").Target("_blank").ID("MenuHyperLink2")
                                    .Menu(F.Menu()
                                        .Items(
                                            F.MenuHyperLink().Text("工商管理系").NavigateUrl("http://is.ustc.edu.cn/").Target("_blank").ID("MenuHyperLink3"),
                                            F.MenuHyperLink().Text("统计与金融系").NavigateUrl("http://stat.ustc.edu.cn/").Target("_blank").ID("MenuHyperLink4")
                                        )
                                    )
                            )
                        )
                )
        )
    )



}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示工具栏按钮展开多级菜单，并由链接菜单项打开目标页面。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>打开多级菜单</h3>
        <ul>
            <li>点击<strong class="example-control-reference" data-example-control="btnUniversityMenu"
                    title="中国科学技术大学">中国科学技术大学</strong>，再展开其中的多级菜单。<br />结果：浏览器显示菜单及下级菜单；带链接的菜单项可按配置打开新页面。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Menu</code>（<strong class="example-control-reference" data-example-control="btnUniversityMenu"
                    title="中国科学技术大学">中国科学技术大学</strong>）：给工具栏按钮配置下拉菜单。</li>
            <li><code>NavigateUrl</code>（<strong class="example-control-reference" data-example-control="MenuHyperLink1" title="第 1 个菜单链接">第 1
                    个菜单链接</strong>、<strong class="example-control-reference" data-example-control="MenuHyperLink2" title="第 2 个菜单链接">第 2 个菜单链接</strong>、<strong
                    class="example-control-reference" data-example-control="MenuHyperLink3" title="第 3 个菜单链接">第 3 个菜单链接</strong>、<strong
                    class="example-control-reference" data-example-control="MenuHyperLink4" title="第 4 个菜单链接">第 4
                    个菜单链接</strong>）：各组分别设为<code>http://scms.ustc.edu.cn/</code>、<code>http://business.ustc.edu.cn/zh_CN/</code>、<code>http://is.ustc.edu.cn/</code>、<code>http://stat.ustc.edu.cn/</code>，指定链接菜单项打开的页面。
            </li>
            <li><code>Target</code>（<strong class="example-control-reference" data-example-control="MenuHyperLink1" title="第 1 个菜单链接">第 1 个菜单链接</strong>、<strong
                    class="example-control-reference" data-example-control="MenuHyperLink2" title="第 2 个菜单链接">第 2 个菜单链接</strong>、<strong
                    class="example-control-reference" data-example-control="MenuHyperLink3" title="第 3 个菜单链接">第 3 个菜单链接</strong>、<strong
                    class="example-control-reference" data-example-control="MenuHyperLink4" title="第 4 个菜单链接">第 4
                    个菜单链接</strong>）：初始为<code>_blank</code>，本页链接在新页面打开。</li>
        </ul>
    </section>
}
