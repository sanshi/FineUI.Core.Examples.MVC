@{
    ViewBag.Title = "Toolbar/ToolbarLayout";
    var F = Html.F();
}


@section body {

    <div id="content1">
        <p>
            <a href="http://tech.163.com/special/jobsdead/" target="_blank"><b>乔布斯</b></a>
        </p>
        <p>
            乔布斯于1955年2月24日出生，苹果创始人之一。今年8月苹果超越埃克森美孚成为全球最大市值企业，截止上季度持有现金达到762亿美金，甚至超过了美国政府国库存款。
        </p>
        <p>
            遗憾的是，苹果的取得巨大成功还是无法给乔布斯一个健康的身体，乔布斯2003年被发现患有胰脏癌，随后又查出肝癌，危在旦夕的乔布斯在经历了8年的抗癌斗争、3次病休、若干次手术后，于2011年8月25日正式宣布从CEO位置辞职。2011年10月6日，乔布斯在苹果发布iPhone 4S后的第二天与世长辞。
        </p>
    </div>

    @(F.Panel().IsFluid(true).Title("面板").BodyPadding(10).ShowBorder(true).ID("Panel1")
        .Toolbars(
            F.Toolbar().ID("ToolbarExample1").Layout(LayoutType.HBox)
                .Items(
                    F.Button().MarginRight(5).BoxFlex(1).Text("按钮一").ID("Button1"),
                    F.Button().BoxFlex(1).Text("按钮二").ID("Button2")
                ),
            F.Toolbar().Layout(LayoutType.Fit)
                .Items(
                    F.ButtonGroup().Layout(LayoutType.HBox)
                        .Items(
                            F.Button().BoxFlex(1).Text("按钮三").ID("Button5"),
                            F.Button().BoxFlex(1).Text("按钮四").ID("Button7"),
                            F.Button().BoxFlex(1).Text("按钮五").ID("Button9")
                        )
                ),
            F.Toolbar().Layout(LayoutType.HBox)
                .Items(
                    F.ButtonGroup().MarginRight(10)
                        .Items(
                            F.Button().Text("按钮三").ID("Button3"),
                            F.Button().Text("按钮四").ID("Button4"),
                            F.Button().Text("按钮五").ID("Button6")
                        ),
                    F.CheckBoxList().BoxFlex(1).ID("CheckBoxList3")
                        .Items(
                            F.CheckItem().Value("value1").Text("可选项 1"),
                            F.CheckItem().Selected(true).Value("value2").Text("可选项 2"),
                            F.CheckItem().Selected(true).Value("value3").Text("可选项 3")
                        )
                ),
            F.Toolbar().Layout(LayoutType.HBox)
                .Items(
                    F.ButtonGroup().MarginRight(10).Layout(LayoutType.HBox).Width(300)
                        .Items(
                            F.Button().BoxFlex(1).Text("按钮六").ID("Button8"),
                            F.Button().BoxFlex(1).Text("按钮七").ID("Button10"),
                            F.Button().BoxFlex(1).Text("按钮八").ID("Button11")
                        ),
                    F.CheckBoxList().BoxFlex(1).ID("CheckBoxList2")
                        .Items(
                            F.CheckItem().Value("value1").Text("可选项 1"),
                            F.CheckItem().Selected(true).Value("value2").Text("可选项 2"),
                            F.CheckItem().Selected(true).Value("value3").Text("可选项 3")
                        )
                ),
            F.Toolbar().Layout(LayoutType.HBox).ID("Toolbar1")
                .Items(
                    F.TextBox().MarginRight(5).Width(100).EmptyText("文本输入框").ID("TextBox2"),
                    F.TextBox().MarginRight(10).Width(100).EmptyText("文本输入框").ID("TextBox1"),
                    F.CheckBoxList().BoxFlex(1).ID("CheckBoxList1")
                        .Items(
                            F.CheckItem().Value("value1").Text("可选项 1"),
                            F.CheckItem().Selected(true).Value("value2").Text("可选项 2"),
                            F.CheckItem().Selected(true).Value("value3").Text("可选项 3")
                        )
                )
        ).ContentEl("#content1")

    )







}


@section exampleDescription {
<section aria-label="页面描述">
    <p>演示工具栏中组合按钮组、输入字段和可伸展项目，通过 <code>HBox</code> 分配同一行空间。</p>
    <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>比较组合项目的宽度</h3>
    <ul>
        <li>在<strong class="example-control-reference" data-example-control="Panel1" title="面板">面板</strong>及其它工具栏中对照固定宽度输入框、按钮组和可伸展项目，再改变浏览器宽度。<br />结果：固定宽度项目保留自身尺寸，可伸展项目分配剩余宽度；按钮组内的按钮仍保持整体排列。</li>
    </ul>
    <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
    <ul class="example-description-properties">
        <li><code>Layout</code>（本页各工具栏，如<strong class="example-control-reference" data-example-control="ToolbarExample1" title="第 1 个工具栏">第 1 个工具栏</strong>）：各组分别设为<code>LayoutType.HBox</code>、<code>LayoutType.Fit</code>，本页工具栏使用 <code>HBox</code> 或指定布局组织复杂子项。</li>
        <li><code>BoxFlex</code>（<strong class="example-control-reference" data-example-control="Button1" title="按钮一">按钮一</strong>、<strong class="example-control-reference" data-example-control="Button2" title="按钮二">按钮二</strong>、<strong class="example-control-reference" data-example-control="Button5" title="第 3 个按钮（按钮三）">第 3 个按钮（按钮三）</strong>、<strong class="example-control-reference" data-example-control="Button7" title="第 4 个按钮（按钮四）">第 4 个按钮（按钮四）</strong>、<strong class="example-control-reference" data-example-control="Button9" title="第 5 个按钮（按钮五）">第 5 个按钮（按钮五）</strong>、<strong class="example-control-reference" data-example-control="CheckBoxList3" title="第 1 个复选框列表">第 1 个复选框列表</strong>、<strong class="example-control-reference" data-example-control="Button8" title="按钮六">按钮六</strong>、<strong class="example-control-reference" data-example-control="Button10" title="按钮七">按钮七</strong>、<strong class="example-control-reference" data-example-control="Button11" title="按钮八">按钮八</strong>、<strong class="example-control-reference" data-example-control="CheckBoxList2" title="第 2 个复选框列表">第 2 个复选框列表</strong>、<strong class="example-control-reference" data-example-control="CheckBoxList1" title="第 3 个复选框列表">第 3 个复选框列表</strong>）：初始为<code>1</code>，为对应项目分配剩余宽度的比例。</li>
    </ul>
</section>
}
