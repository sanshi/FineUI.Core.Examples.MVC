@{
    ViewBag.Title = "Toolbar/ToolbarImagesFixedWidth";
    var F = Html.F();
}


@section body {

    @(F.Panel().IsFluid(true).IFrameName("main").EnableIFrame(true).Height(250).Title("面板").ID("Panel1")
        .Toolbars(
            F.Toolbar().Position(ToolbarPosition.Top)
                .Items(
                    F.Image().Icon(Icon.ArrowRight).ImageWidth(16).ID("Image1"),
                    F.LinkButton().ClickHandler("onButton1Click").Text("按钮一").ID("Button1"),
                    F.Image().Icon(Icon.World).ImageWidth(16).ID("Image2"),
                    F.LinkButton().ClickHandler("onButton2Click").Text("按钮二").ID("Button2"),
                    F.Image().Icon(Icon.Cake).ImageWidth(16).ID("Image3"),
                    F.LinkButton().ClickHandler("onButton3Click").Text("按钮三").ID("Button3")
                )
        )
    )
    <br>
    <br>




}

@section script {

    <script type="text/javascript">

        function onButton1Click(event) {
            alert('Button1');
        }

        function onButton2Click(event) {
            alert('Button2');
        }

        function onButton3Click(event) {
            alert('Button3');
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示给工具栏图片预留固定宽度，避免图片加载时改变按钮位置。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-pic" aria-hidden="true"></i>核对图片加载后的排列</h3>
        <ul>
            <li>打开页面，对照<strong class="example-control-reference" data-example-control="Panel1"
                    title="面板">面板</strong>内图片及相邻按钮的位置。<br />结果：图片加载前后使用同一预留宽度，相邻按钮不会等待图片自然宽度再重新分配位置。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <ul>
            <li>由于页面布局时图片尚未加载，所以会造成布局错乱</li>
            <li>可以为 <code>Image</code> 控件设置固定宽度来解决</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>ImageWidth</code>（<strong class="example-control-reference" data-example-control="Image1" title="第 1 个图片">第 1 个图片</strong>、<strong
                    class="example-control-reference" data-example-control="Image2" title="第 2 个图片">第 2 个图片</strong>、<strong class="example-control-reference"
                    data-example-control="Image3" title="第 3 个图片">第 3 个图片</strong>）：初始为<code>16</code>，为各图片明确预留宽度。</li>
        </ul>
    </section>
}
