@{
    ViewBag.SourceFiles = "~/Areas/GridDataUrl/Controllers/PagingSummaryCurrentPageDataController.cs";
    ViewBag.Title = "GridDataUrl/PagingSummaryCurrentPage";
    var F = Html.F();
}


@section head {

    <style>
        .f-grid-row-summary .f-grid-cell-text {
            font-weight: bold;
            color: red;
        }
    </style>

}

@section body {

    @(F.Grid().IsFluid(true).Height(350).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .DataUrl(Url.Content("~/GridDataUrl/PagingSummaryData")).AllowPaging(true).IsDatabasePaging(false).PageSize(5).EnableSummary(true).SummaryPosition(SummaryPosition.Bottom)
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().ColumnID("Fee").DataField("Fee").HeaderText("学费"),
            F.RenderField().ColumnID("ExtraFee").DataField("ExtraFee").HeaderText("学杂费")
        ).Listener("dataload", "onGrid1DataLoad")
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onGrid1DataLoad(event) {
            var grid1 = this;

            var feeTotal = 0, extraFeeTotal = 0;
            var startRowIndex = grid1.getStartRowIndex(), endRowIndex = grid1.getEndRowIndex();
            for (var i = startRowIndex; i <= endRowIndex; i++) {
                var rowData = grid1.data[i];
                feeTotal += rowData.values['Fee'];
                extraFeeTotal += rowData.values['ExtraFee'];
            }

            grid1.setSummaryData({
                'Fee': feeTotal,
                'ExtraFee': extraFeeTotal
            });
        }

    </script>
}
