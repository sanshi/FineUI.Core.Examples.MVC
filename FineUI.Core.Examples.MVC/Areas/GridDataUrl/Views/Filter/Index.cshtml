@{
    ViewBag.SourceFiles = "~/Areas/GridDataUrl/Controllers/FilterDataController.cs";
    ViewBag.Title = "GridDataUrl/Filter";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .DataUrl(Url.Content("~/GridDataUrl/FilterData")).AllowFilters(true).DataMethod("POST")
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name").EnableFilter(true)
                .Filter(F.GridFilter()
                    .Operator(
                        F.DropDownList().ID("DropDownList1")
                            .Items(
                                F.ListItem().Text("等于").Value("equal"),
                                F.ListItem().Text("包含").Value("contain").Selected(true),
                                F.ListItem().Text("开始于").Value("start"),
                                F.ListItem().Text("结束于").Value("end")
                            )
                    )
                ),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int).EnableFilter(true)
                .Filter(F.GridFilter()
                    .Operator(
                        F.DropDownList().ID("DropDownList2")
                            .Items(
                                F.ListItem().Text("大于").Value("greater").Selected(true),
                                F.ListItem().Text("小于").Value("less"),
                                F.ListItem().Text("等于").Value("equal")
                            )
                    )
                    .Field(
                        F.NumberBox().ID("NumberBox1").NoDecimal(true).NoNegative(true).Required(true).MinValue(1995)
                    )
                ),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150).EnableFilter(true)
                .Filter(F.GridFilter()
                    .Field(
                        F.CheckBoxList().ID("CheckBoxList1").ColumnNumber(1).Required(true)
                            .Items(
                                F.CheckItem().Text("材料科学与工程系").Value("材料科学与工程系"),
                                F.CheckItem().Text("化学系").Value("化学系"),
                                F.CheckItem().Text("物理系").Value("物理系"),
                                F.CheckItem().Text("数学系").Value("数学系"),
                                F.CheckItem().Text("自动化系").Value("自动化系")
                            )
                    )
                ),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup")
        )
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))


}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>通过表头输入条件，用数据请求把过滤参数交给网址接口，再显示匹配记录。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>用条件重新请求异步数据</h3>
        <ul>
            <li>在<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong><strong>姓名</strong>过滤中选择包含，输入<code>张</code>并确定。<br />结果：浏览器通过本页配置的 POST 数据请求提交过滤条件，接口返回匹配记录；清除条件后重新取得完整结果。</li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataMethod</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为 <code>POST</code>，使用
                POST 向 DataUrl 发送过滤参数，与普通按钮回发分别处理。</li>
            <li><code>AllowFilters</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：初始为
                <code>true</code>，为启用过滤的列创建条件入口，结果由数据接口筛选返回。
            </li>
        </ul>
    </section>
}
