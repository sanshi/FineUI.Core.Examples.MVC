@{
    ViewBag.SourceFiles = "~/Areas/GridDataUrl/Controllers/GridDataUrlDataController.cs";
    ViewBag.Title = "GridDataUrl/RowButton";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .DataUrl(Url.Content("~/GridDataUrl/GridDataUrlData"))
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup"),
            F.RenderField().ColumnID("Actions").RendererFunction("renderActions")
        )
    )
    <br>
    <br>

    @(F.Button().Text("选中了哪些行").ID("Button1").ClickHandler("onNotifySelectedRowsClick"))


}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function renderActions(value, params) {
            return '<a class="action editit" href="#">' +
                        '<img class="f-grid-imagefield" src="' + F.resolveUrl('/res/icon/pencil.png') + '">' +
                   '</a>&nbsp;&nbsp;&nbsp;&nbsp;' +
                   '<a class="action deleteit" href="#">' +
                        '<img class="f-grid-imagefield" src="' + F.resolveUrl('/res/icon/delete.png') + '">' +
                   '</a>';
        }


        F.ready(function () {

            var grid1 = F.ui.Grid1; if (!grid1) return;

            grid1.el.on('click', '.f-grid-cell-Actions .action.editit', function (event) {
                event.preventDefault();
                var targetEl = $(this);
                var rowEl = targetEl.closest('.f-grid-row');
                var rowData = grid1.getRowData(rowEl);

                // 触发后台事件
                F.doPostBack({
                    url: '@Url.Action("Grid1_CustomEvent")',
                    params: {
                        eventType: 'edit',
                        rowIndex: rowEl.index(),
                        rowId: rowData.id,
                        rowText: rowData.text
                    }
                });
            });


            grid1.el.on('click', '.f-grid-cell-Actions .action.deleteit', function (event) {
                event.preventDefault();
                var targetEl = $(this);
                var rowEl = targetEl.closest('.f-grid-row');
                var rowData = grid1.getRowData(rowEl);

                F.confirm({
                    message: '删除选中行？',
                    messageIcon: 'warning',
                    target: '_top',
                    ok: function () {
                        // 触发后台事件
                        F.doPostBack({
                            url: '@Url.Action("Grid1_CustomEvent")',
                            params: {
                                eventType: 'delete',
                                rowIndex: rowEl.index(),
                                rowId: rowData.id,
                                rowText: rowData.text
                            }
                        });
                    }
                });

            });

        });

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>为异步加载的每行绑定编辑与删除入口，用事件委托读取本次操作行资料。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>把行内入口交给后台处理</h3>
        <ol>
            <li>点击<strong class="example-control-reference" data-example-control="Grid1"
                    title="表格">表格</strong>首行的编辑图标。<br />结果：页面从入口所属行取得标识和<strong>姓名</strong>，经自定义回发由后台显示操作信息。</li>
            <li>点击该行删除图标，先取消，再重新点击并确认。<br />结果：取消不提交删除事件；确认后后台显示本次删除动作及行资料，本示例不实际从数据源删除学生。</li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>RendererFunction / click / F.customEvent</code>（<strong>网址数据加载与页面脚本</strong>，作用于<strong class="example-control-reference"
                    data-example-control="Grid1" title="表格">表格</strong>）：先生成行内入口，再由表格容器接收点击并找到当前行；异步重绘后仍可使用同一处理。</li>
        </ul>
    </section>
}
