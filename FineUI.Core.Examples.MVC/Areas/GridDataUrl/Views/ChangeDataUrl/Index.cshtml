@{
    ViewBag.SourceFiles = "~/Areas/GridDataUrl/Controllers/GridDataUrlDataController.cs";
    ViewBag.Title = "GridDataUrl/ChangeDataUrl";
    var F = Html.F();
}


@section body {

    @(F.Grid().IsFluid(true).Title("表格").ShowHeader(true).ShowBorder(true).ID("Grid1").DataIDField("Id").DataTextField("Name")
        .DataUrl(Url.Content("~/GridDataUrl/GridDataUrlData"))
        .Columns(
            F.RowNumberField(),
            F.RenderField().HeaderText("姓名").DataField("Name"),
            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup")
        ).Attribute("data-source-key", "source1")
    )
    <br>
    <br>

    @(F.Button().Text("切换网址数据源").ID("Button1").CssClass("marginr").ClickHandler("onButton1Click"))
    @(F.Button().Text("切换网址数据源（服务器端）").ID("Button2").OnClick(Url.Action("Button2_Click"),
            new Parameter("Grid1_sourceKey", "F.ui.Grid1.getAttr('data-source-key')"))
    )




}


@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function onButton1Click(event) {
            var grid1 = F.ui.Grid1;

            if (grid1.getAttr('data-source-key') === 'source1') {
                grid1.setAttr('data-source-key', 'source2')
                grid1.loadDataUrl('@Url.Content("~/GridDataUrl/GridDataUrlData?data2=true")');
            } else {
                grid1.setAttr('data-source-key', 'source1')
                grid1.loadDataUrl('@Url.Content("~/GridDataUrl/GridDataUrlData")');
            }
        }

    </script>
}
