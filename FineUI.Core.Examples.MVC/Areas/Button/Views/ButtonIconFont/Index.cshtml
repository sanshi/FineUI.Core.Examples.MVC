
@{
    ViewBag.Title = "Button/ButtonIconFont";
    var F = Html.F();
}

@section body {

    @(F.Button().ID("btnIcon1").Text("图标在左侧").IconFont(IconFont._Home).CssClass("marginr"))

    @(F.Button().ID("btnIcon2").Text("图标在右侧").IconFont(IconFont._Car).IconAlign(IconAlign.Right).CssClass("marginr"))

    <br />
    <br />

    @(F.Button().ID("btnIcon3").Text("图标在上面").IconFont(IconFont._Camera).IconAlign(IconAlign.Top).CssClass("marginr"))

    @(F.Button().ID("btnIcon4").Text("图标在下面").IconFont(IconFont._Phone).IconAlign(IconAlign.Bottom).CssClass("marginr"))


    <br />
    <br />

    @(F.Button().ID("btnCustomIconFont").Text("点击修改图标（在三个图标之前切换）").IconFont(IconFont._VolumeUp).OnClick(Url.Action("btnCustomIconFont_Click"), Parameter.FromFunction("iconFont", "getCurrentControlIconFontPostbackValue")))

    <br />
    <br />
    只有图片的按钮：
    <br />
    <br />
    @(F.Button().IconFont(IconFont._Android).CssClass("marginr"))
    @(F.Button().IconFont(IconFont._Apple).CssClass("marginr"))
    @(F.Button().IconFont(IconFont._Car).CssClass("marginr"))
    @(F.Button().IconFont(IconFont._Card).CssClass("marginr"))

    <br />
    <br />
    大按钮：
    <br />
    <br />

    @(F.Button().IconFont(IconFont._Home).Size(ButtonSize.Large).Text("图标在左侧").CssClass("marginr"))
    @(F.Button().ID("btnIconRight").IconFont(IconFont._Car).Size(ButtonSize.Large).Text("图标在右侧").IconAlign(IconAlign.Right).CssClass("marginr"))

    <br />
    <br />

    @(F.Button().ID("btnIconTop").IconFont(IconFont._Camera).Size(ButtonSize.Large).Text("图标在上面").IconAlign(IconAlign.Top).CssClass("marginr"))
    @(F.Button().ID("btnIconBottom").IconFont(IconFont._Phone).Size(ButtonSize.Large).Text("图标在下面").IconAlign(IconAlign.Bottom).CssClass("marginr"))



}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlIconFontPostbackValue() {
            return this.iconFont;
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示字体图标、四种图标位置和运行时图标切换。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对比图标与按钮外观</h3>
        <ul>
            <li>
                对照左、右、上、下图标按钮及只有图标的按钮。<br />
                结果：图标与文字按指定方向排列，大按钮与普通按钮使用各自尺寸。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>连续切换图标</h3>
        <ul>
            <li>
                连续点击标为<strong class="example-control-reference" data-example-control="btnCustomIconFont" title="点击修改图标（在三个图标之前切换）">点击修改图标（在三个图标之前切换）</strong>的按钮。<br />
                结果：回发后，后台按音量大、音量小、静音的顺序循环更换图标。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>IconFont</code>（本页全部按钮，如<strong class="example-control-reference" data-example-control="btnIcon1" title="第 1 个按钮（图标在左侧）">第 1 个按钮（图标在左侧）</strong>）：指定字体图标，页面使用主页、汽车、相机、电话和音量图标。</li>
            <li><code>IconAlign</code>（<strong class="example-control-reference" data-example-control="btnIcon2" title="第 2 个按钮（图标在右侧）">第 2 个按钮（图标在右侧）</strong>、<strong class="example-control-reference" data-example-control="btnIcon3" title="第 3 个按钮（图标在上面）">第 3 个按钮（图标在上面）</strong>、<strong class="example-control-reference" data-example-control="btnIcon4" title="第 4 个按钮（图标在下面）">第 4 个按钮（图标在下面）</strong>、<strong class="example-control-reference" data-example-control="btnIconRight" title="第 11 个按钮（图标在右侧）">第 11 个按钮（图标在右侧）</strong>、<strong class="example-control-reference" data-example-control="btnIconTop" title="第 12 个按钮（图标在上面）">第 12 个按钮（图标在上面）</strong>、<strong class="example-control-reference" data-example-control="btnIconBottom" title="第 13 个按钮（图标在下面）">第 13 个按钮（图标在下面）</strong>）：控制图标相对文字的位置。</li>
        </ul>
    </section>
}
