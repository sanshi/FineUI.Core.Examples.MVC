
@{
    ViewBag.Title = "Button/ButtonIcon";
    var F = Html.F();
}

@section body {

    @(F.Button().ID("btnIcon1").Text("图标在左侧").Icon(Icon.Email).CssClass("marginr"))

    @(F.Button().ID("btnIcon2").Text("图标在右侧").Icon(Icon.Star).IconAlign(IconAlign.Right).CssClass("marginr"))

    <br />
    <br />

    @(F.Button().ID("btnIcon3").Text("图标在上面").Icon(Icon.Email).IconAlign(IconAlign.Top).CssClass("marginr"))

    @(F.Button().ID("btnIcon4").Text("图标在下面").Icon(Icon.Star).IconAlign(IconAlign.Bottom).CssClass("marginr"))


    <br />
    <br />

    @(F.Button().ID("btnCustomIcon").Text("自定义图标（点击修改图标）").IconUrl(Url.Content("~/res/images/16/1.png")).OnClick(Url.Action("btnCustomIcon_Click"), Parameter.FromFunction("iconUrl", "getCurrentControlIconUrlPostbackValue")))

    <br />
    <br />
    只有图片的按钮：
    <br />
    <br />
    @(F.Button().IconUrl(Url.Content("~/res/images/16/1.png")).CssClass("marginr"))
    @(F.Button().IconUrl(Url.Content("~/res/images/16/8.png")).CssClass("marginr"))


    <br />
    <br />
    大按钮：
    <br />
    <br />

    @(F.Button().Icon(Icon.Email).Size(ButtonSize.Large).Text("图标在左侧").CssClass("marginr"))
    @(F.Button().Icon(Icon.Star).Size(ButtonSize.Large).Text("图标在右侧").IconAlign(IconAlign.Right).CssClass("marginr"))

    <br />
    <br />

    @(F.Button().Icon(Icon.Email).Size(ButtonSize.Large).Text("图标在上面").IconAlign(IconAlign.Top).CssClass("marginr"))
    @(F.Button().Icon(Icon.Email).Size(ButtonSize.Large).Text("图标在下面").IconAlign(IconAlign.Bottom).CssClass("marginr"))



}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getCurrentControlIconUrlPostbackValue() {
            return this.icon;
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示图片图标在按钮四个方向的排列，以及点击后更换图片。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对比图标位置</h3>
        <ul>
            <li>
                对照“图标在左侧、右侧、上面、下面”的按钮。<br />
                结果：图片分别排列在文字对应方向，只有图片的按钮不预留文字。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>切换图标图片</h3>
        <ul>
            <li>
                连续点击“自定义图标（点击修改图标）”。<br />
                结果：回发后，后台在 1.png、8.png 两张图片之间切换，按钮文字保留。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Icon</code>：使用内置图片枚举，例如 Email、Star。</li>
            <li><code>IconUrl</code>：指定自定义图片地址，点击后由后台更换。</li>
            <li><code>IconAlign</code>：控制图标相对文字的左、右、上、下位置。</li>
        </ul>
    </section>
}
