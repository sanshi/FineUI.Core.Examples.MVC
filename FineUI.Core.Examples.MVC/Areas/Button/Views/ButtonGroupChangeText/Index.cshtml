@{
    ViewBag.Title = "Button/ButtonGroupChangeText";
    var F = Html.F();
}

@section body {

    @(F.Panel().IsFluid(true).ID("Panel1").ShowBorder(true).BodyPadding(10).Height(300).Title("面板")
        .Toolbars(
            F.Toolbar()
                .Items(
                    F.ButtonGroup().ID("ButtonGroup1")
                        .Items(
                            F.Button().ID("Button1").Text("按钮一").IconAlign(IconAlign.Top).Icon(Icon.Email),
                            F.Button().ID("Button2").Text("按钮二").IconAlign(IconAlign.Bottom).Icon(Icon.Star),
                            F.Button().ID("Button3").Text("按钮三").IconAlign(IconAlign.Top).IconFont(IconFont._Camera),
                            F.Button().ID("Button4").Text("按钮四").IconAlign(IconAlign.Bottom).IconFont(IconFont._Phone)
                        )
                )
        )
        .Items(
            F.Button().CssClass("marginr").ID("btnChangeButtonText").Text("修改[按钮四]的文本").OnClick(Url.Action("btnChangeButtonText_Click"), Parameter.FromFunction("text", "getButton4TextPostbackValue")),
            F.Button().ID("btnShowHideButton").Text("显示隐藏[按钮四]").OnClick(Url.Action("btnShowHideButton_Click"), Parameter.FromFunction("hidden", "getButton4HiddenPostbackValue"))
        )
    )
    <br>
    <br>

    @(F.ButtonGroup().ID("ButtonGroup2")
        .Items(
            F.Button().ID("Button5").Text("按钮五").IconAlign(IconAlign.Top).Icon(Icon.Email),
            F.Button().ID("Button6").Text("按钮六").IconAlign(IconAlign.Bottom).Icon(Icon.Star),
            F.Button().ID("Button7").Text("按钮七").IconAlign(IconAlign.Top).IconFont(IconFont._Camera),
            F.Button().ID("Button8").Text("按钮八").IconAlign(IconAlign.Bottom).IconFont(IconFont._Phone)
        )
    )
    <br>

    @(F.Button().CssClass("marginr").ID("btnChangeButtonText2").Text("修改[按钮八]的文本").OnClick(Url.Action("btnChangeButtonText2_Click"), Parameter.FromFunction("text", "getButton8TextPostbackValue")))
    @(F.Button().ID("btnShowHideButton2").Text("显示隐藏[按钮八]").OnClick(Url.Action("btnShowHideButton2_Click"), Parameter.FromFunction("hidden", "getButton8HiddenPostbackValue")))




}

@section script {

    <script>
        // 请求发送前读取当前值；取消确认或发送前检查未通过时不读取。
        function getButton4TextPostbackValue() {
            return F.ui.Button4.getText();
        }

        function getButton4HiddenPostbackValue() {
            return F.ui.Button4.isHidden();
        }

        function getButton8TextPostbackValue() {
            return F.ui.Button8.getText();
        }

        function getButton8HiddenPostbackValue() {
            return F.ui.Button8.isHidden();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示按钮分组内文字变长、按钮隐藏与恢复后，分组重新计算布局。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>修改文字与显示状态</h3>
        <ul>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnChangeButtonText" title="修改[按钮四]的文本">修改[按钮四]的文本</strong>。<br />
                结果：后台给<strong class="example-control-reference" data-example-control="Button4" title="按钮四">按钮四</strong>追加当前时间，再次点击恢复原文字，分组随文字宽度调整。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnShowHideButton" title="显示隐藏[按钮四]">显示隐藏[按钮四]</strong>。<br />
                结果：后台隐藏或恢复<strong class="example-control-reference" data-example-control="Button4" title="按钮四">按钮四</strong>，分组边框及其它按钮重新衔接。
            </li>
            <li>
                在下一组对<strong class="example-control-reference" data-example-control="Button8" title="按钮八">按钮八</strong>执行相同操作。<br />
                结果：同样可以更新文字和显示状态，不需重新创建分组。
            </li>
        </ul>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Text</code>（<strong class="example-control-reference" data-example-control="Button4" title="按钮四">按钮四</strong>、<strong
                    class="example-control-reference" data-example-control="Button8" title="按钮八">按钮八</strong>）：后台在原按钮上更新文字。</li>
            <li><code>Hidden</code>（<strong class="example-control-reference" data-example-control="Button4" title="按钮四">按钮四</strong>、<strong
                    class="example-control-reference" data-example-control="Button8" title="按钮八">按钮八</strong>）：隐藏组内按钮并释放其布局空间。</li>
        </ul>
    </section>
}
