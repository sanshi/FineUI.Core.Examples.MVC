@{
    ViewBag.Title = "DropDownBox/GridPagingDatabaseDefaultValue";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉表格（数据库分页）").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").EmptyText("请从下拉表格中选择").EnableMultiSelect(true).MatchFieldWidth(false).Values("115,105").Texts("董国,吴颖颖")
                .PopPanel(
                    F.Grid().ID("Grid1").Width(650).Height(300).DataIDField("Id").DataTextField("Name").EnableMultiSelect(true).KeepCurrentSelection(true).PageSize(5).ShowBorder(true).ShowHeader(false).AllowPaging(true).IsDatabasePaging(true).OnPageIndexChanged(Url.Action("Grid1_PageIndexChanged"), "Grid1").EnableCheckBoxSelect(true).Hidden(true)
                        .Columns(
                            F.RowNumberField(),
                            F.RenderField().HeaderText("姓名").DataField("Name"),
                            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
                            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
                            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
                            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup")
                        ).RecordCount(ViewBag.Grid1RecordCount).DataSource(ViewBag.Grid1DataSource)
                ),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))




}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示对应节点或人员尚未加载时，仍显示由后台提供的初始业务值和文字。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>先显示尚未加载项的初始选择</h3>
        <ol>
            <li>
                初次打开时查看输入区，再展开面板查看当前页的数据。<br />
                结果：输入区已经显示初始文字，不要求初始项先出现在当前页的数据中。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-info" aria-hidden="true"></i>补充说明</h3>
        <p>注：通过 <code>Values</code> 和 <code>Text</code> 属性来设置<strong class="example-control-reference" data-example-control="DropDownBox1" title="请从下拉表格中选择">下拉框</strong>的初始值（由于初始值可能不在第一页，所以需要指定 <code>Text</code> 属性）。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Values</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="请从下拉表格中选择">请从下拉表格中选择</strong>）：指定初始多选值。 本页声明值为 <code>115</code>,<code>105</code>。</li>
            <li><code>Texts</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="请从下拉表格中选择">请从下拉表格中选择</strong>）：为初始值提供对应文字，尤其适用于尚未加载到当前页的数据。 本页声明值为 董国,吴颖颖。</li>
        </ul>
    </section>
}
