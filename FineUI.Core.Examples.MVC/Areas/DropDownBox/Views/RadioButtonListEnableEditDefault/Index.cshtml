@{
    ViewBag.Title = "DropDownBox/RadioButtonListEnableEditDefault";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉单选框列表").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").DataControlID("RadioButtonList1").Text(@ViewBag.DropDownBox1Text).EnableMultiSelect(false).EnableEdit(true)
                .PopPanel(
                    F.SimpleForm().ID("SimpleForm2").BodyPadding(10).AutoScroll(true).ShowBorder(true).ShowHeader(false).Hidden(true)
                        .Items(
                            F.Label().ID("Label1").Text("请选择一种编程语言："),
                            F.RadioButtonList().ID("RadioButtonList1").ColumnNumber(1)
                                .Items(
                                    F.RadioItem().Text("C#").Value("csharp"),
                                    F.RadioItem().Text("JavaScript").Value("js"),
                                    F.RadioItem().Text("JAVA").Value("java"),
                                    F.RadioItem().Text("Ruby").Value("ruby")
                                )
                        )
                ),
            F.Button().ID("btnSelectItem").Text("选中[JavaScript]").CssClass("marginr").OnClick(Url.Action("btnSelectItem_Click")),
            F.Button().ID("btnSetText").Text("更新为[用户输入值]").CssClass("marginr").OnClick(Url.Action("btnSetText_Click")),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在下拉面板内单选编程语言，允许输入列表之外的文字，以自定义文字作为初值。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>核对初始自由输入</h3>
        <ol>
            <li>
                初次打开页面，查看输入区。<br />
                结果：输入区显示“初始自定义值”；点击获取值时按用户输入文字处理。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableEdit</code>：允许输入列表之外的文字，选中项与自由输入按不同方式读取。 本页声明值为 true。</li>
        </ul>
    </section>
}
