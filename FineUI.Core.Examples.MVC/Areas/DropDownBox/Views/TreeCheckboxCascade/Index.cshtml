@{
    ViewBag.Title = "DropDownBox/TreeCheckboxCascade";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉树").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").EnableMultiSelect(true).Values("luohe").Text("漯河市").CustomData(true)
                .PopPanel(
                    F.Tree().ID("Tree1").ShowHeader(false).EnableCheckBox(true).Hidden(true).CascadeCheck(true)
                        .Nodes(
                            F.TreeNode().Text("中国").NodeID("china").Expanded(true)
                                .Nodes(
                                    F.TreeNode().Text("河南省").NodeID("henan").Expanded(true)
                                        .Nodes(
                                            F.TreeNode().Text("驻马店市").NodeID("zhumadian")
                                                .Nodes(
                                                    F.TreeNode().Text("遂平县").Leaf(false).NodeID("suiping")
                                                        .Nodes(
                                                            F.TreeNode().Text("槐树乡").Leaf(false).NodeID("huaishu")
                                                                .Nodes(
                                                                    F.TreeNode().Text("陈庄村").NodeID("chenzhuang")
                                                                )
                                                        )
                                                ),
                                            F.TreeNode().Text("漯河市").NodeID("luohe")
                                        ),
                                    F.TreeNode().Text("安徽省").Expanded(true).NodeID("anhui")
                                        .Nodes(
                                            F.TreeNode().Text("合肥市").Expanded(true).NodeID("hefei")
                                                .Nodes(
                                                    F.TreeNode().Text("蜀山区").Expanded(false).NodeID("shushanqu")
                                                        .Nodes(
                                                            F.TreeNode().Text("金色池塘小区").NodeID("golden"),
                                                            F.TreeNode().Text("梦圆小区").NodeID("mengyuan"),
                                                            F.TreeNode().Text("桂花园小区").NodeID("guihuayuan")
                                                        ),
                                                    F.TreeNode().Text("包河区").Expanded(true).NodeID("baohequ")
                                                        .Nodes(
                                                            F.TreeNode().Text("中国科学技术大学").NodeID("ustc")
                                                        )
                                                )
                                        )
                                )
                        )
                ).Listener("poppanelshow", "onPopPanelShow"),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))

    <br />
    注：
    <ul>
        <li>自定义数据来源时（CustomData=true），需要同时设置 Value 和 Text 属性来初始化下拉框。</li>
        <li>下拉框的值对应于树控件的复选框，而不是树控件的选中项。</li>
    </ul>

}


@section script {

    <script>

        function onPopPanelShow(event) {
            var nodes = this.getValue();

            F.noEvent(function () {
                F.ui.Tree1.checkNodes(nodes, {
                    deep: true, // 是否递归调用子节点
                    keep: false // 是否保持已选中复选框的状态（false表示在执行本次操作之前，取消已选中的复选框）
                });

                // 启用树控件的级联选择时，确保把树控件的选中值全部同步到下拉框
                syncToDropDownBox();
            });

        }

        // 将树控件的选中值同步到下拉框
        function syncToDropDownBox() {
            var values = [], texts = [];
            var checkedNodes = F.ui.Tree1.getCheckedNodes(true);
            $.each(checkedNodes, function (index, node) {
                values.push(node.id);
                texts.push(node.text);
            });

            F.ui.DropDownBox1.setValue(values, texts);
        }

        F.ready(function () {

            F.ui.Tree1.on('nodecheck', function (event, nodeId, checked) {
                // 加个延迟，等待复选框的级联选择完成
                window.setTimeout(function () {
                    syncToDropDownBox();
                });
            });

        });

    </script>

}
