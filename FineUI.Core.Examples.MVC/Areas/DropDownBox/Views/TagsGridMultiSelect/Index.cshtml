@{
    ViewBag.Title = "DropDownBox/TagsGridMultiSelect";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉表格（多选）").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").EmptyText("请从下拉表格中选择").MatchFieldWidth(false).Values("105,108").EnableMultiSelect(true).MultiSelectMode(MultiSelectMode.Tags)
                .PopPanel(
                    F.Grid().ID("Grid1").ShowBorder(true).ShowHeader(false).DataIDField("Id").DataTextField("Name").Width(550).Height(300).EnableMultiSelect(true).KeepCurrentSelection(true).EnableCheckBoxSelect(true).Hidden(true)
                        .Columns(
                            F.RenderField().DataField("Name").HeaderText("姓名"),
                            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                            F.RenderField().ExpandUnusedSpace(true).MinWidth(150).DataField("Major").HeaderText("所学专业"),
                            F.RenderField().DataField("Desc").RenderAsRowExpander(true).RendererFunction("renderExpander")
                        )
                        .DataSource(DataSourceUtil.GetDataTable())
                ),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").CssClass("marginr").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1"),
            F.Button().ID("btnReset").Text("重置表单").ClickHandler("onResetClick")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))

}

@section script {

    <script src="~/res/js/grid.js"></script>
    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }
    </script>


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在下拉表格中多选人员，以标签显示和移除所选人员。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>移除一个选择标签</h3>
        <ol>
            <li>
                先在下拉面板选择两个可用项，再点击其中一个标签右侧的关闭图标。<br />
                结果：对应业务值与面板中的选择被取消，其它已选项保持不变。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>MultiSelectMode</code>：Tags/tags 将选中的每项显示为可单独移除的标签。 本页声明值为 MultiSelectMode.Tags。</li>
        </ul>
    </section>
}
