@{
    ViewBag.Title = "DropDownBox/GridLayoutSingleSelect";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉表格（复杂布局，单选）").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").EmptyText("请从下拉表格中选择").EnableMultiSelect(false).MatchFieldWidth(false).DataControlID("Grid1")
                .PopPanel(
                    F.Panel().ID("Panel1").BodyPadding(10).Width(650).Height(300).ShowBorder(true).ShowHeader(false).Layout(LayoutType.VBox).BoxConfigSpace(5).Hidden(true)
                        .Items(
                            F.Form().ID("Form5").ShowBorder(false).ShowHeader(false).RemoveLastFieldsMargin(true)
                                .Rows(
                                    F.FormRow()
                                        .Items(
                                            F.TwinTriggerBox().Width(300).EmptyText("在姓名中查找").ShowLabel(false).ID("ttbSearch").ShowTrigger1(false).OnTrigger1Click(Url.Action("ttbSearch_Trigger1Click"), "Panel1").OnTrigger2Click(Url.Action("Grid1_DoReBind"), "Panel1").Trigger1Icon(TriggerIcon.Clear).Trigger2Icon(TriggerIcon.Search),
                                            F.RadioButtonList().ID("rblAtSchool").Label("是否在校").OnSelectedIndexChanged(Url.Action("Grid1_DoReBind"), "Panel1")
                                                .Items(
                                                    F.RadioItem().Text("全部").Value("-1").Selected(true),
                                                    F.RadioItem().Text("在校").Value("1"),
                                                    F.RadioItem().Text("离校").Value("0")
                                                )
                                        )
                                ),
                            F.Grid().ID("Grid1").BoxFlex(1).DataIDField("Id").DataTextField("Name").EnableMultiSelect(false).PageSize(5).ShowBorder(true).ShowHeader(false).AllowPaging(true).IsDatabasePaging(true).OnPageIndexChanged(Url.Action("Grid1_DoReBind"), "Panel1").EnableCheckBoxSelect(true)
                                .Columns(
                                    F.RowNumberField(),
                                    F.RenderField().HeaderText("姓名").DataField("Name"),
                                    F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                                    F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
                                    F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
                                    F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
                                    F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup")
                                ).RecordCount(ViewBag.Grid1RecordCount).DataSource(ViewBag.Grid1DataSource)
                        )
                ),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在含姓名搜索、在校筛选和分页的面板中单选人员。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-radio-button-checked" aria-hidden="true"></i>在复杂面板中只保留一名人员</h3>
        <ol>
            <li>
                展开面板，先后选择两个不同的可用人员。<br />
                结果：后一次选择替换前一次选择，输入区始终只保留一名人员。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="请从下拉表格中选择">请从下拉表格中选择</strong>）：本页<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="请从下拉表格中选择">下拉框</strong>及内嵌表格使用单选，不累积多个选择。</li>
        </ul>
    </section>
}
