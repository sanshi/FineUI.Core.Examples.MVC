@{
    ViewBag.Title = "DropDownBox/CheckBoxList";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉复选框列表").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").DataControlID("RadioButtonList1").EnableMultiSelect(true).Values("js,php")
                .PopPanel(
                    F.SimpleForm().ID("SimpleForm2").BodyPadding(10).AutoScroll(true).ShowBorder(true).ShowHeader(false).Hidden(true)
                        .Items(
                            F.Label().ID("Label1").Text("请选择编程语言："),
                            F.CheckBoxList().ID("RadioButtonList1").ColumnNumber(3)
                                .Items(
                                    F.CheckItem().Text("C#").Value("csharp"),
                                    F.CheckItem().Text("JavaScript").Value("js"),
                                    F.CheckItem().Text("JAVA").Value("java"),
                                    F.CheckItem().Text("Ruby").Value("ruby"),
                                    F.CheckItem().Text("PHP").Value("php"),
                                    F.CheckItem().Text("Objective-C").Value("objc"),
                                    F.CheckItem().Text("Python").Value("python"),
                                    F.CheckItem().Text("Perl").Value("perl"),
                                    F.CheckItem().Text("C++").Value("cplusplus"),
                                    F.CheckItem().Text("Basic").Value("basic"),
                                    F.CheckItem().Text("Go").Value("go"),
                                    F.CheckItem().Text("Swift").Value("swift")
                                )
                        )
                ),
            F.Button().ID("btnSelectItem6").Text("选中[php,basic]").OnClick(Url.Action("btnSelectItem6_Click")).CssClass("marginr"),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在下拉面板内多选编程语言。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check-box-checked" aria-hidden="true"></i>从面板选择编程语言</h3>
        <ol>
            <li>
                点击下拉箭头展开面板，选择<code>Ruby</code>。<br />
                结果：<code>Ruby</code> 加入已有选择，对应值为 <code>ruby</code>。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnGetSelection" title="获取下拉框的选中值">获取下拉框的选中值</strong>。<br />
                结果：回发后由后台显示包含 <code>Ruby</code> 和 <code>ruby</code> 的当前选择；由客户端将文字和值提交给处理方法。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>通过按钮更新选择</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnSelectItem6" title="选中[php,basic]">选中[php,basic]</strong>。<br />
                结果：回发后由后台把当前选择替换为按钮指定的人名或语言；输入区和重新展开的选择状态同步更新。
            </li>
            <li>
                再点击<strong class="example-control-reference" data-example-control="btnGetSelection" title="获取下拉框的选中值">获取下拉框的选中值</strong>。<br />
                结果：读取结果反映刚更新的选择。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataControlID</code>（<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="下拉框">下拉框</strong>）：指定弹出面板中提供选择数据的控件。 本页声明值为 <code>RadioButtonList1</code>。</li>
            <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="下拉框">下拉框</strong>）：决定<strong
                    class="example-control-reference" data-example-control="DropDownBox1" title="下拉框">下拉框</strong>保留单个值还是多个值。 本页声明值为 <code>true</code>。</li>
            <li><code>Values</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="下拉框">下拉框</strong>）：指定初始多选值。 本页声明值为
                <code>js</code>,<code>php</code>。
            </li>
            <li><code>ColumnNumber</code>（<strong class="example-control-reference" data-example-control="RadioButtonList1"
                    title="复选框列表">复选框列表</strong>）：控制弹出单选或复选列表的列数。 本页声明值为 <code>3</code>。</li>
        </ul>
    </section>
}
