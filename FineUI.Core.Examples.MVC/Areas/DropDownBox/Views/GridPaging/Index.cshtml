@{
    ViewBag.Title = "DropDownBox/GridPaging";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉表格（内存分页）").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").EmptyText("请从下拉表格中选择").EnableMultiSelect(true).MatchFieldWidth(false)
                .PopPanel(
                    F.Grid().ID("Grid1").Width(650).Height(300).DataIDField("Id").DataTextField("Name").EnableMultiSelect(true).KeepCurrentSelection(true).PageSize(5).ShowBorder(true).ShowHeader(false).AllowPaging(true).IsDatabasePaging(false).EnableCheckBoxSelect(true).Hidden(true)
                        .Columns(
                            F.RowNumberField(),
                            F.RenderField().HeaderText("姓名").DataField("Name"),
                            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
                            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
                            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
                            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup")
                        )
                        .DataSource(DataSourceUtil.GetDataTable2())
                ),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在浏览器中对已加载人员数据分页，并保留跨页选择。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>继续跨页选择</h3>
        <ol>
            <li>
                刷新当前示例以回到未过滤的初始状态，在第一页找到“金婷婷”；只有该行未选中时才勾选，然后点击分页条的下一页。<br />
                结果：全部数据已加载，翻页在浏览器完成；第一页的选择继续保留。
            </li>
            <li>
                在第二页找到“董超”，只有未选中时才勾选，再获取<strong class="example-control-reference" data-example-control="DropDownBox1" title="请从下拉表格中选择">下拉框</strong>选中值。<br />
                结果：结果同时包含前后两页的人员，包括 <code>103</code> 和 <code>108</code>，不会只剩第二页。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>AllowPaging</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：为弹出表格提供分页工具栏。 本页声明值为 <code>true</code>。</li>
            <li><code>IsDatabasePaging</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：为 <code>true</code> 时后台按当前页加载；为 <code>false</code> 时浏览器对已加载数据分页。 本页声明值为 <code>false</code>。</li>
            <li><code>PageSize</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：决定每页显示多少条数据。 本页声明值为 <code>5</code>。</li>
            <li><code>KeepCurrentSelection</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：在继续选择或翻页时保留已有选择。 本页声明值为 <code>true</code>。</li>
        </ul>
    </section>
}
