@{
    ViewBag.Title = "DropDownBox/GridMultiSelectEnableEdit";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉表格（多选）").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").EmptyText("请从下拉表格中选择").MatchFieldWidth(false).Values("105,108").EnableMultiSelect(true).EnableEdit(true)
                .PopPanel(
                    F.Grid().ID("Grid1").ShowBorder(true).ShowHeader(false).DataIDField("Id").DataTextField("Name").Width(550).Height(300).EnableMultiSelect(true).KeepCurrentSelection(true).EnableCheckBoxSelect(true).Hidden(true)
                        .Columns(
                            F.RenderField().DataField("Name").HeaderText("姓名"),
                            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                            F.RenderField().ExpandUnusedSpace(true).MinWidth(150).DataField("Major").HeaderText("所学专业")
                        )
                        .DataSource(DataSourceUtil.GetDataTable())
                ),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").CssClass("marginr").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1"),
            F.Button().ID("btnReset").Text("重置表单").ClickHandler("onResetClick")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))

}

@section script {

    <script src="~/res/js/grid.js"></script>
    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }
    </script>


}
