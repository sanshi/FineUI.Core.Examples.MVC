@{
    ViewBag.Title = "DropDownBox/GridUpdateValue";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉表格").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").EmptyText("请从下拉表格中选择").MatchFieldWidth(false).Value("105").EnableMultiSelect(false)
                .PopPanel(
                    F.Grid().ID("Grid1").ShowBorder(true).ShowHeader(false).DataIDField("Id").DataTextField("Name").Width(550).Height(300).EnableMultiSelect(false).Hidden(true)
                        .Columns(
                            F.RenderField().DataField("Name").HeaderText("姓名"),
                            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                            F.RenderField().ExpandUnusedSpace(true).MinWidth(150).DataField("Major").HeaderText("所学专业")
                        )
                        .DataSource(DataSourceUtil.GetDataTable())
                ),
            F.Button().ID("btnUpdateValue").CssClass("marginr").Text("更新下拉框的值为[张三石]").OnClick(Url.Action("btnUpdateValue_Click")),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").CssClass("marginr").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1"),
            F.Button().ID("btnReset").Text("重置表单").ClickHandler("onResetClick")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))

}

@section script {

    <script src="~/res/js/grid.js"></script>
    <script type="text/javascript">

        function onResetClick(event) {
            F.ui.SimpleForm1.reset();
        }
    </script>


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在<strong class="example-control-reference" data-example-control="SimpleForm1" title="下拉表格">下拉表格</strong>中单选人员，按钮请求后台替换选中人员。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>通过按钮更新选择</h3>
        <ol>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnUpdateValue" title="更新下拉框的值为[张三石]">更新下拉框的值为[张三石]</strong>。<br />
                结果：回发后由后台把当前选择替换为按钮指定的人名或语言；输入区和重新展开的选择状态同步更新。
            </li>
            <li>
                再点击<strong class="example-control-reference" data-example-control="btnGetSelection" title="获取下拉框的选中值">获取下拉框的选中值</strong>。<br />
                结果：读取结果反映刚更新的选择。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Value</code>（<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="请从下拉表格中选择">请从下拉表格中选择</strong>）：指定初始单选值或多选值数组。 本页声明值为 <code>105</code>。</li>
        </ul>
    </section>
}
