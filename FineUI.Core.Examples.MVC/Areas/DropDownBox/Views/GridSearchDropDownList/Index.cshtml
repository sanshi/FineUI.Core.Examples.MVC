@{
    ViewBag.Title = "DropDownBox/GridSearchDropDownList";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉表格（下拉列表过滤，表头菜单过滤）").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").EmptyText("请从下拉表格中选择").EnableMultiSelect(true).MatchFieldWidth(false)
                .PopPanel(
                    F.Grid().ID("Grid1").Width(650).Height(300).DataIDField("Id").DataTextField("Name").EnableMultiSelect(true).KeepCurrentSelection(true).PageSize(5).ShowBorder(true).ShowHeader(false).AllowPaging(true).IsDatabasePaging(true).OnPageIndexChanged(Url.Action("Grid1_DoReBind"), "Grid1").EnableCheckBoxSelect(true).AllowFilters(true).OnFilterChanged(Url.Action("Grid1_DoReBind"), "Grid1").Hidden(true)
                        .Columns(
                            F.RowNumberField(),
                            F.RenderField().HeaderText("姓名").DataField("Name"),
                            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
                            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
                            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150).EnableFilter(true)
                                .Filter(F.GridFilter()
                                    .Operator(
                                        F.DropDownList().ID("DropDownList1")
                                            .Items(
                                                F.ListItem().Text("等于").Value("equal"),
                                                F.ListItem().Text("包含").Value("contain").Selected(true),
                                                F.ListItem().Text("开始于").Value("start"),
                                                F.ListItem().Text("结束于").Value("end")
                                            )
                                    )
                                ),
                            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup")
                        )
                        .Toolbars(
                            F.Toolbar().Position(ToolbarPosition.Top)
                                .Items(
                                    F.Label().Text("是否在校："),
                                    F.DropDownList().ID("ddlAtSchool").OnSelectedIndexChanged(Url.Action("Grid1_DoReBind"), "Grid1")
                                        .Items(
                                            F.ListItem().Text("全部").Value("-1"),
                                            F.ListItem().Text("在校").Value("1"),
                                            F.ListItem().Text("离校").Value("0")
                                        )
                                )
                        ).RecordCount(ViewBag.Grid1RecordCount).DataSource(ViewBag.Grid1DataSource)
                ),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>组合在校状态下拉过滤和专业列表头过滤。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>组合下拉与表头过滤</h3>
        <ol>
            <li>
                在弹出面板的“是否在校”下拉中选择“离校”。<br />
                结果：后台按离校状态重新加载表格。
            </li>
            <li>
                在“所学专业”列菜单启用过滤，选择“包含”并输入专业关键词。<br />
                结果：专业条件与在校状态一起应用；这里过滤的是“所学专业”列，不是姓名列。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>AllowFilters</code>：允许通过表头菜单设置过滤。 本页声明值为 true。</li>
            <li><code>OnFilterChanged</code>：过滤条件变化后重新加载匹配行。</li>
            <li><code>OnSelectedIndexChanged</code>：筛选下拉框改变后重新加载表格，保留本页的其它过滤条件。</li>
        </ul>
    </section>
}
