@{
    ViewBag.Title = "DropDownBox/TagsTreeMultiSelect";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉树（多选）").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").EnableMultiSelect(true).Values("henan,anhui").MultiSelectMode(MultiSelectMode.Tags)
                .PopPanel(
                    F.Tree().ID("Tree1").ShowHeader(false).EnableMultiSelect(true).KeepCurrentSelection(true).Hidden(true)
                        .Nodes(
                            F.TreeNode().Text("中国").NodeID("china").Expanded(true)
                                .Nodes(
                                    F.TreeNode().Text("河南省").NodeID("henan").Expanded(true)
                                        .Nodes(
                                            F.TreeNode().Text("驻马店市").NodeID("zhumadian")
                                                .Nodes(
                                                    F.TreeNode().Text("遂平县").Leaf(false).NodeID("suiping")
                                                        .Nodes(
                                                            F.TreeNode().Text("槐树乡").Leaf(false).NodeID("huaishu")
                                                                .Nodes(
                                                                    F.TreeNode().Text("陈庄村").NodeID("chenzhuang")
                                                                )
                                                        )
                                                ),
                                            F.TreeNode().Text("漯河市").NodeID("luohe")
                                        ),
                                    F.TreeNode().Text("安徽省").Expanded(true).NodeID("anhui")
                                        .Nodes(
                                            F.TreeNode().Text("合肥市").Expanded(true).NodeID("hefei")
                                                .Nodes(
                                                    F.TreeNode().Text("蜀山区").Expanded(false).NodeID("shushanqu")
                                                        .Nodes(
                                                            F.TreeNode().Text("金色池塘小区").NodeID("golden"),
                                                            F.TreeNode().Text("梦圆小区").NodeID("mengyuan"),
                                                            F.TreeNode().Text("桂花园小区").NodeID("guihuayuan")
                                                        ),
                                                    F.TreeNode().Text("包河区").Expanded(true).NodeID("baohequ")
                                                        .Nodes(
                                                            F.TreeNode().Text("中国科学技术大学").NodeID("ustc")
                                                        )
                                                )
                                        )
                                )
                        )
                ),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))



}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在层级树中保留多个选择，通过标签显示并移除选择。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>移除一个选择标签</h3>
        <ol>
            <li>
                先在下拉面板选择两个可用项，再点击其中一个标签右侧的关闭图标。<br />
                结果：对应业务值与面板中的选择被取消，其它已选项保持不变。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>MultiSelectMode</code>（<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="下拉框">下拉框</strong>）：<code>Tags</code>/<code>tags</code> 将选中的每项显示为可单独移除的标签。 本页声明值为 <code>MultiSelectMode.Tags</code>。</li>
        </ul>
    </section>
}
