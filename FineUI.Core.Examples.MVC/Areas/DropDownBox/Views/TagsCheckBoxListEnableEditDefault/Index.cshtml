@{
    ViewBag.Title = "DropDownBox/TagsCheckBoxListEnableEditDefault";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉复选框列表").ShowHeader(true)
        .Items(
                F.DropDownBox().ID("DropDownBox1").DataControlID("RadioButtonList1").EnableMultiSelect(true).Values(@ViewBag.DropDownBox1Values).Text(@ViewBag.DropDownBox1Text).EnableEdit(true).MultiSelectMode(MultiSelectMode.Tags)
                .PopPanel(
                    F.SimpleForm().ID("SimpleForm2").BodyPadding(10).AutoScroll(true).ShowBorder(true).ShowHeader(false).Hidden(true)
                        .Items(
                            F.Label().ID("Label1").Text("请选择编程语言："),
                            F.CheckBoxList().ID("RadioButtonList1").ColumnNumber(3)
                                .Items(
                                    F.CheckItem().Text("C#").Value("csharp"),
                                    F.CheckItem().Text("JavaScript").Value("js"),
                                    F.CheckItem().Text("JAVA").Value("java"),
                                    F.CheckItem().Text("Ruby").Value("ruby"),
                                    F.CheckItem().Text("PHP").Value("php"),
                                    F.CheckItem().Text("Objective-C").Value("objc"),
                                    F.CheckItem().Text("Python").Value("python"),
                                    F.CheckItem().Text("Perl").Value("perl"),
                                    F.CheckItem().Text("C++").Value("cplusplus"),
                                    F.CheckItem().Text("Basic").Value("basic"),
                                    F.CheckItem().Text("Go").Value("go"),
                                    F.CheckItem().Text("Swift").Value("swift")
                                )
                        )
                ),
            F.Button().ID("btnSelectItem6").Text("选中[php,basic]").OnClick(Url.Action("btnSelectItem6_Click")).CssClass("marginr"),
            F.Button().ID("btnSetText").Text("更新为[用户输入值]").CssClass("marginr").OnClick(Url.Action("btnSetText_Click")),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在下拉面板内多选编程语言，以可移除标签显示选择，允许输入列表之外的文字，初始包含真实语言与自定义标签。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>核对初始自由输入</h3>
        <ol>
            <li>
                初次打开页面，查看输入区。<br />
                结果：初始同时显示 JavaScript 和“初始自定义值”两个标签，前者对应真实语言项，后者是用户输入文字。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableEdit</code>（<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="下拉框">下拉框</strong>）：允许输入列表之外的文字，选中项与自由输入按不同方式读取。 本页声明值为 <code>true</code>。</li>
        </ul>
    </section>
}
