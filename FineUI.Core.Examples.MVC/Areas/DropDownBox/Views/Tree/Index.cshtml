@{
    ViewBag.Title = "DropDownBox/Tree";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉树").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").Values("henan").EnableMultiSelect(false)
                .PopPanel(
                    F.Tree().ID("Tree1").ShowHeader(false).Hidden(true)
                        .Nodes(
                            F.TreeNode().Text("中国").NodeID("china").Expanded(true)
                                .Nodes(
                                    F.TreeNode().Text("河南省").NodeID("henan").Expanded(true)
                                        .Nodes(
                                            F.TreeNode().Text("驻马店市").NodeID("zhumadian")
                                                .Nodes(
                                                    F.TreeNode().Text("遂平县").Leaf(false).NodeID("suiping")
                                                        .Nodes(
                                                            F.TreeNode().Text("槐树乡").Leaf(false).NodeID("huaishu")
                                                                .Nodes(
                                                                    F.TreeNode().Text("陈庄村").NodeID("chenzhuang")
                                                                )
                                                        )
                                                ),
                                            F.TreeNode().Text("漯河市").NodeID("luohe")
                                        ),
                                    F.TreeNode().Text("安徽省").Expanded(true).NodeID("anhui")
                                        .Nodes(
                                            F.TreeNode().Text("合肥市").Expanded(true).NodeID("hefei")
                                                .Nodes(
                                                    F.TreeNode().Text("蜀山区").Expanded(false).NodeID("shushanqu")
                                                        .Nodes(
                                                            F.TreeNode().Text("金色池塘小区").NodeID("golden"),
                                                            F.TreeNode().Text("梦圆小区").NodeID("mengyuan"),
                                                            F.TreeNode().Text("桂花园小区").NodeID("guihuayuan")
                                                        ),
                                                    F.TreeNode().Text("包河区").Expanded(true).NodeID("baohequ")
                                                        .Nodes(
                                                            F.TreeNode().Text("中国科学技术大学").NodeID("ustc")
                                                        )
                                                )
                                        )
                                )
                        )
                ),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))



}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在层级树中选择单个节点。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-list" aria-hidden="true"></i>选择树节点</h3>
        <ol>
            <li>
                展开<strong class="example-control-reference" data-example-control="SimpleForm1" title="下拉树">下拉树</strong>，点击<strong>河南省</strong>下的“驻马店市”。<br />
                结果：选择替换为驻马店市，对应值为 <code>zhumadian</code>。
            </li>
            <li>
                点击面板外空白处收起，再点击<strong class="example-control-reference" data-example-control="btnGetSelection" title="获取下拉框的选中值">获取下拉框的选中值</strong>。<br />
                结果：回发后由后台显示当前树节点文字和标识。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableMultiSelect</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="下拉框">下拉框</strong>）：决定<strong
                    class="example-control-reference" data-example-control="DropDownBox1" title="下拉框">下拉框</strong>保留单个值还是多个值。 本页声明值为 <code>false</code>。</li>
            <li><code>Values</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="下拉框">下拉框</strong>）：指定初始多选值。 本页声明值为
                <code>henan</code>。
            </li>
        </ul>
    </section>
}
