@{
    ViewBag.Title = "DropDownBox/TagsCheckBoxList";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉复选框列表").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").DataControlID("RadioButtonList1").EnableMultiSelect(true).Values("js,php").MultiSelectMode(MultiSelectMode.Tags)
                .PopPanel(
                    F.SimpleForm().ID("SimpleForm2").BodyPadding(10).AutoScroll(true).ShowBorder(true).ShowHeader(false).Hidden(true)
                        .Items(
                            F.Label().ID("Label1").Text("请选择编程语言："),
                            F.CheckBoxList().ID("RadioButtonList1").ColumnNumber(3)
                                .Items(
                                    F.CheckItem().Text("C#").Value("csharp"),
                                    F.CheckItem().Text("JavaScript").Value("js"),
                                    F.CheckItem().Text("JAVA").Value("java"),
                                    F.CheckItem().Text("Ruby").Value("ruby"),
                                    F.CheckItem().Text("PHP").Value("php"),
                                    F.CheckItem().Text("Objective-C").Value("objc"),
                                    F.CheckItem().Text("Python").Value("python"),
                                    F.CheckItem().Text("Perl").Value("perl"),
                                    F.CheckItem().Text("C++").Value("cplusplus"),
                                    F.CheckItem().Text("Basic").Value("basic"),
                                    F.CheckItem().Text("Go").Value("go"),
                                    F.CheckItem().Text("Swift").Value("swift")
                                )
                        )
                ),
            F.Button().ID("btnSelectItem6").Text("选中[php,basic]").OnClick(Url.Action("btnSelectItem6_Click")).CssClass("marginr"),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在下拉面板内多选编程语言，以可移除标签显示选择。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>移除一个选择标签</h3>
        <ol>
            <li>
                先在下拉面板选择两个可用项，再点击其中一个标签右侧的关闭图标。<br />
                结果：对应业务值与面板中的选择被取消，其它已选项保持不变。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>MultiSelectMode</code>（<strong class="example-control-reference" data-example-control="DropDownBox1"
                    title="下拉框">下拉框</strong>）：<code>Tags</code>/<code>tags</code> 将选中的每项显示为可单独移除的标签。 本页声明值为 <code>MultiSelectMode.Tags</code>。</li>
        </ul>
    </section>
}
