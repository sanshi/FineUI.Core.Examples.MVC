@{
    ViewBag.Title = "DropDownBox/TagsGridPagingDatabaseUpdateValue";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉表格（数据库分页）").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").EmptyText("请从下拉表格中选择").EnableMultiSelect(true).MatchFieldWidth(false).MultiSelectMode(MultiSelectMode.Tags)
                .PopPanel(
                    F.Grid().ID("Grid1").Width(650).Height(300).DataIDField("Id").DataTextField("Name").EnableMultiSelect(true).KeepCurrentSelection(true).PageSize(5).ShowBorder(true).ShowHeader(false).AllowPaging(true).IsDatabasePaging(true).OnPageIndexChanged(Url.Action("Grid1_PageIndexChanged"), "Grid1").EnableCheckBoxSelect(true).Hidden(true)
                        .Columns(
                            F.RowNumberField(),
                            F.RenderField().HeaderText("姓名").DataField("Name"),
                            F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                            F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
                            F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
                            F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
                            F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup")
                        ).RecordCount(ViewBag.Grid1RecordCount).DataSource(ViewBag.Grid1DataSource)
                ),
            F.Panel().CssClass("f-field").ShowBorder(false).ShowHeader(false)
                .Items(
                    F.Button().ID("btnUpdateValue").CssClass("marginr").Text("更新下拉框的值为[张娟娟,叶鹏]").OnClick(Url.Action("btnUpdateValue_Click")),
                    F.Button().ID("btnClearValue").CssClass("marginr").Text("清空下拉框的值").OnClick(Url.Action("btnClearValue_Click")),
                    F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1")
                )
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>按需加载当前页人员数据并保留跨页选择，按钮请求后台替换选中人员，以标签显示和移除所选人员。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>通过按钮更新选择</h3>
        <ol>
            <li>
                点击“更新下拉框的值为[张娟娟,叶鹏]”。<br />
                结果：回发后由后台把当前选择替换为按钮指定的人名或语言；输入区和重新展开的选择状态同步更新。
            </li>
            <li>
                再点击“获取下拉框的选中值”。<br />
                结果：读取结果反映刚更新的选择。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-refresh" aria-hidden="true"></i>清空当前选择</h3>
        <ol>
            <li>
                点击“清空下拉框的值”，再获取当前选中值。<br />
                结果：输入文字、选择值及标签被清除，读取结果显示下拉框为空。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>Value</code>：按钮处理后更新下拉框当前选中值，显示文字随本页的选中数据同步更新。</li>
        </ul>
    </section>
}
