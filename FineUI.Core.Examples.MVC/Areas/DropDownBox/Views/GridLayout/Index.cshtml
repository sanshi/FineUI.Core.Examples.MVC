@{
    ViewBag.Title = "DropDownBox/GridLayout";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉表格（复杂布局）").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").EmptyText("请从下拉表格中选择").EnableMultiSelect(true).MatchFieldWidth(false).DataControlID("Grid1")
                .PopPanel(
                    F.Panel().ID("Panel1").BodyPadding(10).Width(650).Height(300).ShowBorder(true).ShowHeader(false).Layout(LayoutType.VBox).BoxConfigSpace(5).Hidden(true)
                        .Items(
                            F.Form().ID("Form5").ShowBorder(false).ShowHeader(false).RemoveLastFieldsMargin(true)
                                .Rows(
                                    F.FormRow()
                                        .Items(
                                            F.TwinTriggerBox().Width(300).EmptyText("在姓名中查找").ShowLabel(false).ID("ttbSearch").ShowTrigger1(false).OnTrigger1Click(Url.Action("ttbSearch_Trigger1Click"), "Panel1").OnTrigger2Click(Url.Action("Grid1_DoReBind"), "Panel1").Trigger1Icon(TriggerIcon.Clear).Trigger2Icon(TriggerIcon.Search),
                                            F.RadioButtonList().ID("rblAtSchool").Label("是否在校").OnSelectedIndexChanged(Url.Action("Grid1_DoReBind"), "Panel1")
                                                .Items(
                                                    F.RadioItem().Text("全部").Value("-1").Selected(true),
                                                    F.RadioItem().Text("在校").Value("1"),
                                                    F.RadioItem().Text("离校").Value("0")
                                                )
                                        )
                                ),
                            F.Grid().ID("Grid1").BoxFlex(1).DataIDField("Id").DataTextField("Name").EnableMultiSelect(true).KeepCurrentSelection(true).PageSize(5).ShowBorder(true).ShowHeader(false).AllowPaging(true).IsDatabasePaging(true).OnPageIndexChanged(Url.Action("Grid1_DoReBind"), "Panel1").EnableCheckBoxSelect(true)
                                .Columns(
                                    F.RowNumberField(),
                                    F.RenderField().HeaderText("姓名").DataField("Name"),
                                    F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                                    F.RenderField().HeaderText("入学年份").DataField("EntranceYear").FieldType(FieldType.Int),
                                    F.RenderCheckField().HeaderText("是否在校").DataField("AtSchool").RenderAsStaticField(true),
                                    F.RenderField().HeaderText("所学专业").DataField("Major").RendererFunction("renderMajor").ExpandUnusedSpace(true).MinWidth(150),
                                    F.RenderField().HeaderText("分组").DataField("Group").RendererFunction("renderGroup")
                                ).RecordCount(ViewBag.Grid1RecordCount).DataSource(ViewBag.Grid1DataSource)
                        )
                ),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))

}


@section script {

    <script src="~/res/js/grid.js"></script>

}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在含姓名搜索、在校筛选和分页的面板中多选人员。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>筛选后选择人员</h3>
        <ol>
            <li>
                展开面板后的<strong class="example-control-reference" data-example-control="ttbSearch" title="在姓名中查找">在姓名中查找</strong>输入框中输入<code>陈</code>，点击搜索图标。<br />
                结果：后台按姓名过滤表格，只显示匹配“陈”的记录，分页回到第一页。
            </li>
            <li>
                在结果中选择<code>陈萍萍</code>，再点击获取值按钮。<br />
                结果：读取结果包含陈萍萍及其行标识 <code>101</code>。
            </li>
            <li>
                点击搜索框清空图标。<br />
                结果：姓名关键词清除，表格重新显示未按姓名过滤的数据。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-search" aria-hidden="true"></i>筛选在校状态</h3>
        <ol>
            <li>
                在面板中选择<code>在校</code>或“离校”。<br />
                结果：表格按所选状态重新加载，原选择集合与当前页可见行分开保存。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>DataControlID</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="请从下拉表格中选择">请从下拉表格中选择</strong>）：指定弹出面板中提供选择数据的控件。 本页声明值为 <code>Grid1</code>。</li>
            <li><code>IsDatabasePaging</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：为 <code>true</code> 时后台按当前页加载；为 <code>false</code> 时浏览器对已加载数据分页。 本页声明值为 <code>true</code>。</li>
            <li><code>KeepCurrentSelection</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：在继续选择或翻页时保留已有选择。 本页声明值为 <code>true</code>。</li>
            <li><code>OnPageIndexChanged</code>（<strong class="example-control-reference" data-example-control="Grid1" title="表格">表格</strong>）：翻页后重新取得当前页数据并绑定。</li>
        </ul>
    </section>
}
