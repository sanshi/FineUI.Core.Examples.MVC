@{
    ViewBag.Title = "DropDownBox/RadioButtonListEnableEdit";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉单选框列表").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").DataControlID("RadioButtonList1").Value("js").EnableMultiSelect(false).EnableEdit(true)
                .PopPanel(
                    F.SimpleForm().ID("SimpleForm2").BodyPadding(10).AutoScroll(true).ShowBorder(true).ShowHeader(false).Hidden(true)
                        .Items(
                            F.Label().ID("Label1").Text("请选择一种编程语言："),
                            F.RadioButtonList().ID("RadioButtonList1").ColumnNumber(1)
                                .Items(
                                    F.RadioItem().Text("C#").Value("csharp"),
                                    F.RadioItem().Text("JavaScript").Value("js"),
                                    F.RadioItem().Text("JAVA").Value("java"),
                                    F.RadioItem().Text("Ruby").Value("ruby")
                                )
                        )
                ),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))


}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>在下拉面板内单选编程语言，允许输入列表之外的文字。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-edit" aria-hidden="true"></i>输入列表之外的文字</h3>
        <ol>
            <li>
                先取消现有选择，再在输入区键入“自定义说明”，收起面板或离开字段。<br />
                结果：输入区保留用户输入文字，不把它误认为某个已有的业务值；获取时按用户输入值处理。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>EnableEdit</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="下拉框">下拉框</strong>）：允许输入列表之外的文字，选中项与自由输入按不同方式读取。 本页声明值为 <code>true</code>。</li>
        </ul>
    </section>
}
