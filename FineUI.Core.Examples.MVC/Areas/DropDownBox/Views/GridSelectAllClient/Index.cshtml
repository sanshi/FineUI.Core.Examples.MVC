@{
    ViewBag.Title = "DropDownBox/GridSelectAllClient";
    var F = Html.F();
}


@section body {

    @(F.SimpleForm().IsFluid(true).ID("SimpleForm1").BodyPadding(10).ShowBorder(true).Title("下拉表格（多选）").ShowHeader(true)
        .Items(
            F.DropDownBox().ID("DropDownBox1").EmptyText("请从下拉表格中选择").MatchFieldWidth(false).EnableMultiSelect(true).DataControlID("Grid1")
                .PopPanel(
                    F.Panel().ID("Panel7").BodyPadding(10).Width(650).Height(300).ShowBorder(true).ShowHeader(false).Layout(LayoutType.Fit).Hidden(true)
                        .Toolbars(
                            F.Toolbar().Position(ToolbarPosition.Bottom)
                                .Items(
                                    F.Button().Text("全选").ID("btnSelectAll").ClickHandler("onSelectAllClick"),
                                    F.Button().Text("全选化学系").ID("btnSelectHuaxue").ClickHandler("onSelectHuaxueClick"),
                                    F.Button().Text("全选物理系").ID("btnSelectWuli").ClickHandler("onSelectWuliClick"),
                                    F.Button().Text("全选材料系（保持已选中项）").ID("btnSelectCailiao").ClickHandler("onSelectSelectCailiaoClick")
                                )
                        )
                        .Items(
                            F.Grid().ID("Grid1").ShowBorder(true).ShowHeader(false).DataIDField("Id").DataTextField("Name").EnableMultiSelect(true).KeepCurrentSelection(true).EnableCheckBoxSelect(true).BoxFlex(1)
                                .Columns(
                                    F.RenderField().DataField("Name").HeaderText("姓名"),
                                    F.RenderField().HeaderText("性别").DataField("Gender").FieldType(FieldType.Int).RendererFunction("renderGender"),
                                    F.RenderField().ExpandUnusedSpace(true).MinWidth(150).DataField("Major").HeaderText("所学专业")
                                )
                                .DataSource(DataSourceUtil.GetDataTable())
                        )
                ),
            F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").CssClass("marginr").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1")
        )
    )
    <br>

    @(F.Label().ID("labResult").EncodeText(false))

}

@section script {

    <script src="~/res/js/grid.js"></script>

    <script>

        function getRowIdsByMajor(majorName) {
            var grid = F.ui.Grid1, rows = [];
            $.each(grid.data, function (index, rowData) {
                if (rowData.values['Major'] == majorName) {
                    rows.push(rowData.id);
                }
            });
            return rows;
        }

        function onSelectAllClick(event) {
            F.ui.Grid1.selectAllRows();
            // 将数据控件中的值同步到输入框
            F.ui.DropDownBox1.syncToBox();
        }

        function onSelectHuaxueClick(event) {
            F.ui.Grid1.selectRows(getRowIdsByMajor('化学系'));
            // 将数据控件中的值同步到输入框
            F.ui.DropDownBox1.syncToBox();
        }

        function onSelectWuliClick(event) {
            F.ui.Grid1.selectRows(getRowIdsByMajor('物理系'));
            // 将数据控件中的值同步到输入框
            F.ui.DropDownBox1.syncToBox();
        }

        function onSelectSelectCailiaoClick(event) {
            F.ui.Grid1.selectRows(getRowIdsByMajor('材料科学与工程系'), { keep: true });
            // 将数据控件中的值同步到输入框
            F.ui.DropDownBox1.syncToBox();
        }

    </script>
}

@section exampleDescription {
    <section aria-label="页面描述">
        <p>通过客户端按钮全选或按专业批量选择人员。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-check" aria-hidden="true"></i>按条件批量选择</h3>
        <ol>
            <li>
                展开面板，点击<strong class="example-control-reference" data-example-control="btnSelectHuaxue" title="全选化学系">全选化学系</strong>。<br />
                结果：客户端只选中专业为化学系的人员。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnSelectCailiao" title="全选材料系（保持已选中项）">全选材料系（保持已选中项）</strong>。<br />
                结果：材料系人员加入已有选择，前面选中的化学系人员继续保留。
            </li>
            <li>
                点击<strong class="example-control-reference" data-example-control="btnSelectAll" title="全选">全选</strong>。<br />
                结果：当前表格内可选人员全部选中。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>syncToBox()</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="请从下拉表格中选择">请从下拉表格中选择</strong>）：脚本批量操作弹出数据控件后，把新的选择文字和值同步回下拉输入区。</li>
            <li><code>DataControlID</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="请从下拉表格中选择">请从下拉表格中选择</strong>）：指定弹出面板中提供选择数据的控件。 本页声明值为 <code>Grid1</code>。</li>
        </ul>
    </section>
}
