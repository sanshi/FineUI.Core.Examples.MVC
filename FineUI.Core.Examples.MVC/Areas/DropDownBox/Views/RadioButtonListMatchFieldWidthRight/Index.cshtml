@{
    ViewBag.Title = "DropDownBox/RadioButtonListMatchFieldWidthRight";
    var F = Html.F();
}


@section body {

    @(F.Panel().ID("Panel1").ShowBorder(true).Layout(LayoutType.HBox).BodyPadding(10).BoxConfigPosition(BoxLayoutPosition.End).BoxConfigAlign(BoxLayoutAlign.Start).ShowHeader(true).Title("面板（Layout=HBox BoxConfigPosition=End）").IsViewPort(true)
        .Items(
            F.SimpleForm().ID("SimpleForm1").BodyPadding(10).Width(400).ShowBorder(true).Title("下拉单选框列表（MatchFieldWidth）").ShowHeader(true)
                .Items(
                    F.DropDownBox().ID("DropDownBox1").DataControlID("RadioButtonList1").Value("js").MatchFieldWidth(false).EnableMultiSelect(false)
                        .PopPanel(
                            F.SimpleForm().ID("SimpleForm2").BodyPadding(10).AutoScroll(true).ShowBorder(true).ShowHeader(false).Width(650).Hidden(true)
                                .Items(
                                    F.Label().ID("Label1").Text("请选择一种编程语言："),
                                    F.RadioButtonList().ID("RadioButtonList1").ColumnNumber(3)
                                        .Items(
                                            F.RadioItem().Text("C#").Value("csharp"),
                                            F.RadioItem().Text("JavaScript").Value("js"),
                                            F.RadioItem().Text("JAVA").Value("java"),
                                            F.RadioItem().Text("Ruby").Value("ruby"),
                                            F.RadioItem().Text("PHP").Value("php"),
                                            F.RadioItem().Text("Objective-C").Value("objc"),
                                            F.RadioItem().Text("Python").Value("python"),
                                            F.RadioItem().Text("Perl").Value("perl"),
                                            F.RadioItem().Text("C++").Value("cplusplus"),
                                            F.RadioItem().Text("Basic").Value("basic"),
                                            F.RadioItem().Text("Go").Value("go"),
                                            F.RadioItem().Text("Swift").Value("swift")
                                        )
                                )
                        ),
                    F.Button().ID("btnGetSelection").Text("获取下拉框的选中值").OnClick(Url.Action("btnGetSelection_Click"), "DropDownBox1"),
                    F.Label().ID("labResult").EncodeText(false)
                )
        )
    )


}


@section exampleDescription {
    <section aria-label="页面描述">
        <p>演示弹出选择面板与输入框的宽度关系。</p>
        <h3><i class="f-icon f-iconfont f-iconfont-layout" aria-hidden="true"></i>对照输入框和弹出面板的宽度</h3>
        <ol>
            <li>
                展开下拉面板，对照它与输入框的左右边界。<br />
                结果：面板是否与输入框等宽由本页 <code>MatchFieldWidth</code> 配置决定，选择行为不受宽度设置影响。
            </li>
            <li>
                缩窄浏览器，再展开靠右侧的下拉面板。<br />
                结果：可以对照右侧空间不足时弹层相对输入框的水平位置。
            </li>
        </ol>
        <h3><i class="f-icon f-iconfont f-iconfont-gear" aria-hidden="true"></i>关键属性</h3>
        <ul class="example-description-properties">
            <li><code>MatchFieldWidth</code>（<strong class="example-control-reference" data-example-control="DropDownBox1" title="下拉框">下拉框</strong>）：控制弹出面板是否强制匹配字段宽度。 本页声明值为 <code>false</code>。</li>
        </ul>
    </section>
}
